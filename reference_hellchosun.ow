rule("system_time")
{
	event
	{
		Ongoing - Global;
	}

	action
	{
		If(Global.timer[3] == 0);
			Global.timer[3] = 10;
			Global.A[1] = Random Integer(1000, 2500);
			Global.A[13] = Random Integer(Global.A[0], Max(12, Global.A[0]));
			Global.A[14] = Random Integer(Global.A[0], Max(15, Global.A[0]));
			Global.A[15] = Random Integer(Global.A[0], Max(15, Global.A[0]));
			Global.A[16] = Random Integer(Max(Global.A[0], 9), 18);
			Global.A[17] = Random Integer(25, 35);
			Global.A[18] = Random Integer(Max(Global.A[0], 8), Max(16, Global.A[0]));
			Global.A[20] = Random Integer(Max(Global.A[0], 8), Global.Tax >= 30000 ? 30 : (Global.Tax >= 10000 ? 20 : 10));
			Global.A[19] = Random Integer(Global.A[0], Max(13, Global.A[0]));
			Global.P[20] = Random Integer(40, 100);
			Global.P[21] = Random Integer(10, 100);
			Global.R += Random Real(-0.050, 0.050);
			Global.T += Random Real(-0.050, 0.050);
			If(Global.R < 0.010);
				Global.R = 0.010;
			Else If(Global.R > 0.200);
				Global.R = 0.200;
			End;
			If(Global.T < 0.010);
				Global.T = 0.010;
			Else If(Global.T > 0.200);
				Global.T = 0.200;
			End;
			If(Global.O[0] == True);
				Global.T = 0.300;
				Global.R = 0.010;
				Big Message(All Players(All Teams), Custom String("급여 변동! 건물별 급여를 확인하세요."));
			Else;
				Big Message(All Players(All Teams), Custom String("건물별 급여, 금리, 세율이 변동되었습니다"));
			End;
		End;
		Wait(60, Ignore Condition);
		Global.timer[1] += 1;
		Global.timer[3] -= 1;
		If(Global.timer[1] >= 60);
			Global.timer[1] = 0;
			Global.timer[2] += 1;
		End;
		If(Global.timer[2] == 1 && Global.timer[1] == 0);
			Big Message(All Players(All Teams), Custom String("지금부터 가상의 NPC가 모든 건물의 상품 및 서비스를 구매합니다!"));
			Big Message(All Players(All Teams), Custom String("건물주의 소득이 증가합니다"));
			Global.A[0] += 1;
			Big Message(All Players(All Teams), Custom String("최저 임금 1만 원 인상 [{0}만 원]", Global.A[0]));
		Else If(Global.timer[2] == 2 && Global.timer[1] == 0);
			Global.A[0] += 1;
			Big Message(All Players(All Teams), Custom String("최저 임금 1만 원 인상 [{0}만 원]", Global.A[0]));
		Else If(Global.timer[2] == 3 && Global.timer[1] == 0);
			Global.A[0] += 1;
			Big Message(All Players(All Teams), Custom String("최저 임금 1만 원 인상 [{0}만 원]", Global.A[0]));
		End;
		If(Global.timer[2] >= 1);
			Global.N = Random Integer(Count Of(All Players(All Teams)), Count Of(All Players(All Teams)) * 2);
			For Global Variable(I, 1, Global.N, 1);
				Global.M = Random Integer(1, 2);
				If(Global.F[3] != Custom String(""));
					If(Global.Stock[1] >= 500 && Random Integer(1, 100) <= 50);
						Global.Stock[1] -= Global.M * 2;
						Global.F[3].B += Global.M * Global.P[1] * 10 / 11;
						Global.F[3].taxAmount += Global.M * Global.P[1] * 10 / 11 * Global.T;
						Global.Tax += Global.M * Global.P[1] / 11;
					Else If(Global.Stock[1] < 500 && Global.Stock[1] >= 4 && Random Integer(1, 100) <= 20);
						Global.Stock[1] -= Global.M * 2;
						Global.F[3].B += Global.M * Global.P[1] * 10 / 11;
						Global.F[3].taxAmount += Global.M * Global.P[1] * 10 / 11 * Global.T;
						Global.Tax += Global.M * Global.P[1] / 11;
					End;
					If(Global.Stock[2] >= 500 && Random Integer(1, 100) <= 50);
						Global.Stock[2] -= Global.M * 1;
						Global.F[3].B += Global.M * Global.P[2] * 10 / 11;
						Global.F[3].taxAmount += Global.M * Global.P[2] * 10 / 11 * Global.T;
						Global.Tax += Global.M * Global.P[2] / 11;
					Else If(Global.Stock[2] < 500 && Global.Stock[2] >= 2 && Random Integer(1, 100) <= 20);
						Global.Stock[2] -= Global.M * 1;
						Global.F[3].B += Global.M * Global.P[2] * 10 / 11;
						Global.F[3].taxAmount += Global.M * Global.P[2] * 10 / 11 * Global.T;
						Global.Tax += Global.M * Global.P[2] / 11;
					End;
				End;
				If(Global.F[5] != Custom String(""));
					If(Global.Stock[3] >= 500 && Random Integer(1, 100) <= 50);
						Global.Stock[3] -= Global.M * 2;
						Global.F[5].B += Global.M * Global.P[3] * 10 / 11;
						Global.F[5].taxAmount += Global.M * Global.P[3] * 10 / 11 * Global.T;
						Global.Tax += Global.M * Global.P[3] / 11;
					Else If(Global.Stock[3] < 500 && Global.Stock[3] >= 4 && Random Integer(1, 100) <= 20);
						Global.Stock[3] -= Global.M * 2;
						Global.F[5].B += Global.M * Global.P[3] * 10 / 11;
						Global.F[5].taxAmount += Global.M * Global.P[3] * 10 / 11 * Global.T;
						Global.Tax += Global.M * Global.P[3] / 11;
					End;
					If(Global.Stock[4] >= 500 && Random Integer(1, 100) <= 50);
						Global.Stock[4] -= Global.M * 1;
						Global.F[5].B += Global.M * Global.P[4] * 10 / 11;
						Global.F[5].taxAmount += Global.M * Global.P[4] * 10 / 11 * Global.T;
						Global.Tax += Global.M * Global.P[4] / 11;
					Else If(Global.Stock[4] < 500 && Global.Stock[4] >= 2 && Random Integer(1, 100) <= 20);
						Global.Stock[4] -= Global.M * 1;
						Global.F[5].B += Global.M * Global.P[4] * 10 / 11;
						Global.F[5].taxAmount += Global.M * Global.P[4] * 10 / 11 * Global.T;
						Global.Tax += Global.M * Global.P[4] / 11;
					End;
				End;
				If(Global.F[9] != Custom String(""));
					If(Global.Stock[7] >= 500 && Random Integer(1, 100) <= 50);
						Global.Stock[7] -= Global.M * 2;
						Global.F[9].B += Global.M * Global.P[11] * 10 / 11;
						Global.F[9].taxAmount += Global.M * Global.P[11] * 10 / 11 * Global.T;
						Global.Tax += Global.M * Global.P[11] / 11;
					Else If(Global.Stock[7] < 500 && Global.Stock[7] >= 4 && Random Integer(1, 100) <= 20);
						Global.Stock[7] -= Global.M * 2;
						Global.F[9].B += Global.M * Global.P[11] * 10 / 11;
						Global.F[9].taxAmount += Global.M * Global.P[11] * 10 / 11 * Global.T;
						Global.Tax += Global.M * Global.P[11] / 11;
					End;
				End;
				If(Global.F[4] != Custom String(""));
					If(Global.Stock[9] >= 500 && Random Integer(1, 100) <= 50);
						Global.Stock[9] -= Global.M * 2;
						Global.F[4].B += Global.M * Global.P[10] * 10 / 11;
						Global.F[4].taxAmount += Global.M * Global.P[10] * 10 / 11 * Global.T;
						Global.Tax += Global.M * Global.P[10] / 11;
					Else If(Global.Stock[9] < 500 && Global.Stock[9] >= 4 && Random Integer(1, 100) <= 20);
						Global.Stock[9] -= Global.M * 2;
						Global.F[4].B += Global.M * Global.P[10] * 10 / 11;
						Global.F[4].taxAmount += Global.M * Global.P[10] * 10 / 11 * Global.T;
						Global.Tax += Global.M * Global.P[10] / 11;
					End;
				End;
				If(Random Integer(1, 100) <= 30);
					Global.F[8].B += Global.M * Global.P[7] * 10 / 11;
					Global.F[8].taxAmount += Global.M * Global.P[7] * 10 / 11 * Global.T;
					Global.Tax += Global.M * Global.P[7] / 11;
					Global.F[6].B += Global.M * Global.P[9] * 10 / 11;
					Global.F[6].taxAmount += Global.M * Global.P[9] * 10 / 11 * Global.T;
					Global.Tax += Global.M * Global.P[9] / 11;
					Global.F[7].B += Global.M * Round To Integer(Global.P[5] * 10 / 11, To Nearest);
					Global.F[7].taxAmount += Global.M * Round To Integer(Global.P[5] * 10 / 11, To Nearest) * Global.T;
					Global.Tax += Global.M * Global.P[5] / 11;
				End;
			End;
		End;
		Loop;
	}
}

rule("system_global_2")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	action
	{
		While(True);
			Wait(300, Ignore Condition);
			If(Event Player.B > 0);
				Small Message(Event Player, Custom String("예금 이자 {0}만 원이 입금되었습니다", Round To Integer(Event Player.B * Global.R, Down)
					>= 10000 ? Custom String("{0}억 {1}", Round To Integer(Event Player.B * Global.R / 10000, Down), Round To Integer(
					Event Player.B * Global.R % 10000, Down)) : Custom String("{0}", Round To Integer(Event Player.B * Global.R, Down))));
				Wait(0.050, Ignore Condition);
				Play Effect(Event Player, Buff Impact Sound, Color(Green), Event Player, 100);
				Event Player.B += Round To Integer(Event Player.B * Global.R, Down);
				Event Player.taxAmount += Round To Integer(Event Player.B * Global.R, Down) * Global.T;
				Event Player.ms[3] += Min(990 - Event Player.ms[3], Random Integer(1, 20));
			Else If(Event Player.B < 0);
				Small Message(Event Player, Custom String("대출 이자 {0}만 원", Round To Integer(Event Player.B * Global.R, Down)
					>= 10000 ? Custom String("{0}억 {1}", 0 - Round To Integer(Event Player.B * Global.R / 10000, Down), 0 - Round To Integer(
					Event Player.B * Global.R % 10000, Down)) : Custom String("{0}", 0 - Round To Integer(Event Player.B * Global.R, Down))));
				Wait(0.050, Ignore Condition);
				Event Player.B += Round To Integer(Event Player.B * Global.R, Down);
				Event Player.ms[3] -= Min(Event Player.ms[3], Random Integer(1, 20));
			End;
		End;
	}
}

