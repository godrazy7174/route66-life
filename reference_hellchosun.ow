	}

	condition
	{
		Is Button Held(Event Player, Button(Reload)) == True;
		Hero(레킹볼) != Hero Of(Event Player);
		Event Player.S[3] >= 1;
		Event Player.AA > 0;
		Is Alive(Event Player) == True;
	}

	action
	{
		Event Player.S[3] -= 1;
		Event Player.R[1] = Min(50, Event Player.AA);
		Wait(0.050, Ignore Condition);
		Event Player.AA -= Event Player.R[1];
		Small Message(Event Player, Custom String("샌드위치를 먹었다 [배고픔 -{0}%]", Round To Integer(Event Player.R[1], Up)));
		Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 50);
	}
