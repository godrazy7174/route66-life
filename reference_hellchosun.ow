						Destroy HUD Text(Event Player.text[4]);
						Set Damage Received(Event Player, 0);
						Event Player.AA = 0;
						Event Player.C[11] = 0;
						Event Player.H[0] = Custom String("국민");
						If(Event Player.ms[1] <= 10);
							Event Player.ms[1] = 0;
							Event Player.ms[0] = Custom String("명성");
						Else;
							Event Player.ms[1] -= 10;
						End;
						Start Forcing Player To Be Hero(Event Player, Event Player.E[0]);
						Global.Tax += Event Player.C[9];
						Event Player.A -= Event Player.C[9];
						If(Event Player.A < 0);
							Event Player.B += Event Player.A;
							Event Player.A = 0;
						End;
						Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
						Teleport(Event Player, Event Player.Jobm[1] == 1 ? Vector(-75.420, 8, -46.370) : (Event Player.Jobm[1] == 2 ? Vector(-47.210,
							4.050, -45.860) : (Event Player.Jobm[1] == 3 ? Vector(-17.110, 3, -53.850) : (Event Player.Jobm[1] == 4 ? Vector(-56.220, 2,
							-2.200) : (Event Player.Jobm[1] == 5 ? Vector(39.800, 4, -45.790) : (Event Player.Jobm[1] == 6 ? Vector(57.980, 8, -30.390) : (
							Event Player.Jobm[1] == 7 ? Vector(78.790, 8, -42.670) : (Event Player.Jobm[1] == 8 ? Vector(171.700, 7.900, 53.560) : (
							Event Player.Jobm[1] == 9 ? Vector(172.460, 7.750, -104.550) : Vector(128.380, 9, -23.880))))))))));
						Event Player.name[0] = Custom String("");
						Wait(0.500, Ignore Condition);
						Small Message(Event Player, Custom String("보석금 {0}만 원을 내고 출소하였습니다 [악명 -10]", Event Player.C[9]));
						Wait(0.200, Ignore Condition);
						Event Player.C[9] = 0;
					Else;
						For Player Variable(Event Player, level, 0, Count Of(Global.C[1]), 1);
							If(Event Player.ms[3] >= Global.C[1][Event Player.level]);
								Event Player.ms[4] = Global.O[0] == True ? Event Player.ms[3] * Global.C[2][Event Player.level] / 2 : Event Player.ms[3] * Global.C[2][Event Player.level];
								Break;
							End;
						End;
						If(
							Event Player.A + Event Player.ms[4] >= Event Player.C[9] || Event Player.A + Event Player.B + Event Player.ms[4] >= Event Player.C[9]);
							Event Player.name[0] = Custom String(
								"---------------\r\n보석금이 부족합니다\r\n대출을 받아 즉시 출소할 수 있습니다\r\n---------------\r\n부족한 금액: {0}만 원\r\n신용점수: {1}점\r\n대출 한도: {2}",
								Event Player.C[9] - (Event Player.A + Event Player.B), Event Player.ms[3], Custom String(
								"{0}만 원\r\n---------------\r\n[좌클] 확인\r\n[점프] 닫기", Event Player.ms[4]));
							Event Player.R[17] = True;
						Else;
							Event Player.name[0] = Custom String("");
							Small Message(Event Player, Custom String("보석금을 지불할 현금과 예금이 부족합니다"));
						End;
					End;
				Else If(Event Player.R[17] == True);
					Event Player.ms[3] -= 50;
					Event Player.J[2] = 1;
					Event Player.gamock = 0;
					Set Melee Enabled(Event Player, False);
					Event Player.Jobm[1] = Random Integer(1, 10);
					Wait(0.500, Ignore Condition);
					Destroy HUD Text(Event Player.text[4]);
					Set Damage Received(Event Player, 0);
					Event Player.AA = 0;
					Event Player.C[11] = 0;
					Event Player.H[0] = Custom String("국민");
					If(Event Player.ms[1] <= 10);
						Event Player.ms[1] = 0;
						Event Player.ms[0] = Custom String("명성");
					Else;
						Event Player.ms[1] -= 10;
					End;
					Start Forcing Player To Be Hero(Event Player, Event Player.E[0]);
					Global.Tax += Event Player.C[9];
					Event Player.A -= Event Player.C[9];
					If(Event Player.A < 0);
						Event Player.B += Event Player.A;
						Event Player.A = 0;
					End;
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
					Teleport(Event Player, Event Player.Jobm[1] == 1 ? Vector(-75.420, 8, -46.370) : (Event Player.Jobm[1] == 2 ? Vector(-47.210,
						4.050, -45.860) : (Event Player.Jobm[1] == 3 ? Vector(-17.110, 3, -53.850) : (Event Player.Jobm[1] == 4 ? Vector(-56.220, 2,
						-2.200) : (Event Player.Jobm[1] == 5 ? Vector(39.800, 4, -45.790) : (Event Player.Jobm[1] == 6 ? Vector(57.980, 8, -30.390) : (
						Event Player.Jobm[1] == 7 ? Vector(78.790, 8, -42.670) : (Event Player.Jobm[1] == 8 ? Vector(171.700, 7.900, 53.560) : (
						Event Player.Jobm[1] == 9 ? Vector(172.460, 7.750, -104.550) : Vector(128.380, 9, -23.880))))))))));
					Event Player.name[0] = Custom String("");
					Wait(0.500, Ignore Condition);
					Small Message(Event Player, Custom String("대출을 받아 보석금 {0}만 원을 내고 출소하였습니다 [악명 -10]", Event Player.C[9]));
					Wait(0.200, Ignore Condition);
					Event Player.C[9] = 0;
				End;
			End;
		End;
	}
}

rule("상호작용S")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Secondary Fire)) == True;
		Hero(레킹볼) != Hero Of(Event Player);
		Is Alive(Event Player) == True;
	}

	action
	{
		If(Event Player.R[15] == True && Event Player.moneyjp > 0);
			Event Player.moneyjp -= 10;
			Wait(0.100, Ignore Condition);
			Event Player.name[0] = Custom String("-------------------\r\n{0}{1}님에게 송금 {2}", Hero Icon String(Hero Of(
				Event Player.players[Event Player.targetIndex])), Event Player.players[Event Player.targetIndex], Custom String(
				"{0}만 원\r\n-------------------\r\n[좌/우클릭] 송금액 +-\r\n[E/V] 플레이어 목록 앞/뒤\r\n[F] 송금하기\r\n-------------------\r\n[점프] 닫기\r\n",
				Event Player.moneyjp));
		End;
	}
}

rule("상호작용점프")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Jump)) == True;
		Hero(레킹볼) != Hero Of(Event Player);
		Is Alive(Event Player) == True;
		Distance Between(Event Player, Global.jp[46]) <= 2;
	}

	action
	{
		If(Event Player.C[1] < 10);
			Call Subroutine(empty_power);
			Abort;
		Else If(Event Player.A < Global.P[5]);
			Call Subroutine(empty_money);
			Abort;
		Else If(Event Player.C[10] >= 1000);
			Small Message(Event Player, Custom String("헬스로 올릴 수 있는 최고인 1,000 기력에 도달했다"));
			Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
			Abort;
		End;
		Event Player.A -= Global.P[5];
		Global.F[7].B += Round To Integer(Global.P[5] * 10 / 11, To Nearest);
		Global.F[7].taxAmount += Round To Integer(Global.P[5] * 10 / 11, To Nearest) * Global.T;
		Global.Tax += Global.P[5] / 11;
		Event Player.C[1] -= 10;
		Event Player.AA += 5;
		Event Player.R[3] = Min(Random Integer(1, 10), 1000 - Event Player.C[10]);
		Wait(0.050, Ignore Condition);
		Event Player.C[10] += Event Player.R[3];
		Wait(1, Ignore Condition);
		Small Message(Event Player, Custom String("헬스를 하여 건강해졌다! [최대 기력 +{1}, 최대 기력: {0}]", Event Player.C[10], Event Player.R[3]));
		Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
		If(Event Player.C[10] == 1000);
			Small Message(Event Player, Custom String("헬스로 올릴 수 있는 최고인 1,000 기력에 도달했다!"));
		End;
	}
}

rule("옷창")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Interact)) == True;
		Hero(레킹볼) != Hero Of(Event Player);
		Distance Between(Global.jp[35], Event Player) <= 2;
	}

	action
	{
		Event Player.name[1] += 1;
		If(Event Player.name[1] <= 13);
			Event Player.name[0] = Custom String(
				"------------------\r\n{0} {1}\r\n------------------\r\n가격: {2}만 원\r\n구매: [V]\r\n[F] 다음\r\n-------------------\r\n[점프] 닫기\r\n",
				Hero Icon String(Global.C[5][Event Player.name[1] - 1]), Global.C[3][Event Player.name[1] - 1],
				Global.C[4][Event Player.name[1] - 1]);
		Else If(Event Player.name[1] == 14);
			Event Player.name[1] = 0;
			Event Player.name[0] = Custom String("");
		End;
	}
}

rule("스포츠카 시스템")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Crouch)) == True;
		Event Player.R[10] == True;
	}

	action
	{
		Wait(1.500, Abort When False);
		If(Event Player.R[9] == 0);
			Event Player.R[8] = 0;
			Set Move Speed(Event Player, 0);
			Wait(0.100, Abort When False);
			Event Player.R[8] = Hero Of(Event Player);
			Event Player.R[9] = 1;
			Start Forcing Player To Be Hero(Event Player, Hero(레킹볼));
			Set Ability 1 Enabled(Event Player, True);
			Wait(0.500, Ignore Condition);
			Press Button(Event Player, Button(Ability 1));
			Set Ability 1 Enabled(Event Player, False);
			Set Move Speed(Event Player, 100);
			Small Message(Event Player, Custom String("스포츠카에 탑승했습니다!"));
		Else;
			Start Forcing Player To Be Hero(Event Player, Event Player.R[8]);
			Event Player.R[9] = 0;
			Small Message(Event Player, Custom String("스포츠카에서 내렸습니다"));
			If(Hero(에코) == Hero Of(Event Player) || Hero(젠야타) == Hero Of(Event Player) || Hero(해저드) == Hero Of(Event Player)
				|| Event Player.C[11] == 1 || Hero(윈스턴) == Hero Of(Event Player));
				Set Ability 1 Enabled(Event Player, True);
			End;
		End;
	}
}

rule("Effect_1")
{
	event
	{
		Ongoing - Each Player;
		All;
		주노;
	}

	condition
	{
		Hero(주노) == Hero Of(Event Player);
	}

	action
	{
		Destroy Effect(Event Player.EffectID[1]);
		Destroy Effect(Event Player.EffectID[2]);
		Destroy Effect(Event Player.EffectID[3]);
		Destroy Effect(Event Player.EffectID[4]);
		Wait(1, Ignore Condition);
		Create Effect(All Players(All Teams), Sparkles, Color(흰색), Event Player, 1, Visible To Position and Radius);
		Event Player.EffectID[2] = Last Created Entity;
		Wait(1, Ignore Condition);
		Create Effect(All Players(All Teams), Sparkles, Color(Red), Event Player, 1, Visible To Position and Radius);
		Event Player.EffectID[3] = Last Created Entity;
	}
}

rule("Effect_2")
{
	event
	{
		Ongoing - Each Player;
		All;
		파라;
	}

	condition
	{
		Hero(파라) == Hero Of(Event Player);
	}

	action
	{
		Destroy Effect(Event Player.EffectID[1]);
		Destroy Effect(Event Player.EffectID[2]);
		Destroy Effect(Event Player.EffectID[3]);
		Destroy Effect(Event Player.EffectID[4]);
		Wait(1, Ignore Condition);
		Create Effect(All Players(All Teams), Good Aura, Color(Orange), Event Player, 0.700, Visible To Position and Radius);
		Event Player.EffectID[1] = Last Created Entity;
		Wait(1, Ignore Condition);
		Create Effect(All Players(All Teams), Sparkles, Color(흰색), Event Player, 1, Visible To Position and Radius);
		Event Player.EffectID[3] = Last Created Entity;
	}
}

rule("Effect_3")
{
	event
	{
		Ongoing - Each Player;
		All;
		브리기테;
	}

	action
	{
		Destroy Effect(Event Player.EffectID[1]);
		Destroy Effect(Event Player.EffectID[2]);
		Destroy Effect(Event Player.EffectID[3]);
		Destroy Effect(Event Player.EffectID[4]);
		Wait(1, Ignore Condition);
		Create Effect(All Players(All Teams), Sparkles, Color(Red), Event Player, 1, Visible To Position and Radius);
		Event Player.EffectID[1] = Last Created Entity;
	}
}

rule("Effect_4")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Hero Of(Event Player) != Hero(주노);
		Hero Of(Event Player) != Hero(파라);
		Hero Of(Event Player) != Hero(브리기테);
	}

	action
	{
		Destroy Effect(Event Player.EffectID[1]);
		Destroy Effect(Event Player.EffectID[2]);
		Destroy Effect(Event Player.EffectID[3]);
		Destroy Effect(Event Player.EffectID[4]);
	}
}

rule("anti crash")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.antiCrashActivated == False;
		Server Load > 230;
	}

	action
	{
		Wait(1, Abort When False);
		Small Message(All Players(All Teams), Custom String("서버 최적화 시스템 작동 중.."));
		Set Slow Motion(10);
		Global.antiCrashActivated = True;
	}
}

rule("disable anti crash")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.antiCrashActivated == True;
		Server Load < 200;
	}

	action
	{
		Set Slow Motion(100);
		Global.antiCrashActivated = False;
	}
}

rule("sub_policescore")
{
	event
	{
		Subroutine;
		policescore;
	}

	action
	{
		Event Player.UI[1] = Custom String("\r\n이번 달 실적: {0}/100\n\n계급: {1} {2}", Event Player.P[6], Event Player.P[4], Custom String(
			"{0}호봉\n월급: {1}만 원", Event Player.P[7], Event Player.P[8]));
	}
}

rule("sub_disablebutton")
{
	event
	{
		Subroutine;
		disablebutton;
	}

	action
	{
		Global.disableButtonList = Array(Button(Primary Fire), Button(Secondary Fire), Button(Ability 2), Button(Reload));
		Global.indexFromVector = Array(Left, Up, Forward);
	}
}

rule("sub_disabledWallCheck")
{
	event
	{
		Subroutine;
		disabledWallCheck;
	}

	action
	{
		While(True);
			Wait(1, Ignore Condition);
			Event Player.disabledWall = First Of(Sorted Array(Global.Position[0], Distance Between(Event Player, Current Array Element)));
			If(Distance Between(Event Player.disabledWall, Event Player) < Global.GO[Index Of Array Value(Global.Position[0],
				Event Player.disabledWall)]);
				Disable Movement Collision With Environment(Event Player, False);
				Wait Until(Distance Between(Event Player.disabledWall, Event Player) >= Global.GO[Index Of Array Value(Global.Position[0],
					Event Player.disabledWall)], 99999);
				Enable Movement Collision With Environment(Event Player);
				Set Damage Received(Event Player, 0);
			End;
		End;
	}
}

rule("sub_납세")
{
	event
	{
		Subroutine;
		tax;
	}

	action
	{
		Event Player.totalAssets[1] = Max(0, Event Player.A);
		Event Player.totalAssets[2] = Max(0, Event Player.B);
		Event Player.taxAmount = Global.B[2] == 1 && Count Of(Filtered Array(Global.F, Current Array Element == Event Player))
			> 1 ? Round To Integer(Event Player.taxAmount * 2, Up) : Round To Integer(Event Player.taxAmount, Up);
		If(Event Player.totalAssets[1] + Event Player.totalAssets[2] >= Round To Integer(Event Player.taxAmount, Up));
			Global.Tax += Round To Integer(Event Player.taxAmount, Up);
			If(Event Player.A >= Round To Integer(Event Player.taxAmount, Up));
				Event Player.A -= Round To Integer(Event Player.taxAmount, Up);
			Else If(Event Player.B >= Round To Integer(Event Player.taxAmount, Up));
				Event Player.B -= Round To Integer(Event Player.taxAmount, Up);
			Else If(Event Player.A + Event Player.B >= Round To Integer(Event Player.taxAmount, Up));
				Event Player.remainingTax = Round To Integer(Event Player.taxAmount, Up) - Event Player.A;
				Event Player.A = 0;
				Event Player.B -= Event Player.remainingTax;
			End;
		Else;
			Small Message(Event Player, Custom String("현금과 예금이 부족하여 세금을 납부할 수 없습니다"));
			Abort;
		End;
		If(Event Player.ms[0] == Custom String("명성"));
			Small Message(Event Player, Custom String("세금 {0}만 원 납부되었습니다 [명성 +2]", Round To Integer(Event Player.taxAmount, Up)));
			Event Player.ms[1] += 2;
		Else If(Event Player.ms[0] == Custom String("악명"));
			Small Message(Event Player, Custom String("세금 {0}만 원 납부되었습니다 [악명 -2]", Round To Integer(Event Player.taxAmount, Up)));
			Event Player.ms[1] -= 2;
			If(Event Player.ms[1] <= 0);
				Event Player.ms[1] = 0 - Event Player.ms[1];
				Event Player.ms[0] = Custom String("명성");
			End;
		End;
		Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
		Destroy In-World Text(Event Player.Tax2);
		Destroy Effect(Event Player.NBeam[1]);
		Event Player.Tax = 0;
		Event Player.ms[3] += Min(990 - Event Player.ms[3], Random Integer(1, 20));
		Wait(0.030, Ignore Condition);
		Event Player.taxAmount = 0;
	}
}

rule("sub_감옥2")
{
	event
	{
		Subroutine;
		prisontime;
	}

	action
	{
		If(Event Player.ms[0] == Custom String("악명"));
			If(Event Player.ms[1] >= 1);
				Create HUD Text(All Players(All Teams), Null, Custom String("\r\n\r\n{0} {1}초 동안 교도소 구속", Event Player, Event Player.C[9]), Null,
					Left, 10, Color(흰색), Color(흰색), Color(흰색), Visible To and String, Default Visibility);
				Event Player.text[4] = Last Text ID;
				Event Player.J[2] = 0;
				While(Event Player.C[9] >= 1);
					Wait(10, Ignore Condition);
					Event Player.C[9] -= 10;
					Skip If(Event Player.J[2] == 1, 1);
				End;
				Destroy HUD Text(Event Player.text[4]);
			End;
		End;
	}
}

rule("sub_대통령 출마 시스템")
{
	event
	{
		Subroutine;
		president;
	}

	action
	{
		If(Event Player.A >= 10000 && Global.Presi == 0 && Event Player.C[11] != 1);
			Global.Presi = 1;
			Event Player.C[11] = 2;
			Set Status(Event Player, Null, Rooted, 10);
			Wait(0.250, Ignore Condition);
			If(Event Player.ms[0] == Custom String("명성"));
				Global.President[1] = Event Player.ms[1] / 10;
			Else If(Event Player.ms[0] == Custom String("악명"));
				Global.President[1] = 0 - Event Player.ms[1] / 10;
			End;
			Teleport(Event Player, Vector(0, 6.500, 23.790));
			Event Player.A -= 10000;
			Global.Tax += 10000;
			Wait(0.500, Ignore Condition);
			Big Message(All Players(All Teams), Custom String("{0} 님이 대통령에 출마했습니다! 투표소로 이동하여 투표하세요", Event Player));
			Create HUD Text(All Players(All Teams), Null, Custom String("대통령 후보: {0}\r\n당선 확률: {1}%", Event Player, Global.President[1]), Null,
				Left, 2, Color(흰색), Color(Sky Blue), Color(흰색), Visible To and String, Default Visibility);
			Global.President[2] = Last Text ID;
			Wait(0.500, Ignore Condition);
			Call Subroutine(start_voting);
		Else If(Event Player.C[11] == 1);
			Small Message(Event Player, Custom String("경찰은 선거에 출마할 수 없습니다"));
			Wait(2, Ignore Condition);
			Small Message(Event Player, Custom String("퇴직 후 선거에 출마할 수 있습니다"));
		Else;
			Small Message(Event Player, Custom String("자산이 부족하거나 대통령 선거가 진행 중이거나 이미 대통령이 있습니다"));
		End;
	}
}

rule("sub_투표 시스템 시작")
{
	event
	{
		Subroutine;
		start_voting;
	}

	action
	{
		All Players(All Teams).hasVoted = 2;
		Start Camera(All Players(All Teams), Vector(9.920, 8, 20.670), Vector(6.400, 6, 23.170), 15);
		Small Message(All Players(All Teams), Custom String("투표소로 이동하여 투표를 시작하세요! 투표 시간: 100초"));
		Set Status(All Players(All Teams), Null, Rooted, 3.900);
		Wait(4, Ignore Condition);
		Start Camera(All Players(All Teams), Ray Cast Hit Position(Local Player, Local Player + World Vector Of(Vector(0, 0, 0),
			Local Player, Rotation) + Up * 1.800 + Facing Direction Of(Local Player) * -2.800, Null, Local Player, True),
			Local Player + Facing Direction Of(Local Player) * 1000, 60);
		Global.President[4] = 100;
		Create HUD Text(All Players(All Teams), Null, Custom String("남은 투표 시간: {0}초", Global.President[4]), Null, Left, 3, Color(흰색),
			Color(흰색), Color(흰색), Visible To and String, Default Visibility);
		Global.President[3] = Last Text ID;
		While(Global.President[4] > 0);
			Wait(1, Ignore Condition);
			Global.President[4] -= 1;
		End;
		Call Subroutine(end_voting);
	}
}

rule("sub_투표 종료 및 결과 처리")
{
	event
	{
		Subroutine;
		end_voting;
	}

	action
	{
		Small Message(All Players(All Teams), Custom String("투표가 종료되었습니다!"));
		Destroy HUD Text(Global.President[2]);
		Destroy HUD Text(Global.President[3]);
		All Players(All Teams).hasVoted = 0;
		Wait(3, Ignore Condition);
		If(Global.President[1] >= Random Integer(1, 100));
			Global.F[1] = Event Player;
			Event Player.H[0] = Custom String("대통령");
			Event Player.E[0] = Hero Of(Event Player);
			Wait(0.500, Ignore Condition);
			Start Forcing Player To Be Hero(Event Player, Hero(브리기테));
			Global.Presi = Append To Array(Global.Presi, Event Player);
			Teleport(Event Player, Vector(0, 6.500, 23.790));
			Start Camera(All Players(All Teams), Vector(0, 6, 16.900), Vector(0, 7.500, 23.790), 40);
			Wait(1.500, Ignore Condition);
			Big Message(All Players(All Teams), Custom String("대통령 당선! {0} 님이 헬조선의 대통령이 되었습니다!", Event Player));
			Start Camera(All Players(All Teams), Vector(0, 6.200, 18), Vector(0, 7.500, 23.790), 40);
			Wait(1.500, Ignore Condition);
			Start Camera(All Players(All Teams), Vector(0, 6.400, 19.500), Vector(0, 7.500, 23.790), 40);
			Wait(1.500, Ignore Condition);
			Start Camera(All Players(All Teams), Vector(0, 6.600, 21), Vector(0, 7.500, 23.790), 40);
			Wait(0.500, Ignore Condition);
			Global.President = 10;
			While(Global.President >= 1);
				Play Effect(All Players(All Teams), Good Pickup Effect, Color(Rose), Vector(5.685, 7, 85.890), 30);
				Wait(0.500, Ignore Condition);
				Global.President -= 1;
			End;
			Wait(1, Ignore Condition);
			Play Effect(All Players(All Teams), Buff Impact Sound, Color(흰색), Event Player, 300);
			Start Camera(All Players(All Teams), Ray Cast Hit Position(Local Player, Local Player + World Vector Of(Vector(0, 0, 0),
				Local Player, Rotation) + Up * 1.800 + Facing Direction Of(Local Player) * -2.800, Null, Local Player, True),
				Local Player + Facing Direction Of(Local Player) * 1000, 60);
			Event Player.A += 10000;
			Event Player.C[11] = 3;
			Event Player.S[1] = 200;
			Event Player.C[10] += 1000;
			Event Player.timer[2] = 30;
			Create HUD Text(Event Player, Null, Custom String("대통령 임기: {0}분 남음", Event Player.timer[2]), Null, Left, 5, Color(흰색), Color(흰색),
				Color(흰색), Visible To and String, Default Visibility);
			Event Player.text[2] = Last Text ID;
			Wait(1, Ignore Condition);
			Small Message(Event Player, Custom String("대통령은 30분의 임기를 채우고 자동으로 퇴임합니다"));
			While(Event Player.timer[2] > 0 && Event Player.C[11] == 3);
				Wait(60, Ignore Condition);
				Event Player.timer[2] -= 1;
			End;
			If(Event Player.R[9] == 1);
				Start Forcing Player To Be Hero(Event Player, Event Player.R[8]);
				Event Player.R[9] = 0;
				Small Message(Event Player, Custom String("스포츠카에서 내렸습니다"));
				If(Hero(에코) == Hero Of(Event Player) || Hero(젠야타) == Hero Of(Event Player) || Hero(해저드) == Hero Of(Event Player)
					|| Event Player.C[11] == 1 || Hero(윈스턴) == Hero Of(Event Player));
					Set Ability 1 Enabled(Event Player, True);
				End;
			End;
			Wait(1, Ignore Condition);
			If(Event Player.C[11] == 3);
				Event Player.C[11] = 0;
				Global.Presi = 0;
				Global.B[1] = 0;
				Start Forcing Player To Be Hero(Event Player, Hero(윈스턴));
				Set Ability 1 Enabled(Event Player, True);
				Wait(0.050, Ignore Condition);
				Event Player.H[0] = Custom String("전 대통령");
				Global.F[1] = Custom String("");
				Destroy HUD Text(Event Player.text[2]);
				Big Message(All Players(All Teams), Custom String("{0} 대통령이 임기를 마치고 퇴임하였습니다", Event Player));
				Small Message(Event Player, Custom String("임기를 다 채워서 대통령직에서 퇴임하였다"));
				Wait(1, Ignore Condition);
				Event Player.B += Round To Integer(10000 * (1 - Global.T), Up);
				Global.Tax -= Round To Integer(10000 * (1 - Global.T), Up);
				Small Message(Event Player, Custom String("임기를 다 채우고 퇴임하여서 퇴직금으로 세금 {0}% 공제 후 {1}만 원을 받았다", Global.T * 100, Round To Integer(
					10000 * (1 - Global.T), Up)));
				Play Effect(All Players(All Teams), Buff Impact Sound, Color(흰색), Event Player, 300);
			End;
		Else;
			Big Message(All Players(All Teams), Custom String("{0} 님이 대통령 선거에 낙선했습니다", Event Player));
			Event Player.C[11] = 0;
			Global.Presi = 0;
		End;
	}
}

rule("sub_투표 종료 및 결과 처리")
{
	event
	{
		Subroutine;
		end_voting2;
	}

	action
	{
		Small Message(All Players(All Teams), Custom String("투표가 종료되었습니다!"));
		Destroy HUD Text(Global.President[2]);
		Destroy HUD Text(Global.President[3]);
		All Players(All Teams).hasVoted = 0;
		Wait(3, Ignore Condition);
		If(Event Player.C[11] == 3 && Global.President[1] >= Random Integer(1, 100));
			Small Message(All Players(All Teams), Custom String("{0} {1} {2}: 촛불의 힘을 보여주자!", Hero Icon String(Hero(메르시)), Hero Icon String(
				Hero(D.Va)), Hero Icon String(Hero(키리코))));
			Event Player.R[3] = Max(100, Event Player.C[10] - 1000);
			Wait(0.020, Ignore Condition);
			Event Player.C[10] = Event Player.R[3];
			Destroy HUD Text(Event Player.text[2]);
			Event Player.timer[2] = 0;
			Event Player.C[11] = 0;
			Global.Presi = 0;
			Global.B[1] = 0;
			Event Player.H[0] = Custom String("탄핵된 대통령");
			Global.F[1] = Custom String("");
			Wait(1, Ignore Condition);
			Big Message(All Players(All Teams), Custom String("대통령 {0}님이 탄핵되었습니다", Event Player));
			Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
			Wait(3, Ignore Condition);
			Event Player.ms[1] = 100;
			Event Player.ms[0] = Custom String("악명");
			Small Message(Event Player, Custom String("대통령에서 탄핵되었다.. [악명 100]"));
			Start Forcing Player To Be Hero(Event Player, Hero(시그마));
		Else;
			Big Message(All Players(All Teams), Custom String("{0} 대통령이 탄핵되지 않았습니다", Global.F[1]));
		End;
	}
}

rule("sub_Police_Salary")
{
	event
	{
		Subroutine;
		Police_Salary;
	}

	action
	{
		Event Player.P[10] = Event Player.P[4];
		Event Player.P[4] = Event Player.P[4] == Custom String("순경") && Event Player.P[9] >= 200 ? Custom String("경장") : (
			Event Player.P[4] == Custom String("경장") && Event Player.P[9] >= 300 ? Custom String("경사") : (
			Event Player.P[4] == Custom String("경사") && Event Player.P[9] >= 400 ? Custom String("경위") : (
			Event Player.P[4] == Custom String("경위") && Event Player.P[9] >= 500 ? Custom String("경감") : (
			Event Player.P[4] == Custom String("경감") && Event Player.P[9] >= 600 ? Custom String("경정") : (
			Event Player.P[4] == Custom String("경정") && Event Player.P[9] >= 700 ? Custom String("총경") : (
			Event Player.P[4] == Custom String("총경") && Event Player.P[9] >= 800 ? Custom String("경무관") : (
			Event Player.P[4] == Custom String("경무관") && Event Player.P[9] >= 900 ? Custom String("치안감") : (
			Event Player.P[4] == Custom String("치안감") && Event Player.P[9] >= 1000 ? Custom String("치안정감") : (
			Event Player.P[4] == Custom String("치안정감") && Event Player.P[9] >= 2000 && Global.F[2] == Custom String("") ? Custom String(
			"치안총감") : Event Player.P[4])))))))));
		If(Event Player.P[10] != Event Player.P[4]);
			Event Player.H[0] = Event Player.P[4] == Custom String("경위") ? Custom String("2급 경찰팀장") : (Event Player.P[4] == Custom String("경감")
				? Custom String("1급 경찰팀장") : (Event Player.P[4] == Custom String("경정") ? Custom String("2급 경찰서장") : (
				Event Player.P[4] == Custom String("총경") ? Custom String("1급 경찰서장") : (Event Player.P[4] == Custom String("경무관")
				? Custom String("헬조선 경찰청 과장") : (Event Player.P[4] == Custom String("치안감") ? Custom String("헬조선 경찰청 차장") : (
				Event Player.P[4] == Custom String("치안정감") ? Custom String("헬조선 경찰청장") : (Event Player.P[4] == Custom String("치안총감")
				? Custom String("경찰청장") : Event Player.H[0])))))));
			Event Player.P[5] = Event Player.P[4] == Custom String("순경") ? Global.A[2] : (Event Player.P[4] == Custom String("경장")
				? Global.A[3] : (Event Player.P[4] == Custom String("경사") ? Global.A[4] : (Event Player.P[4] == Custom String("경위")
				? Global.A[5] : (Event Player.P[4] == Custom String("경감") ? Global.A[6] : (Event Player.P[4] == Custom String("경정")
				? Global.A[7] : (Event Player.P[4] == Custom String("총경") ? Global.A[8] : (Event Player.P[4] == Custom String("경무관")
				? Global.A[9] : (Event Player.P[4] == Custom String("치안감") ? Global.A[10] : (Event Player.P[4] == Custom String("치안정감")
				? Global.A[11] : (Event Player.P[4] == Custom String("치안총감") ? Global.A[12] : 0))))))))));
			Event Player.P[8] = Round To Integer(Event Player.P[5] * 1.020 ^ Event Player.P[7], To Nearest);
			Event Player.P[9] = 0;
			If(Event Player.P[4] == Custom String("경위"));
				Start Forcing Player To Be Hero(Event Player, Hero(바티스트));
			Else If(Event Player.P[4] == Custom String("경무관"));
				Start Forcing Player To Be Hero(Event Player, Hero(소전));
			Else If(Event Player.P[4] == Custom String("치안총감"));
				Start Forcing Player To Be Hero(Event Player, Hero(라인하르트));
				Global.F[2] = Event Player;
			End;
			Small Message(Event Player, Custom String("축하합니다! {0} 진급하였습니다", Event Player.P[4]));
			Call Subroutine(policescore);
		End;
	}
}

rule("sub_badcop")
{
	event
	{
		Subroutine;
		badcop;
	}

	action
	{
		If(Event Player.C[11] == 1 && Event Player.ms[0] == Custom String("악명"));
			Set Melee Enabled(Event Player, False);
			Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
			Small Message(Event Player, Custom String("{0}: 경찰이 범죄를 저지르면 안 되지!", Hero Icon String(Hero(라인하르트))));
			Wait(3, Ignore Condition);
			Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
			Small Message(Event Player, Custom String("{0}: 당장 짐싸서 나가!", Hero Icon String(Hero(라인하르트))));
			Wait(3, Ignore Condition);
			Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
			Big Message(Event Player, Custom String("경찰 {0}님이 범죄를 저질러 불명예 퇴직 당했습니다", Event Player));
			Wait(2, Ignore Condition);
			Set Ability 1 Enabled(Event Player, False);
			Event Player.H[0] = Custom String("불명예 경찰");
			Start Forcing Player To Be Hero(Event Player, Hero(애쉬));
			Event Player.ms[0] = Custom String("악명");
			Event Player.R[7] = True;
			Event Player.ms[1] = 10;
			Event Player.C[11] = 0;
			If(Global.F[2] == Event Player);
				Destroy HUD Text(Event Player.text[2]);
				Event Player.timer[2] = 0;
				Global.F[2] = Custom String("");
			End;
			Event Player.UI[1] = Custom String("\r\n");
		End;
	}
}

rule("sub_lotto")
{
	event
	{
		Subroutine;
		lotto;
	}

	action
	{
		If(Global.O[0] == True);
			Small Message(Event Player, Custom String("극단적 긴축 정책으로 인해 로또를 구매할 수 없습니다"));
			Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 200);
			Abort;
		Else If(Event Player.A < Global.P[8]);
			Call Subroutine(empty_money);
			Abort;
		End;
		Event Player.lotto1[1] = Random Integer(1, 10000);
		Event Player.A -= Global.P[8];
		Global.Tax += Global.P[8];
		Event Player.lotto1[2] = 0;
		If(Event Player.lotto1[1] == 1);
			Wait(4, Ignore Condition);
			Small Message(Event Player, Custom String("번호 {0}, 1등 당첨 축하드립니다!", Event Player.lotto1[1]));
			Play Effect(Event Player, Buff Explosion Sound, Color(흰색), Event Player, 300);
			Event Player.lotto1[2] = 20000;
			Big Message(All Players(All Teams), Custom String("누군가 로또 [1등]에 당첨되었습니다!"));
		Else If(Event Player.lotto1[1] <= 10);
			Wait(3, Ignore Condition);
			Small Message(Event Player, Custom String("번호 {0}, 2등 당첨 축하드립니다!", Event Player.lotto1[1]));
			Play Effect(Event Player, Buff Explosion Sound, Color(흰색), Event Player, 300);
			Event Player.lotto1[2] = 1000;
			Big Message(All Players(All Teams), Custom String("누군가 로또 [2등]에 당첨되었습니다!"));
		Else If(Event Player.lotto1[1] <= 100);
			Wait(2, Ignore Condition);
			Small Message(Event Player, Custom String("번호 {0}, 3등 당첨 축하드립니다!", Event Player.lotto1[1]));
			Play Effect(Event Player, Buff Explosion Sound, Color(흰색), Event Player, 300);
			Event Player.lotto1[2] = 100;
		Else;
			Wait(1.500, Ignore Condition);
			Small Message(Event Player, Custom String("번호 {0}, 낙첨입니다", Event Player.lotto1[1]));
			Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 100);
			Abort;
		End;
		If(Global.Tax < Event Player.lotto1[2] * (1 - 0.330));
			Small Message(Event Player, Custom String("헬조선의 재정이 부족해 로또 당첨금을 지급받을 수 없습니다"));
			Wait(3, Ignore Condition);
			Small Message(Event Player, Custom String("유감을 표합니다.. 재정 관리를 못한 대통령이 문제네요.."));
			Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 200);
			Abort;
		Else;
			Wait(3, Ignore Condition);
			Event Player.B += Round To Integer(Event Player.lotto1[2] * (1 - 0.330), Up);
			Global.Tax -= Round To Integer(Event Player.lotto1[2] * (1 - 0.330), Up);
			Small Message(Event Player, Custom String("세금 33% 공제 후 {0}만 원 입금", Round To Integer(Event Player.lotto1[2] * (1 - 0.330), Up)));
			Play Effect(Event Player, Buff Explosion Sound, Color(흰색), Event Player, 300);
		End;
	}
}

