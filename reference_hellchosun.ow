		Else If(Distance Between(Event Player, Global.jp[64]) <= 1);
			If(Event Player.C[1] < 10);
				Call Subroutine(empty_power);
				Abort;
			Else If(Event Player.A < Global.P[5]);
				Call Subroutine(empty_money);
				Abort;
			End;
			Event Player.C[5] += Random Integer(0, 2);
			Event Player.C[6] += 1;
			Event Player.A -= Global.P[5];
