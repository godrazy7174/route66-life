rule("건물매각")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Secondary Fire)) == True;
		Is Button Held(Event Player, Button(Ability 1)) == True;
		Hero(레킹볼) != Hero Of(Event Player);
		Is Alive(Event Player) == True;
	}

	action
	{
		Event Player.NearPos = First Of(Sorted Array(Global.Position[1], Distance Between(Position Of(Event Player),
			Current Array Element)));
		Abort If(Distance Between(Position Of(Event Player), Event Player.NearPos) > 1);
		Event Player.PositionIndex = Index Of Array Value(Global.Position[1], Event Player.NearPos);
		Event Player.R[3] = Event Player.PositionIndex + 3;
		Abort If(Global.C[11] != 0);
		Abort If(Global.F[Event Player.R[3]] != Event Player);
		Event Player.F[Event Player.R[3]] = 0;
		Event Player.H[0] = Custom String("국민");
		Event Player.A += Round To Integer(Global.S[Event Player.R[3]] * (1 - Global.T), Up);
		Global.Tax += Round To Integer(Global.S[Event Player.R[3]] * Global.T, Up);
		Global.F[Event Player.R[3]] = Custom String("");
		If(Event Player.R[3] == 3);
			Global.A[13] = Random Integer(6, 12);
			Global.P[1] = 2;
			Global.P[2] = 10;
		Else If(Event Player.R[3] == 4);
			Global.A[14] = Random Integer(6, 15);
			Global.P[10] = 10;
		Else If(Event Player.R[3] == 5);
			Global.A[15] = Random Integer(8, 18);
			Global.P[3] = 7;
			Global.P[4] = 20;
		Else If(Event Player.R[3] == 6);
			Global.A[16] = Random Integer(9, 18);
			Global.P[9] = 10;
		Else If(Event Player.R[3] == 7);
			Global.A[17] = Random Integer(20, 35);
			Global.P[5] = 12;
		Else If(Event Player.R[3] == 8);
			Global.A[18] = Random Integer(7, 16);
			Global.P[7] = 15;
		Else If(Event Player.R[3] == 9);
			Global.A[19] = Random Integer(6, 12);
			Global.P[11] = 2;
		End;
		Small Message(Event Player, Custom String("{1}를 매각했다 | 세금 공제 후 {0}만 원 지급", Round To Integer(Global.S[Event Player.R[3]] * (
			1 - Global.T), Up), Global.Position[2][Event Player.PositionIndex]));
	}
}

rule("소매치기")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.ms[0] == Custom String("악명");
		Event Player.ms[1] >= 100;
		Is Button Held(Event Player, Button(Interact)) == True;
		Hero(레킹볼) != Hero Of(Event Player);
		Distance Between(Event Player, Global.jp[92]) <= 1;
	}

	action
	{
		If(Event Player.D[7] == 0);
			Event Player.D[7] = 1;
			Set Melee Enabled(Event Player, True);
			Small Message(Event Player, Custom String("소매치기 장비를 획득했다"));
			Wait(2, Ignore Condition);
			Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
			Small Message(Event Player, Custom String("소매치기는 근접 공격으로 국민의 돈을 털 수 있으며"));
			Wait(4, Ignore Condition);
			Small Message(Event Player, Custom String("경찰의 돈은 뺏을 수 없지만 영장을 훔쳐 무력화 시킬 수 있다"));
			Event Player.H[0] = Custom String("소매치기범");
			Event Player.timer[3] = Hero Of(Event Player) != Hero(해저드) ? 5 : 10;
			Create HUD Text(Event Player, Null, Custom String("소매치기 장비: {0}분 남음", Event Player.timer[3]), Null, Left, 5, Color(흰색), Color(흰색),
				Color(흰색), Visible To and String, Visible Never);
			Event Player.text[3] = Last Text ID;
			While(Event Player.timer[3] > 0);
				Wait(60, Ignore Condition);
				Event Player.timer[3] -= 1;
			End;
			If(Event Player.timer[3] <= 0);
				Event Player.D[7] = 0;
				Set Melee Enabled(Event Player, False);
				Small Message(Event Player, Custom String("소매치기 장비가 파괴되었다"));
				Destroy HUD Text(Event Player.text[3]);
				Event Player.timer[3] = 0;
			End;
		End;
	}
}

rule("play_player_14")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.hasVoted == 2;
		Global.President[4] > 0;
		Is Button Held(Event Player, Button(Primary Fire)) == True;
		Hero(레킹볼) != Hero Of(Event Player);
		Distance Between(Event Player, Global.jp[5]) <= 10;
	}

	action
	{
		If(Global.O[0] == True);
			Global.President[1] += 10;
		Else;
			Global.President[1] += 7;
		End;
		Event Player.hasVoted = 1;
		Small Message(Event Player, Custom String("찬성 투표 완료"));
		If(Event Player.ms[0] == Custom String("명성"));
			Small Message(Event Player, Custom String("헬조선의 국민으로서 소중한 한 표를 행사했습니다 [명성 +4]"));
			Event Player.ms[1] += 4;
		Else If(Event Player.ms[0] == Custom String("악명"));
			Small Message(Event Player, Custom String("헬조선의 국민으로서 소중한 한 표를 행사했습니다 [악명 -4]"));
			Event Player.ms[1] -= 4;
			If(Event Player.ms[1] <= 0);
				Event Player.ms[1] = 0 - Event Player.ms[1];
				Event Player.ms[0] = Custom String("명성");
			End;
		End;
	}
}

rule("play_player_15")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.hasVoted == 2;
		Global.President[4] > 0;
		Is Button Held(Event Player, Button(Secondary Fire)) == True;
		Hero(레킹볼) != Hero Of(Event Player);
		Distance Between(Event Player, Global.jp[5]) <= 10;
	}

	action
	{
		If(Global.O[0] == True);
			Global.President[1] -= 10;
		Else;
			Global.President[1] -= 7;
		End;
		Event Player.hasVoted = 1;
		Small Message(Event Player, Custom String("반대 투표 완료"));
		If(Event Player.ms[0] == Custom String("명성"));
			Small Message(Event Player, Custom String("헬조선의 국민으로서 소중한 한 표를 행사했습니다 [명성 +4]"));
			Event Player.ms[1] += 4;
		Else If(Event Player.ms[0] == Custom String("악명"));
			Small Message(Event Player, Custom String("헬조선의 국민으로서 소중한 한 표를 행사했습니다 [악명 -4]"));
			Event Player.ms[1] -= 4;
			If(Event Player.ms[1] <= 0);
				Event Player.ms[1] = 0 - Event Player.ms[1];
				Event Player.ms[0] = Custom String("명성");
			End;
		End;
	}
}

rule("상호작용FSy")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Interact)) == True;
		Hero(레킹볼) != Hero Of(Event Player);
		Is Alive(Event Player) == True;
	}

	action
	{
		If(Distance Between(Event Player, Global.jp[1]) <= 1);
			Call Subroutine(president);
		End;
	}
}

rule("상호작용FSy")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Interact)) == True;
		Hero(레킹볼) != Hero Of(Event Player);
		Is Alive(Event Player) == True;
	}

	action
	{
		If(Distance Between(Event Player, Global.jp[10]) <= 3.500 && Event Player.C[11] == 1);
			If(Event Player.P[3] == 0);
				If(Event Player.P[4] != Custom String("순경"));
					Set Status(Event Player, Null, Rooted, 4);
					Small Message(Event Player, Custom String("구속영장 발부받는 중..."));
					Wait(4, Ignore Condition);
					Small Message(Event Player, Custom String("구속영장을 발부받았다"));
					Set Melee Enabled(Event Player, True);
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
					Event Player.P[3] = 1;
					Wait(3, Ignore Condition);
					Small Message(Event Player, Custom String("근접공격으로 악명을 가진 범죄자들을 체포할 수 있습니다"));
					Wait(3, Ignore Condition);
					Small Message(Event Player, Custom String("범죄자를 잡으면 인센티브로 돈과 명성을 받을 수 있습니다"));
					Wait(3, Ignore Condition);
					Small Message(Event Player, Custom String("잡은 범죄자의 악명당 이달의 실적치도 오릅니다"));
				Else If(Event Player.P[4] == Custom String("순경"));
					Small Message(Event Player, Custom String("순경 계급은 영장을 발부할 수 없습니다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 100);
				End;
			Else If(Event Player.P[3] == 1);
				Small Message(Event Player, Custom String("이미 구속영장을 소지하고 있습니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 100);
			End;
		End;
		If(Distance Between(Event Player, Global.jp[11]) <= 3.500);
			If(Event Player.C[11] == 1);
				If(Event Player.C[1] >= 50);
					Set Status(Event Player, Null, Rooted, 5);
					Small Message(Event Player, Custom String("경찰 업무 중.. [기력 -50, 배고픔 +10%]"));
					Event Player.C[1] -= 50;
					Event Player.AA += 10;
					Event Player.R[3] = Random Integer(1, 20);
					Event Player.P[6] += Event Player.R[3];
					Event Player.P[9] += Event Player.R[3];
					Wait(5, Ignore Condition);
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
					Small Message(Event Player, Custom String("일을 마치고 퇴근했다"));
					Call Subroutine(policescore);
				Else If(Event Player.C[1] < 50);
					Call Subroutine(empty_power);
					Abort;
				End;
			Else If(Event Player.C[11] != 1);
				Small Message(Event Player, Custom String("경찰만 가능합니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Wait(1, Ignore Condition);
			End;
		End;
		If(Distance Between(Event Player, Global.jp[12]) <= 1);
			If(Event Player.C[11] == 1);
				Set Melee Enabled(Event Player, False);
				Set Ability 1 Enabled(Event Player, False);
				Event Player.C[11] = 0;
				Event Player.P[3] = 0;
				Event Player.P[6] = 0;
				Event Player.P[9] = 0;
				Event Player.P[8] = 0;
				Small Message(Event Player, Custom String("경찰을 그만두었다"));
				Wait(2, Ignore Condition);
				If(Global.F[2] == Event Player);
					Destroy HUD Text(Event Player.text[2]);
					Event Player.timer[2] = 0;
					Global.F[2] = Custom String("");
					Wait(0.050, Ignore Condition);
					Small Message(Event Player, Custom String("경찰청장에서 퇴직했다"));
					Wait(1, Ignore Condition);
					Small Message(Event Player, Custom String("임기를 채우지 않아 정년퇴직금은 받지 못했다"));
				End;
				Event Player.H[0] = Custom String("퇴직 경찰");
				If(Event Player.P[7] > 1);
					Event Player.B += Round To Integer(Event Player.P[7] * 100 * (1 - Global.T), Up);
					Global.Tax -= Round To Integer(Event Player.P[7] * 100 * (1 - Global.T), Up);
					Small Message(Event Player, Custom String("퇴직금으로 {0}만 원을 받았다", Event Player.P[7] * 100));
				End;
				Event Player.UI[1] = Custom String("\r\n");
				Start Forcing Player To Be Hero(Event Player, Event Player.E[0]);
			End;
		End;
		If(Distance Between(Event Player, Global.jp[13]) <= 2);
			If(Event Player.C[1] < 50);
				Call Subroutine(empty_power);
				Abort;
			Else If(Event Player.AA <= 90);
				Event Player.AA += 10;
				Event Player.C[1] -= 50;
				Set Status(Event Player, Null, Rooted, 2);
				Wait(2, Ignore Condition);
				Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
				If(Event Player.ms[0] == Custom String("명성"));
					Event Player.ms[1] += 2;
					Small Message(Event Player, Custom String("자원봉사를 하니 보람을 느낀다 [명성 +2, 배고픔 +10%, 기력 -50%]"));
				Else If(Event Player.ms[0] == Custom String("악명"));
					Event Player.ms[1] -= 2;
					If(Event Player.ms[1] <= 0);
						Event Player.ms[1] = 0 - Event Player.ms[1];
						Event Player.ms[0] = Custom String("명성");
					End;
					Small Message(Event Player, Custom String("자원봉사를 하니 보람을 느낀다 [악명 -2, 배고픔 +10%, 기력 -50%]"));
				End;
			End;
		End;
		If(Distance Between(Event Player, Global.jp[14]) <= 2);
			If(Event Player.A < 25);
				Call Subroutine(empty_money);
				Abort;
			End;
			Event Player.A -= 25;
			Global.Tax += 25;
			Event Player.taxAmount -= 5;
			If(Event Player.ms[0] == Custom String("명성"));
				Event Player.ms[1] += 1;
			Else If(Event Player.ms[0] == Custom String("악명"));
				If(Event Player.ms[1] == 1);
					Event Player.ms[1] = 0;
					Event Player.ms[0] = Custom String("명성");
				Else If(Event Player.ms[1] >= 2);
					Event Player.ms[1] -= 1;
				End;
			End;
			Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
		End;
		If(Distance Between(Event Player, Global.jp[15]) <= 2);
			If(Event Player.C[1] < Event Player.C[10]);
				Small Message(Event Player, Custom String("길바닥에서 잠을 청했다..."));
				Set Status(Event Player, Null, Asleep, 9999);
				While(Distance Between(Event Player, Global.jp[15]) <= 4 && Event Player.C[1] < Event Player.C[10]);
					Event Player.C[1] = Min(Event Player.C[10], Event Player.C[1] + 8);
					Event Player.AA += 2;
					Small Message(Event Player, Custom String("노숙을 그만두려면 {0} 버튼을 꾹 눌러주세요", Input Binding String(Button(Ability 2))));
					If(Is Button Held(Event Player, Button(Ability 2)) == True);
						Break;
					End;
					Wait(4, Ignore Condition);
				End;
				Clear Status(Event Player, Asleep);
				Small Message(Event Player, Custom String("길바닥에서 잠을 자고나니 배가 고프다..."));
				Set Move Speed(Event Player, 80);
				Set Aim Speed(Event Player, 80);
				Event Player.timer[4] = 10;
			Else;
				Small Message(Event Player, Custom String("현재 기력이 충분합니다 [노숙 불가능]"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 200);
			End;
		End;
		If(Event Player.R[15] == True);
			If(Event Player.moneyjp != 0);
				If(Event Player.B >= Event Player.moneyjp);
					Event Player.B -= Event Player.moneyjp;
					Event Player.players[Event Player.targetIndex].B += Event Player.moneyjp;
					Small Message(Event Player, Custom String("{0}{2}님에게 {1}만 원을 송금하였습니다!", Hero Icon String(Hero Of(
						Event Player.players[Event Player.targetIndex])), Event Player.moneyjp, Event Player.players[Event Player.targetIndex]));
					Small Message(Event Player.players[Event Player.targetIndex], Custom String("{0}{2}님으로부터 {1}만 원을 송금 받았습니다!", Hero Icon String(
						Hero Of(Event Player)), Event Player.moneyjp, Event Player));
					Wait(0.500, Abort When False);
				End;
			End;
		End;
		If(Is Button Held(Event Player, Button(Interact)) && Event Player.R[13] == True);
			Event Player.R[13] = False;
			Event Player.name[0] = Custom String("-------------------\r\n잡코리아\r\n-------------------\r\n에그 하우스: {0}만 원 / 옷가게: {1}만 원\r\n{2}",
				Global.A[13], Global.A[14], Custom String("술집: {0}만 원 / 도서관: {1}만 원\r\n{2}", Global.A[15], Global.A[16], Custom String(
				"헬스 트레이너: {0}만 원 / 호텔: {1}만 원\r\n제설 작업: {2}", Global.A[17], Global.A[18], Custom String(
				"{0}만 원 / 카페: {1}만 원\r\n-------------------\r\n[점프] 닫기\r\n", Global.A[20], Global.A[19]))));
		End;
		If(Distance Between(Event Player, Global.jp[57]) <= 3);
			For Player Variable(Event Player, level, 0, Count Of(Global.C[1]), 1);
				If(Event Player.ms[3] >= Global.C[1][Event Player.level]);
					Event Player.ms[4] = Global.O[0] == True ? Event Player.ms[3] * Global.C[2][Event Player.level] / 2 : Event Player.ms[3] * Global.C[2][Event Player.level];
					Break;
				End;
			End;
			Event Player.name[0] = Custom String(
				"-------------------\r\n신용 점수: {0}\r\n대출 한도: {1}만 원\r\n-------------------\r\n[E] 대출 받기\r\n-------------------\r\n[점프] 닫기\r\n",
				Event Player.ms[3], Event Player.ms[4]);
			Event Player.name[2] = 1;
		End;
	}
}

rule("상호작용WASD")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		(Throttle Of(Event Player) == True) == True;
		Hero Of(Event Player) != Hero(레킹볼);
		Event Player.R[11] == True;
	}

	action
	{
		If(Distance Between(Event Player, Global.jp[8]) <= 1.500);
			If(Event Player.R[12] == False);
				If(Z Component Of(Throttle Of(Event Player)) == 1);
					Event Player.name[1] = (Event Player.name[1] - 1 + Count Of(Global.Position[9])) % Count Of(Global.Position[9]);
				Else If(Z Component Of(Throttle Of(Event Player)) == -1);
					Event Player.name[1] = (Event Player.name[1] + 1) % Count Of(Global.Position[9]);
				End;
				For Player Variable(Event Player, level, 0, Count Of(Global.Position[9]), 1);
					Event Player.name[3 + Event Player.level] = Event Player.level == Event Player.name[1] ? Custom String("• {0} ◀\r\n",
						Global.Position[9][Event Player.level]) : Custom String("• {0}\r\n", Global.Position[9][Event Player.level]);
				End;
				Event Player.name[0] = Custom String("------------------\r\n헬조선 관리하기\r\n------------------\r\n{0}{1}{2}", Event Player.name[3],
					Event Player.name[4], Custom String("{0}{1}{2}", Event Player.name[5], Event Player.name[6], Custom String(
					"{0}{1}{2}------------------\r\n[W] ↑\r\n[S] ↓\r\n[좌클] 확인\r\n[점프] 닫기", Event Player.name[7], Event Player.name[8],
					Event Player.name[9])));
			Else If(Event Player.R[12] == True);
				If(Event Player.name[1] <= 1);
					If(Z Component Of(Throttle Of(Event Player)) == 1);
						Event Player.name[2] = (Event Player.name[2] - 1 + Count Of(Global.Position[10])) % Count Of(Global.Position[10]);
					Else If(Z Component Of(Throttle Of(Event Player)) == -1);
						Event Player.name[2] = (Event Player.name[2] + 1) % Count Of(Global.Position[10]);
					End;
					For Player Variable(Event Player, level, 0, Count Of(Global.Position[10]), 1);
						Event Player.name[3 + Event Player.level] = Event Player.level == Event Player.name[2] ? Custom String("• {0} ◀\r\n",
							Global.Position[10][Event Player.level]) : Custom String("• {0}\r\n", Global.Position[10][Event Player.level]);
					End;
					Event Player.name[0] = Event Player.name[1] == 0 ? Custom String(
						"------------------\r\n세율 [최대 30%]\r\n------------------\r\n{0}{1}{2}", Event Player.name[3], Event Player.name[4],
						Custom String("------------------\r\n[W] ↑\r\n[S] ↓\r\n[좌클] 확인\r\n[점프] 닫기")) : Custom String(
						"------------------\r\n최저 임금\r\n------------------\r\n{0}{1}{2}", Event Player.name[3], Event Player.name[4], Custom String(
						"------------------\r\n[W] ↑\r\n[S] ↓\r\n[좌클] 확인\r\n[점프] 닫기"));
				End;
			End;
		Else If(Distance Between(Event Player, Global.jp[24]) <= 1.200 || Distance Between(Event Player, Global.jp[25])
				<= 1.200 || Distance Between(Event Player, Global.jp[26]) <= 1.200);
			If(Event Player.R[12] == False);
				If(Z Component Of(Throttle Of(Event Player)) == 1);
					Event Player.name[1] = (Event Player.name[1] - 1 + Count Of(Global.Position[7])) % Count Of(Global.Position[7]);
				Else If(Z Component Of(Throttle Of(Event Player)) == -1);
					Event Player.name[1] = (Event Player.name[1] + 1) % Count Of(Global.Position[7]);
				End;
				For Player Variable(Event Player, level, 0, Count Of(Global.Position[7]), 1);
					Event Player.name[3 + Event Player.level] = Event Player.level == Event Player.name[1] ? Custom String("• {0} ◀\r\n",
						Global.Position[7][Event Player.level]) : Custom String("• {0}\r\n", Global.Position[7][Event Player.level]);
				End;
				Event Player.name[0] = Custom String("------------------\r\nATM\r\n------------------\r\n{0}{1}{2}", Event Player.name[3],
					Event Player.name[4], Custom String("{0}{1}", Event Player.name[5], Custom String(
					"------------------\r\n[W] ↑\r\n[S] ↓\r\n[좌클] 확인\r\n[점프] 닫기")));
			Else If(Event Player.R[12] == True);
				If(Event Player.name[1] == 0 || Event Player.name[1] == 1);
					If(Z Component Of(Throttle Of(Event Player)) == 1);
						Event Player.name[2] = (Event Player.name[2] - 1 + Count Of(Global.Position[8])) % Count Of(Global.Position[8]);
					Else If(Z Component Of(Throttle Of(Event Player)) == -1);
						Event Player.name[2] = (Event Player.name[2] + 1) % Count Of(Global.Position[8]);
					End;
					For Player Variable(Event Player, level, 0, Count Of(Global.Position[8]), 1);
						Event Player.name[3 + Event Player.level] = Event Player.level == Event Player.name[2] ? Custom String("• {0} ◀\r\n",
							Global.Position[8][Event Player.level]) : Custom String("• {0}\r\n", Global.Position[8][Event Player.level]);
					End;
					Event Player.name[0] = Event Player.name[1] == 0 ? Custom String("------------------\r\n입금\r\n------------------\r\n{0}{1}{2}",
						Event Player.name[3], Event Player.name[4], Custom String("{0}{1}{2}", Event Player.name[5], Event Player.name[6],
						Custom String("{0}------------------\r\n[W] ↑\r\n[S] ↓\r\n[좌클] 확인\r\n[점프] 닫기", Event Player.name[7]))) : Custom String(
						"------------------\r\n출금\r\n------------------\r\n{0}{1}{2}", Event Player.name[3], Event Player.name[4], Custom String(
						"{0}{1}{2}", Event Player.name[5], Event Player.name[6], Custom String(
						"{0}------------------\r\n[W] ↑\r\n[S] ↓\r\n[좌클] 확인\r\n[점프] 닫기", Event Player.name[7])));
				End;
			End;
		Else If(Distance Between(Event Player, Global.jp[16]) <= 2 || Distance Between(Event Player, Global.jp[17])
				<= 2 || Distance Between(Event Player, Global.jp[18]) <= 2 || Distance Between(Event Player, Global.jp[19]) <= 2);
			If(Z Component Of(Throttle Of(Event Player)) == 1);
				Event Player.name[1] = (Event Player.name[1] - 1 + Count Of(Global.Position[3])) % Count Of(Global.Position[3]);
			Else If(Z Component Of(Throttle Of(Event Player)) == -1);
				Event Player.name[1] = (Event Player.name[1] + 1) % Count Of(Global.Position[3]);
			End;
			For Player Variable(Event Player, level, 0, Count Of(Global.Position[3]), 1);
				Event Player.name[5 + Event Player.level] = Event Player.level == Event Player.name[1] ? Custom String("• {0} ◀\r\n",
					Global.Position[3][Event Player.level]) : Custom String("• {0}\r\n", Global.Position[3][Event Player.level]);
			End;
			Event Player.name[0] = Custom String("------------------\r\n버스 [가격: 1만 원]\r\n------------------\r\n{0}{1}{2}",
				Event Player.name[5], Event Player.name[6], Custom String("{0}{1}{2}", Event Player.name[7], Event Player.name[8],
				Custom String("------------------\r\n[W] ↑\r\n[S] ↓\r\n[V] 하차\r\n[점프] 닫기")));
		Else If(Distance Between(Event Player, Global.jp[20]) <= 1.200 || Distance Between(Event Player, Global.jp[21])
				<= 1.200 || Distance Between(Event Player, Global.jp[22]) <= 1.200 || Distance Between(Event Player, Global.jp[23]) <= 1.200);
			If(Z Component Of(Throttle Of(Event Player)) == 1);
				Event Player.name[1] = (Event Player.name[1] - 1 + Count Of(Global.Position[4])) % Count Of(Global.Position[4]);
			Else If(Z Component Of(Throttle Of(Event Player)) == -1);
				Event Player.name[1] = (Event Player.name[1] + 1) % Count Of(Global.Position[4]);
			End;
			For Player Variable(Event Player, level, 0, Count Of(Global.Position[4]), 1);
				Event Player.name[2 + Event Player.level] = Event Player.level == Event Player.name[1] ? Custom String("{0} ◀",
					Global.Position[4][Event Player.level]) : Custom String("{0}", Global.Position[4][Event Player.level]);
			End;
			Event Player.name[0] = Custom String("------------------\r\n택시 [가격: 2만 원]\r\n------------------\r\n{0}   {1}  \r\n{2}",
				Event Player.name[2], Event Player.name[3], Custom String("{0}   {1}  \r\n{2}", Event Player.name[4], Event Player.name[5],
				Custom String("{0}     {1}  \r\n{2}", Event Player.name[6], Event Player.name[7], Custom String("{0}     {1}  \r\n{2}",
				Event Player.name[8], Event Player.name[9], Custom String("{0}   {1}  \r\n{2}", Event Player.name[10], Event Player.name[11],
				Custom String("{0}   {1}  \r\n{2}", Event Player.name[12], Event Player.name[13], Custom String(
				"------------------\r\n[W] ↑\r\n[S] ↓\r\n[V] 하차\r\n[점프] 닫기")))))));
		Else If(Distance Between(Event Player, Global.jp[9]) <= 3.500);
			If(Z Component Of(Throttle Of(Event Player)) == 1);
				Event Player.name[1] = (Event Player.name[1] - 1 + Count Of(Global.C[7])) % Count Of(Global.C[7]);
			Else If(Z Component Of(Throttle Of(Event Player)) == -1);
				Event Player.name[1] = (Event Player.name[1] + 1) % Count Of(Global.C[7]);
			End;
			For Player Variable(Event Player, level, 0, Count Of(Global.C[7]), 1);
				Event Player.name[2 + Event Player.level] = Event Player.level == Event Player.name[1] ? Custom String("• {0} ◀\r\n",
					Global.C[7][Event Player.level]) : Custom String("• {0}\r\n", Global.C[7][Event Player.level]);
			End;
			Event Player.name[0] = Custom String("------------------\r\n시험 [응시료: {0}만 원]\r\n------------------\r\n{1}{2}", Global.P[21],
				Event Player.name[2], Custom String("{0}{1}{2}", Event Player.name[3], Event Player.name[4], Custom String("{0}{1}{2}",
				Event Player.name[5], Event Player.name[6], Custom String("{0}{1}{2}", Event Player.name[7], Event Player.name[8],
				Custom String("{0}------------------\r\n[W] ↑\r\n[S] ↓\r\n[좌클릭] 응시\r\n[점프] 닫기", Event Player.name[9])))));
		Else If(Distance Between(Event Player, Global.jp[43]) <= 2);
			If(Z Component Of(Throttle Of(Event Player)) == 1);
				Event Player.name[1] = (Event Player.name[1] - 1 + Count Of(Global.C[7])) % Count Of(Global.C[7]);
			Else If(Z Component Of(Throttle Of(Event Player)) == -1);
				Event Player.name[1] = (Event Player.name[1] + 1) % Count Of(Global.C[7]);
			End;
			For Player Variable(Event Player, level, 0, Count Of(Global.C[7]), 1);
				Event Player.name[3 + Event Player.level] = Event Player.level == Event Player.name[1] ? Custom String("• {0} ◀\r\n",
					Global.C[7][Event Player.level]) : Custom String("• {0}\r\n", Global.C[7][Event Player.level]);
			End;
			Event Player.name[2] = Event Player.name[1] == 0 ? Custom String("[{0}/2~50]회", Event Player.C[41 + Event Player.name[1]]) : (
				Event Player.name[1] == 1 ? Custom String("[{0}/2~50]회", Event Player.C[41 + Event Player.name[1]]) : (
				Event Player.name[1] == 2 ? Custom String("[{0}/14~100]회", Event Player.C[41 + Event Player.name[1]]) : (
				Event Player.name[1] == 3 ? Custom String("[{0}/2~50]회", Event Player.C[41 + Event Player.name[1]]) : (
				Event Player.name[1] == 4 ? Custom String("[{0}/4~60]회", Event Player.C[41 + Event Player.name[1]]) : (
				Event Player.name[1] == 5 ? Custom String("[{0}/6~70]회", Event Player.C[41 + Event Player.name[1]]) : Custom String(
				"[{0}/4~60]회"))))));
			Event Player.name[0] = Custom String("------------------\r\n공부한 횟수 {0}\r\n------------------\r\n{1}{2}", Event Player.name[2],
				Event Player.name[3], Custom String("{0}{1}{2}", Event Player.name[4], Event Player.name[5], Custom String("{0}{1}{2}",
				Event Player.name[6], Event Player.name[7], Custom String(
				"{0}{1}{2}------------------\r\n[W] ↑\r\n[S] ↓\r\n[좌클릭] 공부\r\n[점프] 닫기", Event Player.name[8], Event Player.name[9],
				Event Player.name[10]))));
		Else If(Distance Between(Event Player, Global.jp[107]) <= 2);
			If(Z Component Of(Throttle Of(Event Player)) == 1);
				Event Player.name[1] = (Event Player.name[1] - 1 + Count Of(Global.C[8])) % Count Of(Global.C[8]);
			Else If(Z Component Of(Throttle Of(Event Player)) == -1);
				Event Player.name[1] = (Event Player.name[1] + 1) % Count Of(Global.C[8]);
			End;
			For Player Variable(Event Player, level, 0, Count Of(Global.C[8]), 1);
				Event Player.name[3 + Event Player.level] = Event Player.level == Event Player.name[1] ? Custom String("{0} ◀\r\n",
					Global.C[8][Event Player.level]) : Custom String("{0}\r\n", Global.C[8][Event Player.level]);
			End;
			Event Player.name[2] = Event Player.name[1] == 0 ? 1 : (Event Player.name[1] == 1 ? 10 : (Event Player.name[1] == 2 ? 100 : (
				Event Player.name[1] == 3 ? 1000 : 0)));
			Event Player.name[0] = Custom String("------------------\r\n주사위 도박\r\n------------------\r\n{0}{1}{2}", Event Player.name[3],
				Event Player.name[4], Custom String("{0}{1}{2}", Event Player.name[5], Event Player.name[6], Custom String(
				"------------------\r\n[W] ↑\r\n[S] ↓\r\n[좌클릭] 확인\r\n[점프] 닫기")));
		End;
	}
}

rule("상호작용FSh")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Interact)) == True;
		Hero(레킹볼) != Hero Of(Event Player);
		Is Alive(Event Player) == True;
	}

	action
	{
		If(Distance Between(Event Player, Global.jp[30]) <= 1);
			If(Event Player.F[3] == 1);
				If(Event Player.name[1] == 0);
					Wait(0.250, Ignore Condition);
					Event Player.name[1] = 1;
					Event Player.name[0] = Custom String("------------------\r\n매매가\r\n------------------\r\n{0}", Custom String(
						"입금: [E]\r\n출금: [V]\r\n빠르게: [+Ctrl]\r\n\r\n[F] 다음\r\n[점프] 닫기"));
					Wait(0.250, Abort When False);
				End;
				If(Event Player.name[1] == 1);
					Wait(0.250, Ignore Condition);
					Event Player.name[1] = 2;
					Event Player.name[0] = Custom String("------------------\r\n알바 급여\r\n------------------\r\n{0}", Custom String(
						"올리기: [E]\r\n내리기: [V]\r\n\r\n[F] 다음\r\n[점프] 닫기"));
					Wait(0.250, Abort When False);
				End;
				If(Event Player.name[1] == 2);
					Wait(0.250, Ignore Condition);
					Event Player.name[1] = 3;
					Event Player.name[0] = Custom String("------------------\r\n계란빵 가격\r\n------------------\r\n{0}", Custom String(
						"올리기: [E]\r\n내리기: [V]\r\n\r\n[F] 다음\r\n[점프] 닫기"));
					Wait(0.250, Abort When False);
				End;
				If(Event Player.name[1] == 3);
					Wait(0.250, Ignore Condition);
					Event Player.name[1] = 4;
					Event Player.name[0] = Custom String("------------------\r\n간장계란밥 가격\r\n------------------\r\n{0}", Custom String(
