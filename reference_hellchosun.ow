rule("system_global_1")
{
	event
	{
		Ongoing - Global;
	}

	action
	{
		Disable Inspector Recording;
		Disable Built-In Game Mode Announcer;
		Disable Built-In Game Mode Completion;
		Disable Built-In Game Mode Music;
		Disable Built-In Game Mode Scoring;
		Call Subroutine(disablebutton);
		Wait Until(Is Game In Progress, 99);
		Create HUD Text(Local Player, Null, Custom String("헬조선에서 살아남기 #2.11.2 | FZ1MP"), Custom String("{0}{1}",
			Global.timer[2] >= 1 ? Custom String("{0}시간 ", Global.timer[2]) : Custom String("  "), Global.timer[1] >= 1 ? Custom String(
			"{0}분", Global.timer[1]) : Custom String("  ")), Right, 1, Color(흰색), Global.timer[2] >= 4 ? Color(Red) : (
			Global.timer[2] >= 3 ? Color(Yellow) : Color(흰색)), Color(흰색), Visible To String and Color, Visible Always);
		Create HUD Text(Local Player, Custom String(" \n  보유현금: {0}  \r\n  은행예금: {1}  \r\n \r", Round To Integer(Local Player.A, Down)
			>= 10000 ? Custom String("{0}억 {1}만 원", Round To Integer(Local Player.A / 10000, Down), Round To Integer(
			Local Player.A % 10000, Down)) : Custom String("{0}만 원", Round To Integer(Local Player.A, Down)), Round To Integer(
			Local Player.B, Down) >= 10000 ? Custom String("{0}억 {1}만 원", Round To Integer(Local Player.B / 10000, Down), Round To Integer(
			Local Player.B % 10000, Down)) : Custom String("{0}만 원", Round To Integer(Local Player.B, Down))), Null, Null, Right, 1, Color(
			흰색), Color(흰색), Color(흰색), Visible To and String, Default Visibility);
		Create HUD Text(Local Player, Null, Custom String("{0}", Local Player.UI[1]), Null, Right, 2, Color(흰색), Color(흰색), Color(Yellow),
			Visible To and String, Default Visibility);
		Create HUD Text(Local Player, Null, Null, Custom String(
			"\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n[인벤토리 최대 {0}개]\r\n\r\n[{1}{2}", Local Player.S[1],
			Input Binding String(Button(Ability 2)), Custom String("+{0}] 계란빵 {1}개\r\n{2}", Input Binding String(Button(Ultimate)),
			Local Player.S[2], Custom String("[{0}+{1}] 간장계란밥 {2}", Input Binding String(Button(Melee)), Input Binding String(Button(
			Ultimate)), Custom String("{0}개\r\n{1}", Local Player.S[4], Custom String("[{0}] 샌드위치 {1}개\r\n{2}", Input Binding String(
			Button(Reload)), Local Player.S[3], Custom String("[{0}] 스마트폰\r\n[{1}] 달리기", Input Binding String(Button(Ultimate)),
			Input Binding String(Button(Ability 1)))))))), Right, 3, Color(흰색), Color(흰색), Color(흰색), Visible To and String,
			Default Visibility);
		Create HUD Text(Local Player, Null, Null, Custom String("기력 {0}% ㅣ 배고픔 {1}% ㅣ {2}", Round To Integer(Local Player.C[1], Up),
			Round To Integer(Local Player.AA, Up), Custom String("{0} {1}", Local Player.ms[0], Local Player.ms[1])), Left, 1, Color(흰색),
			Color(흰색), Color(Green), Visible To and String, Default Visibility);
		Create HUD Text(Local Player, Null, Null, Custom String("\n\r\n\r\n\r\n\r\n"), Top, 15, Color(흰색), Color(흰색), Color(흰색),
			Visible To and String, Default Visibility);
		Create HUD Text(Local Player, Custom String("{0}", Local Player.name[0]), Null, Null, Top, 16, Color(흰색), Color(흰색), Color(흰색),
			Visible To and String, Default Visibility);
		Global.Tax = 50000;
		For Global Variable(I, 1, 12, 1);
			Global.F[Global.I] = Custom String("");
		End;
		Global.O[0] = False;
		Global.O[1] = False;
		Global.Stock[1] = Random Integer(1, 75);
		Global.Stock[2] = Random Integer(1, 15);
		Global.Stock[3] = Random Integer(1, 30);
		Global.Stock[4] = Random Integer(1, 6);
		Global.Stock[6] = Random Integer(0, 5);
		Global.Stock[7] = Random Integer(1, 50);
		Global.Stock[8] = 3;
		Global.Stock[9] = 5;
		Global.Stock[10] = Random Integer(1, 15);
		Global.S[3] = 6000;
		Global.S[4] = 5000;
		Global.S[5] = 6000;
		Global.S[6] = 6000;
		Global.S[7] = 8000;
		Global.S[8] = 6000;
		Global.S[9] = 7000;
		Global.S[10] = 1000;
		Global.jp[98] = Vector(93.210, 11, -34.940);
		Global.jp[103] = Vector(55.080, 8, -1.070);
		Global.P[1] = 2;
		Global.P[2] = 10;
		Global.P[3] = 3;
		Global.P[4] = 20;
		Global.P[5] = 12;
