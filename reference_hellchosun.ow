							Start Forcing Player To Be Hero(Event Player, Hero(캐서디));
							Set Ability 1 Enabled(Event Player, True);
							Wait(1, Ignore Condition);
							Event Player.C[11] = 1;
							Event Player.P[4] = Custom String("순경");
							Event Player.P[5] = Global.A[2];
							Event Player.P[6] = 0;
							Event Player.P[7] = 1;
							Event Player.P[9] = 0;
							Event Player.C[43] = 0;
							Event Player.ms[3] += 100;
							Event Player.P[8] = Round To Integer(Global.A[2], To Nearest);
