					Wait(0.250, Ignore Condition);
					Event Player.name[1] = 1;
					Event Player.name[0] = Custom String("------------------\r\n매매가\r\n------------------\r\n{0}", Custom String(
						"입금: [E]\r\n출금: [V]\r\n빠르게: [+Ctrl]\r\n\r\n[F] 다음\r\n[점프] 닫기"));
					Wait(0.250, Abort When False);
				End;
				If(Event Player.name[1] == 1);
					Wait(0.250, Ignore Condition);
					Event Player.name[1] = 2;
					Event Player.name[0] = Custom String("------------------\r\n알바 급여\r\n------------------\r\n{0}", Custom String(
						"올리기: [E]\r\n내리기: [V]\r\n\r\n[F] 다음\r\n[점프] 닫기"));
					Wait(0.250, Abort When False);
				End;
				If(Event Player.name[1] == 2);
					Wait(0.250, Ignore Condition);
					Event Player.name[1] = 3;
					Event Player.name[0] = Custom String("------------------\r\n아메리카노 가격\r\n------------------\r\n{0}", Custom String(
						"올리기: [E]\r\n내리기: [V]\r\n\r\n[F] 다음\r\n[점프] 닫기"));
					Wait(0.250, Abort When False);
				End;
				If(Event Player.name[1] == 3);
					Wait(0.250, Ignore Condition);
					Event Player.name[1] = 4;
					Event Player.name[0] = Custom String("------------------\r\n샌드위치 가격\r\n------------------\r\n{0}", Custom String(
						"올리기: [E]\r\n내리기: [V]\r\n\r\n[F] 다음\r\n[점프] 닫기"));
					Wait(0.250, Abort When False);
				End;
				If(Event Player.name[1] == 4);
					Wait(0.250, Ignore Condition);
					Event Player.name[0] = Custom String("");
					Event Player.name[1] = 0;
					Wait(0.250, Abort When False);
				End;
			End;
		Else If(Distance Between(Event Player, Global.jp[27]) <= 1);
			If(Event Player.F[10] == 1);
				Set Move Speed(Event Player, 0);
				Set Invisible(Event Player, All);
				Start Camera(Event Player, Vector(23.250, 20, -46.850), Vector(30.110, 3, -54.210), 5);
				Wait(0.020, Ignore Condition);
				Event Player.R[4] = True;
				Teleport(Event Player, Vector(32.120, 3.900, -58));
				Event Player.name[0] = Event Player.name[1] == 0 ? Custom String(
					"------------------\r\n잠자기: [E]\r\n매매가 입금: [V]\r\n------------------{0}", Custom String("\r\n\r\n\r\n[점프] 닫기"))
					: Custom String("");
				Event Player.name[1] = Event Player.name[1] == 1 ? 0 : Event Player.name[1] + 1;
			Else;
				Small Message(Event Player, Custom String("조선 더 힐 입주민만 입장 가능합니다"));
			End;
		End;
	}
}

rule("상호작용Fi")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Interact)) == True;
		Hero(레킹볼) != Hero Of(Event Player);
		Is Alive(Event Player) == True;
	}

	action
	{
		If(Distance Between(Event Player, Global.jp[31]) <= 1.500);
			Call Subroutine(EggHouseparttime);
		Else If(Distance Between(Event Player, Global.jp[32]) <= 3);
			If(Event Player.S[1] <= Event Player.S[2] + Event Player.S[3] + Event Player.S[4]);
				Small Message(Event Player, Custom String("인벤토리가 가득 찼습니다. 가방을 업그레이드 하세요"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Abort;
			Else If(Event Player.A < Global.P[2]);
				Call Subroutine(empty_money);
				Abort;
			Else If(Global.Stock[2] < 1);
				Small Message(Event Player, Custom String("재고가 부족합니다. 에그 하우스 알바를 통해 재고를 채울 수 있습니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Abort;
			End;
			Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 50);
			Event Player.S[4] += 1;
			Global.Stock[2] -= 1;
			Global.F[3].B += Global.P[2] * 10 / 11;
			Global.F[3].taxAmount += Global.P[2] * 10 / 11 * Global.T;
			Event Player.A -= Global.P[2];
			Global.Tax += Global.P[2] / 11;
			Wait(0.050, Ignore Condition);
		Else If(Distance Between(Event Player, Global.jp[34]) <= 1.500);
			If(Event Player.C[1] >= 30 && Event Player.C[11] != 3 && Event Player.C[11] != 1);
				Event Player.Jobm[1] = Random Integer(1, 3);
				Set Status(Event Player, Null, Rooted, 5);
				Teleport(Event Player, Vector(21.390, 4, -21.980));
				Event Player.C[1] -= 30;
				Event Player.AA += 6;
				Wait(0.250, Ignore Condition);
				If(Event Player.Jobm[1] == 1);
					Small Message(Event Player, Custom String("옷을 정리하는 중... [기력 -30, 배고픔 +6%]"));
				Else If(Event Player.Jobm[1] == 2);
					Small Message(Event Player, Custom String("손님을 응대하는 중... [기력 -30, 배고픔 +6%]"));
				Else If(Event Player.Jobm[1] == 3);
					Small Message(Event Player, Custom String("상품을 진열하는 중... [기력 -30, 배고픔 +6%]"));
				End;
				Wait(5, Ignore Condition);
				Global.Stock[9] += 1;
				Event Player.A += Global.A[14];
				Event Player.taxAmount += Global.A[14] * Global.T;
				Global.F[4].B -= Global.A[14];
				Global.F[4].taxAmount -= Global.A[14] * Global.T;
				Event Player.H[0] = Custom String("옷가게 알바생");
				Teleport(Event Player, Global.jp[34]);
				Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
				Small Message(Event Player, Custom String("급여를 받았다 +{0}만 원", Global.A[14]));
			Else If(Event Player.C[11] == 1);
				Small Message(Event Player, Custom String("경찰은 알바를 할 수 없습니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
			Else If(Event Player.C[11] == 3);
				Small Message(Event Player, Custom String("대통령은 알바를 할 수 없습니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
			Else If(Event Player.C[1] < 30);
				Call Subroutine(empty_power);
				Abort;
			End;
		End;
		If(Distance Between(Event Player, Global.jp[36]) <= 1);
			If(Global.Stock[9] < 1);
				Small Message(Event Player, Custom String("재고가 부족합니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Abort;
			Else If(Event Player.A < Global.P[10]);
				Call Subroutine(empty_money);
				Abort;
			Else If(Event Player.S[1] >= 200);
				Small Message(Event Player, Custom String("가방이 최고 레벨입니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
			Else If(Event Player.A >= Global.P[10] && Event Player.S[1] < 200 && Global.Stock[9] >= 1);
				Event Player.A -= Global.P[10];
				Global.F[4].B += Global.P[10] * 10 / 11;
				Global.F[4].taxAmount += Global.P[10] * 10 / 11 * Global.T;
				Global.Tax += Global.P[10] / 11;
				Event Player.S[1] += 2;
				Global.Stock[9] -= 1;
				Wait(0.050, Ignore Condition);
				Small Message(Event Player, Custom String("가방을 업그레이드했다 [인벤토리 최대 개수 {0}개]", Event Player.S[1]));
				Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
			End;
		End;
		If(Distance Between(Event Player, Global.jp[38]) <= 1.500);
			If(Event Player.C[11] == 0);
				If(Event Player.C[1] >= 50);
					Event Player.Jobm[1] = Random Integer(1, 4);
					Set Status(Event Player, Null, Rooted, 5);
					Teleport(Event Player, Vector(-52.710, 2, -8.360));
					Event Player.C[1] -= 50;
					Event Player.AA += 7;
					If(Event Player.C[27] == Custom String("조주기능사"));
						Event Player.Jobm[1] = Random Integer(1, 2);
					End;
					Wait(0.500, Ignore Condition);
					If(Event Player.Jobm[1] == 1);
						Small Message(Event Player, Custom String("손님에게 칵테일을 건네는 중... [기력 -50, 배고픔 +7%]"));
						Wait(2, Ignore Condition);
						Small Message(Event Player, Custom String("{0}: 술이 달군..", Hero Icon String(Hero(윈스턴))));
						Wait(2, Ignore Condition);
						Small Message(Event Player, Custom String("{0}: 고맙네..", Hero Icon String(Hero(윈스턴))));
						Event Player.R[2] = Random Integer(1, 10);
						Event Player.A += Event Player.R[2];
						Small Message(Event Player, Custom String("단골 손님에게 팁을 받았다 +{0}만 원", Event Player.R[2]));
						Wait(0.500, Ignore Condition);
					Else;
						Small Message(Event Player, Event Player.Jobm[1] == 2 ? Custom String("칵테일을 만드는 중... [기력 -50, 배고픔 +7%]") : (
							Event Player.Jobm[1] == 3 ? Custom String("술병을 닦는 중... [기력 -50, 배고픔 +7%]") : Custom String("바를 정리하는 중... [기력 -50, 배고픔 +7%]")));
						Wait(4.500, Ignore Condition);
					End;
					Event Player.C[13] += Random Integer(0, 1);
					Event Player.A += Global.A[15];
					Event Player.taxAmount += Global.A[15] * Global.T;
					Global.F[5].B -= Global.A[15];
					Global.F[5].taxAmount -= Global.A[15] * Global.T;
					Event Player.H[0] = Event Player.C[27] == Custom String("조주기능사") ? Custom String("술집 바텐더 Lv{0}", Event Player.C[13])
						: Custom String("술집 알바생 Lv{0}", Event Player.C[13]);
					If(Event Player.Jobm[1] == 2);
						Global.Stock[3] = Min(Global.Stock[3] + Max(1, Min(20, Round To Integer(Event Player.C[13] / 5, Down))), 1000);
						Global.Stock[4] = Min(Global.Stock[4] + Max(1, Min(20, Round To Integer(Event Player.C[13] / 10, Down))), 1000);
					End;
					Teleport(Event Player, Global.jp[38]);
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
					Small Message(Event Player, Custom String("급여를 받았다 +{0}만 원", Global.A[15]));
				Else If(Event Player.C[1] < 50);
					Call Subroutine(empty_power);
					Abort;
				End;
			Else If(Event Player.C[11] == 1);
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Small Message(Event Player, Custom String("경찰은 알바를 할 수 없습니다"));
			Else If(Event Player.C[11] == 3);
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Small Message(Event Player, Custom String("대통령은 알바를 할 수 없습니다"));
			End;
		End;
		If(Distance Between(Event Player, Global.jp[39]) <= 1);
			If(Event Player.A >= Global.P[4] && Global.Stock[4] >= 1);
				Event Player.A -= Global.P[4];
				Global.F[5].B += Global.P[4] * 10 / 11;
				Global.F[5].taxAmount += Global.P[4] * 10 / 11 * Global.T;
				Global.Tax += Global.P[4] / 11;
				Global.Stock[4] -= 1;
				Set Status(Event Player, Null, Rooted, 4.500);
				Small Message(Event Player, Custom String("{0}: 초여름엔..", Hero Icon String(Hero Of(Event Player))));
				Wait(0.500, Ignore Condition);
				Small Message(Event Player, Custom String("{0}: 제철인 장어지", Hero Icon String(Hero Of(Event Player))));
				Wait(1.500, Ignore Condition);
				Small Message(Event Player, Custom String("{0}: ...", Hero Icon String(Hero Of(Event Player))));
				Wait(1, Ignore Condition);
				Small Message(Event Player, Custom String("{0}: 맛있구만..", Hero Icon String(Hero Of(Event Player))));
				Event Player.AA = 0;
				Wait(1.500, Ignore Condition);
				Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
				Event Player.AA = 0;
				Small Message(Event Player, Custom String("장어를 먹고 배고픔이 모두 사라졌다"));
			Else If(Event Player.A >= Global.P[4] && Global.Stock[4] < 1);
				Small Message(Event Player, Custom String("재고가 부족합니다. 술집 알바를 통해 재고를 채울 수 있습니다.", Event Player));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
			Else If(Event Player.A < Global.P[4]);
				Call Subroutine(empty_money);
				Abort;
			Else If(Event Player.AA <= 0);
				Small Message(Event Player, Custom String("배고픔이 충분합니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
			End;
		End;
		If(Distance Between(Event Player, Global.jp[42]) <= 1.500);
			Abort If(Event Player.C[11] != 0 || Event Player.C[11] == 3);
			If(Event Player.C[1] >= 45);
				Event Player.Jobm[1] = Random Integer(1, 3);
				Set Status(Event Player, Null, Rooted, 5);
				Teleport(Event Player, Vector(-48.780, 10, -25.240));
				Event Player.C[1] -= 45;
				Event Player.AA += 5;
				Wait(0.250, Ignore Condition);
				Small Message(Event Player, Event Player.Jobm[1] == 1 ? Custom String("책을 정리하는 중... [기력 -45, 배고픔 +5%]") : (
					Event Player.Jobm[1] == 2 ? Custom String("대출을 처리하는 중... [기력 -45, 배고픔 +5%]") : Custom String(
					"도서를 분류하는 중... [기력 -45, 배고픔 +5%]")));
				Wait(5, Ignore Condition);
				Event Player.A += Global.A[16];
				Event Player.taxAmount += Global.A[16] * Global.T;
				Global.F[6].B -= Global.A[16];
				Global.F[6].taxAmount -= Global.A[16] * Global.T;
				Event Player.H[0] = Custom String("도서관 알바");
				Teleport(Event Player, Global.jp[42]);
				Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
				Small Message(Event Player, Custom String("급여를 받았다 +{0}만 원", Global.A[16]));
			Else If(Event Player.C[11] == 1);
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Small Message(Event Player, Custom String("경찰은 알바를 할 수 없습니다"));
				Wait(0.250, Ignore Condition);
			Else If(Event Player.C[11] == 3);
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Small Message(Event Player, Custom String("대통령은 알바를 할 수 없습니다"));
				Wait(0.250, Ignore Condition);
			Else If(Event Player.C[1] < 45);
				Call Subroutine(empty_power);
				Abort;
			End;
		End;
		If(Distance Between(Event Player, Global.jp[45]) <= 1.500);
			If(Event Player.C[22] != Custom String("생활 스포츠 지도사"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Small Message(Event Player, Custom String("생활 스포츠 지도사 자격을 취득해야 일할 수 있습니다"));
				Abort;
			Else If(Event Player.C[10] < 500);
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Small Message(Event Player, Custom String("최대 기력이 부족해 트레이너가 될 수 없습니다"));
				Abort;
			Else If(Event Player.C[11] != 0);
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Small Message(Event Player, Custom String("경찰과 대통령은 일을 할 수 없습니다"));
				Abort;
			Else If(Event Player.C[1] < 100);
				Call Subroutine(empty_power);
				Abort;
			End;
			If(Hero Of(Event Player) == Hero(정커퀸) || Hero Of(Event Player) == Hero(둠피스트) || Hero Of(Event Player) == Hero(솔저: 76) || Hero Of(
				Event Player) == Hero(D.Va));
				If(Event Player.C[10] < 1000);
					Start Forcing Player To Be Hero(Event Player, Hero(정커퀸));
					Event Player.H[0] = Custom String("헬스 트레이너");
				Else If(Event Player.C[10] < 3000);
					Start Forcing Player To Be Hero(Event Player, Hero(둠피스트));
					Event Player.H[0] = Custom String("헬창");
				Else;
					Start Forcing Player To Be Hero(Event Player, Hero(마우가));
					Event Player.H[0] = Custom String("보디빌더");
				End;
			End;
			Event Player.Jobm[1] = Random Integer(1, 3);
			Event Player.R[3] = Random Integer(10, 25);
			Set Status(Event Player, Null, Rooted, 6);
			Teleport(Event Player, Vector(-22.410, 4, -15.980));
			Event Player.C[1] -= 100;
			Event Player.R[2] = Min(Random Integer(1, 3), 3000 - Event Player.C[10]);
			Wait(0.050, Ignore Condition);
			Event Player.C[10] += Event Player.R[2];
			Event Player.AA += Event Player.R[3];
			Wait(0.250, Ignore Condition);
			Small Message(Event Player, Event Player.Jobm[1] == 1 ? Custom String("운동 지도를 하는 중... [기력 -100, 배고픔 +{0}%]", Event Player.R[3]) : (
				Event Player.Jobm[1] == 2 ? Custom String("회원의 자세를 교정하는 중... [기력 -100, 배고픔 +{0}%]", Event Player.R[3]) : Custom String(
				"트레이닝 세션을 진행하는 중... [기력 -100, 배고픔 +{0}%]", Event Player.R[3])));
			Wait(6, Ignore Condition);
			Event Player.A += Global.A[17];
			Event Player.taxAmount += Global.A[17] * Global.T;
			Global.F[7].B -= Global.A[17];
			Global.F[7].taxAmount -= Global.A[17] * Global.T;
			Teleport(Event Player, Global.jp[45]);
			Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
			Small Message(Event Player, Custom String("급여를 받았다 +{0}만 원", Global.A[17]));
		End;
		If(Distance Between(Event Player, Global.jp[49]) <= 1.500);
			If(Event Player.C[11] != 0);
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Small Message(Event Player, Custom String("경찰과 대통령은 알바를 할 수 없습니다"));
				Abort;
			Else If(Event Player.C[1] < 40);
				Call Subroutine(empty_power);
				Abort;
			End;
			Event Player.Jobm[1] = Random Integer(1, 3);
			Set Status(Event Player, Null, Rooted, 6.250);
			Teleport(Event Player, Vector(48.730, 10, -24.810));
			Event Player.C[1] -= 40;
			Event Player.AA += 6;
			Wait(0.250, Ignore Condition);
			If(Event Player.Jobm[1] == 1);
				Small Message(Event Player, Custom String("예약을 확인하는 중..."));
			Else If(Event Player.Jobm[1] == 2);
				Small Message(Event Player, Custom String("고객을 응대하는 중..."));
			Else If(Event Player.Jobm[1] == 3);
				Small Message(Event Player, Custom String("체크인을 돕는 중..."));
			End;
			Wait(3, Ignore Condition);
			Event Player.Jobm[1] = Random Integer(1, 3);
			If(Event Player.Jobm[1] == 1);
				Small Message(Event Player, Custom String("예약을 확인하는 중... [기력 -40, 배고픔 +6%]"));
			Else If(Event Player.Jobm[1] == 2);
				Small Message(Event Player, Custom String("고객을 응대하는 중... [기력 -40, 배고픔 +6%]"));
			Else If(Event Player.Jobm[1] == 3);
				Small Message(Event Player, Custom String("체크인을 돕는 중... [기력 -40, 배고픔 +6%]"));
			End;
			Wait(3, Ignore Condition);
			If(Event Player.C[25] == Custom String("호텔 매니지먼트"));
				Event Player.A += Global.A[18] * 1.500;
				Event Player.taxAmount += Global.A[18] * Global.T * 1.500;
				Global.F[8].B -= Global.A[18] * 1.500;
				Global.F[8].taxAmount -= Global.A[18] * Global.T * 1.500;
				Event Player.H[0] = Custom String("호텔 매니저");
				Small Message(Event Player, Custom String("급여를 받았다 +{0}만 원", Global.A[18] * 1.500));
			Else;
				Event Player.A += Global.A[18];
				Event Player.taxAmount += Global.A[18] * Global.T;
				Global.F[8].B -= Global.A[18];
				Global.F[8].taxAmount -= Global.A[18] * Global.T;
				Event Player.H[0] = Custom String("호텔 알바생");
				Small Message(Event Player, Custom String("급여를 받았다 +{0}만 원", Global.A[18]));
			End;
			Teleport(Event Player, Global.jp[49]);
			Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
		End;
		If(Distance Between(Event Player, Global.jp[50]) <= 2);
			If(Event Player.C[1] < Event Player.C[10] && Event Player.A >= Global.P[7]);
				Set Status(Event Player, Null, Rooted, 8);
				Set Status(Event Player, Null, Phased Out, 8);
				Set Invisible(Event Player, All);
				Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
				Small Message(Event Player, Custom String("피곤한 몸을 이끌고 침대에 누웠다"));
				Heal(Event Player, Null, Max Health(Event Player));
				Event Player.C[1] = Event Player.C[10];
				Event Player.A -= Global.P[7];
				Global.F[8].B += Global.P[7] * 10 / 11;
				Global.F[8].taxAmount += Global.P[7] * 10 / 11 * Global.T;
				Global.Tax += Global.P[7] / 11;
				Wait(4, Ignore Condition);
				Small Message(Event Player, Custom String("{0}: Zzz", Hero Icon String(Hero Of(Event Player))));
				Wait(4, Ignore Condition);
				Set Invisible(Event Player, None);
				Clear Status(Event Player, Phased Out);
				Clear Status(Event Player, Rooted);
				Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
				Small Message(Event Player, Custom String("기력이 최대로 회복되었다"));
			Else If(Event Player.A < Global.P[7]);
				Small Message(Event Player, Custom String("돈이 부족합니다. 노숙을 통해서도 기력을 충전할 수 있습니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Wait(1, Ignore Condition);
			Else;
				Small Message(Event Player, Custom String("이미 기력이 충분합니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Wait(3, Ignore Condition);
			End;
		End;
		If(Distance Between(Event Player, Global.jp[61]) <= 2);
			If(Event Player.A >= Global.P[14]);
				Set Status(Event Player, Null, Rooted, 8);
				Set Status(Event Player, Null, Phased Out, 8);
				Set Invisible(Event Player, All);
				Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
				Small Message(Event Player, Custom String("피곤한 몸을 이끌고 침대에 누웠다"));
				Heal(Event Player, Null, Max Health(Event Player));
				Event Player.A -= Global.P[14];
				Global.Tax += Global.P[14] / 11;
				Wait(4, Ignore Condition);
				Small Message(Event Player, Custom String("{0}: Zzz", Hero Icon String(Hero Of(Event Player))));
				Wait(4, Ignore Condition);
				Event Player.C[1] = Min(Event Player.C[1] + 150, Event Player.C[10]);
				Set Invisible(Event Player, None);
				Clear Status(Event Player, Phased Out);
				Clear Status(Event Player, Rooted);
				Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
				Small Message(Event Player, Custom String("기력이 회복되었다"));
			Else If(Event Player.A < Global.P[14]);
				Small Message(Event Player, Custom String("돈이 부족합니다. 노숙을 통해서도 기력을 충전할 수 있습니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
			Else;
				Small Message(Event Player, Custom String("이미 기력이 충분합니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
			End;
		End;
		If(Distance Between(Event Player, Global.jp[51]) <= 1.500);
			If(Event Player.C[1] < 65);
				Call Subroutine(empty_power);
				Abort;
			Else If(Global.O[0] == True);
				Small Message(Event Player, Custom String("극단적 긴축 정책으로 인해 제설 작업을 할 수 없습니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 200);
				Abort;
			End;
			Event Player.Jobm[1] = Random Integer(1, 3);
			Set Status(Event Player, Null, Rooted, 5);
			Event Player.C[1] -= 65;
			Event Player.AA += 7;
			Wait(0.250, Ignore Condition);
			If(Event Player.Jobm[1] == 1);
				Teleport(Event Player, Vector(-2.870, 4, 32.070));
				Small Message(Event Player, Custom String("눈을 치우는 중... [기력 -65, 배고픔 +7%]"));
			Else If(Event Player.Jobm[1] == 2);
				Teleport(Event Player, Vector(-11.700, -0.100, 8.140));
				Small Message(Event Player, Custom String("인도를 정리하는 중... [기력 -65, 배고픔 +7%]"));
			Else If(Event Player.Jobm[1] == 3);
				Teleport(Event Player, Vector(-8.220, 1.450, -32.320));
				Small Message(Event Player, Custom String("눈을 쌓이지 않도록 치우는 중... [기력 -65, 배고픔 +7%]"));
			End;
			Event Player.R[2] = Min(Random Integer(1, 2), 3000 - Event Player.C[10]);
			Wait(0.050, Ignore Condition);
			Event Player.C[10] += Event Player.R[2];
			Wait(5, Ignore Condition);
			Event Player.A += Global.A[20];
			Event Player.taxAmount += Global.A[20] * Global.T;
			Global.Tax -= Global.A[20];
			Teleport(Event Player, Global.jp[51]);
			Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
			Small Message(Event Player, Custom String("급여를 받았다 +{0}만 원", Global.A[20]));
		End;
		If(Distance Between(Event Player, Global.jp[53]) <= 1.500);
			If(Event Player.C[1] >= 35 && Event Player.C[11] != 3 && Event Player.C[11] != 1);
				Event Player.Jobm[1] = Random Integer(1, 4);
				Set Status(Event Player, Null, Rooted, 5);
				Teleport(Event Player, Vector(-18.620, 4.010, 9.940));
				Event Player.C[1] -= 35;
				Event Player.AA += 5;
				If(Event Player.C[28] == Custom String("바리스타"));
					Event Player.Jobm[1] = Random Integer(1, 3);
				End;
				Wait(0.500, Ignore Condition);
				If(Event Player.Jobm[1] == 1);
					Small Message(Event Player, Custom String("신선한 원두로 커피를 추출하는 중... [기력 -35, 배고픔 +5%]"));
				Else If(Event Player.Jobm[1] == 2);
					Small Message(Event Player, Custom String("향기로운 커피를 만들고 있는 중... [기력 -35, 배고픔 +5%]"));
				Else If(Event Player.Jobm[1] == 3);
					Small Message(Event Player, Custom String("샌드위치를 만드는 중... [기력 -35, 배고픔 +5%]"));
				Else If(Event Player.Jobm[1] == 4);
					Small Message(Event Player, Custom String("커피 머신을 청소하는 중... [기력 -35, 배고픔 +5%]"));
				End;
				Wait(4.500, Ignore Condition);
				Event Player.C[14] += Random Integer(0, 1);
				Event Player.H[0] = Event Player.C[28] == Custom String("바리스타") ? Custom String("카페 바리스타 Lv{0}", Event Player.C[14])
					: Custom String("카페 알바생 Lv{0}", Event Player.C[14]);
				If(Event Player.Jobm[1] <= 2);
					Global.Stock[7] = Min(Global.Stock[7] + Max(1, Min(10, Round To Integer(Event Player.C[14] / 5, Down))), 1000);
				Else If(Event Player.Jobm[1] == 3);
					Global.Stock[10] = Min(Global.Stock[10] + Max(1, Min(20, Round To Integer(Event Player.C[14] / 10, Down))), 1000);
				End;
				If(Event Player.C[28] == Custom String("바리스타"));
					Event Player.Jobm = Random Integer(1, 3);
					If(Event Player.Jobm == 1);
						Event Player.R[3] = Min(10, Event Player.C[10] - Event Player.C[1]);
						Event Player.R[1] = Min(1, Event Player.AA);
						Event Player.C[1] += Event Player.R[3];
						Event Player.AA -= Event Player.R[1];
						Small Message(Event Player, Custom String("아메리카노를 마셨다 [배고픔 -{0}%, 기력 충전 +{1}%]", Round To Integer(Event Player.R[1], Up),
							Event Player.R[3]));
					End;
				End;
				Teleport(Event Player, Global.jp[53]);
				Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
				Event Player.A += Global.A[19];
				Event Player.taxAmount += Global.A[19] * Global.T;
				Global.F[9].B -= Global.A[19];
				Global.F[9].taxAmount -= Global.A[19] * Global.T;
				Small Message(Event Player, Custom String("급여를 받았다 [+{0}만 원]", Global.A[19]));
			Else If(Event Player.C[11] == 1);
				Small Message(Event Player, Custom String("경찰은 알바를 할 수 없습니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Wait(0.250, Ignore Condition);
			Else If(Event Player.C[11] == 3);
				Small Message(Event Player, Custom String("대통령은 알바를 할 수 없습니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Wait(0.250, Ignore Condition);
			Else If(Event Player.C[1] < 35);
				Call Subroutine(empty_power);
				Abort;
			End;
		End;
		If(Distance Between(Event Player, Global.jp[54]) <= 1);
			If(Global.Stock[7] < 1);
				Small Message(Event Player, Custom String("재고가 부족합니다. 카페 알바를 통해 재고를 채울 수 있습니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Abort;
			Else If(Event Player.A < Global.P[11]);
				Call Subroutine(empty_money);
				Abort;
			End;
			Global.Stock[7] -= 1;
			Event Player.A -= Global.P[11];
			Global.F[9].B += Global.P[11] * 10 / 11;
			Global.F[9].taxAmount += Global.P[11] * 10 / 11 * Global.T;
			Global.Tax += Global.P[11] / 11;
			Event Player.R[3] = Min(10, Event Player.C[10] - Event Player.C[1]);
			Event Player.R[1] = Min(1, Event Player.AA);
			Event Player.C[1] += Event Player.R[3];
			Event Player.AA -= Event Player.R[1];
			Small Message(Event Player, Custom String("아메리카노를 마셨다 [배고픔 -{0}%, 기력 충전 +{1}%]", Round To Integer(Event Player.R[1], Up),
				Event Player.R[3]));
			Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
			Set Move Speed(Event Player, 250);
			Event Player.timer[4] = 2;
		End;
	}
}

rule("상호작용FM")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Interact)) == True;
		Hero(레킹볼) != Hero Of(Event Player);
		Is Alive(Event Player) == True;
	}

	action
	{
		If(Distance Between(Event Player, Global.jp[90]) <= 2);
			If(Event Player.D[9] == 0);
				Small Message(Event Player, Custom String("{0}: ATM 중 하나에서 현금을 수거해와", Hero Icon String(Hero(솜브라))));
				Wait(2.500, Ignore Condition);
				Small Message(Event Player, Custom String("{0}: 그럼 보수를 지불하지", Hero Icon String(Hero(솜브라))));
				Event Player.D[9] = 1;
				Event Player.ms[1] += 1;
				If(Event Player.ms[0] == Custom String("명성"));
					Event Player.ms[1] = 1;
				End;
				Event Player.ms[0] = Custom String("악명");
			Else If(Event Player.D[9] == 1);
				Small Message(Event Player, Custom String("{0}: 수거하러 안 가고 뭐하는 거지?", Hero Icon String(Hero(솜브라))));
				Wait(2.500, Ignore Condition);
				Small Message(Event Player, Custom String("{0}: ATM 3곳을 뒤져봐", Hero Icon String(Hero(솜브라))));
			Else If(Event Player.D[9] == 2 && Event Player.A >= 100);
				Event Player.R[3] = Random Integer(10, 50);
				Small Message(Event Player, Custom String("{0}: 현금은 가져왔나?", Hero Icon String(Hero(솜브라))));
				Wait(2.500, Ignore Condition);
				Event Player.A -= 100;
				Small Message(Event Player, Custom String("{0}: 잘 가져왔네. 보수를 지불하지. 또 일을 하고 싶다면 언제든 와라", Hero Icon String(Hero(솜브라))));
				Wait(2.500, Ignore Condition);
				Event Player.D[9] = 0;
				Event Player.ms[1] += 1;
				If(Event Player.ms[0] == Custom String("명성"));
					Event Player.ms[1] = 1;
				End;
				Event Player.ms[0] = Custom String("악명");
				Event Player.A += Event Player.R[3];
				Small Message(Event Player, Custom String("보이스피싱 현금 운반책 알바를 하고 돈을 벌었다 [+{0}만 원 / 악명 +2]", Event Player.R[3]));
				Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
				Call Subroutine(badcop);
			End;
		End;
		If(Distance Between(Event Player, Global.jp[103]) <= 1);
			If(Event Player.D[9] == 1);
				If(Event Player.C[1] >= 70);
					Global.jp[103] = Global.jp[Random Integer(104, 106)];
					Set Status(Event Player, Null, Rooted, 5);
					Small Message(Event Player, Custom String("현금을 수거하는 중.. [기력 -70, 배고픔 +15%]"));
					Event Player.C[1] -= 70;
					Event Player.AA += 10;
					Event Player.D[9] = 2;
					Wait(5, Ignore Condition);
					Event Player.A += 100;
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
					Small Message(Event Player, Custom String("현금을 수거했습니다. 지하철에 가져다주세요"));
				Else If(Event Player.C[1] < 70);
					Call Subroutine(empty_power);
					Abort;
				End;
			End;
		End;
		If(Distance Between(Event Player, Global.jp[91]) <= 2);
			If(Event Player.C[1] < 200);
				Call Subroutine(empty_power);
				Abort;
			Else If(Event Player.ms[0] != Custom String("악명") || Event Player.ms[1] < 200);
				Small Message(Event Player, Custom String("악명치가 200 이상이여야 합니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Abort;
			End;
			Set Status(Event Player, Null, Rooted, 8);
			Teleport(Event Player, Vector(112.300, 9, -15.650));
			Wait(0.050, Ignore Condition);
			Small Message(Event Player, Custom String("전화 발신 중.."));
			Wait(2, Ignore Condition);
			Small Message(Event Player, Custom String("{0}: 여보세요?", Hero Icon String(Hero Of(Event Player))));
			Wait(2, Ignore Condition);
			Small Message(Event Player, Custom String("{1}: 헬조선중앙지검 {0} 검사입니다", Event Player, Hero Icon String(Hero Of(Event Player))));
			Wait(2, Ignore Condition);
			Event Player.R[3] = Random Integer(10, 100);
			Event Player.R[2] = Random Integer(1, 100);
			Event Player.H[0] = Custom String("보이스피싱 범죄자");
			If(Event Player.R[2] <= Global.B[0] - 40);
				Event Player.jp = Random Value In Array(Filtered Array(All Players(All Teams),
					Current Array Element != Event Player && Current Array Element.B >= -300 && Current Array Element.gamock == 0));
				If(Event Player.jp != Null);
					Small Message(Event Player, Custom String("{1}: 다름이 아니라 {0}씨의 통장이 범죄에 연류되어..", Event Player.jp, Hero Icon String(Hero Of(
						Event Player))));
					Wait(2, Ignore Condition);
					Event Player.jp.B -= Event Player.R[3];
					Event Player.A += Event Player.R[3];
					Small Message(Event Player.jp, Custom String("보이스 피싱을 당해 당신의 계좌에서 {0}만 원이 빠져나갔습니다...", Event Player.R[3]));
					Small Message(Event Player, Custom String("보이스피싱에 성공했습니다 [+{0}만 원 / 기력 -200 / 배고픔 +5% / 악명 +2]", Event Player.R[3]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
				Else;
					Small Message(Event Player, Custom String("{0}: 무슨 검사가 010으로 전화를 합니까? 끊을게요", Hero Icon String(Hero(솔저: 76))));
					Wait(3, Ignore Condition);
					Small Message(Event Player, Custom String("보이스피싱에 실패했습니다 [기력 -200 / 배고픔 +5% / 악명 +2]"));
					Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 100);
				End;
			Else If(Event Player.R[2] <= Global.B[0]);
				Small Message(Event Player, Custom String("{0}: 다름이 아니라 영희씨의 통장이 범죄에 연류되어..", Hero Icon String(Hero Of(Event Player))));
				Wait(2, Ignore Condition);
				Event Player.A += Event Player.R[3];
				Small Message(Event Player, Custom String("보이스피싱에 성공했습니다 [+{0}만 원 / 기력 -200 / 배고픔 +5% / 악명 +2]", Event Player.R[3]));
				Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
			Else;
				Small Message(Event Player, Custom String("{0}: 내가 당할 것 같습니까? 끊습니다!", Hero Icon String(Hero(솔저: 76))));
				Wait(3, Ignore Condition);
				Small Message(Event Player, Custom String("보이스피싱에 실패했습니다 [기력 -200 / 배고픔 +5% / 악명 +2]"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 100);
			End;
			Event Player.AA += 5;
			Event Player.C[1] -= 200;
			Event Player.ms[1] += 2;
			Teleport(Event Player, Global.jp[91]);
		End;
		If(Distance Between(Event Player, Global.jp[93]) <= 2);
			If(Event Player.C[1] < 50);
				Call Subroutine(empty_power);
				Abort;
			Else If(Event Player.D[8] == 1);
				Small Message(Event Player, Custom String("불법 약물을 이미 가지고 있습니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Abort;
			Else If(Event Player.ms[0] == Custom String("명성") || Event Player.ms[1] < 50);
				Small Message(Event Player, Custom String("악명치가 50 이상이어야 합니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Abort;
			End;
			Set Status(Event Player, Null, Rooted, 5);
			Event Player.D[8] = 1;
			Event Player.C[1] -= 50;
			Small Message(Event Player, Custom String("불법 약물 제조 중.."));
			Wait(5, Ignore Condition);
			Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
			Event Player.ms[1] += 2;
			Small Message(Event Player, Custom String("불법 약물을 제조했다 [악명 +2 / 기력 -50]"));
			Event Player.UI[1] = Custom String("\r\n불법 약물을 납품하세요 [술집]");
			Wait(3, Ignore Condition);
			Event Player.H[0] = Custom String("약물 제조원");
			Small Message(Event Player, Custom String("제조한 불법 약물은 납품을 통해 돈을 벌 수 있습니다 [술집]"));
		End;
		If(Distance Between(Event Player, Global.jp[94]) <= 1);
			If(Event Player.D[8] == 0);
				Small Message(Event Player, Custom String("불법 약물을 가지고 있지 않습니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Abort;
			End;
			Set Status(Event Player, Null, Rooted, 5);
			Event Player.D[8] = 0;
			Global.Stock[6] += 1;
			Event Player.ms[1] += 2;
			Small Message(Event Player, Custom String("불법 약물 납품 중.. [악명 +2]"));
			Event Player.UI[1] = Custom String("\r\n");
			Wait(5, Ignore Condition);
			Event Player.A += Global.P[20];
			Small Message(Event Player, Custom String("불법 약물을 납품했다 [+{0}만 원]", Global.P[20]));
			Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
		End;
		If(Distance Between(Event Player, Global.jp[95]) <= 1.500);
			If(Event Player.C[10] >= 3000);
				Small Message(Event Player, Custom String("최고인 3,000 기력에 도달했다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Abort;
			Else If(Event Player.A < Global.P[6]);
				Call Subroutine(empty_money);
				Abort;
			Else If(Global.Stock[6] < 1);
				Small Message(Event Player, Custom String("약물 재고가 없어 주입 받을 수 없습니다. 약물을 제조해 납품할 수 있습니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Abort;
			End;
			Event Player.A -= Global.P[6];
			Global.Stock[6] -= 1;
			Event Player.R[3] = Min(Random Integer(1, 120), 3000 - Event Player.C[10]);
			Set Status(Event Player, Null, Knocked Down, 3);
			Small Message(Event Player, Custom String("불법 약물 주입 중.."));
			Wait(3, Ignore Condition);
			Event Player.C[10] += Event Player.R[3];
			Event Player.C[1] = Event Player.C[10];
			Event Player.ms[1] += 4;
			If(Event Player.ms[0] == Custom String("명성"));
				Event Player.ms[1] = 4;
				Event Player.ms[0] = Custom String("악명");
			End;
			Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
			Small Message(Event Player, Custom String("불법 약물을 주입했다 [최대 기력 +{0}, 최대 기력: {1}, 악명 +4]", Event Player.R[3], Event Player.C[10]));
			Event Player.H[0] = Custom String("약쟁이");
			Set Aim Speed(Event Player, 80);
			Set Move Speed(Event Player, 160);
			Event Player.timer[4] = 60;
			If(Event Player.C[10] == 3000);
				Small Message(Event Player, Custom String("{0} 최대 기력 {1}!", Hero Icon String(Hero Of(Event Player)), Event Player.C[10]));
				Small Message(Event Player, Custom String("최고인 3,000 기력에 도달했다"));
			End;
			Call Subroutine(badcop);
		End;
		If(Distance Between(Event Player, Global.jp[96]) <= 1);
			Teleport(Event Player, Global.jp[97]);
		Else If(Distance Between(Event Player, Global.jp[97]) <= 1);
			Teleport(Event Player, Global.jp[96]);
		End;
		If(Distance Between(Event Player, Global.jp[98]) <= 1);
			Abort If(Event Player.C[1] < 5);
			Event Player.Jobm[1] = Random Integer(1, 2);
			Event Player.R[3] = Random Integer(1, 4);
			Small Message(Event Player, Custom String("자판기를 터는 중.. [악명 +1, 기력 -5, 배고픔 +5%]"));
			Event Player.H[0] = Custom String("잡범");
			Global.jp[98] = Global.jp[Random Integer(99, 102)];
			Event Player.ms[1] += 1;
			If(Event Player.ms[0] == Custom String("명성"));
				Event Player.ms[1] = 1;
			End;
			Event Player.ms[0] = Custom String("악명");
			Event Player.C[1] -= 5;
			If(Event Player.Jobm[1] == 1);
				Small Message(Event Player, Custom String("음료수를 마시고 조금의 현금을 얻었다 [+{0}만 원, 배고픔 -5%]", Event Player.R[3]));
			Else;
				Event Player.AA += 5;
				Small Message(Event Player, Custom String("조금의 현금을 얻었다 [+{0}만 원]", Event Player.R[3]));
			End;
			Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
			Event Player.A += Event Player.R[3];
			Call Subroutine(badcop);
		End;
	}
}

rule("상호작용E")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Ability 2)) == True;
		Hero(레킹볼) != Hero Of(Event Player);
		Is Alive(Event Player) == True;
	}

	action
	{
		If(Event Player.name[1] == 1);
			For Player Variable(Event Player, level, 0, Count Of(Global.Position[6]), 1);
				If(Distance Between(Event Player, Global.Position[6][Event Player.level])
					<= 1 && Event Player.F[Event Player.level + 3] == 1 && Event Player.A >= 100);
					If(Is Button Held(Event Player, Button(Crouch)));
						Global.S[Event Player.level + 3] += 100;
						Event Player.A -= 100;
						Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
						Wait(0.100, Ignore Condition);
						Loop If Condition Is True;
					End;
					Global.S[Event Player.level + 3] += 100;
					Event Player.A -= 100;
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
			If(Event Player.R[4] == True && Event Player.F[10] == 1);
				If(Event Player.C[1] < Event Player.C[10]);
					Set Status(Event Player, Null, Rooted, 4);
					Set Status(Event Player, Null, Phased Out, 4);
					Set Invisible(Event Player, All);
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
					Small Message(Event Player, Custom String("피곤한 몸을 이끌고 침대에 누웠다"));
					Heal(Event Player, Null, Max Health(Event Player));
					Event Player.C[1] = Event Player.C[10];
					Wait(2, Ignore Condition);
					Small Message(Event Player, Custom String("{0}: Zzz", Hero Icon String(Hero Of(Event Player))));
					Wait(2, Ignore Condition);
					Set Invisible(Event Player, None);
					Clear Status(Event Player, Phased Out);
					Clear Status(Event Player, Rooted);
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
					Small Message(Event Player, Custom String("기력이 최대로 회복되었다"));
				Else;
					Small Message(Event Player, Custom String("이미 기력이 충분합니다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
		Else If(Event Player.name[1] == 2);
			For Player Variable(Event Player, level, 0, 7, 1);
				If(Distance Between(Event Player, Global.Position[6][Event Player.level])
					<= 1 && Event Player.F[Event Player.level + 3] == 1 && Global.A[Event Player.level + 13] < 50);
					If(Is Button Held(Event Player, Button(Crouch)));
						Global.A[Event Player.level + 13] += 1;
						Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
						Wait(0.100, Ignore Condition);
						Loop If Condition Is True;
					End;
					Global.A[Event Player.level + 13] += 1;
					Event Player.B[1] = Global.A[Event Player.level + 13];
					Event Player.B[2] = Global.Position[2][Event Player.level];
					Wait(0.020, Ignore Condition);
					Small Message(Event Player, Custom String("급여를 올렸다 | {1} 알바 급여 {0}만 원", Event Player.B[1], Event Player.B[2]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
		Else If(Event Player.name[1] == 3);
			If(Distance Between(Event Player, Global.jp[30]) <= 1);
				If(Event Player.F[3] == 1 && Global.P[1] < 6);
					Global.P[1] += 1;
					Wait(0.250, Ignore Condition);
					Small Message(Event Player, Custom String("가격을 올렸다 | 계란빵 가격 {0}만 원", Global.P[1]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
			"옷가게"
			If(Distance Between(Event Player, Global.jp[33]) <= 1);
				If(Event Player.F[4] == 1 && Global.P[10] < 50);
					Global.P[10] += 1;
					Wait(0.250, Ignore Condition);
					Small Message(Event Player, Custom String("가격을 올렸다 | 가방 가격 {0}만 원", Global.P[10]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
			"헬스장"
			If(Distance Between(Event Player, Global.jp[44]) <= 1);
				If(Event Player.F[7] == 1 && Global.P[5] < 48);
					Global.P[5] += 1;
					Wait(0.250, Ignore Condition);
					Small Message(Event Player, Custom String("가격을 올렸다 | PT회비 {0}만 원", Global.P[5]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
			"술집"
			If(Distance Between(Event Player, Global.jp[37]) <= 1);
				If(Event Player.F[5] == 1 && Global.P[3] < 9);
					Global.P[3] += 1;
					Wait(0.250, Ignore Condition);
					Small Message(Event Player, Custom String("가격을 올렸다 | 칵테일 가격 {0}만 원", Global.P[3]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
			"도서관"
			If(Distance Between(Event Player, Global.jp[41]) <= 1);
				If(Event Player.F[6] == 1 && Global.P[9] < 40);
					Global.P[9] += 1;
					Wait(0.250, Ignore Condition);
					Small Message(Event Player, Custom String("가격을 올렸다 | 입장료 {0}만 원", Global.P[9]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
			"호텔"
			If(Distance Between(Event Player, Global.jp[48]) <= 1);
				If(Event Player.F[8] == 1 && Global.P[7] < 50);
					Global.P[7] += 1;
					Wait(0.250, Ignore Condition);
					Small Message(Event Player, Custom String("가격을 올렸다 | 호텔 숙박 가격 {0}만 원", Global.P[7]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
			If(Distance Between(Event Player, Global.jp[52]) <= 1);
				If(Event Player.F[9] == 1 && Global.P[11] < 5);
					Global.P[11] += 1;
					Wait(0.250, Ignore Condition);
					Small Message(Event Player, Custom String("가격을 올렸다 | 아메리카노 가격 {0}만 원", Global.P[11]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
		Else If(Event Player.name[1] == 4);
			If(Distance Between(Event Player, Global.jp[30]) <= 1);
				If(Event Player.F[3] == 1 && Global.P[2] < 30);
					Global.P[2] += 1;
					Wait(0.250, Ignore Condition);
					Small Message(Event Player, Custom String("가격을 올렸다 | 간장계란밥 가격 {0}만 원", Global.P[2]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
			"술집"
			If(Distance Between(Event Player, Global.jp[37]) <= 3);
				If(Event Player.F[5] == 1 && Global.P[4] < 60);
					Global.P[4] += 1;
					Wait(0.250, Ignore Condition);
					Small Message(Event Player, Custom String("가격을 올렸다 | 장어 가격 {0}만 원", Global.P[4]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
			If(Distance Between(Event Player, Global.jp[52]) <= 1);
				If(Event Player.F[9] == 1 && Global.P[15] < 30);
					Global.P[15] += 1;
					Wait(0.250, Ignore Condition);
					Small Message(Event Player, Custom String("가격을 올렸다 | 샌드위치 가격 {0}만 원", Global.P[15]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
		End;
		If(Distance Between(Event Player, Global.jp[39]) <= 1);
			If(Global.Stock[3] < 1);
				Small Message(Event Player, Custom String("재고가 부족합니다. 술집 알바를 통해 재고를 채울 수 있습니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Abort;
			Else If(Event Player.A < Global.P[3]);
				Call Subroutine(empty_money);
				Abort;
			End;
			Global.Stock[3] -= 1;
			Event Player.A -= Global.P[3];
			Global.F[5].B += Global.P[3] * 10 / 11;
			Global.F[5].taxAmount += Global.P[3] * 10 / 11 * Global.T;
			Global.Tax += Global.P[3] / 11;
			Event Player.R[3] = Min(20, Event Player.C[10] - Event Player.C[1]);
			Event Player.R[1] = Min(5, Event Player.AA);
			Event Player.C[1] += Event Player.R[3];
			Event Player.AA -= Event Player.R[1];
			Small Message(Event Player, Custom String("술을 마셨다 [배고픔 -{0}%, 기력 충전 +{1}%]", Round To Integer(Event Player.R[1], Up),
				Event Player.R[3]));
			Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
			Set Move Speed(Event Player, 150);
			Set Aim Speed(Event Player, 200);
			Event Player.timer[4] = 20;
		End;
		If(Distance Between(Event Player, Global.jp[32]) <= 3);
			If(Event Player.A >= Global.P[1] && Global.Stock[1] >= 1);
				If(Event Player.S[1] > Event Player.S[2] + Event Player.S[3] + Event Player.S[4]);
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
					Event Player.S[2] += 1;
					Global.Stock[1] -= 1;
					Global.F[3].B += Global.P[1] * 10 / 11;
					Global.F[3].taxAmount += Global.P[1] * 10 / 11 * Global.T;
					Event Player.A -= Global.P[1];
					Global.Tax += Global.P[1] / 11;
				Else If(Event Player.S[1] <= Event Player.S[2] + Event Player.S[3] + Event Player.S[4]);
					Small Message(Event Player, Custom String("인벤토리가 가득 찼습니다. 가방을 업그레이드 하세요"));
					Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				End;
			Else If(Event Player.A >= Global.P[1] && Global.Stock[1] < 1);
				Small Message(Event Player, Custom String("계란빵 재고가 부족합니다. 에그 하우스 알바를 통해 재고를 채울 수 있습니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Wait(3, Ignore Condition);
			Else;
				Call Subroutine(empty_money);
				Abort;
			End;
		Else If(Distance Between(Event Player, Global.jp[54]) <= 1);
			If(Event Player.A >= Global.P[15] && Global.Stock[10] >= 1);
				If(Event Player.S[1] > Event Player.S[2] + Event Player.S[3] + Event Player.S[4]);
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
					Event Player.S[3] += 1;
					Global.Stock[10] -= 1;
					Global.F[9].B += Global.P[15] * 10 / 11;
					Global.F[9].taxAmount += Global.P[15] * 10 / 11 * Global.T;
					Event Player.A -= Global.P[15];
					Global.Tax += Global.P[15] / 11;
				Else If(Event Player.S[1] <= Event Player.S[2] + Event Player.S[3] + Event Player.S[4]);
					Small Message(Event Player, Custom String("인벤토리가 가득 찼습니다. 가방을 업그레이드 하세요"));
					Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				End;
			Else If(Event Player.A >= Global.P[15] && Global.Stock[1] < 1);
				Small Message(Event Player, Custom String("샌드위치 재고가 부족합니다. 카페 알바를 통해 재고를 채울 수 있습니다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
				Wait(3, Ignore Condition);
			Else;
				Call Subroutine(empty_money);
				Abort;
			End;
		End;
		If(Event Player.R[15] == True);
			Event Player.targetIndex = (Event Player.targetIndex + 1) % Count Of(Event Player.players);
			Wait(0.100, Ignore Condition);
			Event Player.name[0] = Custom String("-------------------\r\n{0}{1}님에게 송금 {2}", Hero Icon String(Hero Of(
				Event Player.players[Event Player.targetIndex])), Event Player.players[Event Player.targetIndex], Custom String(
				"{0}만 원\r\n-------------------\r\n[좌/우클릭] 송금액 +-\r\n[E/V] 플레이어 목록 앞/뒤\r\n[F] 송금하기\r\n-------------------\r\n[점프] 닫기\r\n",
				Event Player.moneyjp));
		End;
		If(Distance Between(Event Player, Global.jp[57]) <= 3);
			If(Event Player.name[2] == 1);
				If(Event Player.B >= 0);
					If(Event Player.ms[3] >= 50);
						Wait(0.500, Ignore Condition);
						Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
						Small Message(Event Player, Custom String("{0}만 원 대출 입금 완료 [신용 -50]", Event Player.ms[4]));
						Event Player.A += Event Player.ms[4];
						Event Player.B -= Event Player.ms[4];
						Event Player.ms[3] -= 50;
						Event Player.name[0] = Custom String("");
					Else;
						Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 100);
						Small Message(Event Player, Custom String("신용이 부족합니다"));
					End;
				Else;
					Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 100);
					Small Message(Event Player, Custom String("이미 은행 예금이 마이너스입니다"));
					Wait(2, Ignore Condition);
					Small Message(Event Player, Custom String("돈을 갚은 후 대출이 가능합니다"));
				End;
			End;
		End;
	}
}

rule("상호작용V")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Melee)) == True;
		Event Player.gamock == 0;
		Hero(레킹볼) != Hero Of(Event Player);
		Is Alive(Event Player) == True;
	}

	action
	{
		If(Distance Between(Event Player, Global.jp[35]) <= 2 && Event Player.C[11] == 0);
			If(Event Player.name[1] - 1 >= 0 && Event Player.name[1] - 1 < Count Of(Global.C[4])
				&& Event Player.A >= Global.C[4][Event Player.name[1] - 1] && Hero Of(Event Player) != Global.C[5][Event Player.name[1] - 1]);
				Start Forcing Player To Be Hero(Event Player, Global.C[5][Event Player.name[1] - 1]);
				Set Ability 1 Enabled(Event Player, False);
				Event Player.A -= Global.C[4][Event Player.name[1] - 1];
				Global.F[4].B += Global.C[4][Event Player.name[1] - 1] * 10 / 11;
				Global.F[4].taxAmount += Global.C[4][Event Player.name[1] - 1] * 10 / 11 * Global.T;
				Global.Tax += Global.C[4][Event Player.name[1] - 1] / 11;
				Wait(0.250, Ignore Condition);
				Small Message(Event Player, Custom String("{0}를 구매하였습니다 (-{1}만 원)", Global.C[3][Event Player.name[1] - 1],
					Global.C[4][Event Player.name[1] - 1]));
				Play Effect(Event Player, Bad Pickup Effect, Color(Lime Green), Event Player, 5);
			End;
		Else If(Event Player.R[13] == True);
			Event Player.R[13] = False;
			Event Player.R[15] = True;
			Event Player.players = Filtered Array(All Players(All Teams), Current Array Element != Event Player);
			Wait(0.100, Ignore Condition);
			Event Player.name[0] = Custom String("-------------------\r\n{0}{1}님에게 송금 {2}", Hero Icon String(Hero Of(
				Event Player.players[Event Player.targetIndex])), Event Player.players[Event Player.targetIndex], Custom String(
				"{0}만 원\r\n-------------------\r\n[좌/우클릭] 송금액 +-\r\n[E/V] 플레이어 목록 앞/뒤\r\n[F] 송금하기\r\n-------------------\r\n[점프] 닫기\r\n",
				Event Player.moneyjp));
		Else If(Event Player.R[15] == True);
			Event Player.targetIndex = (Event Player.targetIndex - 1 + Count Of(Event Player.players)) % Count Of(Event Player.players);
			Wait(0.100, Ignore Condition);
			Event Player.name[0] = Custom String("-------------------\r\n{0}{1}님에게 송금 {2}", Hero Icon String(Hero Of(
				Event Player.players[Event Player.targetIndex])), Event Player.players[Event Player.targetIndex], Custom String(
				"{0}만 원\r\n-------------------\r\n[좌/우클릭] 송금액 +-\r\n[E/V] 플레이어 목록 앞/뒤\r\n[F] 송금하기\r\n-------------------\r\n[점프] 닫기\r\n",
				Event Player.moneyjp));
		Else If(Distance Between(Event Player, Global.jp[16]) <= 2 || Distance Between(Event Player, Global.jp[17])
				<= 2 || Distance Between(Event Player, Global.jp[18]) <= 2 || Distance Between(Event Player, Global.jp[19]) <= 2);
			Event Player.A -= Global.P[12];
			Global.Tax += Global.P[12] * 1 / 11;
			Small Message(Event Player, Custom String("{0}으로 이동 중...", Global.Position[3][Event Player.name[1]]));
			Event Player.R[11] = False;
			Wait(1, Ignore Condition);
			Teleport(Event Player, Global.jp[Event Player.name[1] + 16]);
			Small Message(Event Player, Custom String("{0}에 하차하였습니다!", Global.Position[3][Event Player.name[1]]));
			Set Move Speed(Event Player, 100);
			Wait(0.050, Ignore Condition);
			Event Player.name[0] = Custom String("");
			Event Player.name[1] = 0;
		Else If(Distance Between(Event Player, Global.jp[20]) <= 1.200 || Distance Between(Event Player, Global.jp[21])
				<= 1.200 || Distance Between(Event Player, Global.jp[22]) <= 1.200 || Distance Between(Event Player, Global.jp[23]) <= 1.200);
			Event Player.A -= Global.P[13];
			Global.Tax += Global.P[13] * 1 / 11;
			Event Player.R[11] = False;
			Teleport(Event Player, Global.Position[5][Event Player.name[1]]);
			Small Message(Event Player, Custom String("{0}에 하차하였습니다!", Global.Position[4][Event Player.name[1]]));
			Set Move Speed(Event Player, 100);
			Wait(0.050, Ignore Condition);
			Event Player.name[0] = Custom String("");
			Event Player.name[1] = 0;
		End;
		If(Event Player.name[1] == 1);
			For Player Variable(Event Player, level, 0, Count Of(Global.Position[6]), 1);
				If(Distance Between(Event Player, Global.Position[6][Event Player.level])
					<= 1 && Event Player.F[Event Player.level + 3] == 1 && Global.S[Event Player.level + 3] > Global.C[10][Event Player.level]);
					If(Is Button Held(Event Player, Button(Crouch)));
						Global.S[Event Player.level + 3] -= 100;
						Event Player.A += 100;
						Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
						Wait(0.100, Ignore Condition);
						Loop If Condition Is True;
					End;
					Global.S[Event Player.level + 3] -= 100;
					Event Player.A += 100;
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
			If(Event Player.R[4] == True && Event Player.F[10] == 1 && Event Player.A >= 100);
				Global.S[10] += 100;
				Event Player.A -= 100;
				Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
			End;
		Else If(Event Player.name[1] == 2);
			For Player Variable(Event Player, level, 0, 7, 1);
				If(Distance Between(Event Player, Global.Position[6][Event Player.level])
					<= 1 && Event Player.F[Event Player.level + 3] == 1 && Global.A[Event Player.level + 13] > Global.A[0]);
					If(Is Button Held(Event Player, Button(Crouch)));
						Global.A[Event Player.level + 13] -= 1;
						Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
						Wait(0.100, Ignore Condition);
						Loop If Condition Is True;
					End;
					Global.A[Event Player.level + 13] -= 1;
					Event Player.B[1] = Global.A[Event Player.level + 13];
					Event Player.B[2] = Global.Position[2][Event Player.level];
					Wait(0.020, Ignore Condition);
					Small Message(Event Player, Custom String("급여를 내렸다 | {1} 알바 급여 {0}만 원", Event Player.B[1], Event Player.B[2]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
		Else If(Event Player.name[1] == 3);
			If(Distance Between(Event Player, Global.jp[30]) <= 1);
				If(Event Player.F[3] == 1 && Global.P[1] >= 1);
					Global.P[1] -= 1;
					Wait(0.250, Ignore Condition);
					Small Message(Event Player, Custom String("가격을 내렸다 | 계란빵 가격 {0}만 원", Global.P[1]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
			"옷가게"
			If(Distance Between(Event Player, Global.jp[33]) <= 1);
				If(Event Player.F[4] == 1 && Global.P[10] >= 1);
					Global.P[10] -= 1;
					Wait(0.250, Ignore Condition);
					Small Message(Event Player, Custom String("가격을 내렸다 | 가방 가격 {0}만 원", Global.P[10]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
			"헬스장"
			If(Distance Between(Event Player, Global.jp[44]) <= 1);
				If(Event Player.F[7] == 1 && Global.P[5] >= 1);
					Global.P[5] -= 1;
					Wait(0.250, Ignore Condition);
					Small Message(Event Player, Custom String("가격을 내렸다 | PT회비 {0}만 원", Global.P[5]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
			"술집"
			If(Distance Between(Event Player, Global.jp[37]) <= 1);
				If(Event Player.F[5] == 1 && Global.P[3] >= 1);
					Global.P[3] -= 1;
					Wait(0.250, Ignore Condition);
					Small Message(Event Player, Custom String("가격을 내렸다 | 칵테일 가격 {0}만 원", Global.P[3]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
			"도서관"
			If(Distance Between(Event Player, Global.jp[41]) <= 1);
				If(Event Player.F[6] == 1 && Global.P[9] >= 1);
					Global.P[9] -= 1;
					Wait(0.250, Ignore Condition);
					Small Message(Event Player, Custom String("가격을 내렸다 | 입장료 가격 {0}만 원", Global.P[9]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
			"호텔"
			If(Distance Between(Event Player, Global.jp[48]) <= 1);
				If(Event Player.F[8] == 1 && Global.P[7] >= 1);
					Global.P[7] -= 1;
					Wait(0.250, Ignore Condition);
					Small Message(Event Player, Custom String("가격을 내렸다 | 호텔 숙박 가격 {0}만 원", Global.P[7]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
			If(Distance Between(Event Player, Global.jp[52]) <= 1);
				If(Event Player.F[9] == 1 && Global.P[11] >= 1);
					Global.P[11] -= 1;
					Wait(0.250, Ignore Condition);
					Small Message(Event Player, Custom String("가격을 내렸다 | 아메리카노 가격 {0}만 원", Global.P[11]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
		Else If(Event Player.name[1] == 4);
			If(Distance Between(Event Player, Global.jp[30]) <= 1);
				If(Event Player.F[3] == 1 && Global.P[2] >= 1);
					Global.P[2] -= 1;
					Wait(0.250, Ignore Condition);
					Small Message(Event Player, Custom String("가격을 내렸다 | 간장계란밥 가격 {0}만 원", Global.P[2]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
			If(Distance Between(Event Player, Global.jp[37]) <= 3);
				If(Event Player.F[5] == 1 && Global.P[4] >= 1);
					Global.P[4] -= 1;
					Wait(0.250, Ignore Condition);
					Small Message(Event Player, Custom String("가격을 내렸다 | 장어 가격 {0}만 원", Global.P[4]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
			If(Distance Between(Event Player, Global.jp[52]) <= 1);
				If(Event Player.F[9] == 1 && Global.P[15] >= 1);
					Global.P[15] -= 1;
					Wait(0.250, Ignore Condition);
					Small Message(Event Player, Custom String("가격을 내렸다 | 샌드위치 가격 {0}만 원", Global.P[15]));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
				End;
			End;
		End;
		Event Player.NearPos = First Of(Sorted Array(Global.Position[1], Distance Between(Position Of(Event Player),
			Current Array Element)));
		Abort If(Distance Between(Position Of(Event Player), Event Player.NearPos) > 1);
		Event Player.PositionIndex = Index Of Array Value(Global.Position[1], Event Player.NearPos);
		Event Player.R[3] = Event Player.PositionIndex + 3;
		Abort If(Global.C[11] == 1);
		Abort If(Global.F[Event Player.R[3]] == Event Player);
		If(Event Player.A < Global.S[Event Player.R[3]]);
			Call Subroutine(empty_money);
			Abort;
		End;
		If(Global.B[2] == 1 && Count Of(Filtered Array(Global.F, Current Array Index >= 3 && Current Array Element == Event Player)) >= 1);
			Small Message(Event Player, Custom String("다건물주 규제 정책으로 인해 최대 1개의 건물만 소유할 수 있습니다"));
			Abort;
		End;
		Event Player.A -= Global.S[Event Player.R[3]];
		Global.F[Event Player.R[3]].B += Global.S[Event Player.R[3]];
		Event Player.H[0] = Custom String("{0} 주인", Global.Position[2][Event Player.PositionIndex]);
		Small Message(Event Player, Custom String("{0}를 인수했습니다!", Global.Position[2][Event Player.PositionIndex]));
		Big Message(All Players(All Teams), Custom String("{1} {0} 인수", Global.Position[2][Event Player.PositionIndex], Event Player));
		Global.F[Event Player.R[3]] = Event Player;
		All Players(All Teams).F[Event Player.R[3]] = 0;
		Event Player.F[Event Player.R[3]] = 1;
	}
}

rule("상호작용P")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Primary Fire)) == True;
		Hero(레킹볼) != Hero Of(Event Player);
		Is Alive(Event Player) == True;
	}

	action
	{
		If(Distance Between(Event Player, Global.jp[7]) <= 4);
			If(Event Player.Tax == 1);
				Call Subroutine(tax);
			End;
		Else If(Distance Between(Event Player, Global.jp[6]) <= 2);
			Set Status(Event Player, Null, Rooted, 9999);
			Set Status(Event Player, Null, Phased Out, 9999);
			Set Invisible(Event Player, All);
			Start Camera(Event Player, Vector(-34, 100, -20), Vector(-34, 10, -21), 0);
			Small Message(Event Player, Custom String("안녕하세요 {0} 국민님, 튜토리얼을 진행하겠습니다", Event Player));
			Wait(3, Ignore Condition);
			Start Camera(Event Player, Vector(68.090, 10, -3.450), Vector(70.760, 9, -6.250), 0);
			Small Message(Event Player, Custom String("다양한 일을 통해 돈을 벌 수 있습니다"));
			Wait(2, Ignore Condition);
			Start Camera(Event Player, Vector(18.700, 7, -13.620), Vector(22.310, 5, -17.640), 0);
			Wait(2, Ignore Condition);
			Start Camera(Event Player, Vector(-7.580, 2, 11.750), Vector(-12.340, 0.500, 8.340), 0);
			Small Message(Event Player, Custom String("스마트폰에서 잡코리아를 열어 여러 일자리의 급여를 한눈에 확인할 수 있습니다"));
			Wait(2, Ignore Condition);
			Start Camera(Event Player, Vector(-47.630, 14, -26.100), Vector(-47.630, 12, -20.280), 0);
			Wait(2, Ignore Condition);
			Start Camera(Event Player, Vector(-18.500, 8, -14.870), Vector(-22.960, 6, -18.610), 0);
			Wait(2, Ignore Condition);
			Start Camera(Event Player, Vector(-62.550, 5, -11.810), Vector(-54.940, 2.500, -13.070), 0);
			Wait(2, Ignore Condition);
			Start Camera(Event Player, Vector(62.600, 10, -19.180), Vector(52.310, 10.500, -18.660), 0);
			Small Message(Event Player, Custom String("호텔 입니다. 기력을 충전하실 수 있습니다"));
			Wait(2, Ignore Condition);
			Start Camera(Event Player, Vector(48.450, 14, -20.150), Vector(48.170, 12, -23.470), 10);
			Wait(3, Ignore Condition);
			Start Camera(Event Player, Vector(33.410, 6, -18.760), Vector(43.480, 4, -18.530), 0);
			Small Message(Event Player, Custom String("에그 하우스 입니다. 음식을 구매하여 인벤토리에 저장할 수 있습니다"));
			Wait(2, Ignore Condition);
			Start Camera(Event Player, Vector(63.390, 4, -6.480), Vector(58.020, 2.300, -6.600), 10);
			Wait(4, Ignore Condition);
			Start Camera(Event Player, Vector(-29.760, 6, -19.640), Vector(-40.900, 5, -18.980), 0);
			Small Message(Event Player, Custom String("술집 입니다. 칵테일이나 음식을 먹을 수 있습니다"));
			Wait(2, Ignore Condition);
			Start Camera(Event Player, Vector(-62.270, 4, -8.660), Vector(57.430, 2.500, -8.760), 10);
			Wait(4, Ignore Condition);
			Start Camera(Event Player, Vector(-39.110, 7, -16.570), Vector(-28.610, 4, -16.170), 0);
			Small Message(Event Player, Custom String("헬스장 입니다. 최대 기력을 올릴 수 있습니다"));
			Wait(2, Ignore Condition);
			Start Camera(Event Player, Vector(-25.300, 7.160, -19.550), Vector(-19.190, 6, -15.320), 10);
			Wait(3, Ignore Condition);
			Start Camera(Event Player, Vector(-58.330, 10, -9.040), Vector(-58.580, 8.500, -2.960), 0);
			Small Message(Event Player, Custom String("맵 곳곳에 배치된 ATM을 통해 은행 예금 관리 및 로또를 구매할 수 있습니다"));
			Wait(2, Ignore Condition);
			Start Camera(Event Player, Vector(10.480, 3, -29.690), Vector(7.630, 2, -32.800), 0);
			Wait(2, Ignore Condition);
			Start Camera(Event Player, Vector(56.380, 11, -10.870), Vector(57.400, 7.900, -4), 0);
			Wait(3, Ignore Condition);
			Start Camera(Event Player, Vector(-74.200, 10, -25.060), Vector(-77.890, 12, -24.980), 0);
			Small Message(Event Player, Custom String("경찰서 입니다. 범죄자를 잡고 평화를 꿈꾸신다면 여기로"));
			Wait(4, Ignore Condition);
			Start Camera(Event Player, Vector(6.510, 6.500, 19.890), Vector(0.520, 7.500, 24.790), 0);
			Small Message(Event Player, Custom String("선거를 통해 헬조선을 통치하는 대통령이 될 수도 있습니다"));
			Wait(3, Ignore Condition);
			Small Message(Event Player, Custom String("대통령 선거는 1억 원의 선거자금만 낸다면 누구나 출마할 수 있습니다"));
			Wait(3, Ignore Condition);
			Small Message(Event Player, Custom String("대통령 출마 시 (명성도/10)%의 당선 확률을 가지고 투표를 시작합니다"));
			Wait(4, Ignore Condition);
			Small Message(Event Player, Custom String("이후 국민들의 찬성/반대에 따라 기본 확률에서 명당 +-2%씩 당선 확률이 변합니다"));
			Wait(4, Ignore Condition);
			Small Message(Event Player, Custom String("명성도, 국민들의 지지도 중요하겠죠?"));
			Wait(3, Ignore Condition);
			Start Camera(Event Player, Vector(-11.820, 6, 28.450), Vector(-8, 4.500, 30.710), 0);
			Small Message(Event Player, Custom String("자원봉사나 재정 지원을 통해 명성을 올릴 수 있으며"));
			Wait(3, Ignore Condition);
			Start Camera(Event Player, Vector(11.300, 6, 22.800), Vector(12.410, 6, 22.800), 0);
			Small Message(Event Player, Custom String("다른 플레이어에게 가까이 멈춰 서서"));
			Wait(2.500, Ignore Condition);
			Small Message(Event Player, Custom String("인사를 하여도 명성치를 올려줄 수 있습니다"));
			Wait(3, Ignore Condition);
			Start Camera(Event Player, Vector(-8.320, 3, 15.160), Vector(-4.570, 1.500, 13.070), 0);
			Small Message(Event Player, Custom String("10분마다 세금을 걷으니 꼭 납부하세요. 체납 시 구속될 수 있습니다"));
			Wait(2.500, Ignore Condition);
			Small Message(Event Player, Custom String("소개해드린 것 외에도 많은 것이 있으니 재미있게 즐겨주세요!"));
			Wait(2.500, Ignore Condition);
			Small Message(Event Player, Custom String("Make By 레비 REBI"));
			Set Move Speed(Event Player, 100);
			Start Camera(Event Player, Ray Cast Hit Position(Event Player, Event Player + World Vector Of(Vector(0, 0, 0), Event Player,
				Rotation) + Up * 1.800 + Facing Direction Of(Event Player) * -2.800, Null, Event Player, True),
				Event Player + Facing Direction Of(Event Player) * 1000, 60);
			Set Invisible(Event Player, None);
			Clear Status(Event Player, Phased Out);
			Clear Status(Event Player, Rooted);
			Stop Forcing Player Position(Event Player);
			Wait(1, Ignore Condition);
			Event Player.S[3] += 3;
			Small Message(Event Player, Custom String("튜토리얼 완료 보상을 받았다 [샌드위치 +3개]"));
			Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
		Else If(Distance Between(Event Player, Global.jp[24]) <= 1.200 || Distance Between(Event Player, Global.jp[25])
				<= 1.200 || Distance Between(Event Player, Global.jp[26]) <= 1.200);
			If(Event Player.R[11] == False);
				Event Player.R[11] = True;
				Set Move Speed(Event Player, 0);
				For Player Variable(Event Player, level, 0, Count Of(Global.Position[7]), 1);
					Event Player.name[3 + Event Player.level] = Event Player.level == Event Player.name[1] ? Custom String("• {0} ◀\r\n",
						Global.Position[7][Event Player.level]) : Custom String("• {0}\r\n", Global.Position[7][Event Player.level]);
				End;
				Event Player.name[0] = Custom String("------------------\r\nATM\r\n------------------\r\n{0}{1}{2}", Event Player.name[3],
					Event Player.name[4], Custom String("{0}{1}", Event Player.name[5], Custom String(
					"------------------\r\n[W] ↑\r\n[S] ↓\r\n[좌클] 확인\r\n[점프] 닫기")));
			Else If(Event Player.R[11] == True);
				If(Event Player.R[12] == False);
					Event Player.R[12] = True;
					If(Event Player.name[1] == 0 || Event Player.name[1] == 1);
						For Player Variable(Event Player, level, 0, Count Of(Global.Position[8]), 1);
							Event Player.name[3 + Event Player.level] = Event Player.level == Event Player.name[2] ? Custom String("• {0} ◀\r\n",
								Global.Position[8][Event Player.level]) : Custom String("• {0}\r\n", Global.Position[8][Event Player.level]);
						End;
						Event Player.name[0] = Event Player.name[1] == 0 ? Custom String("------------------\r\n입금\r\n------------------\r\n{0}{1}{2}",
							Event Player.name[3], Event Player.name[4], Custom String("{0}{1}{2}", Event Player.name[5], Event Player.name[6],
							Custom String("{0}------------------\r\n[W] ↑\r\n[S] ↓\r\n[좌클] 확인\r\n[점프] 닫기", Event Player.name[7]))) : Custom String(
							"------------------\r\n출금\r\n------------------\r\n{0}{1}{2}", Event Player.name[3], Event Player.name[4], Custom String(
							"{0}{1}{2}", Event Player.name[5], Event Player.name[6], Custom String(
							"{0}------------------\r\n[W] ↑\r\n[S] ↓\r\n[좌클] 확인\r\n[점프] 닫기", Event Player.name[7])));
					Else If(Event Player.name[1] == 2);
						Event Player.name[0] = Custom String("------------------\r\n로또 1/9999\r\n------------------\r\n• 구매 ◀\r\n{0}", Custom String(
							"------------------\r\n[W] ↑\r\n[S] ↓\r\n[좌클] 확인\r\n[점프] 닫기"));
					End;
				Else If(Event Player.R[12] == True);
					If(Event Player.name[1] == 0);
						If(Event Player.name[2] == 0 && Event Player.A >= 1);
							Event Player.A -= 1;
							Event Player.B += 1;
							Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
						Else If(Event Player.name[2] == 1 && Event Player.A >= 10);
							Event Player.A -= 10;
							Event Player.B += 10;
							Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
						Else If(Event Player.name[2] == 2 && Event Player.A >= 100);
							Event Player.A -= 100;
							Event Player.B += 100;
							Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
						Else If(Event Player.name[2] == 3 && Event Player.A >= 1000);
							Event Player.A -= 1000;
							Event Player.B += 1000;
							Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
						Else If(Event Player.name[2] == 4 && Event Player.A > 0);
							Small Message(Event Player, Custom String("{0}만 원 입금", Event Player.A));
							Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
							Wait(0.016, Ignore Condition);
							Event Player.B += Event Player.A;
							Event Player.A = 0;
						End;
					Else If(Event Player.name[1] == 1);
						If(Event Player.name[2] == 0 && Event Player.B >= 1);
							Event Player.B -= 1;
							Event Player.A += 1;
							Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
						Else If(Event Player.name[2] == 1 && Event Player.B >= 10);
							Event Player.B -= 10;
							Event Player.A += 10;
							Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
						Else If(Event Player.name[2] == 2 && Event Player.B >= 100);
							Event Player.B -= 100;
							Event Player.A += 100;
							Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
						Else If(Event Player.name[2] == 3 && Event Player.B >= 1000);
							Event Player.B -= 1000;
							Event Player.A += 1000;
							Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
						Else If(Event Player.name[2] == 4 && Event Player.B > 0);
							Small Message(Event Player, Custom String("{0}만 원 출금", Event Player.B));
							Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
							Wait(0.016, Ignore Condition);
							Event Player.A += Event Player.B;
							Event Player.B = 0;
						End;
					Else If(Event Player.name[1] == 2);
						Call Subroutine(lotto);
					End;
				End;
			End;
		Else If(Distance Between(Event Player, Global.jp[8]) <= 1.500);
			Abort If(Event Player.C[11] != 3);
			If(Event Player.R[11] == False);
				Event Player.R[11] = True;
				Set Move Speed(Event Player, 0);
				Event Player.name[0] = Custom String(
					"------------------\r\n헬조선 관리하기\r\n------------------\r\n• 세율 ◀\r\n• 최저 임금\r\n• 민생회복지원금 정책{0}{1}", Custom String(
					"\r\n• 정착 지원금 정책\r\n• 보이스피싱 방지 정책\r\n• 다건물주 규제 정책\r\n• 하야하기\r\n"), Custom String(
					"------------------\r\n[W] ↑\r\n[S] ↓\r\n[좌클] 확인\r\n[점프] 닫기"));
			Else If(Event Player.R[11] == True);
				If(Event Player.R[12] == False);
					If(Event Player.name[1] <= 1);
						For Player Variable(Event Player, level, 0, Count Of(Global.Position[10]), 1);
							Event Player.name[3 + Event Player.level] = Event Player.level == Event Player.name[2] ? Custom String("• {0} ◀\r\n",
								Global.Position[10][Event Player.level]) : Custom String("• {0}\r\n", Global.Position[10][Event Player.level]);
						End;
						Event Player.name[0] = Event Player.name[1] == 0 ? Custom String(
							"------------------\r\n세율 [최대 30%]\r\n------------------\r\n{0}{1}{2}", Event Player.name[3], Event Player.name[4],
							Custom String("------------------\r\n[W] ↑\r\n[S] ↓\r\n[좌클] 확인\r\n[점프] 닫기")) : Custom String(
							"------------------\r\n최저 임금 [인상 시 재정 5천만 원 소요]\r\n------------------\r\n{0}{1}{2}", Event Player.name[3],
							Event Player.name[4], Custom String("------------------\r\n[W] ↑\r\n[S] ↓\r\n[좌클] 확인\r\n[점프] 닫기"));
					Else If(Event Player.name[1] >= 2);
						Event Player.name[0] = Custom String("{0}{1}", Event Player.name[1] == 2 ? Custom String(
							"------------------\r\n민생회복지원금 정책 [재정 6천만 원 소요]\r\n------------------\r\n• 실시 ◀\r\n") : (
							Event Player.name[1] == 3 ? Custom String(
							"------------------\r\n정착 지원금 정책 [회당 3백만 원 소요]\r\n------------------\r\n• 활성화/비활성화 ◀\r\n") : (
							Event Player.name[1] == 4 ? Custom String(
							"------------------\r\n보이스피싱 방지 정책 [재정 4천만 원 소요]\r\n------------------\r\n• 실시 ◀\r\n") : (
							Event Player.name[1] == 5 ? Custom String("------------------\r\n다건물주 규제 정책 [재정 5천만 원 소요]\r\n------------------\r\n• 실시 ◀\r\n")
							: Custom String("------------------\r\n정말 하야하시겠습니까?\r\n------------------\r\n• 하야하기 ◀\r\n")))), Custom String(
							"------------------\r\n[W] ↑\r\n[S] ↓\r\n[좌클] 확인\r\n[점프] 닫기"));
					End;
					Wait(0.050, Ignore Condition);
					Event Player.R[12] = True;
				Else If(Event Player.R[12] == True && Global.O[0] == False);
					If(Event Player.name[1] == 0);
						If(Event Player.name[2] == 0 && Global.T <= 0.290);
							Global.T += 0.010;
							Event Player.ms[1] -= 10;
							If(Event Player.ms[1] <= 0);
								Event Player.ms[1] = 0 - Event Player.ms[1];
								Event Player.ms[0] = Custom String("악명");
							End;
							Wait(0.100, Ignore Condition);
							Small Message(All Players(All Teams), Custom String("세율 인상 [세율: {0}%]", Global.T * 100));
						Else If(Event Player.name[2] == 1 && Global.T >= 0.060);
							Global.T -= 0.010;
							Event Player.ms[1] += 10;
							Wait(0.100, Ignore Condition);
							Small Message(All Players(All Teams), Custom String("세율 인하 [세율: {0}%]", Global.T * 100));
						End;
						Play Effect(All Players(All Teams), Buff Impact Sound, Color(흰색), Event Player, 300);
					Else If(Event Player.name[1] == 1);
						If(Event Player.name[2] == 0 && Global.A[0] < 15);
							Global.A[0] += 1;
							Wait(0.100, Ignore Condition);
							Global.Tax -= 5000;
							Event Player.ms[1] += 10;
							Big Message(All Players(All Teams), Custom String("최저 임금 인상 [{0}만 원]", Global.A[0]));
						Else If(Event Player.name[2] == 1 && Global.A[0] > 5);
							Global.A[0] -= 1;
							Wait(0.100, Ignore Condition);
							Event Player.ms[1] -= 10;
							If(Event Player.ms[1] <= 0);
								Event Player.ms[1] = 0 - Event Player.ms[1];
								Event Player.ms[0] = Custom String("악명");
							End;
							Big Message(All Players(All Teams), Custom String("최저 임금 인하 [{0}만 원]", Global.A[0]));
						End;
						Play Effect(All Players(All Teams), Buff Impact Sound, Color(흰색), Event Player, 300);
					Else If(Event Player.name[1] == 2 && Global.Tax >= 1);
						Big Message(All Players(All Teams), Custom String("{0} 대통령이 민생회복지원금 정책을 실시했습니다!", Event Player));
						Big Message(All Players(All Teams), Custom String("모든 국민에게 100만 원의 민생회복지원금이 지급됩니다", Event Player));
						Global.Tax -= 6000;
						All Players(All Teams).A += 100;
						Event Player.ms[1] += 20;
					Else If(Event Player.name[1] == 3);
						If(Global.B[1] == 1);
							Big Message(All Players(All Teams), Custom String("{0} 대통령이 정착 지원금 정책을 중단했습니다!", Event Player));
							Global.B[1] = 0;
						Else;
							Big Message(All Players(All Teams), Custom String("{0} 대통령이 정착 지원금 정책을 실시했습니다!", Event Player));
							Event Player.ms[1] += 20;
							Big Message(All Players(All Teams), Custom String("지금부터 새로운 플레이어에게 정착 지원금 3백만 원이 지원됩니다!", Event Player));
							Global.B[1] = 1;
						End;
					Else If(Event Player.name[1] == 5);
						If(Global.B[2] == 1);
							Global.B[2] = 0;
							Big Message(All Players(All Teams), Custom String("{0} 대통령이 다건물주 규제 정책을 중단했습니다!", Event Player));
						Else;
							Global.B[2] = 1;
							Global.Tax -= 5000;
							Big Message(All Players(All Teams), Custom String("{0} 대통령이 다건물주 규제 정책을 실시했습니다!", Event Player));
							Big Message(All Players(All Teams), Custom String("최대 1개의 건물을 소유할 수 있습니다"));
							Big Message(All Players(All Teams), Custom String("2개 이상의 건물을 소유한 플레이어에겐 추가 세금이 부과됩니다"));
						End;
					Else If(Event Player.name[1] == 6);
						Event Player.R[3] = Max(100, Event Player.C[10] - 1000);
						Wait(0.020, Ignore Condition);
						Event Player.C[10] = Event Player.R[3];
						Destroy HUD Text(Event Player.text[2]);
						Event Player.timer[2] = 0;
						Event Player.C[11] = 0;
						Global.Presi = 0;
						Global.B[1] = 0;
						Start Forcing Player To Be Hero(Event Player, Event Player.E[0]);
						Wait(0.250, Ignore Condition);
						Event Player.H[0] = Custom String("하야한 대통령");
						Global.F[1] = Custom String("");
						Big Message(All Players(All Teams), Custom String("{0} 대통령이 하야하였습니다", Event Player));
						Small Message(Event Player, Custom String("대통령직에서 하야하였다"));
						Play Effect(All Players(All Teams), Buff Impact Sound, Color(흰색), Event Player, 300);
					End;
				End;
			End;
		Else If(Distance Between(Event Player, Global.jp[16]) <= 2 || Distance Between(Event Player, Global.jp[17])
				<= 2 || Distance Between(Event Player, Global.jp[18]) <= 2 || Distance Between(Event Player, Global.jp[19]) <= 2);
			If(Event Player.A < Global.P[12]);
				Call Subroutine(empty_money);
				Abort;
			End;
			Event Player.R[11] = True;
			Set Move Speed(Event Player, 0);
			Event Player.name[5] = Custom String("");
			For Player Variable(Event Player, level, 0, Count Of(Global.Position[3]), 1);
				Event Player.name[5 + Event Player.level] = Event Player.level == Event Player.name[1] ? Custom String("• {0} ◀\r\n",
					Global.Position[3][Event Player.level]) : Custom String("• {0}\r\n", Global.Position[3][Event Player.level]);
			End;
			Event Player.name[0] = Custom String("------------------\r\n버스 [가격: 1만 원]\r\n------------------\r\n{0}{1}{2}",
				Event Player.name[5], Event Player.name[6], Custom String("{0}{1}{2}", Event Player.name[7], Event Player.name[8],
				Custom String("------------------\r\n[W] ↑\r\n[S] ↓\r\n[V] 하차\r\n[점프] 닫기")));
		Else If(Distance Between(Event Player, Global.jp[20]) <= 1.200 || Distance Between(Event Player, Global.jp[21])
				<= 1.200 || Distance Between(Event Player, Global.jp[22]) <= 1.200 || Distance Between(Event Player, Global.jp[23]) <= 1.200);
			If(Event Player.A < Global.P[13]);
				Call Subroutine(empty_money);
				Abort;
			End;
			Event Player.R[11] = True;
			Set Move Speed(Event Player, 0);
			Event Player.name[5] = Custom String("");
			For Player Variable(Event Player, level, 0, Count Of(Global.Position[4]), 1);
				Event Player.name[2 + Event Player.level] = Event Player.level == Event Player.name[1] ? Custom String("{0} ◀",
					Global.Position[4][Event Player.level]) : Custom String("{0}", Global.Position[4][Event Player.level]);
			End;
			Event Player.name[0] = Custom String("------------------\r\n택시 [가격: 2만 원]\r\n------------------\r\n{0}   {1}  \r\n{2}",
				Event Player.name[2], Event Player.name[3], Custom String("{0}   {1}  \r\n{2}", Event Player.name[4], Event Player.name[5],
				Custom String("{0}     {1}  \r\n{2}", Event Player.name[6], Event Player.name[7], Custom String("{0}     {1}  \r\n{2}",
				Event Player.name[8], Event Player.name[9], Custom String("{0}   {1}  \r\n{2}", Event Player.name[10], Event Player.name[11],
				Custom String("{0}   {1}  \r\n{2}", Event Player.name[12], Event Player.name[13], Custom String(
				"------------------\r\n[W] ↑\r\n[S] ↓\r\n[V] 하차\r\n[점프] 닫기")))))));
		End;
		If(Event Player.R[15] == True);
			Event Player.moneyjp += 10;
			Wait(0.100, Ignore Condition);
			Event Player.name[0] = Custom String("-------------------\r\n{0}{1}님에게 송금 {2}", Hero Icon String(Hero Of(
				Event Player.players[Event Player.targetIndex])), Event Player.players[Event Player.targetIndex], Custom String(
				"{0}만 원\r\n-------------------\r\n[좌/우클릭] 송금액 +-\r\n[E/V] 플레이어 목록 앞/뒤\r\n[F] 송금하기\r\n-------------------\r\n[점프] 닫기\r\n",
				Event Player.moneyjp));
		End;
	}
}

rule("상호작용P")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Primary Fire)) == True;
		Hero(레킹볼) != Hero Of(Event Player);
		Is Alive(Event Player) == True;
	}

	action
	{
		If(Distance Between(Event Player, Global.jp[9]) <= 3.500);
			If(Event Player.R[11] == False);
				Event Player.R[11] = True;
				Set Move Speed(Event Player, 0);
				For Player Variable(Event Player, level, 0, Count Of(Global.C[7]), 1);
					Event Player.name[2 + Event Player.level] = Event Player.level == Event Player.name[1] ? Custom String("• {0} ◀\r\n",
						Global.C[7][Event Player.level]) : Custom String("• {0}\r\n", Global.C[7][Event Player.level]);
				End;
				Event Player.name[0] = Custom String("------------------\r\n시험 [응시료: {0}만 원]\r\n------------------\r\n{1}{2}", Global.P[21],
					Event Player.name[2], Custom String("{0}{1}{2}", Event Player.name[3], Event Player.name[4], Custom String("{0}{1}{2}",
					Event Player.name[5], Event Player.name[6], Custom String("{0}{1}{2}", Event Player.name[7], Event Player.name[8],
					Custom String("{0}------------------\r\n[W] ↑\r\n[S] ↓\r\n[좌클릭] 응시\r\n[점프] 닫기", Event Player.name[9])))));
			Else If(Event Player.R[11] == True);
				If(Event Player.R[12] == False);
					Event Player.name[0] = Custom String("{0}{1}", Event Player.name[1] == 0 ? Custom String(
						"------------------\r\n검정고시\r\n- 경찰이 되기 위해 필요\r\n------------------\r\n• 응시 ◀\r\n") : (
						Event Player.name[1] == 1 ? Custom String(
						"------------------\r\n생활 스포츠 지도사\r\n- 헬스 트레이너가 되기 위해 필요\r\n------------------\r\n• 응시 ◀\r\n") : (
						Event Player.name[1] == 2 ? Custom String(
