	action
	{
		Small Message(Event Player, Custom String("벽이 허술해 보인다. 탈옥의 희망이 보인다."));
		Wait(1, Ignore Condition);
		Small Message(Event Player, Custom String("벽을 주먹으로 계속 치면 탈옥 할 수도 있습니다"));
		Wait(1, Ignore Condition);
