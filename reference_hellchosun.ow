rule("player")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.gamock == 1;
		Is Button Held(Event Player, Button(Melee)) == True;
		Distance Between(Event Player, Global.jp[4]) <= 3;
	}

	action
	{
		If(Hero Of(Event Player) != Hero(해저드));
			Event Player.J[1] = Random Integer(1, 100);
		Else;
			Event Player.J[1] = Random Integer(1, 50);
		End;
		Event Player.wallsound = Random Integer(1, 5);
		If(Event Player.wallsound == 1);
			Small Message(Event Player, Custom String("퍽! 퍽! 퍽!"));
			Wait(0.250, Ignore Condition);
		Else If(Event Player.wallsound == 2);
			Small Message(Event Player, Custom String("손이 아프다"));
			Wait(0.750, Ignore Condition);
		Else If(Event Player.wallsound == 3);
			Small Message(Event Player, Custom String("벌써 힘들어..ㅠㅠ"));
			Wait(1, Ignore Condition);
		Else If(Event Player.wallsound == 4);
			Small Message(Event Player, Custom String("조금만 더..."));
			Wait(1.250, Ignore Condition);
		Else If(Event Player.wallsound == 5);
			Small Message(Event Player, Custom String("오늘 안에 나갈 수 있을까..?"));
			Wait(1.500, Ignore Condition);
		End;
		If(Event Player.J[1] == 10);
			Set Melee Enabled(Event Player, False);
			Set Status(Event Player, Null, Rooted, 9);
			Event Player.Jobm[1] = Random Integer(1, 10);
			Event Player.J[2] = 1;
			Wait(1.500, Ignore Condition);
			Small Message(Event Player, Custom String("어??"));
			Wait(1.500, Ignore Condition);
			Small Message(Event Player, Custom String("나갈 수 있는 틈이 생겼다"));
			Wait(1.500, Ignore Condition);
			Small Message(Event Player, Custom String("탈옥 시도 중.."));
			Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
			Destroy HUD Text(Event Player.text[4]);
			Wait(5.500, Ignore Condition);
			Event Player.gamock = 0;
			Teleport(Event Player, Event Player.Jobm[1] == 1 ? Vector(-75.420, 8, -46.370) : (Event Player.Jobm[1] == 2 ? Vector(-47.210,
				4.050, -45.860) : (Event Player.Jobm[1] == 3 ? Vector(-17.110, 3, -53.850) : (Event Player.Jobm[1] == 4 ? Vector(-56.220, 2,
				-2.200) : (Event Player.Jobm[1] == 5 ? Vector(39.800, 4, -45.790) : (Event Player.Jobm[1] == 6 ? Vector(57.980, 8, -30.390) : (
				Event Player.Jobm[1] == 7 ? Vector(78.790, 8, -42.670) : (Event Player.Jobm[1] == 8 ? Vector(171.700, 7.900, 53.560) : (
				Event Player.Jobm[1] == 9 ? Vector(172.460, 7.750, -104.550) : Vector(128.380, 9, -23.880))))))))));
			Set Damage Received(Event Player, 0);
			Event Player.ms[1] += 10;
			Event Player.J[1] = 0;
			Event Player.C[9] = 0;
			Event Player.AA = 0;
			Small Message(Event Player, Custom String("교도소 탈옥에 성공했다!"));
			Event Player.C[7] += 1;
			Wait(3, Ignore Condition);
			Small Message(Event Player, Custom String("죗값을 치르지 않고 감옥을 탈옥했다 [악명 +10]"));
		End;
	}
}

rule("player")
{
	event
	{
		Ongoing - Each Player;
		All;
		브리기테;
	}

	action
	{
		While(Event Player.C[11] == 3);
			Wait(360, Ignore Condition);
			Abort If(Event Player.C[11] != 3);
			Event Player.B += Global.A[1];
			Event Player.taxAmount += Global.A[1] * Global.T;
			Global.Tax -= Global.A[1];
			Event Player.ms[1] += 10;
			Small Message(Event Player, Custom String("대통령 월급 {0}만 원이 입금되었습니다", Global.A[1]));
			Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
			Event Player.ms[3] += Min(990 - Event Player.ms[3], Random Integer(1, 20));
		End;
	}
}

rule("player")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.C[11] == 1;
	}

	action
	{
		While(Event Player.C[11] == 1);
			Wait(360, Abort When False);
			Abort If(Event Player.C[11] != 1);
			If(Event Player.P[6] >= 100);
				Event Player.B += Event Player.P[8];
				Event Player.taxAmount += Event Player.P[8] * Global.T;
				Global.Tax -= Event Player.P[8];
				Small Message(Event Player, Custom String("경찰 {0} 계급 월급 {1}만 원이 입금되었습니다 [+ 1호봉]", Event Player.P[4], Event Player.P[8]));
				Event Player.ms[1] += 10;
				Event Player.P[7] += 1;
				Call Subroutine(Police_Salary);
			Else;
				Event Player.B += Round To Integer(Event Player.P[8] * 0.200, To Nearest);
				Event Player.taxAmount += Event Player.P[8] * 0.200 * Global.T;
				Global.Tax -= Round To Integer(Event Player.P[8] * 0.200, To Nearest);
				Small Message(Event Player, Custom String("이번 달 실적이 부족해 경찰 {0} 계급 월급의 20%인 {1}만 원만 입금되었습니다", Event Player.P[4], Round To Integer(
					Event Player.P[8] * 0.200, To Nearest)));
			End;
			Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
			Event Player.ms[3] += Min(990 - Event Player.ms[3], Random Integer(1, 20));
			Event Player.P[6] = 0;
			Call Subroutine(policescore);
		End;
	}
}

rule("player")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.C[11] == 3;
		Event Player.ms[0] == Custom String("악명");
	}

	action
	{
		Set Melee Enabled(Event Player, False);
		Set Ability 1 Enabled(Event Player, False);
		Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
		Big Message(All Players(All Teams), Custom String("대통령 {0}님이 범죄를 저질렀습니다", Event Player));
		Wait(5, Ignore Condition);
		Small Message(All Players(All Teams), Custom String("{0} {1} {2}: 대통령이 범죄를 저질렀다!", Hero Icon String(Hero(메르시)), Hero Icon String(
			Hero(D.Va)), Hero Icon String(Hero(키리코))));
		Wait(5, Ignore Condition);
		Small Message(All Players(All Teams), Custom String("{0} {1} {2}: 하야하라! 하야하라!", Hero Icon String(Hero(메르시)), Hero Icon String(Hero(
			D.Va)), Hero Icon String(Hero(키리코))));
		Wait(5, Ignore Condition);
		Small Message(All Players(All Teams), Custom String("{0} {1} {2}: 촛불의 힘을 보여주자!", Hero Icon String(Hero(메르시)), Hero Icon String(
			Hero(D.Va)), Hero Icon String(Hero(키리코))));
		Wait(5, Ignore Condition);
		Small Message(All Players(All Teams), Custom String("{0}{1}: 여론이 안좋다...", Hero Icon String(Hero(브리기테)), Event Player));
		Wait(10, Ignore Condition);
		If(Event Player.C[11] == 3);
			Event Player.R[3] = Max(100, Event Player.C[10] - 1000);
			Wait(0.020, Ignore Condition);
			Event Player.C[10] = Event Player.R[3];
			Destroy HUD Text(Event Player.text[2]);
			Event Player.timer[2] = 0;
			Event Player.C[11] = 0;
			Global.Presi = 0;
			Global.B[1] = 0;
			Event Player.H[0] = Custom String("탄핵된 대통령");
			Global.F[1] = Custom String("");
			Wait(1, Ignore Condition);
			Big Message(All Players(All Teams), Custom String("대통령 {0}님이 탄핵되었습니다", Event Player));
			Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
			Wait(3, Ignore Condition);
			Event Player.ms[1] = 100;
			Event Player.ms[0] = Custom String("악명");
			Small Message(Event Player, Custom String("대통령에서 탄핵되었다.. [악명 100]"));
			Start Forcing Player To Be Hero(Event Player, Hero(시그마));
		End;
	}
}

rule("player")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.C[11] == 0;
		Event Player.C[7] >= 2;
		Event Player.ms[1] >= 500;
		Event Player.ms[0] == Custom String("악명");
		Is Button Held(Event Player, Button(Interact)) == True;
		Hero Of(Event Player) != Hero(해저드);
		Distance Between(Event Player, Global.jp[108]) <= 1;
	}

	action
	{
		Start Forcing Player To Be Hero(Event Player, Hero(해저드));
		Event Player.H[0] = Custom String("강력 범죄자");
		Wait(1, Ignore Condition);
		Small Message(Event Player, Custom String("히든 조건을 달성하여 해저드로 바꼈습니다. 덤벼들기 스킬을 사용할 수 있습니다"));
		Set Ability 1 Enabled(Event Player, True);
		Wait(1, Ignore Condition);
		Big Message(All Players(All Teams), Custom String("{0}님이 히든 조건을 달성하여 강력 범죄자가 되었습니다", Event Player));
	}
}

rule("player")
{
	event
	{
		Ongoing - Each Player;
		All;
		라인하르트;
	}

	action
	{
		Event Player.timer[2] = 30;
		Create HUD Text(Event Player, Null, Custom String("경찰청장 임기: {0}분 남음", Event Player.timer[2]), Null, Left, 5, Color(흰색), Color(흰색),
			Color(흰색), Visible To and String, Default Visibility);
		Event Player.text[2] = Last Text ID;
		While(Event Player.timer[2] > 0 && Global.F[2] == Event Player);
			Wait(60, Ignore Condition);
			Event Player.timer[2] -= 1;
		End;
		If(Global.F[2] == Event Player);
			Event Player.C[11] = 0;
			Event Player.P[3] = 0;
			Start Forcing Player To Be Hero(Event Player, Hero(오리사));
			Set Melee Enabled(Event Player, False);
			Set Ability 1 Enabled(Event Player, False);
			Wait(0.050, Ignore Condition);
			Event Player.H[0] = Custom String("전 경찰청장");
			Global.F[2] = Custom String("");
			Destroy HUD Text(Event Player.text[2]);
			Big Message(All Players(All Teams), Custom String("{0} 경찰청장이 임기를 마치고 퇴임하였습니다", Event Player));
			Small Message(Event Player, Custom String("임기를 다 채워서 경찰청장에서 퇴임하였다"));
			Wait(1, Ignore Condition);
			Event Player.B += Round To Integer(8000 * (1 - Global.T), Up);
			Global.Tax -= Round To Integer(8000 * (1 - Global.T), Up);
			Small Message(Event Player, Custom String("임기를 다 채우고 퇴임하여서 퇴직금으로 세금 {0}% 공제 후 {1}만 원을 받았다", Global.T * 100, Round To Integer(
				8000 * (1 - Global.T), Up)));
			Play Effect(All Players(All Teams), Buff Impact Sound, Color(흰색), Event Player, 300);
		End;
	}
}

rule("player")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.C[11] == 1;
		Is Button Held(Event Player, Button(Melee)) == True;
		Distance Between(Event Player, Position Of(Closest Player To(Event Player, All Teams))) <= 1.500;
		Hero(레킹볼) != Hero Of(Event Player);
	}

	action
	{
		Event Player.jp = First Of(Sorted Array(Remove From Array(Players Within Radius(Event Player, 1.500, Team Of(Event Player), Off),
			Event Player), Absolute Value(Horizontal Facing Angle Of(Event Player) - Horizontal Angle From Direction(Direction Towards(
			Event Player, Current Array Element))) + Distance Between(Event Player, Current Array Element)));
		Abort If(Event Player.jp == Null);
		Abort If(Event Player.jp.gamock == 1);
		Abort If(Event Player.J[1] == 10);
		Abort If(Event Player.jp.R[10] == True);
		If(Event Player.P[3] == 0);
			Small Message(Event Player, Custom String("영장을 가지고 있지 않습니다"));
			Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
			Abort;
		Else If(Event Player.C[1] < 100);
			Call Subroutine(empty_power);
			Abort;
		Else If(Event Player.jp.ms[0] != Custom String("악명") || Event Player.jp.ms[1] < 30);
			Small Message(Event Player, Custom String("악명 30 이상만 체포할 수 있습니다"));
			Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
			Abort;
		End;
		Set Melee Enabled(Event Player, False);
		Event Player.jp.gamock = 1;
		Event Player.jp.D[7] = 0;
		Event Player.jp.timer[3] = 0;
		Destroy HUD Text(Event Player.jp.text[3]);
		Play Effect(Event Player, Bad Explosion, Color(Red), Event Player.jp, 1.500);
		Event Player.P[3] = 0;
		Event Player.C[1] -= 100;
		Set Move Speed(Event Player.jp, 100);
		Set Status(Event Player.jp, Null, Knocked Down, 15);
		Set Status(Event Player.jp, Null, Phased Out, 15);
		Set Status(Event Player, Null, Rooted, 10);
		Small Message(All Players(All Teams), Custom String("{2}{1}: {0} 현행범으로 체포한다", Event Player.jp, Event Player, Hero Icon String(
			Hero Of(Event Player))));
		Wait(3, Ignore Condition);
		Small Message(All Players(All Teams), Custom String("{2}{1}: 귀하는 묵비권을 행사할 수 있으며 변호사를....", Event Player.jp, Event Player,
			Hero Icon String(Hero Of(Event Player))));
		Wait(3, Ignore Condition);
		Teleport(Event Player.jp, Global.jp[3]);
		Destroy In-World Text(Event Player.jp.location);
		Big Message(All Players(All Teams), Custom String("{0} 교도소 구속", Event Player.jp));
		Event Player.B += Event Player.jp.ms[1];
		Event Player.taxAmount += Event Player.jp.ms[1] * Global.T;
		Global.Tax -= Event Player.jp.ms[1];
		Event Player.P[6] += Round To Integer(Event Player.jp.ms[1] * 1.500, To Nearest);
		Event Player.P[9] += Round To Integer(Event Player.jp.ms[1] * 1.500, To Nearest);
		Event Player.ms[1] += Round To Integer(Event Player.jp.ms[1] / 4, To Nearest);
		Wait(0.050, Ignore Condition);
		Small Message(Event Player, Custom String("범죄자를 검거했다 [실적 +{0} / 명성 +{1} / 인센티브 +{2}만 원 / 기력 -100]", Round To Integer(
			Event Player.jp.ms[1] * 1.500, To Nearest), Round To Integer(Event Player.jp.ms[1] / 4, To Nearest), Event Player.jp.ms[1]));
		Call Subroutine(policescore);
		Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
		Teleport(Event Player, Vector(9.540, 0, 22.020));
	}
}

rule("player")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.D[7] == 1;
		Is Button Held(Event Player, Button(Melee)) == True;
		Hero(레킹볼) != Hero Of(Event Player);
		Distance Between(Event Player, Position Of(Closest Player To(Event Player, All Teams))) <= 1.500;
	}

	action
	{
		Event Player.jp = First Of(Sorted Array(Remove From Array(Players Within Radius(Event Player, 1.500, Team Of(Event Player), Off),
			Event Player), Absolute Value(Horizontal Facing Angle Of(Event Player) - Horizontal Angle From Direction(Direction Towards(
			Event Player, Current Array Element))) + Distance Between(Event Player, Current Array Element)));
		Abort If(Event Player.jp.gamock == 1);
		Abort If(Event Player.jp.R[9] == 1);
		If(Event Player.C[1] < 75);
			Call Subroutine(empty_power);
			Abort;
		Else If(Event Player.jp.C[11] == 1 && Event Player.jp.P[3] == 1);
			Small Message(Event Player, Custom String("경찰의 영장을 소매치기해서 무력화 시켰다 [기력 -75, 악명 +6] [쿨타임: 30초]"));
			Event Player.jp.P[3] = 0;
			Event Player.C[1] -= 75;
			Event Player.ms[1] += 6;
			Set Status(Event Player.jp, Null, Knocked Down, 3);
			Small Message(Event Player.jp, Custom String("소매치기한테 영장을 뺏겼다"));
			Set Melee Enabled(Event Player.jp, False);
			Wait(30, Ignore Condition);
			Abort;
		Else If(Event Player.jp.C[11] == 1 && Event Player.jp.P[3] == 0);
			Small Message(Event Player, Custom String("이 경찰은 영장을 보유하고 있지 않습니다"));
			Abort;
		Else If(Event Player.jp.C[11] == 3);
			Small Message(Event Player, Custom String("대통령을 소매치기 하시다니.."));
			Event Player.gamock = 1;
			Teleport(Event Player, Global.jp[3]);
			Big Message(All Players(All Teams), Custom String("{0}가 {1} 대통령을 소매치기하려고 한 시도 때문에 긴급체포 당했다", Event Player, Event Player.jp));
			Abort;
		Else If(Event Player.jp.C[5] >= Random Integer(1, 200));
			Set Status(Event Player, Null, Knocked Down, 3);
			Set Status(Event Player.jp, Null, Rooted, 1);
			Small Message(Event Player, Custom String("{0}은 호신술을 배운 것 같다.. 소매치기에 실패했다.. [기력 -75] [쿨타임: 30초], Event Player.jp"));
			Small Message(Event Player.jp, Custom String("배워놓았던 호신술 덕분에 소매치기를 넘어뜨렸다!"));
			Event Player.C[1] -= 75;
			Wait(30, Ignore Condition);
			Abort;
		End;
		Event Player.R[1] = Random Integer(1, Min(Event Player.jp.A, 100));
		Wait(0.500, Ignore Condition);
		Event Player.jp.A -= Event Player.R[1];
		Event Player.A += Event Player.R[1];
		Set Status(Event Player.jp, Null, Knocked Down, 3);
		Small Message(Players Within Radius(Event Player, 10, All Teams, Off), Custom String("누군가 {0}의 돈을 훔쳤습니다...", Event Player.jp,
			Event Player));
		Small Message(Event Player, Custom String("{0}의 돈을 {1}만 원 훔쳤다... [기력 -75, 악명 +4] [쿨타임: 30초]", Event Player.jp, Event Player.R[1]));
		Play Effect(All Players(All Teams), Good Explosion, Color(Red), Event Player.jp, 0.100);
		Event Player.C[1] -= 75;
		Event Player.ms[1] += 4;
		Small Message(Event Player.jp, Custom String("누군가 당신의 돈을 {0}만 원 훔쳤습니다", Event Player.R[1]));
		Wait(30, Ignore Condition);
	}
}

rule("player")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Communicating(Event Player, Hello) == True;
		Is Moving(Event Player) == False;
		Hero(레킹볼) != Hero Of(Event Player);
		Distance Between(Event Player, Position Of(Closest Player To(Event Player, All Teams))) <= 1.500;
	}

	action
	{
		Event Player.jp = First Of(Sorted Array(Remove From Array(Players Within Radius(Event Player, 1.500, Team Of(Event Player), Off),
			Event Player), Absolute Value(Horizontal Facing Angle Of(Event Player) - Horizontal Angle From Direction(Direction Towards(
			Event Player, Current Array Element))) + Distance Between(Event Player, Current Array Element)));
		Abort If(Event Player.jp.gamock == 1);
		If(Event Player.jp.ms[0] == Custom String("명성"));
			Event Player.jp.ms[1] += 2;
			Small Message(Event Player, Custom String("{0}님의 명성을 높여주었습니다 [쿨타임: 1분]", Event Player.jp));
			Small Message(Event Player.jp, Custom String("{0}님이 명성을 높여주었습니다 [명성 +2]", Event Player));
			Play Effect(All Players(All Teams), Good Explosion, Color(Green), Event Player.jp, 1);
			Play Effect(All Players(All Teams), Buff Impact Sound, Color(흰색), Event Player, 100);
			Wait(60, Ignore Condition);
		End;
		If(Event Player.jp.ms[0] == Custom String("악명"));
			Event Player.jp.ms[1] -= 2;
			Small Message(Event Player, Custom String("{0}님의 명성을 높여주었습니다 [쿨타임: 1분]", Event Player.jp));
			Small Message(Event Player.jp, Custom String("{0}님이 명성을 높여주었습니다 [악명 -2]", Event Player));
			Play Effect(All Players(All Teams), Good Explosion, Color(Green), Event Player.jp, 1);
			Play Effect(All Players(All Teams), Buff Impact Sound, Color(흰색), Event Player, 100);
			If(Event Player.jp.ms[1] <= 0);
				Event Player.jp.ms[1] = 0 - Event Player.jp.ms[1];
				Event Player.jp.ms[0] = Custom String("명성");
			End;
			Wait(60, Ignore Condition);
		End;
	}
}

rule("player")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Ultimate)) == True;
		Event Player.gamock == 0;
		Hero(레킹볼) != Hero Of(Event Player);
	}

	action
	{
		If(Is Button Held(Event Player, Button(Ultimate)) && Event Player.R[13] == False);
			Wait(0.250, Abort When False);
			Small Message(Event Player, Custom String("스마트폰 지문 인식 중..."));
			Wait(0.750, Abort When False);
			Set Move Speed(Event Player, 60);
			Event Player.R[13] = True;
			Event Player.name[0] = Custom String("-------------------\r\n스마트폰\r\n-------------------\r\n{0}", Custom String(
				"[V] 송금\r\n[F] 잡코리아\r\n[Q] 내 정보\r\n-------------------\r\n[점프] 닫기\r\n"));
		Else If(Event Player.R[13] == True);
			Event Player.R[13] = False;
			Event Player.name[0] = Custom String("-------------------\r\n내 정보\r\n-------------------\r\n최대 기력: {0}%\r\n신용 점수: {1}\r\n{2}",
				Event Player.C[10], Event Player.ms[3], Custom String("\r\n보유 자격증\r\n• {0}\r\n• {1}\r\n{2}", Event Player.C[21],
				Event Player.C[22], Custom String("• {0}\r\n• {1}\r\n{2}", Event Player.C[24], Event Player.C[25], Custom String(
				"• {0}\r\n• {1}\r\n• {2}", Event Player.C[26], Event Player.C[27], Event Player.C[28]))));
		End;
	}
}

rule("player")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Jump)) == True;
		Hero(레킹볼) != Hero Of(Event Player);
		Is Alive(Event Player) == True;
	}

	action
	{
		If(Event Player.R[4] == True && Event Player.F[10] == 1);
			Teleport(Event Player, Global.jp[27]);
			Set Invisible(Event Player, None);
			Event Player.R[4] = False;
			Small Message(Event Player, Custom String("집에서 나왔다"));
		End;
		Event Player.R[11] = False;
		Event Player.R[12] = False;
		Event Player.R[13] = False;
		Event Player.R[15] = False;
		Event Player.R[16] = False;
		Event Player.R[17] = False;
		Event Player.name[0] = Custom String("");
		Event Player.name[1] = 0;
		Event Player.name[2] = 0;
		Set Move Speed(Event Player, 100);
		Start Camera(Event Player, Ray Cast Hit Position(Event Player, Event Player + World Vector Of(Vector(0, 0, 0), Event Player,
			Rotation) + Up * 1.800 + Facing Direction Of(Event Player) * -2.800, Null, Event Player, True),
			Event Player + Facing Direction Of(Event Player) * 1000, 60);
	}
}

rule("Button_EQ")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Ability 2)) == True;
		Is Button Held(Event Player, Button(Ultimate)) == True;
		Hero(레킹볼) != Hero Of(Event Player);
		Event Player.S[2] >= 1;
		Event Player.AA > 0;
		Is Alive(Event Player) == True;
	}

	action
	{
		Event Player.S[2] -= 1;
		Event Player.R[1] = Min(10, Event Player.AA);
		Wait(0.050, Ignore Condition);
		Event Player.AA -= Event Player.R[1];
		Small Message(Event Player, Custom String("계란빵을 먹었다 [배고픔 -{0}%]", Round To Integer(Event Player.R[1], Up)));
		Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 50);
	}
}

