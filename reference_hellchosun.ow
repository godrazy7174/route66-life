rule("player")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	action
	{
		While(True);
			Wait(376, Ignore Condition);
			Wait(276, Ignore Condition);
			Skip If(Event Player.taxAmount <= 0, 13);
			Skip If(Event Player.gamock == 1, 12);
			Big Message(Event Player, Custom String("국민 여러분, 세금 납부 기간이 다가오고 있습니다"));
			Wait(8, Ignore Condition);
			Big Message(Event Player, Custom String("지난 기간의 소득에 따른 세금을 납부하지 않으면 처벌을 받을 수 있습니다"));
			Wait(16, Ignore Condition);
			Create Beam Effect(All Players(All Teams), Good Beam, Event Player, Global.jp[7], Color(Yellow), Position and Radius);
			Event Player.NBeam[1] = Last Created Entity;
			Create In-World Text(Players Within Radius(Global.jp[7], 150, All Teams, Off), Icon String(Flag), Up + Global.jp[7], 10,
				Do Not Clip, Visible To, Color(Red), Default Visibility);
			Event Player.Tax2 = Last Text ID;
			Event Player.Tax = 1;
			Big Message(Event Player, Custom String("국세청에서 세금을 납부하세요"));
		End;
	}
}

rule("player")
{
	event
	{
		Player Joined Match;
		Team 1;
		All;
	}

	action
	{
		Create Progress Bar HUD Text(Event Player, Local Player.health, Null, Left, 0, Color(Red), Null, Values, Default Visibility);
		Event Player.text[1] = Last Text ID;
		Disable Game Mode HUD(Event Player);
		Set Damage Received(Event Player, 0);
		Disable Nameplates(Event Player, First Of(True));
		Disable Hero HUD(Event Player);
		Disable Messages(Event Player);
		Set Ability 1 Enabled(Event Player, False);
		Set Ultimate Ability Enabled(Event Player, False);
		Set Melee Enabled(Event Player, False);
		Wait(0.250, Ignore Condition);
		Start Rule(disabledWallCheck, Do Nothing);
		For Player Variable(Event Player, level, 0, Count Of(Global.disableButtonList), 1);
			Disallow Button(Event Player, Global.disableButtonList[Event Player.level]);
		End;
		Wait(0.500, Ignore Condition);
		Start Forcing Player Outlines(All Players(All Teams), Event Player, False, Null, Default);
		Event Player.name[0] = Custom String("");
		Event Player.A = 100;
		Event Player.B = -50;
		Event Player.C[1] = 100;
		Event Player.C[5] = 0;
		Event Player.C[10] = 100;
		Event Player.S[1] = 10;
		Event Player.S[2] = 9;
		Event Player.S[3] = 1;
		Event Player.Y = Event Player;
		Event Player.ms[3] = Random Integer(200, 400);
		Event Player.ms[1] = 0;
		Event Player.ms[0] = Custom String("명성");
		Event Player.UI[1] = Custom String("\r\n");
		Event Player.H[0] = Custom String("국민");
		For Player Variable(Event Player, level, 21, 27, 1);
			Event Player.C[Event Player.level] = Custom String("");
		End;
		Wait(0.500, Ignore Condition);
		Create In-World Text(All Players(Team 1), Custom String("『 {0} 』 {1}\r\n\r\n\r\n\r\n", Event Player.H[0], Event Player),
			Event Player, 1.150, Clip Against Surfaces, Visible To Position String and Color, Event Player.ms[0] == Custom String("악명")
			? Color(Red) : Color(흰색), Default Visibility);
		Create In-World Text(All Players(Team 1), Custom String("{0} {1}\r\n현금 {2}\r\n", Event Player.ms[0], Event Player.ms[1],
			Round To Integer(Event Player.A, Down) >= 10000 ? Custom String("{0}억 {1}만 원", Round To Integer(Event Player.A / 10000, Down),
			Round To Integer(Event Player.A % 10000, Down)) : Custom String("{0}만 원", Round To Integer(Event Player.A, Down))),
			Event Player, 0.900, Clip Against Surfaces, Visible To Position and String, Color(흰색), Visible Never);
		Stop Forcing Player Position(Event Player);
		Wait(3, Ignore Condition);
		Start Camera(Event Player, Ray Cast Hit Position(Event Player, Event Player + World Vector Of(Vector(0, 0, 0), Event Player,
			Rotation) + Up * 1.800 + Facing Direction Of(Event Player) * -2.800, Null, Event Player, True),
			Event Player + Facing Direction Of(Event Player) * 1000, 60);
		Chase Player Variable At Rate(Event Player, health, Normalized Health(Event Player) * 100, Absolute Value(Normalized Health(
			Event Player) * 100 - Event Player.health) * 2 + 1, Destination and Rate);
		Wait(3, Ignore Condition);
		If(Custom String("{0}", Event Player) == Custom String("레비"));
			Start Forcing Player To Be Hero(Event Player, Hero(에코));
			Event Player.H[0] = Custom String("제작자");
			Set Ability 1 Enabled(Event Player, True);
			Set Ultimate Ability Enabled(Event Player, True);
			Event Player.B = 50000;
			Event Player.C[5] = 200;
			Event Player.C[10] = 10000;
			Event Player.S[3] = 500;
			Event Player.ms[1] = 1000;
			Event Player.C[31] = 50;
			Event Player.C[33] = 100;
			Event Player.S[1] = 1000;
			Event Player.R[10] = True;
			Event Player.C[21] = Custom String("검정고시");
			Event Player.C[22] = Custom String("생활 스포츠 지도사");
			Event Player.C[24] = Custom String("운전 면허");
			Event Player.C[25] = Custom String("호텔 매니지먼트");
			Event Player.C[26] = Custom String("조리기능사");
			Event Player.C[27] = Custom String("조주기능사");
			Event Player.C[28] = Custom String("바리스타");
		Else If(Custom String("{0}", Event Player) == Custom String("코모"));
			Start Forcing Player To Be Hero(Event Player, Hero(젠야타));
			Set Ability 1 Enabled(Event Player, True);
			Set Ultimate Ability Enabled(Event Player, True);
			Event Player.B = 500;
		End;
		If(Global.B[1] == 1);
			Event Player.A += 300;
			Global.Tax -= 300;
			Small Message(Event Player, Custom String("정착 지원금 정책으로 300만 원을 지원받았습니다"));
		End;
	}
}

rule("player")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Has Spawned(Event Player) == True;
	}

	action
	{
		Teleport(Event Player, Vector(7.710, 4, 26.790));
	}
}

rule("player")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	action
	{
		While(True);
			Wait(10, Ignore Condition);
			If(Event Player.C[9] <= 0);
				Event Player.AA += 1;
			End;
		End;
	}
}

rule("player")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Ability 1)) == True;
		Is Moving(Event Player) == True;
		Event Player.gamock == 0;
		Hero(레킹볼) != Hero Of(Event Player);
	}

	action
	{
		If(Event Player.AA < 100);
			Set Move Speed(Event Player, 150);
			Stop Chasing Player Variable(Event Player, AA);
			Chase Player Variable At Rate(Event Player, AA, 100, 2, Destination and Rate);
		Else;
			Set Move Speed(Event Player, 100);
			Stop Chasing Player Variable(Event Player, AA);
			Small Message(Event Player, Custom String("배고픔이 부족해 달릴 수가 없다{0}", Hero Icon String(Hero Of(Event Player))));
		End;
	}
}

rule("player")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Ability 1)) != True;
	}

	action
	{
		Set Move Speed(Event Player, 100);
		Stop Chasing Player Variable(Event Player, AA);
	}
}

rule("player")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Alive(Event Player) == True;
	}

	action
	{
		While(True);
			Wait(5, Ignore Condition);
			If(Event Player.AA >= 100);
				Set Damage Received(Event Player, 100);
				Start Damage Over Time(Event Player, Null, 5, 10);
				Set Aim Speed(Event Player, 30);
				Set Move Speed(Event Player, 60);
				Event Player.timer[4] = 10;
				Small Message(Event Player, Custom String("배고파...{0}", Hero Icon String(Hero Of(Event Player))));
			Else;
				Heal(Event Player, Null, Max Health(Event Player));
			End;
		End;
	}
}

rule("player")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.timer[4] > 0;
	}

	action
	{
		While(Event Player.timer[4] > 0);
			Event Player.timer[4] -= 1;
			Wait(1, Ignore Condition);
			If(Event Player.timer[4] <= 0);
				Set Move Speed(Event Player, 100);
				Set Aim Speed(Event Player, 100);
			End;
		End;
	}
}

rule("player")
{
	event
	{
		Player Died;
		All;
		All;
	}

	action
	{
		If(Event Player.C[11] == 3);
			Big Message(All Players(All Teams), Custom String("{0} 대통령이 사망하였습니다", Event Player));
			Destroy HUD Text(Event Player.text[2]);
			Event Player.timer[2] = 0;
			Event Player.C[11] = 0;
			Global.Presi = Remove From Array(Global.Presi, Event Player);
			Global.Presi = 0;
			Global.B[1] = 0;
			Global.F[1] = Custom String("");
			Start Forcing Player To Be Hero(Event Player, Event Player.E[0]);
		End;
		Teleport(Event Player, Vector(8, 4, 27));
		Event Player.AA = 80;
		Event Player.A = 0;
		Event Player.B -= 100;
		Event Player.S[1] = 10;
		Event Player.S[2] = 0;
		Event Player.S[3] = 0;
		Event Player.C[1] = 0;
		Event Player.R[3] = Max(100, Event Player.C[10] - 100);
		Wait(0.020, Ignore Condition);
		Event Player.C[10] = Event Player.R[3];
		Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
		If(Hero Of(Event Player) == Hero(레킹볼));
			Start Forcing Player To Be Hero(Event Player, Event Player.R[8]);
			Event Player.R[9] = 0;
			Small Message(Event Player, Custom String("스포츠카에서 내렸습니다"));
			If(Hero(에코) == Hero Of(Event Player) || Hero(젠야타) == Hero Of(Event Player) || Hero(해저드) == Hero Of(Event Player)
				|| Event Player.C[11] == 1 || Hero(윈스턴) == Hero Of(Event Player));
				Set Ability 1 Enabled(Event Player, True);
			End;
		End;
		Small Message(Event Player, Custom String("가지고 있는 돈과 아이템을 모두 잃고 병원비로 백만 원을 지출했다.."));
	}
}

rule("player")
{
	event
	{
		Player Left Match;
		All;
		All;
	}

	action
	{
		Destroy Progress Bar HUD Text(Event Player.text[1]);
		Destroy HUD Text(Event Player.text[2]);
		Destroy HUD Text(Event Player.text[3]);
		For Player Variable(Event Player, level, 1, 5, 1);
			If(Event Player.EffectID[Event Player.level] != 0);
				Destroy Effect(Event Player.EffectID[Event Player.level]);
			End;
		End;
		For Player Variable(Event Player, level, 3, 12, 1);
			If(Global.F[Event Player.level] == Event Player);
				Global.F[Event Player.level] = Custom String("");
				Global.S[Event Player.level] = Event Player.level == 11 ? Global.S[10] : (Event Player.level == 7 ? 5000 : (
					Event Player.level == 9 ? 4000 : (Event Player.level == 4 ? 5000 : 6000)));
			End;
		End;
		If(Array Contains(Global.Presi, Event Player));
			Global.Presi = Remove From Array(Global.Presi, Event Player);
			Big Message(All Players(All Teams), Custom String("대통령이 헬조선을 떠났습니다.."));
			Global.Presi = 0;
			Global.B[1] = 0;
			Global.F[1] = Custom String("");
		End;
		If(Event Player.C[11] == 2);
			Global.Presi = 0;
			Destroy HUD Text(Global.President[2]);
			Destroy HUD Text(Global.President[3]);
			All Players(All Teams).hasVoted = 0;
		End;
		If(Global.F[2] == Event Player);
			Big Message(All Players(All Teams), Custom String("경찰청장이 헬조선을 떠났습니다.."));
			Global.F[2] = Custom String("");
		End;
	}
}

rule("player")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.Tax == 1;
	}

	action
	{
		Wait(180, Abort When False);
		Event Player.Chenan = 1;
		Event Player.ms[1] += 20;
		If(Event Player.ms[0] == Custom String("명성"));
			Event Player.ms[1] = 20;
		End;
		Event Player.ms[0] = Custom String("악명");
		Small Message(Event Player, Custom String("세금을 체납하여 악명이 증가했습니다 [악명 +20]"));
		If(Event Player.A > 0);
			Event Player.forcedTax = Round To Integer(Event Player.A * Global.T, To Nearest);
			Event Player.A -= Event Player.forcedTax;
			Global.Tax += Event Player.forcedTax;
			Event Player.fine = Round To Integer(Event Player.A * 0.200, To Nearest);
			Event Player.A -= Event Player.fine;
			Global.Tax += Event Player.fine;
			Small Message(Event Player, Custom String("세금 {0}만 원과 벌금 {1}만 원이 강제 징수되었습니다", Event Player.forcedTax, Event Player.fine));
		End;
		If(Event Player.B > 0);
			Event Player.forcedTax = Round To Integer(Event Player.B * Global.T, To Nearest);
			Event Player.B -= Event Player.forcedTax;
			Global.Tax += Event Player.forcedTax;
			Event Player.fine = Round To Integer(Event Player.B * 0.200, To Nearest);
			Event Player.B -= Event Player.fine;
			Global.Tax += Event Player.fine;
			Small Message(Event Player, Custom String("세금 {0}만 원과 벌금 {1}만 원이 강제 징수되었습니다", Event Player.forcedTax, Event Player.fine));
		End;
		Event Player.taxAmount = 0;
		Wait(5, Abort When False);
		Event Player.Tax = 0;
		Event Player.ms[3] = 0;
		Destroy In-World Text(Event Player.Tax2);
		Destroy Effect(Event Player.NBeam[1]);
		Event Player.Chenan = 0;
		If(Event Player.C[11] == 0);
			Event Player.gamock = 1;
			Teleport(Event Player, Global.jp[3]);
			Small Message(Event Player, Custom String("세금 체납으로 인해 감옥에 수감되었습니다"));
		End;
		Call Subroutine(badcop);
	}
}

rule("player")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.gamock == 1;
		Event Player.ms[1] >= 1;
		Event Player.ms[0] == Custom String("악명");
		Distance Between(Event Player, Global.jp[2]) <= 9;
	}

	action
	{
		Set Status(Event Player, Null, Rooted, 2);
		If(Event Player.ms[1] < 50);
			Event Player.C[9] = Event Player.ms[1] * 4;
		Else If(Event Player.ms[1] >= 50 && Event Player.ms[1] < 100);
			Event Player.C[9] = Event Player.ms[1] * 6;
		Else;
			Event Player.C[9] = Event Player.ms[1] * 10;
		End;
		Event Player.Tax = 0;
		If(Event Player.timer[3] > 0);
			Set Melee Enabled(Event Player, False);
			Event Player.D[7] = 0;
			Small Message(Event Player, Custom String("소매치기 장비가 파괴되었다"));
			Destroy HUD Text(Event Player.text[3]);
			Event Player.timer[3] = 0;
		End;
		Destroy In-World Text(Event Player.Tax2);
		Destroy Effect(Event Player.NBeam[1]);
		Event Player.E[0] = Hero Of(Event Player);
		If(Hero Of(Event Player) != Hero(해저드));
			If(Event Player.ms[1] >= 200);
				Start Forcing Player To Be Hero(Event Player, Hero(로드호그));
			Else;
				Start Forcing Player To Be Hero(Event Player, Hero(정크랫));
			End;
		End;
		Event Player.H[0] = Custom String("죄수");
		Small Message(Event Player, Custom String("옷을 빼앗기고 감옥에 갇혔다.. [{0}초 뒤 석방]", Event Player.C[9]));
		Call Subroutine(prisontime);
		Abort If(Event Player.J[2] == 1);
		Set Status(Event Player, Null, Rooted, 5);
		Small Message(Event Player, Custom String("{0}: 이봐! {1} 출소다!", Hero Icon String(Hero(라인하르트)), Event Player));
		Wait(2, Ignore Condition);
		Event Player.C[9] = 0;
		Event Player.H[0] = Custom String("국민");
		Event Player.ms[1] = 0;
		Event Player.ms[0] = Custom String("명성");
		If(Hero Of(Event Player.E[0]) != Hero(해저드));
			Start Forcing Player To Be Hero(Event Player, Event Player.E[0]);
		Else;
			Start Forcing Player To Be Hero(Event Player, Hero(솔저: 76));
		End;
		Teleport(Event Player, Vector(8.830, 0, 14.510));
		Event Player.gamock = 0;
		Small Message(Event Player, Custom String("모든 죗값을 치르고 나니 홀가분하다 [명성 초기화]"));
		Wait(1, Ignore Condition);
		Small Message(Event Player, Custom String("드디어 출소했다. 이젠 착하게 살아야지.."));
		Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
		Set Melee Enabled(Event Player, False);
	}
}

