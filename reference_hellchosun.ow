rule("sub_EggHouseparttime")
{
	event
	{
		Subroutine;
		EggHouseparttime;
	}

	action
	{
		If(Event Player.C[11] != 0);
			Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
			Small Message(Event Player, Custom String("경찰과 대통령은 알바를 할 수 없습니다"));
			Abort;
		Else If(Event Player.C[1] < 35);
			Call Subroutine(empty_power);
			Abort;
		End;
		Event Player.C[1] -= 35;
		Event Player.AA += 5;
		Event Player.Jobm[1] = Random Integer(1, 3);
		Set Status(Event Player, Null, Rooted, 5);
		Teleport(Event Player, Vector(53.400, 1.990, -5.370));
		If(Event Player.C[26] == Custom String("조리기능사"));
			Event Player.Jobm[1] = Random Integer(1, 2);
		End;
		Wait(0.500, Ignore Condition);
		Small Message(Event Player, Event Player.Jobm[1] == 1 ? Custom String("계란빵을 굽는 중... [기력 -35, 배고픔 +5%]") : (
			Event Player.Jobm[1] == 2 ? Custom String("간장계란밥을 준비하는 중... [기력 -35, 배고픔 +5%]") : Custom String(
			"주방을 정리하는 중... [기력 -35, 배고픔 +5%]")));
		Wait(4.500, Ignore Condition);
		Event Player.C[12] += Random Integer(0, 1);
		Event Player.H[0] = Event Player.C[26] == Custom String("조리기능사") ? Custom String("에그하우스 요리사 Lv{0}", Event Player.C[12])
			: Custom String("에그하우스 알바생 Lv{0}", Event Player.C[12]);
		If(Event Player.Jobm[1] == 1);
			Global.Stock[1] = Min(Global.Stock[1] + Max(1, Min(20, Round To Integer(Event Player.C[12] / 5, Down))), 1000);
		Else If(Event Player.Jobm[1] == 2);
			Global.Stock[2] = Min(Global.Stock[2] + Max(1, Min(20, Round To Integer(Event Player.C[12] / 10, Down))), 1000);
		End;
		Event Player.A += Event Player.C[26] == Custom String("조리기능사") ? Global.A[13] * 1.500 : Global.A[13];
		Event Player.taxAmount += Event Player.C[26] == Custom String("조리기능사") ? Global.A[13] * 1.500 * Global.T : Global.A[13] * Global.T;
		Global.F[3].B -= Event Player.C[26] == Custom String("조리기능사") ? Global.A[13] * 1.500 : Global.A[13];
		Global.F[3].taxAmount -= Event Player.C[26] == Custom String("조리기능사") ? Global.A[13] * 1.500 * Global.T : Global.A[13] * Global.T;
		If(Event Player.C[12] >= 100 && Event Player.Jobm[1] == 2);
			Event Player.R[1] = Min(50, Event Player.AA);
			Wait(0.050, Ignore Condition);
			Event Player.AA -= Event Player.R[1];
			Global.Stock[2] -= 1;
			Small Message(Event Player, Custom String("급여를 받고 음식을 먹었다 [+{0}만 원, 배고픔 -{1}%]", Event Player.C[26] == Custom String("조리기능사")
				? Global.A[13] * 1.500 : Global.A[13], Round To Integer(Event Player.R[1], Up)));
		Else If(
				Event Player.C[12] >= 10 && Event Player.Jobm[1] == 1 && Event Player.S[1] >= Event Player.S[2] + Event Player.S[3] + Event Player.S[4] + 1);
			Event Player.S[2] += 1;
			Global.Stock[1] -= 1;
			Small Message(Event Player, Custom String("급여와 음식을 받았다 [+{0}만 원, 계란빵 +1개]", Event Player.C[26] == Custom String("조리기능사")
				? Global.A[13] * 1.500 : Global.A[13]));
		Else;
			Small Message(Event Player, Custom String("급여를 받았다 [+{0}만 원]", Event Player.C[26] == Custom String("조리기능사")
				? Global.A[13] * 1.500 : Global.A[13]));
		End;
		Teleport(Event Player, Global.jp[31]);
		Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 100);
	}
}

rule("policewall")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.C[11] == 1;
	}

	action
	{
		Wait(0.500, Abort When False);
		If(Is True For Any(Array(Vector(100.380, 11, -30.230), Vector(100.830, 11, -18.920)), Distance Between(Event Player,
			Current Array Element) <= 4));
			Small Message(Event Player, Custom String("경찰은 지하철에 진입할 수 없습니다"));
			Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
			Teleport(Event Player, Vector(74.160, 8.140, -24.090));
		End;
		Loop;
	}
}

rule("server close_1")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.timer[2] == 3;
		Global.timer[1] >= 50;
	}

	action
	{
		Play Effect(All Players(All Teams), Bad Pickup Effect, Color(Aqua), All Players(All Teams), 200);
		Big Message(All Players(All Teams), Custom String("10분 후 서버 종료!"));
		Wait(300, Ignore Condition);
		Play Effect(All Players(All Teams), Bad Pickup Effect, Color(Aqua), All Players(All Teams), 200);
		Big Message(All Players(All Teams), Custom String("5분 후 서버 종료!"));
		Wait(300, Ignore Condition);
		Play Effect(All Players(All Teams), Bad Pickup Effect, Color(Aqua), All Players(All Teams), 200);
		Small Message(All Players(All Teams), Custom String("서버가 종료됩니다"));
		Big Message(All Players(All Teams), Custom String("서버가 종료됩니다"));
		Wait(2, Ignore Condition);
		Small Message(All Players(All Teams), Custom String("헬조선에서 살아남기를 사랑해주셔서 감사합니다{0}", Icon String(Happy)));
		Big Message(All Players(All Teams), Custom String("헬조선에서 살아남기를 사랑해주셔서 감사합니다{0}", Icon String(Happy)));
		Wait(3, Ignore Condition);
		Restart Match;
	}
}

rule("no")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.O[0] == False;
		Global.Tax <= 0;
	}

	action
	{
		Global.O[0] = True;
		Big Message(All Players(All Teams), Custom String("헬조선의 재정이 적자가 났습니다"));
		Wait(3, Ignore Condition);
		Big Message(All Players(All Teams), Custom String("극단적 긴축 정책이 발동됩니다"));
		Wait(3, Ignore Condition);
		Big Message(All Players(All Teams), Custom String("세율이 30%로 인상됩니다"));
		Global.T = 0.300;
		Wait(1, Ignore Condition);
		Big Message(All Players(All Teams), Custom String("금리가 1%로 인하됩니다"));
		Global.R = 0.010;
		Big Message(All Players(All Teams), Custom String("대출 한도가 줄어듭니다"));
		Wait(1, Ignore Condition);
		Big Message(All Players(All Teams), Custom String("IMF 책임을 물어 대통령 탄핵 투표를 실시합니다"));
		Teleport(Global.F[1], Vector(0, 6.500, 23.790));
		Global.President[1] = 0;
		Wait(0.500, Ignore Condition);
		Create HUD Text(All Players(All Teams), Null, Custom String("{0} 대통령 탄핵 투표\r\n탄핵 확률: {1}%", Global.F[1], Global.President[1]),
			Null, Left, 2, Color(흰색), Color(Sky Blue), Color(흰색), Visible To and String, Default Visibility);
		Global.President[2] = Last Text ID;
		All Players(All Teams).hasVoted = 2;
		Start Camera(All Players(All Teams), Vector(9.920, 8, 20.670), Vector(6.400, 6, 23.170), 15);
		Big Message(All Players(All Teams), Custom String("투표소로 이동하여 투표하세요"));
		Set Status(All Players(All Teams), Null, Rooted, 3.900);
		Wait(4, Ignore Condition);
		Start Camera(All Players(All Teams), Ray Cast Hit Position(Local Player, Local Player + World Vector Of(Vector(0, 0, 0),
			Local Player, Rotation) + Up * 1.800 + Facing Direction Of(Local Player) * -2.800, Null, Local Player, True),
			Local Player + Facing Direction Of(Local Player) * 1000, 60);
		Global.President[4] = 200;
		Create HUD Text(All Players(All Teams), Null, Custom String("남은 투표 시간: {0}초", Global.President[4]), Null, Left, 3, Color(흰색),
			Color(흰색), Color(흰색), Visible To and String, Default Visibility);
		Global.President[3] = Last Text ID;
		While(Global.President[4] > 0);
			Wait(1, Ignore Condition);
			Global.President[4] -= 1;
		End;
		Call Subroutine(end_voting2);
	}
}

rule("no")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.Tax >= 100000;
		Global.O[1] == False;
	}

	action
	{
		Global.O[1] = True;
		Big Message(All Players(All Teams), Custom String("헬조선의 재정이 10억 원을 달성했습니다"));
		Wait(3, Ignore Condition);
		Big Message(All Players(All Teams), Custom String("재정이 풍족하여 세율이 감소합니다"));
		Wait(3, Ignore Condition);
		Global.T -= Random Real(0.010, 0.200);
		If(Global.T < 0.010);
			Global.T = 0.010;
		Else If(Global.T > 0.200);
			Global.T = 0.200;
		End;
	}
}

rule("no")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global.O[0] == True;
		Global.Tax >= 1;
	}

	action
	{
		Global.O[0] = False;
		Big Message(All Players(All Teams), Custom String("국가 재정이 0원을 초과했습니다! 헬조선이 IMF의 늪에서 벗어났습니다!"));
		Wait(3, Ignore Condition);
		Big Message(All Players(All Teams), Custom String("극단적 긴축 정책이 취소됩니다"));
		Global.T = Random Real(0.010, 0.020);
		Global.R = Random Real(0.010, 0.020);
	}
}

rule("무단수정금지")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Is Button Held(Event Player, Button(Reload)) == True;
		Is Button Held(Event Player, Button(Ability 1)) == True;
		Is Button Held(Event Player, Button(Ultimate)) == True;
		Custom String("{0}", Event Player) == Custom String("레비");
	}

	action
	{
		Big Message(All Players(All Teams), Custom String("정식 버전이 아닌 무단 수정된 방입니다"));
		Big Message(All Players(All Teams), Custom String("정식 코드 FZ1MP로 방을 생성해주세요"));
		Big Message(All Players(All Teams), Custom String("무단 수정된 방으로 게임이 종료됩니다"));
		Wait(5, Ignore Condition);
		Remove Player(All Players(All Teams));
		Restart Match;
	}
}

rule("무단수정금지")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.C[11] == 3;
		Event Player.R[11] == True;
		Event Player.R[12] == True;
		Event Player.name[1] == 4;
		Event Player.name[2] == 0;
		Global.O[0] == False;
		Is Button Held(Event Player, Button(Primary Fire)) == True;
		Distance Between(Event Player, Global.jp[8]) <= 1.500;
	}

	action
	{
		If(Global.B[0] == 50);
			Small Message(Event Player, Custom String("이미 실시한 정책입니다"));
		End;
		Big Message(All Players(All Teams), Custom String("{0} 대통령이 보이스피싱 방지 정책을 실시했습니다!", Event Player));
		Big Message(All Players(All Teams), Custom String("예방 교육이 실시되어 10분간 보이스피싱 피해 확률이 감소합니다!", Event Player));
		Global.Tax -= 4000;
		Global.B[0] = 50;
		Wait(600, Ignore Condition);
		Global.B[0] = 70;
	}
}