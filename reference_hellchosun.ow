			Play Effect(Event Player, Buff Impact Sound, Color(흰색), Event Player, 300);
		Else If(Distance Between(Event Player, Global.jp[28]) <= 1);
			disabled Abort If(Event Player.gamock != 1);
			If(Event Player.R[16] == False);
				Event Player.R[16] = True;
				Event Player.name[0] = Custom String(
					"------------------\r\n보석금을 지불하면 즉시 출소할 수 있습니다\r\n------------------\r\n보석금: {1}만 원\r\n\r\n[좌클] 확인\r\n[점프] 닫기",
					Event Player.C[9], Event Player.C[9]);
			Else If(Event Player.R[16] == True);
				If(Event Player.R[17] == False);
					If(
						Event Player.A + Event Player.B >= Event Player.C[9] || Event Player.A >= Event Player.C[9] || Event Player.B >= Event Player.C[9]);
						Event Player.J[2] = 1;
						Event Player.gamock = 0;
						Set Melee Enabled(Event Player, False);
						Event Player.Jobm[1] = Random Integer(1, 10);
