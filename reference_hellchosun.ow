					Event Player.name[1] == 2 ? Custom String("({0}/14~100)회", Event Player.C[41 + Event Player.name[1]]) : (
					Event Player.name[1] == 3 ? Custom String("({0}/2~50)회", Event Player.C[41 + Event Player.name[1]]) : (
					Event Player.name[1] == 4 ? Custom String("({0}/4~60)회", Event Player.C[41 + Event Player.name[1]]) : (
					Event Player.name[1] == 5 ? Custom String("({0}/6~70)회", Event Player.C[41 + Event Player.name[1]]) : (
					Event Player.name[1] == 6 ? Custom String("({0}/4~60)회", Event Player.C[41 + Event Player.name[1]]) : Custom String(
					"({0}/4~60)회", Event Player.C[41 + Event Player.name[1]])))))));
				Event Player.name[0] = Custom String("------------------\r\n공부한 횟수 {0}\r\n------------------\r\n{1}{2}", Event Player.name[2],
					Event Player.name[3], Custom String("{0}{1}{2}", Event Player.name[4], Event Player.name[5], Custom String("{0}{1}{2}",
					Event Player.name[6], Event Player.name[7], Custom String(
					"{0}{1}{2}------------------\r\n[W] ↑\r\n[S] ↓\r\n[좌클릭] 공부\r\n[점프] 닫기", Event Player.name[8], Event Player.name[9],
					Event Player.name[10]))));
				Event Player.R[11] = True;
			End;
		Else If(Distance Between(Event Player, Global.jp[107]) <= 2);
			If(Event Player.R[11] == False);
				Event Player.R[11] = True;
				Set Move Speed(Event Player, 0);
				For Player Variable(Event Player, level, 0, Count Of(Global.C[8]), 1);
					Event Player.name[3 + Event Player.level] = Event Player.level == Event Player.name[1] ? Custom String("{0} ◀\r\n",
						Global.C[8][Event Player.level]) : Custom String("{0}\r\n", Global.C[8][Event Player.level]);
				End;
				Event Player.name[2] = Event Player.name[1] == 0 ? 1 : (Event Player.name[1] == 1 ? 10 : (Event Player.name[1] == 2 ? 100 : (
					Event Player.name[1] == 3 ? 1000 : 0)));
				Event Player.name[0] = Custom String("------------------\r\n주사위 도박\r\n------------------\r\n{0}{1}{2}", Event Player.name[3],
					Event Player.name[4], Custom String("{0}{1}{2}", Event Player.name[5], Event Player.name[6], Custom String(
					"------------------\r\n[W] ↑\r\n[S] ↓\r\n[좌클릭] 확인\r\n[점프] 닫기")));
			Else If(Event Player.R[11] == True);
				If(Event Player.A < Event Player.name[2]);
					Call Subroutine(empty_money);
					Abort;
				End;
				Event Player.R[11] = False;
				Event Player.A -= Event Player.name[2];
				Global.F[5].B += Event Player.name[2];
				Small Message(Event Player, Custom String("주사위를 던집니다..."));
				Event Player.Jobm[1] = Random Integer(1, 6);
				Event Player.Jobm[2] = Random Integer(1, 6);
				Wait(1, Ignore Condition);
				Small Message(Event Player, Custom String("첫번째 주사위 {0}!", Event Player.Jobm[1]));
				Wait(0.250, Ignore Condition);
				Small Message(Event Player, Custom String("두번째 주사위 {0}!", Event Player.Jobm[2]));
				Wait(1, Ignore Condition);
				If(Event Player.Jobm[1] == Event Player.Jobm[2]);
					Event Player.A += 5 * Event Player.name[2];
					Global.F[5].B -= 5 * Event Player.name[2];
					Small Message(Event Player, Custom String("더블 {0}! 축하합니다! {1}만 원의 5배인 {2}만 원을 획득했습니다!", Event Player.Jobm[1], Event Player.name[2],
						Event Player.name[2] * 5));
					Play Effect(Event Player, Buff Impact Sound, Color(Yellow), Event Player, 100);
				Else;
					Small Message(Event Player, Custom String("아쉽게도 더블이 아닙니다..."));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Event Player, 100);
				End;
				Event Player.H[0] = Custom String("도박꾼");
				Event Player.R[11] = True;
			End;
		Else If(Distance Between(Event Player, Global.jp[63]) <= 1);
			If(Event Player.R[10] == False);
				If(Event Player.C[24] != Custom String("운전 면허"));
					Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Event Player, 300);
					Small Message(Event Player, Custom String("운전 면허를 취득해야 구매할 수 있습니다"));
					Abort;
				Else If(Event Player.A < 40000);
					Call Subroutine(empty_money);
					Abort;
				Else If(Global.Stock[8] <= 0);
					Small Message(Event Player, Custom String("재고가 부족합니다"));
					Abort;
				End;
				Event Player.A -= 40000;
				Global.Tax += 40000 / 11;
				Global.Stock[8] -= 1;
				Small Message(Event Player, Custom String("스포츠카를 구매했다"));
				Event Player.R[10] = True;
				Wait(2, Ignore Condition);
				Small Message(Event Player, Custom String("Ctrl를 길게 눌러 스포츠카에 탑승/하차 할 수 있다"));
				Wait(2, Ignore Condition);
				Small Message(Event Player, Custom String("Ctrl를 길게 눌러 스포츠카에 탑승/하차 할 수 있다"));
			Else If(Event Player.R[10] == True);
				Event Player.A += 10000;
				Global.Stock[8] += 1;
				Small Message(Event Player, Custom String("스포츠카를 판매했다"));
				Event Player.R[10] = False;
