		Create In-World Text(And(Distance Between(Local Player, Value In Array(Global Variable(LocPos), 9)) < 13, Local Player.TutOn == 0) ? Local Player : False, Custom String("{0}{1}", Custom String("튜토리얼 — 처음이라면 여기서 (완주 보상 육포 3 · 물통 3 · $50)\r\n세이브 코드 — 발급받아 적어두면 다음 방에서 복원할 수 있다\r\n마을 금고 — $1,000씩 함께 보태 우물에서 기차역까지 여덟 단계\r\n"), Custom String("[{0}] 실행", Input Binding String(Button(Interact)))), Add(Value In Array(Global Variable(LocPos), 9), Vector(0, 1.5, 0)), 0.95, Do Not Clip, Visible To Position and String, Color(흰색), Default Visibility);
