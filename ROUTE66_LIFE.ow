rule("[월드 01] 시간 흐름")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(Ready) == 1;
	}

	action
	{
		Wait(2, Ignore Condition);
		Modify Global Variable(Clock, Add, 4);
		If(Global Variable(Clock) >= 1440);
			Set Global Variable(Clock, 0);
			Modify Global Variable(Day, Add, 1);
			Set Global Variable(OrePrice, Random Integer(2, 5));
			Set Global Variable(HidePrice, Random Integer(3, 6));
			Set Global Variable(DailyGoal, Add(320, Multiply(Global Variable(Day), 64)));
			Set Global Variable(TodayJob, Random Integer(1, 6));
			Big Message(All Players(All Teams), Custom String("새 아침 — 오늘은 {0}의 날! 해당 직업 보수 1.5배", Value In Array(Array(Custom String("뜨내기"), Custom String("광부"), Custom String("사냥꾼"), Custom String("현상금 사냥꾼"), Custom String("무법자"), Custom String("파발꾼"), Custom String("목동")), Global Variable(TodayJob))));
			Set Global Variable(ContractKind, Random Integer(1, 4));
			Set Global Variable(TickerMsg, Custom String("오늘의 계약 — {0} (달성 시 $150 · 명성 +3)", Value In Array(Array(Custom String("채굴 8회"), Custom String("야수 4마리"), Custom String("배달 3건"), Custom String("소몰이 2회")), Subtract(Global Variable(ContractKind), 1))));
			Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
			If(Modulo(Global Variable(Day), 3) == 0);
				Small Message(All Players(All Teams), Custom String("오늘은 열차의 날 — 저녁 8시, 열차가 협곡 철길목을 지난다"));
			End;
			Set Global Variable(TickerMsg, Custom String("{0}일차 — 새 아침. 원석 ${1} / 가죽 ${2}", Global Variable(Day), Global Variable(OrePrice), Global Variable(HidePrice)));
			Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
		End;
		If(And(Global Variable(IsNight) == 0, Or(Global Variable(Clock) >= 1200, Global Variable(Clock) < 360)));
			Set Global Variable(IsNight, 1);
			Set Global Variable(TickerMsg, Custom String("해가 졌다 — 마을의 불이 꺼진다"));
			Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
			Small Message(All Players(All Teams), Custom String("어둠 속에서는 길 위에서 뭔가 주울 확률이 오른다"));
			Play Effect(All Players(All Teams), Ring Explosion, Color(Orange), Value In Array(Global Variable(LocPos), 0), 6);
		Else If(And(Global Variable(IsNight) == 1, And(Global Variable(Clock) >= 360, Global Variable(Clock) < 1200)));
			Set Global Variable(IsNight, 0);
			Set Global Variable(TickerMsg, Custom String("동이 텄다 — 마을에 다시 불이 들어온다"));
			Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
		End;
		Loop();
	}
}

rule("[월드 02] 욕구 감소")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
	}

	action
	{
		Wait(10, Ignore Condition);
		If(Event Player.TutOn == 0);
			Set Player Variable(Event Player, Hunger, Max(0, Subtract(Event Player.Hunger, 1.2)));
			Set Player Variable(Event Player, Thirst, Max(0, Subtract(Event Player.Thirst, Event Player.Rebuild >= 1 ? 1.2 : 1.5)));
			Set Player Variable(Event Player, Energy, Max(0, Subtract(Event Player.Energy, 0.5)));
		End;
		Loop();
	}
}

rule("[월드 03] 결핍 패널티")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
	}

	action
	{
		Wait(5, Ignore Condition);
		If(Or(Event Player.Hunger <= 0, Event Player.Thirst <= 0));
			Damage(Event Player, Null, 8);
			If(Event Player.Sprinting == 0);
				Set Move Speed(Event Player, 70);
			End;
			Small Message(Event Player, Custom String("탈진 — 먹을 것이나 물이 필요하다"));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 60);
		Else If(Event Player.Energy <= 0);
			If(Event Player.Sprinting == 0);
				Set Move Speed(Event Player, 80);
			End;
			Set Aim Speed(Event Player, 70);
		Else;
			If(Event Player.Sprinting == 0);
				Set Move Speed(Event Player, And(Event Player.HasBag == 0, Event Player.HasHorse == 0) ? 110 : 100);
				If(Event Player.Job == 3);
					Set Move Speed(Event Player, 115);
				End;
			End;
			Set Aim Speed(Event Player, 100);
			If(And(Event Player.Hunger > 50, Event Player.Thirst > 50));
				Heal(Event Player, Null, 5);
			End;
		End;
		Loop();
	}
}

rule("[월드 04] 구역 감지")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Global Variable(Ready) == 1;
	}

	action
	{
		Set Player Variable(Event Player, Tmp, -1);
		Set Player Variable(Event Player, ZoneDist, 9999);
		For Player Variable(Event Player, Idx, 0, 15, 1);
			If(And(Distance Between(Position Of(Event Player), Value In Array(Global Variable(LocPos), Event Player.Idx)) <= Value In Array(Global Variable(LocRad), Event Player.Idx), Distance Between(Position Of(Event Player), Value In Array(Global Variable(LocPos), Event Player.Idx)) < Event Player.ZoneDist));
				Set Player Variable(Event Player, Tmp, Event Player.Idx);
				Set Player Variable(Event Player, ZoneDist, Distance Between(Position Of(Event Player), Value In Array(Global Variable(LocPos), Event Player.Idx)));
			End;
		End;
		If(Event Player.Tmp != Event Player.Zone);
			Set Player Variable(Event Player, Zone, Event Player.Tmp);
			Set Player Variable(Event Player, MenuIdx, 0);
		End;
		Wait(Server Load() > 200 ? 0.8 : 0.35, Ignore Condition);
		Loop();
	}
}

rule("[월드 09] 낮 — 해가 뜬다")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(Ready) == 1;
		Global Variable(IsNight) == 0;
	}

	action
	{
		For Global Variable(Idx, 0, 19, 1);
			Destroy Effect(Value In Array(Global Variable(SignIds), Global Variable(Idx)));
		End;
		Set Global Variable(SignIds, Empty Array);
		Create Effect(All Players(All Teams), Light Shaft, Color(흰색), Value In Array(Global Variable(LocPos), 0), 1.2, Visible To Position Radius and Color);
		Modify Global Variable(SignIds, Append To Array, Last Created Entity());
		Create Effect(All Players(All Teams), Light Shaft, Color(흰색), Value In Array(Global Variable(LocPos), 1), 1.2, Visible To Position Radius and Color);
		Modify Global Variable(SignIds, Append To Array, Last Created Entity());
		Create Effect(All Players(All Teams), Light Shaft, Color(흰색), Value In Array(Global Variable(LocPos), 2), 1.2, Visible To Position Radius and Color);
		Modify Global Variable(SignIds, Append To Array, Last Created Entity());
		Create Effect(All Players(All Teams), Light Shaft, Color(흰색), Value In Array(Global Variable(LocPos), 3), 1.2, Visible To Position Radius and Color);
		Modify Global Variable(SignIds, Append To Array, Last Created Entity());
		Create Effect(All Players(All Teams), Light Shaft, Color(흰색), Value In Array(Global Variable(LocPos), 4), 1.2, Visible To Position Radius and Color);
		Modify Global Variable(SignIds, Append To Array, Last Created Entity());
		Create Effect(All Players(All Teams), Light Shaft, Color(흰색), Value In Array(Global Variable(LocPos), 5), 1.2, Visible To Position Radius and Color);
		Modify Global Variable(SignIds, Append To Array, Last Created Entity());
		Create Effect(All Players(All Teams), Light Shaft, Color(흰색), Value In Array(Global Variable(LocPos), 6), 1.2, Visible To Position Radius and Color);
		Modify Global Variable(SignIds, Append To Array, Last Created Entity());
		Create Effect(All Players(All Teams), Light Shaft, Color(흰색), Value In Array(Global Variable(LocPos), 7), 1.2, Visible To Position Radius and Color);
		Modify Global Variable(SignIds, Append To Array, Last Created Entity());
		Create Effect(All Players(All Teams), Light Shaft, Color(흰색), Value In Array(Global Variable(LocPos), 8), 1.2, Visible To Position Radius and Color);
		Modify Global Variable(SignIds, Append To Array, Last Created Entity());
		Create Effect(All Players(All Teams), Light Shaft, Color(Aqua), Value In Array(Global Variable(LocPos), 9), 1.2, Visible To Position Radius and Color);
		Modify Global Variable(SignIds, Append To Array, Last Created Entity());
		Create Effect(All Players(All Teams), Sphere, Color(Yellow), Add(Divide(Add(Value In Array(Global Variable(LocPos), 0), Value In Array(Global Variable(LocPos), 8)), 2), Vector(0, 90, 0)), 22, Visible To Position Radius and Color);
		Modify Global Variable(SignIds, Append To Array, Last Created Entity());
		Create Effect(All Players(All Teams), Good Aura, Color(흰색), Add(Divide(Add(Value In Array(Global Variable(LocPos), 0), Value In Array(Global Variable(LocPos), 8)), 2), Vector(0, 90, 0)), 55, Visible To Position Radius and Color);
		Modify Global Variable(SignIds, Append To Array, Last Created Entity());
		Create Effect(All Players(All Teams), Good Aura, Color(흰색), Add(Value In Array(Global Variable(LocPos), 0), Vector(0, 55, 0)), 30, Visible To Position Radius and Color);
		Modify Global Variable(SignIds, Append To Array, Last Created Entity());
		Create Effect(All Players(All Teams), Good Aura, Color(흰색), Add(Value In Array(Global Variable(LocPos), 4), Vector(0, 55, 0)), 30, Visible To Position Radius and Color);
		Modify Global Variable(SignIds, Append To Array, Last Created Entity());
		Create Effect(All Players(All Teams), Good Aura, Color(흰색), Add(Value In Array(Global Variable(LocPos), 7), Vector(0, 55, 0)), 30, Visible To Position Radius and Color);
		Modify Global Variable(SignIds, Append To Array, Last Created Entity());
		Create Effect(All Players(All Teams), Light Shaft, Color(흰색), Value In Array(Global Variable(LocPos), 11), 1.2, Visible To Position Radius and Color);
		Modify Global Variable(SignIds, Append To Array, Last Created Entity());
		Create Effect(All Players(All Teams), Light Shaft, Color(흰색), Value In Array(Global Variable(LocPos), 12), 1.2, Visible To Position Radius and Color);
		Modify Global Variable(SignIds, Append To Array, Last Created Entity());
		Create Effect(All Players(All Teams), Light Shaft, Color(흰색), Value In Array(Global Variable(LocPos), 13), 1.2, Visible To Position Radius and Color);
		Modify Global Variable(SignIds, Append To Array, Last Created Entity());
		Create Effect(All Players(All Teams), Light Shaft, Color(흰색), Value In Array(Global Variable(LocPos), 14), 1.2, Visible To Position Radius and Color);
		Modify Global Variable(SignIds, Append To Array, Last Created Entity());
	}
}

rule("[월드 10] 밤 — 해가 진다")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(Ready) == 1;
		Global Variable(IsNight) == 1;
	}

	action
	{
		For Global Variable(Idx, 0, 19, 1);
			Destroy Effect(Value In Array(Global Variable(SignIds), Global Variable(Idx)));
		End;
		Set Global Variable(SignIds, Empty Array);
	}
}

rule("[평판 01] 죄는 이름을 갉는다")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Noto != Event Player.LastNoto;
	}

	action
	{
		If(Event Player.Noto > Event Player.LastNoto);
			If(Round To Integer(Divide(Subtract(Event Player.Noto, Event Player.LastNoto), 2), Up) >= 3);
				Small Message(Event Player, Custom String("소문이 퍼진다 — 명성 {0} (-{1})", Max(0, Subtract(Event Player.Fame, Round To Integer(Divide(Subtract(Event Player.Noto, Event Player.LastNoto), 2), Up))), Round To Integer(Divide(Subtract(Event Player.Noto, Event Player.LastNoto), 2), Up)));
			End;
			Set Player Variable(Event Player, Fame, Max(0, Subtract(Event Player.Fame, Round To Integer(Divide(Subtract(Event Player.Noto, Event Player.LastNoto), 2), Up))));
		End;
		Set Player Variable(Event Player, LastNoto, Event Player.Noto);
	}
}


rule("[월드 05] 아침 정산")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Event Player.LastDay != Global Variable(Day);
	}

	action
	{
		Set Player Variable(Event Player, LastDay, Global Variable(Day));
		Set Player Variable(Event Player, Whisky, 0);
		Set Player Variable(Event Player, GoalDone, 0);
		Set Player Variable(Event Player, Giant, Multiply(Round To Integer(Divide(Event Player.Giant, 10), Down), 10));
		If(Global Variable(FundTier) >= 3);
			Set Player Variable(Event Player, Fame, Min(100, Add(Event Player.Fame, 1)));
		End;
		If(And(Event Player.Rebirth >= 1, Event Player.Earned > Event Player.DayStart));
			Set Player Variable(Event Player, Amt, Round To Integer(Multiply(Subtract(Event Player.Earned, Event Player.DayStart), Multiply(0.1, Event Player.Rebirth)), Down));
			If(Event Player.Amt >= 1);
				Modify Player Variable(Event Player, Money, Add, Event Player.Amt);
				Modify Player Variable(Event Player, Earned, Add, Event Player.Amt);
				Small Message(Event Player, Custom String("환생의 가호 — 어제 수입의 {0}%, +$ {1}", Multiply(10, Event Player.Rebirth), Event Player.Amt));
			End;
		End;
		If(Event Player.Deposit >= 100);
			Set Player Variable(Event Player, Amt, Min(200, Round To Integer(Multiply(Event Player.Deposit, 0.01), Down)));
			Modify Player Variable(Event Player, Deposit, Add, Event Player.Amt);
			Small Message(Event Player, Custom String("은행 이자 +$ {0} (예금 $ {1})", Event Player.Amt, Event Player.Deposit));
		End;
		Set Player Variable(Event Player, DayStart, Event Player.Earned);
		Set Player Variable(Event Player, Noto, Max(0, Subtract(Event Player.Noto, 2)));
		Set Player Variable(Event Player, Fame, Max(0, Subtract(Event Player.Fame, 1)));
		Play Effect(Event Player, Buff Impact Sound, Color(Yellow), Position Of(Event Player), 70);
	}
}

rule("[월드 06] 일일 목표 달성")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Event Player.GoalDone == 0;
		Subtract(Event Player.Earned, Event Player.DayStart) >= Global Variable(DailyGoal);
	}

	action
	{
		Set Player Variable(Event Player, GoalDone, 1);
		Modify Player Variable(Event Player, Money, Add, Event Player.Rebuild >= 2 ? 400 : 200);
		Modify Player Variable(Event Player, Earned, Add, Event Player.Rebuild >= 2 ? 400 : 200);
		Set Player Variable(Event Player, Fame, Min(100, Add(Event Player.Fame, 3)));
		Big Message(Event Player, Custom String("오늘의 목표 달성 — 보너스 $ {0}", Event Player.Rebuild >= 2 ? 400 : 200));
		Play Effect(Event Player, Good Explosion, Color(Lime Green), Position Of(Event Player), 2);
	}
}

rule("[월드 07] 재산 순위 갱신")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(Ready) == 1;
	}

	action
	{
		Set Global Variable(RankArr, Sorted Array(Filtered Array(All Players(All Teams), Player Variable(Current Array Element, Init) == 1), Subtract(0, Add(Player Variable(Current Array Element, Money), Player Variable(Current Array Element, Deposit)))));
		Wait(3, Ignore Condition);
		Loop();
	}
}

rule("[코어 13] 2팀은 야수 전용")
{
	event
	{
		Ongoing - Each Player;
		Team 2;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
	}

	action
	{
		Move Player to Team(Event Player, Team 1, -1);
		Wait(1.5, Ignore Condition);
		If(Team Of(Event Player) == Team 2);
			Small Message(Event Player, Custom String("2팀은 야수의 자리다 — 1팀이 비면 알아서 옮겨준다"));
			Wait(3, Ignore Condition);
			Loop();
		End;
	}
}

rule("[조작 01] 행동 커서 이동 (R)")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Busy == 0;
		Global Variable(ArchOn) == 0;
		Event Player.SaveOn == 0;
		Is Button Held(Event Player, Button(Reload)) == True;
	}

	action
	{
		Set Player Variable(Event Player, MenuIdx, Modulo(Add(Event Player.MenuIdx, 1), Value In Array(Array(1, 1, 3, 4, 2, 3, 6, 2, 5, 6, 6, 5, 6, 4, 1, 1), Add(Event Player.Zone, 1))));
		Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Position Of(Event Player), 60);
	}
}

rule("[조작 02] 육포 먹기 (E)")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Is Alive(Event Player) == True;
		Is Button Held(Event Player, Button(Ability 2)) == True;
	}

	action
	{
		If(Hero Of(Event Player) == Hero(시온));
			Abort;
		End;
		If(Value In Array(Event Player.Inv, 0) >= 1);
			Set Player Variable At Index(Event Player, Inv, 0, Subtract(Value In Array(Event Player.Inv, 0), 1));
			Set Player Variable(Event Player, Hunger, Min(100, Add(Event Player.Hunger, 20)));
			Heal(Event Player, Null, 15);
			Small Message(Event Player, Custom String("육포를 먹었다 — 허기 {0}", Round To Integer(Event Player.Hunger, Down)));
			Play Effect(Event Player, Buff Impact Sound, Color(Lime Green), Position Of(Event Player), 50);
		Else;
			Small Message(Event Player, Custom String("육포가 없다 — 주유소 잡화점에서 판다"));
		End;
	}
}

rule("[조작 02-2] 물 마시기 (Q)")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Is Alive(Event Player) == True;
		Is Button Held(Event Player, Button(Ultimate)) == True;
	}

	action
	{
		If(And(Event Player.Rebuild >= 1, Event Player.Zone == 9));
			Set Player Variable(Event Player, Thirst, Min(100, Add(Event Player.Thirst, 20)));
			Heal(Event Player, Null, 10);
			Small Message(Event Player, Custom String("마을 우물의 물 — 물통이 축나지 않았다 (갈증 {0})", Round To Integer(Event Player.Thirst, Down)));
			Play Effect(Event Player, Buff Impact Sound, Color(Sky Blue), Position Of(Event Player), 50);
		Else If(Value In Array(Event Player.Inv, 1) >= 1);
			Set Player Variable At Index(Event Player, Inv, 1, Subtract(Value In Array(Event Player.Inv, 1), 1));
			Set Player Variable(Event Player, Thirst, Min(100, Add(Event Player.Thirst, 20)));
			Heal(Event Player, Null, 10);
			Small Message(Event Player, Custom String("물을 마셨다 — 갈증 {0}", Round To Integer(Event Player.Thirst, Down)));
			Play Effect(Event Player, Buff Impact Sound, Color(Sky Blue), Position Of(Event Player), 50);
		Else;
			Small Message(Event Player, Custom String("물통이 없다 — 주유소 잡화점에서 판다"));
		End;
	}
}

rule("[조작 04] 달리기 (Shift)")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Contraband == 0;
		Event Player.Sack == 0;
		Event Player.Escort == 0;
		Event Player.Init == 1;
		Is Alive(Event Player) == True;
		Event Player.Busy == 0;
		Event Player.Energy > 0;
		Is Moving(Event Player) == True;
		Is Button Held(Event Player, Button(Ability 1)) == True;
	}

	action
	{
		Set Player Variable(Event Player, Sprinting, 1);
		Set Move Speed(Event Player, 165);
		Wait(Add(3, Multiply(Event Player.HasBag, 3)), Ignore Condition);
		Set Player Variable(Event Player, Energy, Max(0, Subtract(Event Player.Energy, 1)));
		Loop If(And(Is Button Held(Event Player, Button(Ability 1)), And(Is Moving(Event Player), And(Event Player.Energy > 0, And(Event Player.Busy == 0, And(Is Alive(Event Player), And(Event Player.Contraband == 0, And(Event Player.Sack == 0, Event Player.Escort == 0))))))));
		Set Player Variable(Event Player, Sprinting, 0);
		If(Or(Event Player.Hunger <= 0, Event Player.Thirst <= 0));
			Set Move Speed(Event Player, 70);
		Else If(Event Player.Energy <= 0);
			Set Move Speed(Event Player, 80);
		Else;
			Set Move Speed(Event Player, And(Event Player.HasBag == 0, Event Player.HasHorse == 0) ? 110 : 100);
			If(Event Player.Job == 3);
				Set Move Speed(Event Player, 115);
			End;
		End;
	}
}

rule("[조작 05] 바이크 질주 (시온 E)")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Hero Of(Event Player) == Hero(시온);
		Is Using Ability 2(Event Player) == True;
		Is Alive(Event Player) == True;
		Event Player.Contraband == 0;
		Event Player.Sack == 0;
		Event Player.Escort == 0;
	}

	action
	{
		Set Player Variable(Event Player, Sprinting, 1);
		Set Move Speed(Event Player, 200);
		Wait(0.25, Ignore Condition);
		Loop If(And(Is Using Ability 2(Event Player), And(Is Alive(Event Player), And(Event Player.Contraband == 0, And(Event Player.Sack == 0, Event Player.Escort == 0)))));
		Set Player Variable(Event Player, Sprinting, 0);
		If(Or(Event Player.Hunger <= 0, Event Player.Thirst <= 0));
			Set Move Speed(Event Player, 70);
		Else If(Event Player.Energy <= 0);
			Set Move Speed(Event Player, 80);
		Else;
			Set Move Speed(Event Player, And(Event Player.HasBag == 0, Event Player.HasHorse == 0) ? 110 : 100);
			If(Event Player.Job == 3);
				Set Move Speed(Event Player, 115);
			End;
		End;
	}
}

rule("[코어 12] 3인칭 시점 고정")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Event Player.TutOn == 0;
		Is Alive(Event Player) == True;
	}

	action
	{
		Wait(0.3, Ignore Condition);
		Start Camera(Event Player, Ray Cast Hit Position(Add(Position Of(Event Player), Vector(0, 1.9, 0)), Add(Add(Position Of(Event Player), Vector(0, 1.9, 0)), Multiply(Facing Direction Of(Event Player), -4)), Empty Array, All Players(All Teams), False), Add(Add(Position Of(Event Player), Vector(0, 1.9, 0)), Multiply(Facing Direction Of(Event Player), 6)), 50);
	}
}

rule("[조작 03a] 행동 실행 — 식당·광산·잡화점·모텔·정비소")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Busy == 0;
		Event Player.Zone != -1;
		Is Alive(Event Player) == True;
		Global Variable(ArchOn) == 0;
		Or(Event Player.Escort == 0, Distance Between(Position Of(Event Player), Event Player.EscortPos) >= 4) == True;
		Or(Global Variable(WagonOn) == 0, Distance Between(Position Of(Event Player), Global Variable(WagonPos)) >= 4) == True;
		Or(Global Variable(HuntPhase) != 1, Distance Between(Position Of(Event Player), Global Variable(HuntTrackPos)) >= 5) == True;
		Is Button Held(Event Player, Button(Crouch)) == False;
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	action
	{
		If(And(Event Player.Bounty >= 800, Array Contains(Array(0, 2, 3, 4, 10, 13, 14), Event Player.Zone)));
			Small Message(Event Player, Custom String("수배범과는 거래하지 않는다 — 은신처로 가라"));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			Abort;
		End;
		If(Or(Or(Event Player.Zone == 0, Event Player.Zone == 13), Event Player.Zone == 14));
			Set Player Variable(Event Player, Amt, Round To Integer(Multiply(36, Subtract(1, Multiply(Subtract(Event Player.Fame, Event Player.Noto), 0.002))), To Nearest));
			If(Event Player.Money >= Event Player.Amt);
				Modify Player Variable(Event Player, Money, Subtract, Event Player.Amt);
				If(And(Entity Exists(Value In Array(Global Variable(BldOwner), 0)), Value In Array(Global Variable(BldOwner), 0) != Event Player));
					Set Player Variable(Value In Array(Global Variable(BldOwner), 0), Rent, Max(1, Round To Integer(Multiply(Event Player.Amt, 0.1), To Nearest)));
					Modify Player Variable(Value In Array(Global Variable(BldOwner), 0), Money, Add, Player Variable(Value In Array(Global Variable(BldOwner), 0), Rent));
					Small Message(Value In Array(Global Variable(BldOwner), 0), Custom String("임대 수입 +$ {0}", Player Variable(Value In Array(Global Variable(BldOwner), 0), Rent)));
				End;
				Set Player Variable(Event Player, Hunger, Min(100, Add(Event Player.Hunger, 60)));
				Set Player Variable(Event Player, Thirst, Min(100, Add(Event Player.Thirst, 60)));
				Heal(Event Player, Null, 60);
				Small Message(Event Player, Custom String("따뜻한 식사 — 허기 {0} · 갈증 {1}", Round To Integer(Event Player.Hunger, Down), Round To Integer(Event Player.Thirst, Down)));
				Play Effect(Event Player, Buff Impact Sound, Color(Lime Green), Position Of(Event Player), 60);
			Else;
				Small Message(Event Player, Custom String("돈이 모자란다 ($ {0} 필요)", Event Player.Amt));
				Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			End;
		Else If(Event Player.Zone == 1);
			If(Event Player.MenuIdx == 0);
				Call Subroutine(DoMine);
			Else If(Event Player.MenuIdx == 1);
				Set Player Variable(Event Player, Amt, And(Event Player.Job == 1, Value In Array(Event Player.Adv, Event Player.Job) == 1) ? 0 : 20);
				If(Event Player.Money >= Event Player.Amt);
					Modify Player Variable(Event Player, Money, Subtract, Event Player.Amt);
					Set Player Variable(Event Player, Prospect, Add(Event Player.Prospect, 3));
					Small Message(Event Player, Custom String("정밀 탐사 — 다음 3회 채굴의 대박 확률 상승"));
					Play Effect(Event Player, Buff Impact Sound, Color(Yellow), Position Of(Event Player), 50);
				Else;
					Small Message(Event Player, Custom String("돈이 모자란다 ($ {0} 필요)", Event Player.Amt));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				End;
			Else;
				If(Event Player.Job != 1);
					Small Message(Event Player, Custom String("광부만 승급할 수 있다 — 채굴이 너를 광부로 만든다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Value In Array(Event Player.Adv, Event Player.Job) == 1);
					Small Message(Event Player, Custom String("이미 광산주다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Value In Array(Event Player.JobXP, 1) < 1000);
					Small Message(Event Player, Custom String("경험이 부족하다 — {0} / 1000", Value In Array(Event Player.JobXP, 1)));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else;
					Set Player Variable At Index(Event Player, Adv, Event Player.Job, 1);
					Big Message(All Players(All Teams), Custom String("{0} — 광산주로 올라섰다!", Event Player));
					Small Message(Event Player, Custom String("정밀 탐사 무료 · 채굴 10% 확률로 수확 2배"));
					Play Effect(All Players(All Teams), Ring Explosion, Color(Yellow), Position Of(Event Player), 4);
					Play Effect(Event Player, Buff Explosion Sound, Color(Yellow), Position Of(Event Player), 200);
				End;
			End;
		Else If(Event Player.Zone == 2);
			If(Event Player.MenuIdx == 0);
				Set Player Variable(Event Player, Amt, Round To Integer(Multiply(22, Subtract(1, Multiply(Subtract(Event Player.Fame, Event Player.Noto), 0.002))), To Nearest));
				If(Global Variable(JerkyStock) < 1);
					Small Message(Event Player, Custom String("육포 재고가 없다 — 사냥꾼·목동이 채워줄 것이다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.Money >= Event Player.Amt);
					Modify Player Variable(Event Player, Money, Subtract, Event Player.Amt);
					Modify Global Variable(JerkyStock, Subtract, 1);
					Set Player Variable At Index(Event Player, Inv, 0, Add(Value In Array(Event Player.Inv, 0), 1));
					If(And(Entity Exists(Value In Array(Global Variable(BldOwner), 2)), Value In Array(Global Variable(BldOwner), 2) != Event Player));
						Set Player Variable(Value In Array(Global Variable(BldOwner), 2), Rent, Max(1, Round To Integer(Multiply(Event Player.Amt, 0.1), To Nearest)));
						Modify Player Variable(Value In Array(Global Variable(BldOwner), 2), Money, Add, Player Variable(Value In Array(Global Variable(BldOwner), 2), Rent));
						Small Message(Value In Array(Global Variable(BldOwner), 2), Custom String("임대 수입 +$ {0}", Player Variable(Value In Array(Global Variable(BldOwner), 2), Rent)));
					End;
					Small Message(Event Player, Custom String("육포를 샀다 (보유 {0})", Value In Array(Event Player.Inv, 0)));
					Play Effect(Event Player, Buff Impact Sound, Color(Lime Green), Position Of(Event Player), 55);
					Play Effect(Event Player, Good Pickup Effect, Color(Lime Green), Position Of(Event Player), 1);
				Else;
					Small Message(Event Player, Custom String("돈이 모자란다 ($ {0} 필요)", Event Player.Amt));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				End;
			Else If(Event Player.MenuIdx == 1);
				Set Player Variable(Event Player, Amt, Round To Integer(Multiply(15, Subtract(1, Multiply(Subtract(Event Player.Fame, Event Player.Noto), 0.002))), To Nearest));
				If(Event Player.Money >= Event Player.Amt);
					Modify Player Variable(Event Player, Money, Subtract, Event Player.Amt);
					Set Player Variable At Index(Event Player, Inv, 1, Add(Value In Array(Event Player.Inv, 1), 1));
					If(And(Entity Exists(Value In Array(Global Variable(BldOwner), 2)), Value In Array(Global Variable(BldOwner), 2) != Event Player));
						Set Player Variable(Value In Array(Global Variable(BldOwner), 2), Rent, Max(1, Round To Integer(Multiply(Event Player.Amt, 0.1), To Nearest)));
						Modify Player Variable(Value In Array(Global Variable(BldOwner), 2), Money, Add, Player Variable(Value In Array(Global Variable(BldOwner), 2), Rent));
						Small Message(Value In Array(Global Variable(BldOwner), 2), Custom String("임대 수입 +$ {0}", Player Variable(Value In Array(Global Variable(BldOwner), 2), Rent)));
					End;
					Small Message(Event Player, Custom String("물통을 샀다 (보유 {0})", Value In Array(Event Player.Inv, 1)));
					Play Effect(Event Player, Buff Impact Sound, Color(Lime Green), Position Of(Event Player), 55);
					Play Effect(Event Player, Good Pickup Effect, Color(Lime Green), Position Of(Event Player), 1);
				Else;
					Small Message(Event Player, Custom String("돈이 모자란다 ($ {0} 필요)", Event Player.Amt));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				End;
			Else If(Event Player.MenuIdx == 2);
				Set Player Variable(Event Player, Amt, Round To Integer(Multiply(95, Subtract(1, Multiply(Subtract(Event Player.Fame, Event Player.Noto), 0.002))), To Nearest));
				If(Global Variable(JerkyStock) < 5);
					Small Message(Event Player, Custom String("묶음을 만들 재고가 없다 (현재 {0}) — 사냥꾼·목동이 채워줄 것이다", Global Variable(JerkyStock)));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.Money >= Event Player.Amt);
					Modify Player Variable(Event Player, Money, Subtract, Event Player.Amt);
					Modify Global Variable(JerkyStock, Subtract, 5);
					Set Player Variable At Index(Event Player, Inv, 0, Add(Value In Array(Event Player.Inv, 0), 5));
					If(And(Entity Exists(Value In Array(Global Variable(BldOwner), 2)), Value In Array(Global Variable(BldOwner), 2) != Event Player));
						Set Player Variable(Value In Array(Global Variable(BldOwner), 2), Rent, Max(1, Round To Integer(Multiply(Event Player.Amt, 0.1), To Nearest)));
						Modify Player Variable(Value In Array(Global Variable(BldOwner), 2), Money, Add, Player Variable(Value In Array(Global Variable(BldOwner), 2), Rent));
						Small Message(Value In Array(Global Variable(BldOwner), 2), Custom String("임대 수입 +$ {0}", Player Variable(Value In Array(Global Variable(BldOwner), 2), Rent)));
					End;
					Small Message(Event Player, Custom String("육포 5개 묶음 구매 (보유 {0})", Value In Array(Event Player.Inv, 0)));
					Play Effect(Event Player, Buff Impact Sound, Color(Lime Green), Position Of(Event Player), 55);
					Play Effect(Event Player, Good Pickup Effect, Color(Lime Green), Position Of(Event Player), 1);
				Else;
					Small Message(Event Player, Custom String("돈이 모자란다 ($ {0} 필요)", Event Player.Amt));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				End;
			Else If(Event Player.MenuIdx == 3);
				If(Add(Value In Array(Event Player.Inv, 2), Value In Array(Event Player.Inv, 3)) <= 0);
					Small Message(Event Player, Custom String("팔 원석도 가죽도 없다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else;
					Set Player Variable(Event Player, SellSum, Round To Integer(Multiply(Multiply(Multiply(Add(Multiply(Value In Array(Event Player.Inv, 2), Global Variable(OrePrice)), Multiply(Value In Array(Event Player.Inv, 3), Global Variable(HidePrice))), Global Variable(SellMult)), 0.9), Add(1, Multiply(Subtract(Event Player.Fame, Event Player.Noto), 0.0015))), To Nearest));
					Modify Player Variable(Event Player, Money, Add, Event Player.SellSum);
					Modify Player Variable(Event Player, Earned, Add, Event Player.SellSum);
					Set Player Variable At Index(Event Player, Inv, 2, 0);
					Set Player Variable At Index(Event Player, Inv, 3, 0);
					Small Message(Event Player, Custom String("잡화점에 전부 넘겼다 — $ {0}   (시세 90%)", Event Player.SellSum));
					If(And(Entity Exists(Value In Array(Global Variable(BldOwner), 2)), Value In Array(Global Variable(BldOwner), 2) != Event Player));
						Set Player Variable(Value In Array(Global Variable(BldOwner), 2), Rent, Max(1, Round To Integer(Multiply(Event Player.SellSum, 0.1), To Nearest)));
						Modify Player Variable(Value In Array(Global Variable(BldOwner), 2), Money, Add, Player Variable(Value In Array(Global Variable(BldOwner), 2), Rent));
						Small Message(Value In Array(Global Variable(BldOwner), 2), Custom String("임대 수입 +$ {0}", Player Variable(Value In Array(Global Variable(BldOwner), 2), Rent)));
					End;
					Play Effect(Event Player, Buff Explosion Sound, Color(Yellow), Position Of(Event Player), 100);
				End;
			End;
		Else If(Event Player.Zone == 3);
			If(Event Player.MenuIdx == 0);
				Call Subroutine(DoSleep);
			Else;
				If(Event Player.HasHome == 1);
					Small Message(Event Player, Custom String("이미 내 방이 있다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.Money >= 22000);
					Modify Player Variable(Event Player, Money, Subtract, 22000);
					If(And(Entity Exists(Value In Array(Global Variable(BldOwner), 3)), Value In Array(Global Variable(BldOwner), 3) != Event Player));
						Set Player Variable(Value In Array(Global Variable(BldOwner), 3), Rent, Max(1, Round To Integer(Multiply(22000, 0.1), To Nearest)));
						Modify Player Variable(Value In Array(Global Variable(BldOwner), 3), Money, Add, Player Variable(Value In Array(Global Variable(BldOwner), 3), Rent));
						Small Message(Value In Array(Global Variable(BldOwner), 3), Custom String("임대 수입 +$ {0}", Player Variable(Value In Array(Global Variable(BldOwner), 3), Rent)));
					End;
					Set Player Variable(Event Player, HasHome, 1);
					Big Message(All Players(All Teams), Custom String("{0} — 모텔에 자기 방을 마련했다", Event Player));
					Small Message(Event Player, Custom String("숙박 회복이 80으로 늘고, 죽어도 잃는 돈이 15%에서 5%로 줄어든다"));
					Play Effect(All Players(All Teams), Ring Explosion, Color(Yellow), Position Of(Event Player), 3);
				Else;
					Small Message(Event Player, Custom String("돈이 모자란다 ($22000 필요)"));
				End;
			End;
		Else If(Event Player.Zone == 4);
			If(Event Player.MenuIdx == 0);
				If(Value In Array(Event Player.Inv, 2) > 0);
					Set Player Variable(Event Player, SellQty, Value In Array(Event Player.Inv, 2));
					Set Player Variable(Event Player, SellSum, Round To Integer(Multiply(Multiply(Multiply(Event Player.SellQty, Global Variable(OrePrice)), Global Variable(SellMult)), Add(1, Multiply(Subtract(Event Player.Fame, Event Player.Noto), 0.0015))), To Nearest));
					Modify Player Variable(Event Player, Money, Add, Event Player.SellSum);
					Modify Player Variable(Event Player, Earned, Add, Event Player.SellSum);
					Small Message(Event Player, Custom String("원석 {0}개 판매 — $ {1}", Event Player.SellQty, Event Player.SellSum));
					If(And(Entity Exists(Value In Array(Global Variable(BldOwner), 4)), Value In Array(Global Variable(BldOwner), 4) != Event Player));
						Set Player Variable(Value In Array(Global Variable(BldOwner), 4), Rent, Max(1, Round To Integer(Multiply(Event Player.SellSum, 0.1), To Nearest)));
						Modify Player Variable(Value In Array(Global Variable(BldOwner), 4), Money, Add, Player Variable(Value In Array(Global Variable(BldOwner), 4), Rent));
						Small Message(Value In Array(Global Variable(BldOwner), 4), Custom String("임대 수입 +$ {0}", Player Variable(Value In Array(Global Variable(BldOwner), 4), Rent)));
					End;
					Set Player Variable At Index(Event Player, Inv, 2, 0);
					Play Effect(Event Player, Buff Explosion Sound, Color(Yellow), Position Of(Event Player), 100);
				Else;
					Small Message(Event Player, Custom String("팔 원석이 없다"));
				End;
			Else If(Event Player.MenuIdx == 1);
				If(Value In Array(Event Player.Inv, 3) > 0);
					Set Player Variable(Event Player, SellQty, Value In Array(Event Player.Inv, 3));
					Set Player Variable(Event Player, SellSum, Round To Integer(Multiply(Multiply(Multiply(Event Player.SellQty, Global Variable(HidePrice)), Global Variable(SellMult)), Add(1, Multiply(Subtract(Event Player.Fame, Event Player.Noto), 0.0015))), To Nearest));
					Modify Player Variable(Event Player, Money, Add, Event Player.SellSum);
					Modify Player Variable(Event Player, Earned, Add, Event Player.SellSum);
					Small Message(Event Player, Custom String("가죽 {0}장 판매 — $ {1}", Event Player.SellQty, Event Player.SellSum));
					If(And(Entity Exists(Value In Array(Global Variable(BldOwner), 4)), Value In Array(Global Variable(BldOwner), 4) != Event Player));
						Set Player Variable(Value In Array(Global Variable(BldOwner), 4), Rent, Max(1, Round To Integer(Multiply(Event Player.SellSum, 0.1), To Nearest)));
						Modify Player Variable(Value In Array(Global Variable(BldOwner), 4), Money, Add, Player Variable(Value In Array(Global Variable(BldOwner), 4), Rent));
						Small Message(Value In Array(Global Variable(BldOwner), 4), Custom String("임대 수입 +$ {0}", Player Variable(Value In Array(Global Variable(BldOwner), 4), Rent)));
					End;
					Set Player Variable At Index(Event Player, Inv, 3, 0);
					Play Effect(Event Player, Buff Explosion Sound, Color(Orange), Position Of(Event Player), 100);
				Else;
					Small Message(Event Player, Custom String("팔 가죽이 없다"));
				End;
			Else;
				Small Message(Event Player, Custom String("오늘 시세 — 원석 $ {0} / 가죽 $ {1}", Global Variable(OrePrice), Global Variable(HidePrice)));
				Play Effect(Event Player, Debuff Impact Sound, Color(Sky Blue), Position Of(Event Player), 25);
			End;
		End;
	}
}

rule("[조작 03b] 행동 실행 — 술집·개활지·초소·은신처")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Busy == 0;
		Event Player.Zone != -1;
		Is Alive(Event Player) == True;
		Global Variable(ArchOn) == 0;
		Or(Event Player.Escort == 0, Distance Between(Position Of(Event Player), Event Player.EscortPos) >= 4) == True;
		Or(Global Variable(WagonOn) == 0, Distance Between(Position Of(Event Player), Global Variable(WagonPos)) >= 4) == True;
		Or(Global Variable(HuntPhase) != 1, Distance Between(Position Of(Event Player), Global Variable(HuntTrackPos)) >= 5) == True;
		Is Button Held(Event Player, Button(Crouch)) == False;
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	action
	{
		If(And(Event Player.Bounty >= 800, Array Contains(Array(0, 2, 3, 4, 10, 13, 14), Event Player.Zone)));
			Small Message(Event Player, Custom String("수배범과는 거래하지 않는다 — 은신처로 가라"));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			Abort;
		End;
		If(Event Player.Zone == 5);
			If(Event Player.MenuIdx == 0);
				If(Event Player.Whisky >= 2);
					Small Message(Event Player, Custom String("오늘은 그만 마셔라 — 하루 두 잔까지"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.Money >= Round To Integer(Multiply(38, Subtract(1, Multiply(Subtract(Event Player.Fame, Event Player.Noto), 0.002))), To Nearest));
					Set Player Variable(Event Player, Amt, Round To Integer(Multiply(38, Subtract(1, Multiply(Subtract(Event Player.Fame, Event Player.Noto), 0.002))), To Nearest));
					Modify Player Variable(Event Player, Money, Subtract, Event Player.Amt);
					Modify Player Variable(Event Player, Whisky, Add, 1);
					If(And(Entity Exists(Value In Array(Global Variable(BldOwner), 5)), Value In Array(Global Variable(BldOwner), 5) != Event Player));
						Set Player Variable(Value In Array(Global Variable(BldOwner), 5), Rent, Max(1, Round To Integer(Multiply(Event Player.Amt, 0.1), To Nearest)));
						Modify Player Variable(Value In Array(Global Variable(BldOwner), 5), Money, Add, Player Variable(Value In Array(Global Variable(BldOwner), 5), Rent));
						Small Message(Value In Array(Global Variable(BldOwner), 5), Custom String("임대 수입 +$ {0}", Player Variable(Value In Array(Global Variable(BldOwner), 5), Rent)));
					End;
					Set Player Variable(Event Player, Energy, Min(100, Add(Event Player.Energy, Event Player.Rebuild >= 4 ? 38 : 30)));
					Set Player Variable(Event Player, Thirst, Min(100, Add(Event Player.Thirst, 10)));
					Small Message(Event Player, Custom String("위스키 한 잔 — 피로 {0}", Round To Integer(Event Player.Energy, Down)));
					Play Effect(Event Player, Buff Impact Sound, Color(Yellow), Position Of(Event Player), 50);
				Else;
					Small Message(Event Player, Custom String("돈이 모자란다 ($ {0} 필요)", Round To Integer(Multiply(38, Subtract(1, Multiply(Subtract(Event Player.Fame, Event Player.Noto), 0.002))), To Nearest)));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				End;
			Else If(Event Player.MenuIdx == 1);
				If(Event Player.Money >= 75);
					Modify Player Variable(Event Player, Money, Subtract, 75);
					Set Player Variable(Event Player, Busy, 1);
					If(And(Entity Exists(Value In Array(Global Variable(BldOwner), 5)), Value In Array(Global Variable(BldOwner), 5) != Event Player));
						Set Player Variable(Value In Array(Global Variable(BldOwner), 5), Rent, Max(1, Round To Integer(Multiply(75, 0.1), To Nearest)));
						Modify Player Variable(Value In Array(Global Variable(BldOwner), 5), Money, Add, Player Variable(Value In Array(Global Variable(BldOwner), 5), Rent));
						Small Message(Value In Array(Global Variable(BldOwner), 5), Custom String("임대 수입 +$ {0}", Player Variable(Value In Array(Global Variable(BldOwner), 5), Rent)));
					End;
					Small Message(Event Player, Custom String("카드를 돌린다..."));
					Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Position Of(Event Player), 70);
					Wait(1.4, Ignore Condition);
					Set Player Variable(Event Player, Roll, Random Integer(1, 100));
					If(Event Player.Roll <= 5);
						Modify Player Variable(Event Player, Money, Add, 450);
						Modify Player Variable(Event Player, Earned, Add, 450);
						Big Message(All Players(All Teams), Custom String("{0} — 술집에서 잭팟! $450", Event Player));
						Play Effect(All Players(All Teams), Buff Explosion Sound, Color(Yellow), Position Of(Event Player), 200);
						Play Effect(All Players(All Teams), Ring Explosion, Color(Yellow), Position Of(Event Player), 3);
					Else If(Event Player.Roll <= 30);
						Modify Player Variable(Event Player, Money, Add, 135);
						Modify Player Variable(Event Player, Earned, Add, 135);
						Small Message(Event Player, Custom String("이겼다 — $135 획득"));
						Play Effect(Event Player, Good Explosion, Color(Lime Green), Position Of(Event Player), 2);
						Play Effect(Event Player, Buff Explosion Sound, Color(Lime Green), Position Of(Event Player), 130);
					Else;
						Small Message(Event Player, Custom String("잃었다 — 다음 판은 다를지도"));
						Play Effect(Event Player, Bad Explosion, Color(Red), Position Of(Event Player), 1.5);
						Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 110);
					End;
					Set Player Variable(Event Player, Busy, 0);
				Else;
					Small Message(Event Player, Custom String("판돈이 모자란다 ($75 필요)"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				End;
			Else If(Event Player.MenuIdx == 2);
				Small Message(Event Player, Global Variable(PowderSet) == 1 ? Custom String("소문 — 누가 철길목에 손을 댔다더군. 저녁 8시를 노려라") : Custom String("{0}", And(Modulo(Global Variable(Day), 3) == 0, Global Variable(IsNight) == 0) ? Custom String("소문 — 오늘 저녁 8시 열차가 선다. 대장간 화약이 동날 게다") : Custom String("{0}", Global Variable(HuntPhase) >= 1 ? Custom String("소문 — 큰 놈이 돌아다닌다. 주황 흔적을 쫓아라") : Custom String("{0}", Global Variable(RatOn) == 1 ? Custom String("소문 — 쥐떼가 잡화점을 털고 있다!") : Value In Array(Array(Custom String("소문 — 오늘은 조용하다"), Custom String("소문 — 금맥 소동이 벌어졌다!"), Custom String("소문 — 모래폭풍이 온다"), Custom String("소문 — 야수들이 사납게 날뛴다"), Custom String("소문 — 역마차가 들어왔다"), Custom String("소문 — 누군가 누명을 썼다"), Custom String("소문 — 금광이 무너지고 있다")), Global Variable(EventKind))))));
				Play Effect(Event Player, Debuff Impact Sound, Color(Sky Blue), Position Of(Event Player), 25);
			Else If(Event Player.MenuIdx == 3);
				If(Event Player.BrewReady <= 0);
					Small Message(Event Player, Custom String("넘길 밀주가 없다 — 은신처 양조장에서 담가라"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else;
					Set Player Variable(Event Player, Amt, Value In Array(Event Player.Adv, 4) == 1 ? 15 : 25);
					If(Random Integer(1, 100) <= Event Player.Amt);
						Set Player Variable(Event Player, SellQty, Event Player.BrewReady);
						Set Player Variable(Event Player, BrewReady, 0);
						Modify Player Variable(Event Player, Bounty, Add, 150);
						Set Player Variable(Event Player, Noto, Min(100, Add(Event Player.Noto, 10)));
					Set Global Variable(TickerMsg, Custom String("{0}의 밀주 {1}병이 단속에 걸렸다 — 전량 몰수!", Event Player, Event Player.SellQty));
					Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
						Play Effect(All Players(All Teams), Ring Explosion, Color(Red), Position Of(Event Player), 3);
						Play Effect(Event Player, Explosion Sound, Color(Red), Position Of(Event Player), 160);
					Else;
						Set Player Variable(Event Player, SellQty, Event Player.BrewReady);
						Set Player Variable(Event Player, SellSum, Multiply(Event Player.BrewReady, 48));
						Set Player Variable(Event Player, BrewReady, 0);
						Modify Player Variable(Event Player, Money, Add, Event Player.SellSum);
						Modify Player Variable(Event Player, Earned, Add, Event Player.SellSum);
						Set Player Variable(Event Player, Noto, Min(100, Add(Event Player.Noto, 5)));
						Small Message(Event Player, Custom String("뒷문으로 밀주 {0}병을 넘겼다 — +$ {1} (악명 +5)", Event Player.SellQty, Event Player.SellSum));
						Play Effect(Event Player, Buff Explosion Sound, Color(Purple), Position Of(Event Player), 120);
					End;
				End;
			Else If(Event Player.MenuIdx == 4);
				If(Event Player.Money >= 5000);
					Modify Player Variable(Event Player, Money, Subtract, 5000);
					If(And(Entity Exists(Value In Array(Global Variable(BldOwner), 5)), Value In Array(Global Variable(BldOwner), 5) != Event Player));
						Set Player Variable(Value In Array(Global Variable(BldOwner), 5), Rent, Max(1, Round To Integer(Multiply(5000, 0.1), To Nearest)));
						Modify Player Variable(Value In Array(Global Variable(BldOwner), 5), Money, Add, Player Variable(Value In Array(Global Variable(BldOwner), 5), Rent));
						Small Message(Value In Array(Global Variable(BldOwner), 5), Custom String("임대 수입 +$ {0}", Player Variable(Value In Array(Global Variable(BldOwner), 5), Rent)));
					End;
				Set Global Variable(FireEnd, Add(Total Time Elapsed(), 4));
					Big Message(All Players(All Teams), Custom String("{0}이(가) 불꽃을 사들였다 — 밖으로 나가 하늘을 봐라!", Event Player));
					Play Effect(All Players(All Teams), Buff Impact Sound, Color(Yellow), Position Of(Event Player), 200);
				Else;
					Small Message(Event Player, Custom String("돈이 모자란다 ($5000 필요)"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				End;
			Else If(Event Player.MenuIdx == 5);
				If(Event Player.Money >= 25);
					Modify Player Variable(Event Player, Money, Subtract, 25);
					Set Player Variable At Index(Event Player, Inv, 1, Add(Value In Array(Event Player.Inv, 1), 1));
					Small Message(Event Player, Custom String("뒷문으로 물통을 받았다 — 보유 {0} (뒷문은 장부에 안 남는다)", Value In Array(Event Player.Inv, 1)));
					Play Effect(Event Player, Buff Impact Sound, Color(Purple), Position Of(Event Player), 50);
				Else;
					Small Message(Event Player, Custom String("돈이 모자란다 ($25 필요)"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				End;
			End;
		Else If(Event Player.Zone == 6);
			If(Event Player.MenuIdx == 0);
				Call Subroutine(DoHunt);
			Else;
				If(Event Player.Job != 2);
					Small Message(Event Player, Custom String("사냥꾼만 승급할 수 있다 — 흔적 추적이 너를 사냥꾼으로 만든다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Value In Array(Event Player.Adv, Event Player.Job) == 1);
					Small Message(Event Player, Custom String("이미 맹수 사냥꾼이다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Value In Array(Event Player.JobXP, 2) < 1000);
					Small Message(Event Player, Custom String("경험이 부족하다 — {0} / 1000", Value In Array(Event Player.JobXP, 2)));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else;
					Set Player Variable At Index(Event Player, Adv, Event Player.Job, 1);
					Big Message(All Players(All Teams), Custom String("{0} — 맹수 사냥꾼으로 올라섰다!", Event Player));
					Small Message(Event Player, Custom String("내 추적에서 거대 야수 확률 4.4% → 6.4% · 가죽 +1장"));
					Play Effect(All Players(All Teams), Ring Explosion, Color(Orange), Position Of(Event Player), 4);
					Play Effect(Event Player, Buff Explosion Sound, Color(Orange), Position Of(Event Player), 200);
				End;
			End;
		Else If(Event Player.Zone == 7);
			If(Event Player.MenuIdx == 0);
				Set Player Variable(Event Player, Amt, Max(Event Player.Fame >= 70 ? 100 : 200, Round To Integer(Multiply(Event Player.Bounty, Event Player.Fame >= 70 ? 0.25 : 0.5), To Nearest)));
				If(Event Player.Bounty <= 0);
					Small Message(Event Player, Custom String("수배 중이 아니다 — 낼 벌금이 없다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.Money >= Event Player.Amt);
					Modify Player Variable(Event Player, Money, Subtract, Event Player.Amt);
					Set Player Variable(Event Player, Bounty, 0);
					Set Player Variable(Event Player, Noto, Max(0, Subtract(Event Player.Noto, 40)));
					Small Message(Event Player, Custom String("벌금을 냈다 — 수배가 풀렸다"));
					Play Effect(Event Player, Buff Impact Sound, Color(Sky Blue), Position Of(Event Player), 80);
				Else;
					Small Message(Event Player, Custom String("돈이 모자란다 ($ {0} 필요)", Event Player.Amt));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				End;
			Else If(Event Player.MenuIdx == 1);
				Small Message(Event Player, Custom String("현상금 게시판 — 지금 수배자 {0}명", Count Of(Filtered Array(All Players(All Teams), Player Variable(Current Array Element, Bounty) > 0))));
				Play Effect(Event Player, Debuff Impact Sound, Color(Sky Blue), Position Of(Event Player), 25);
				Wait(2, Ignore Condition);
				Small Message(Event Player, Custom String("현상금은 범인의 주머니에서 나온다 — 빈털터리는 잡아도 못 번다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(Sky Blue), Position Of(Event Player), 25);
			Else If(Event Player.MenuIdx == 2);
				If(Event Player.Job != 3);
					Small Message(Event Player, Custom String("현상금 사냥꾼만 승급할 수 있다 — 수배자 체포가 너를 현상금 사냥꾼으로 만든다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Value In Array(Event Player.Adv, Event Player.Job) == 1);
					Small Message(Event Player, Custom String("이미 보안관이다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Value In Array(Event Player.JobXP, 3) < 1000);
					Small Message(Event Player, Custom String("경험이 부족하다 — {0} / 1000", Value In Array(Event Player.JobXP, 3)));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.Fame < 30);
					Small Message(Event Player, Custom String("명성이 부족하다 — 보안관은 신뢰가 필요하다 ({0} / 30)", Event Player.Fame));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else;
					Set Player Variable At Index(Event Player, Adv, Event Player.Job, 1);
					Big Message(All Players(All Teams), Custom String("{0} — 보안관으로 올라섰다!", Event Player));
					Small Message(Event Player, Custom String("체포 3초 · 몰수 벌금의 절반을 수수료로"));
					Play Effect(All Players(All Teams), Ring Explosion, Color(Sky Blue), Position Of(Event Player), 4);
					Play Effect(Event Player, Buff Explosion Sound, Color(Sky Blue), Position Of(Event Player), 200);
				End;
			Else If(Event Player.MenuIdx == 3);
				If(Global Variable(TaxOn) == 0);
					Small Message(Event Player, Custom String("징수 기간이 아니다 — 징수원은 이틀에 한 번 아침 10시에 온다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.TaxPaidRound == Global Variable(TaxRound));
					Small Message(Event Player, Custom String("이미 납부했다"));
				Else If(Add(Event Player.Money, Event Player.Deposit) < 100);
					Set Player Variable(Event Player, TaxPaidRound, Global Variable(TaxRound));
					Small Message(Event Player, Custom String("낼 것도 없다 — 징수원이 혀를 차며 보내줬다"));
				Else;
					Set Player Variable(Event Player, Amt, Round To Integer(Multiply(Add(Event Player.Money, Event Player.Deposit), Event Player.Fame >= 70 ? 0.04 : 0.08), Down));
					If(Event Player.Rebuild >= 3);
						Set Player Variable(Event Player, Amt, Max(1, Round To Integer(Multiply(Event Player.Amt, 0.5), To Nearest)));
					End;
					If(Event Player.Money >= Event Player.Amt);
						Modify Player Variable(Event Player, Money, Subtract, Event Player.Amt);
					Else;
						Modify Player Variable(Event Player, Deposit, Subtract, Subtract(Event Player.Amt, Event Player.Money));
						Set Player Variable(Event Player, Money, 0);
					End;
					Set Player Variable(Event Player, TaxPaidRound, Global Variable(TaxRound));
					Set Player Variable(Event Player, Fame, Min(100, Add(Event Player.Fame, 2)));
					Small Message(Event Player, Custom String("재산세 $ {0} 납부 — 성실한 시민이다 (명성 +2)", Event Player.Amt));
					Play Effect(Event Player, Buff Impact Sound, Color(Sky Blue), Position Of(Event Player), 60);
				End;
			Else;
				If(Event Player.Job == 3);
					Small Message(Event Player, Custom String("이미 현상금 사냥꾼이다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.Fame < 30);
					Small Message(Event Player, Custom String("마을의 신뢰가 모자란다 — 명성 {0} / 30", Event Player.Fame));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.Noto > 20);
					Small Message(Event Player, Custom String("죄지은 손에 배지를 맡길 수는 없다 — 악명 {0} (20 이하라야 한다)", Event Player.Noto));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else;
					Set Player Variable(Event Player, JobArg, 3);
					Call Subroutine(BecomeJob);
					Big Message(Event Player, Custom String("배지를 받았다 — 석궁의 프레야가 된다. 전단이 붙은 자($300+)를 산 채로 잡아라"));
					Play Effect(Event Player, Buff Impact Sound, Color(Sky Blue), Position Of(Event Player), 80);
				End;
			End;
		Else If(Event Player.Zone == 8);
			If(Event Player.MenuIdx == 0);
				If(Add(Value In Array(Event Player.Inv, 2), Value In Array(Event Player.Inv, 3)) <= 0);
					Small Message(Event Player, Custom String("넘길 원석도 가죽도 없다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Abort;
				End;
				Set Player Variable(Event Player, SellSum, Add(Multiply(Value In Array(Event Player.Inv, 2), Global Variable(OrePrice)), Multiply(Value In Array(Event Player.Inv, 3), Global Variable(HidePrice))));
				If(And(Event Player.Job == 4, Event Player.Noto >= 50));
					Set Player Variable(Event Player, SellSum, Round To Integer(Multiply(Event Player.SellSum, 1.8), Down));
				Else If(Event Player.Job == 4);
					Set Player Variable(Event Player, SellSum, Round To Integer(Multiply(Event Player.SellSum, 1.65), Down));
				Else;
					Set Player Variable(Event Player, SellSum, Round To Integer(Multiply(Event Player.SellSum, 1.3), Down));
				End;
				If(Event Player.SellSum > 0);
					Modify Player Variable(Event Player, Money, Add, Event Player.SellSum);
					Modify Player Variable(Event Player, Earned, Add, Event Player.SellSum);
					Set Player Variable At Index(Event Player, Inv, 2, 0);
					Set Player Variable At Index(Event Player, Inv, 3, 0);
					Set Player Variable(Event Player, Noto, Min(100, Add(Event Player.Noto, 5)));
					Small Message(Event Player, Custom String("장물을 넘겼다 — $ {0}   (악명 +5)", Event Player.SellSum));
					Play Effect(Event Player, Buff Explosion Sound, Color(Purple), Position Of(Event Player), 100);
				Else;
					Small Message(Event Player, Custom String("넘길 원석도 가죽도 없다"));
				End;
			Else If(Event Player.MenuIdx == 1);
				Call Subroutine(DoPlan);
			Else If(Event Player.MenuIdx == 2);
				If(Event Player.Money >= 40);
					Modify Player Variable(Event Player, Money, Subtract, 40);
					Set Player Variable(Event Player, Hunger, Min(100, Add(Event Player.Hunger, 45)));
					Set Player Variable(Event Player, Thirst, Min(100, Add(Event Player.Thirst, 45)));
					Set Player Variable(Event Player, Energy, Min(100, Add(Event Player.Energy, 30)));
					Small Message(Event Player, Custom String("뒷골목에서 몸을 숨기고 숨을 돌렸다 (허기·갈증 +45, 피로 +30)"));
					Play Effect(Event Player, Buff Impact Sound, Color(Purple), Position Of(Event Player), 60);
				Else;
					Small Message(Event Player, Custom String("돈이 모자란다 ($40 필요)"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				End;
			Else If(Event Player.MenuIdx == 3);
				If(Event Player.BrewVats == 0);
					If(Event Player.Noto < 30);
						Small Message(Event Player, Custom String("양조는 아무나 못 한다 — 악명 30을 쌓아 와라 (현재 {0})", Event Player.Noto));
						Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
					Else If(Event Player.Money >= 2000);
						Modify Player Variable(Event Player, Money, Subtract, 2000);
						Set Player Variable(Event Player, BrewVats, 1);
						Big Message(Event Player, Custom String("뒷골목에 양조장을 차렸다 — 물통 2개면 밀주를 담근다"));
						Play Effect(Event Player, Buff Explosion Sound, Color(Purple), Position Of(Event Player), 140);
					Else;
						Small Message(Event Player, Custom String("돈이 모자란다 ($2000 필요)"));
						Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
					End;
				Else If(Event Player.BrewReady > 0);
					Small Message(Event Player, Custom String("밀주 {0}병 보관 중 — 술집 뒷문에 넘겨라", Event Player.BrewReady));
				Else If(Event Player.BrewEnd > Total Time Elapsed());
					Small Message(Event Player, Custom String("숙성 중... {0}초 뒤에 익는다", Round To Integer(Subtract(Event Player.BrewEnd, Total Time Elapsed()), Up)));
				Else If(Value In Array(Event Player.Inv, 1) >= 2);
					Set Player Variable At Index(Event Player, Inv, 1, Subtract(Value In Array(Event Player.Inv, 1), 2));
					Set Player Variable(Event Player, BrewEnd, Add(Total Time Elapsed(), 720));
					Big Message(Event Player, Custom String("밀주를 담갔다 — 하루 뒤에 익는다"));
					Play Effect(Event Player, Buff Impact Sound, Color(Purple), Position Of(Event Player), 60);
				Else;
					Small Message(Event Player, Custom String("물통 2개가 필요하다 (보유 {0})", Value In Array(Event Player.Inv, 1)));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				End;
			Else If(Event Player.MenuIdx == 4);
				If(Event Player.BrewVats == 0);
					Small Message(Event Player, Custom String("양조장부터 차려라"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.BrewVats >= 2);
					Small Message(Event Player, Custom String("이미 최대 규모다 — 한 번에 6병"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.Money >= 5000);
					Modify Player Variable(Event Player, Money, Subtract, 5000);
					Set Player Variable(Event Player, BrewVats, 2);
					Big Message(Event Player, Custom String("양조통을 늘렸다 — 이제 한 번에 6병"));
					Play Effect(Event Player, Buff Explosion Sound, Color(Purple), Position Of(Event Player), 140);
				Else;
					Small Message(Event Player, Custom String("돈이 모자란다 ($5000 필요)"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				End;
			Else;
				If(Event Player.Job != 4);
					Small Message(Event Player, Custom String("무법자만 승급할 수 있다 — 강탈과 습격이 너를 무법자로 만든다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Value In Array(Event Player.Adv, Event Player.Job) == 1);
					Small Message(Event Player, Custom String("이미 갱단 두목이다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Value In Array(Event Player.JobXP, 4) < 1000);
					Small Message(Event Player, Custom String("경험이 부족하다 — {0} / 1000", Value In Array(Event Player.JobXP, 4)));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else;
					Set Player Variable At Index(Event Player, Adv, Event Player.Job, 1);
					Big Message(All Players(All Teams), Custom String("{0} — 갱단 두목으로 올라섰다!", Event Player));
					Small Message(Event Player, Custom String("습격의 약탈 게이지가 1.5배 빠르다 · 강탈 쿨타임 30초"));
					Play Effect(All Players(All Teams), Ring Explosion, Color(Purple), Position Of(Event Player), 4);
					Play Effect(Event Player, Buff Explosion Sound, Color(Purple), Position Of(Event Player), 200);
				End;
			End;
		End;
		Wait Until(Not(Is Button Held(Event Player, Button(Interact))), 3);
	}
}

rule("[조작 03c] 행동 실행 — 안내소")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Busy == 0;
		Event Player.Zone != -1;
		Is Alive(Event Player) == True;
		Global Variable(ArchOn) == 0;
		Or(Event Player.Escort == 0, Distance Between(Position Of(Event Player), Event Player.EscortPos) >= 4) == True;
		Or(Global Variable(WagonOn) == 0, Distance Between(Position Of(Event Player), Global Variable(WagonPos)) >= 4) == True;
		Or(Global Variable(HuntPhase) != 1, Distance Between(Position Of(Event Player), Global Variable(HuntTrackPos)) >= 5) == True;
		Is Button Held(Event Player, Button(Crouch)) == False;
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	action
	{
		If(And(Event Player.Bounty >= 800, Array Contains(Array(0, 2, 3, 4, 10, 13, 14), Event Player.Zone)));
			Small Message(Event Player, Custom String("수배범과는 거래하지 않는다 — 은신처로 가라"));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			Abort;
		End;
		If(Event Player.Zone == 9);
			If(Event Player.MenuIdx == 0);
				Call Subroutine(DoTutorial);
			Else If(Event Player.MenuIdx == 1);
				Set Player Variable(Event Player, SaveA, Add(Multiply(Min(9999, Round To Integer(Divide(Add(Event Player.Money, Event Player.Deposit), 100), Down)), 100), Add(Multiply(Event Player.Pick, 10), Add(Multiply(Event Player.HasHome, 4), Add(Multiply(Event Player.HasHorse, 2), Event Player.HasBag)))));
				Set Player Variable(Event Player, SaveB, Add(Multiply(Add(Multiply(Add(Multiply(Add(Multiply(Event Player.Job, 10), Value In Array(Event Player.Adv, Event Player.Job)), 10), Min(9, Round To Integer(Divide(Value In Array(Event Player.JobXP, Event Player.Job), 250), Down))), 10), Min(9, Round To Integer(Divide(Event Player.Fame, 10), Down))), 10), Min(9, Round To Integer(Divide(Event Player.Noto, 10), Down))));
				Set Player Variable(Event Player, SaveB, Add(Multiply(Event Player.SaveB, 10), Modulo(Add(Event Player.SaveA, Event Player.SaveB), 9)));
				Set Player Variable(Event Player, PadA, Add(Add(Event Player.SaveA >= 10 ? 1 : 0, Event Player.SaveA >= 100 ? 1 : 0), Add(Event Player.SaveA >= 1000 ? 1 : 0, Add(Event Player.SaveA >= 10000 ? 1 : 0, Event Player.SaveA >= 100000 ? 1 : 0))));
				Set Player Variable(Event Player, PadB, Add(Add(Event Player.SaveB >= 10 ? 1 : 0, Event Player.SaveB >= 100 ? 1 : 0), Add(Event Player.SaveB >= 1000 ? 1 : 0, Add(Event Player.SaveB >= 10000 ? 1 : 0, Event Player.SaveB >= 100000 ? 1 : 0))));
				Set Player Variable(Event Player, SaveC, Add(Add(Add(Multiply(Event Player.Rebuild, 100000), Multiply(Event Player.Rebirth, 10000)), Multiply(Min(9, Round To Integer(Divide(Event Player.Giant, 10), Down)), 1000)), Multiply(Min(99, Round To Integer(Divide(Event Player.Earned, 2000), Down)), 10)));
				Set Player Variable(Event Player, SaveC, Add(Event Player.SaveC, Modulo(Add(Add(Event Player.SaveA, Event Player.SaveB), Round To Integer(Divide(Event Player.SaveC, 10), Down)), 9)));
				Set Player Variable(Event Player, PadC, Add(Add(Event Player.SaveC >= 10 ? 1 : 0, Event Player.SaveC >= 100 ? 1 : 0), Add(Event Player.SaveC >= 1000 ? 1 : 0, Add(Event Player.SaveC >= 10000 ? 1 : 0, Event Player.SaveC >= 100000 ? 1 : 0))));
				Destroy HUD Text(Event Player.SaveHud);
				Create HUD Text(Event Player, Null, Custom String("세이브 코드   {0} - {1} - {2}", Custom String("{0}{1}", Value In Array(Array(Custom String("00000"), Custom String("0000"), Custom String("000"), Custom String("00"), Custom String("0"), Custom String("")), Event Player.PadA), Event Player.SaveA), Custom String("{0}{1}", Value In Array(Array(Custom String("00000"), Custom String("0000"), Custom String("000"), Custom String("00"), Custom String("0"), Custom String("")), Event Player.PadB), Event Player.SaveB), Custom String("{0}{1}", Value In Array(Array(Custom String("00000"), Custom String("0000"), Custom String("000"), Custom String("00"), Custom String("0"), Custom String("")), Event Player.PadC), Event Player.SaveC)), Custom String("적어둬라 — 방이 닫히면 이 코드만 남는다 (마스터리는 9까지 담긴다)"), Left, 5, Color(흰색), Color(Yellow), Color(회색), Visible To Sort Order String and Color, Default Visibility);
				Set Player Variable(Event Player, SaveHud, Last Text ID());
				Big Message(Event Player, Custom String("세이브 코드 발급 — 화면 왼쪽에 떠 있다"));
				Play Effect(Event Player, Buff Impact Sound, Color(Yellow), Position Of(Event Player), 60);
			Else If(Event Player.MenuIdx == 2);
				Set Player Variable(Event Player, Busy, 1);
				Set Player Variable(Event Player, EnterA, 0);
				Set Player Variable(Event Player, EnterB, 0);
				Set Player Variable(Event Player, EnterC, 0);
				Set Player Variable(Event Player, EntryIdx, 0);
				Set Player Variable(Event Player, EntryCur, 0);
				Create HUD Text(Event Player, Custom String("코드 입력   {0}", Custom String("A {0}   B {1}   C {2}", Event Player.EnterA, Event Player.EnterB, Event Player.EnterC)), Custom String("자리 {0}/18   현재 숫자 [ {1} ]", Event Player.EntryIdx, Event Player.EntryCur), Custom String("[R] +1    [F] 자리 확정    [{0}] 한 칸 지우기    [웅크리기] 취소", Input Binding String(Button(Melee))), Left, 5, Color(Aqua), Color(흰색), Color(회색), Visible To Sort Order String and Color, Default Visibility);
				Set Player Variable(Event Player, KeyHud, Last Text ID());
				Wait Until(Not(Is Button Held(Event Player, Button(Interact))), 5);
				Set Player Variable(Event Player, SaveOn, 1);
				Small Message(Event Player, Custom String("주의 — 복원하면 현재 진행이 덮어써집니다"));
			Else If(Event Player.MenuIdx == 3);
				If(Global Variable(TownStage) >= 8);
					Small Message(Event Player, Custom String("마을은 이미 되살아났다 — 당신의 이름과 함께"));
					Play Effect(Event Player, Buff Impact Sound, Color(Yellow), Position Of(Event Player), 50);
				Else If(Event Player.Money < 1000);
					Small Message(Event Player, Custom String("돈이 모자란다 ($1000 필요)"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else;
					Modify Player Variable(Event Player, Money, Subtract, 1000);
					Modify Global Variable(Fund, Add, 1000);
					Set Player Variable(Event Player, Contrib, 1);
					Set Player Variable(Event Player, Fame, Min(100, Add(Event Player.Fame, 2)));
					Set Player Variable(Event Player, Amt, Max(0, Subtract(Value In Array(Array(8000, 23000, 48000, 88000, 148000, 233000, 348000, 498000), Global Variable(TownStage)), Global Variable(Fund))));
					Big Message(All Players(All Teams), Custom String("{0} — 마을 금고에 $1,000 · {1}까지 $ {2}", Event Player, Value In Array(Array(Custom String("마을 우물"), Custom String("전신국"), Custom String("길손의 쉼터"), Custom String("마을 은행"), Custom String("역마차 급행로"), Custom String("오페라 극장"), Custom String("국도 대축제"), Custom String("기차역")), Global Variable(TownStage)), Event Player.Amt));
					Play Effect(All Players(All Teams), Buff Impact Sound, Color(Yellow), Position Of(Event Player), 90);
				End;
			Else If(Event Player.MenuIdx == 4);
				If(Global Variable(RebuildMax) < 3);
					Small Message(Event Player, Custom String("마을 은행이 아직 서지 않았다 — 마을 금고 4단계부터"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.Money < 1);
					Small Message(Event Player, Custom String("맡길 돈이 없다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else;
					Modify Player Variable(Event Player, Deposit, Add, Event Player.Money);
					Set Player Variable(Event Player, Money, 0);
					Small Message(Event Player, Custom String("전액을 맡겼다 — 예금 $ {0} (강탈과 죽음이 닿지 않는다)", Event Player.Deposit));
					Play Effect(Event Player, Buff Impact Sound, Color(Yellow), Position Of(Event Player), 60);
				End;
			Else;
				If(Event Player.Deposit < 1);
					Small Message(Event Player, Custom String("예금이 비어 있다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else;
					Modify Player Variable(Event Player, Money, Add, Event Player.Deposit);
					Set Player Variable(Event Player, Deposit, 0);
					Small Message(Event Player, Custom String("전액을 찾았다 — 소지금 $ {0}", Event Player.Money));
					Play Effect(Event Player, Buff Impact Sound, Color(Yellow), Position Of(Event Player), 60);
				End;
			End;
		End;
	}
}

rule("[조작 03d] 행동 실행 — 대장간")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Busy == 0;
		Event Player.Zone != -1;
		Is Alive(Event Player) == True;
		Global Variable(ArchOn) == 0;
		Or(Event Player.Escort == 0, Distance Between(Position Of(Event Player), Event Player.EscortPos) >= 4) == True;
		Or(Global Variable(WagonOn) == 0, Distance Between(Position Of(Event Player), Global Variable(WagonPos)) >= 4) == True;
		Or(Global Variable(HuntPhase) != 1, Distance Between(Position Of(Event Player), Global Variable(HuntTrackPos)) >= 5) == True;
		Is Button Held(Event Player, Button(Crouch)) == False;
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	action
	{
		If(And(Event Player.Bounty >= 800, Array Contains(Array(0, 2, 3, 4, 10, 13, 14), Event Player.Zone)));
			Small Message(Event Player, Custom String("수배범과는 거래하지 않는다 — 은신처로 가라"));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			Abort;
		End;
		If(Event Player.Zone == 10);
			If(Event Player.MenuIdx == 0);
				If(Event Player.Pick >= 4);
					Small Message(Event Player, Custom String("곡괭이가 이미 최고 등급이다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else;
					Set Player Variable(Event Player, Amt, Value In Array(Array(800, 2000, 4000, 8000), Event Player.Pick));
					If(Event Player.Money >= Event Player.Amt);
						Modify Player Variable(Event Player, Money, Subtract, Event Player.Amt);
						Modify Player Variable(Event Player, Pick, Add, 1);
						If(And(Entity Exists(Value In Array(Global Variable(BldOwner), 10)), Value In Array(Global Variable(BldOwner), 10) != Event Player));
							Set Player Variable(Value In Array(Global Variable(BldOwner), 10), Rent, Max(1, Round To Integer(Multiply(Event Player.Amt, 0.1), To Nearest)));
							Modify Player Variable(Value In Array(Global Variable(BldOwner), 10), Money, Add, Player Variable(Value In Array(Global Variable(BldOwner), 10), Rent));
							Small Message(Value In Array(Global Variable(BldOwner), 10), Custom String("임대 수입 +$ {0}", Player Variable(Value In Array(Global Variable(BldOwner), 10), Rent)));
						End;
						Big Message(Event Player, Custom String("곡괭이 Lv.{0} — 채굴 수확 +{1}", Event Player.Pick, Event Player.Pick));
						Play Effect(Event Player, Buff Explosion Sound, Color(Orange), Position Of(Event Player), 100);
					Else;
						Small Message(Event Player, Custom String("돈이 모자란다 ($ {0} 필요)", Event Player.Amt));
					End;
				End;
			Else If(Event Player.MenuIdx == 1);
				If(Event Player.HasBag == 1);
					Small Message(Event Player, Custom String("이미 가죽 배낭이 있다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.Money >= 4800);
					Modify Player Variable(Event Player, Money, Subtract, 4800);
					If(And(Entity Exists(Value In Array(Global Variable(BldOwner), 10)), Value In Array(Global Variable(BldOwner), 10) != Event Player));
						Set Player Variable(Value In Array(Global Variable(BldOwner), 10), Rent, Max(1, Round To Integer(Multiply(4800, 0.1), To Nearest)));
						Modify Player Variable(Value In Array(Global Variable(BldOwner), 10), Money, Add, Player Variable(Value In Array(Global Variable(BldOwner), 10), Rent));
						Small Message(Value In Array(Global Variable(BldOwner), 10), Custom String("임대 수입 +$ {0}", Player Variable(Value In Array(Global Variable(BldOwner), 10), Rent)));
					End;
					Set Player Variable(Event Player, HasBag, 1);
					If(Event Player.HasHorse == 0);
						Start Forcing Player To Be Hero(Event Player, Hero(트레이서));
					End;
					Big Message(Event Player, Custom String("가죽 배낭 — 달리기 피로 소모 절반"));
					Small Message(Event Player, Custom String("배낭을 멘 트레이서가 되었다"));
					Play Effect(Event Player, Buff Explosion Sound, Color(Orange), Position Of(Event Player), 100);
				Else;
					Small Message(Event Player, Custom String("돈이 모자란다 ($4800 필요)"));
				End;
			Else If(Event Player.MenuIdx == 2);
				If(Event Player.HasHorse == 1);
					Small Message(Event Player, Custom String("이미 말이 있다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.Money >= 11000);
					Modify Player Variable(Event Player, Money, Subtract, 11000);
					If(And(Entity Exists(Value In Array(Global Variable(BldOwner), 10)), Value In Array(Global Variable(BldOwner), 10) != Event Player));
						Set Player Variable(Value In Array(Global Variable(BldOwner), 10), Rent, Max(1, Round To Integer(Multiply(11000, 0.1), To Nearest)));
						Modify Player Variable(Value In Array(Global Variable(BldOwner), 10), Money, Add, Player Variable(Value In Array(Global Variable(BldOwner), 10), Rent));
						Small Message(Value In Array(Global Variable(BldOwner), 10), Custom String("임대 수입 +$ {0}", Player Variable(Value In Array(Global Variable(BldOwner), 10), Rent)));
					End;
					Set Player Variable(Event Player, HasHorse, 1);
					Start Forcing Player To Be Hero(Event Player, Hero(시온));
					Big Message(All Players(All Teams), Custom String("{0} — 말을 샀다", Event Player));
					Small Message(Event Player, Custom String("이제 시온이다 — [E] 바이크 (쿨타임 2초) · 육포는 허기가 지면 알아서 꺼내 먹는다"));
					Play Effect(All Players(All Teams), Ring Explosion, Color(Orange), Position Of(Event Player), 3);
				Else;
					Small Message(Event Player, Custom String("돈이 모자란다 ($11000 필요)"));
				End;
			Else If(Event Player.MenuIdx == 3);
				If(Event Player.HasPowder == 1);
					Small Message(Event Player, Custom String("화약은 이미 챙겼다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.Money >= 200);
					Modify Player Variable(Event Player, Money, Subtract, 200);
					Set Player Variable(Event Player, HasPowder, 1);
					If(And(Entity Exists(Value In Array(Global Variable(BldOwner), 10)), Value In Array(Global Variable(BldOwner), 10) != Event Player));
						Set Player Variable(Value In Array(Global Variable(BldOwner), 10), Rent, Max(1, Round To Integer(Multiply(200, 0.1), To Nearest)));
						Modify Player Variable(Value In Array(Global Variable(BldOwner), 10), Money, Add, Player Variable(Value In Array(Global Variable(BldOwner), 10), Rent));
						Small Message(Value In Array(Global Variable(BldOwner), 10), Custom String("임대 수입 +$ {0}", Player Variable(Value In Array(Global Variable(BldOwner), 10), Rent)));
					End;
					Big Message(Event Player, Custom String("화약을 챙겼다 — 열차의 날, 철길목에서 [{0}]로 설치", Input Binding String(Button(Interact))));
					Play Effect(Event Player, Buff Impact Sound, Color(Orange), Position Of(Event Player), 70);
				Else;
					Small Message(Event Player, Custom String("돈이 모자란다 ($200 필요)"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				End;
			Else If(Event Player.MenuIdx == 4);
				If(Event Player.Money >= 40000);
					Modify Player Variable(Event Player, Money, Subtract, 40000);
					If(And(Entity Exists(Value In Array(Global Variable(BldOwner), 10)), Value In Array(Global Variable(BldOwner), 10) != Event Player));
						Set Player Variable(Value In Array(Global Variable(BldOwner), 10), Rent, Max(1, Round To Integer(Multiply(40000, 0.1), To Nearest)));
						Modify Player Variable(Value In Array(Global Variable(BldOwner), 10), Money, Add, Player Variable(Value In Array(Global Variable(BldOwner), 10), Rent));
						Small Message(Value In Array(Global Variable(BldOwner), 10), Custom String("임대 수입 +$ {0}", Player Variable(Value In Array(Global Variable(BldOwner), 10), Rent)));
					End;
				Destroy Effect(Global Variable(StatueFx));
					Destroy In-World Text(Global Variable(StatueTxt));
					Create Effect(All Players(All Teams), Sphere, Color(Yellow), Add(Value In Array(Global Variable(LocPos), 0), Vector(2.5, 1.4, 2.5)), 0.9, Visible To Position Radius and Color);
					Set Global Variable(StatueFx, Last Created Entity());
					Create In-World Text(All Players(All Teams), Custom String("『 {0} 』", Event Player), Add(Value In Array(Global Variable(LocPos), 0), Vector(2.5, 3, 2.5)), 1.6, Do Not Clip, Visible To and Position, Color(Yellow), Default Visibility);
					Set Global Variable(StatueTxt, Last Text ID());
					Big Message(All Players(All Teams), Custom String("{0} — 식당 앞에 황금 동상을 세웠다!! ($40,000)", Event Player));
					Play Effect(All Players(All Teams), Ring Explosion, Color(Yellow), Add(Value In Array(Global Variable(LocPos), 0), Vector(2.5, 1.4, 2.5)), 6);
					Play Effect(All Players(All Teams), Buff Explosion Sound, Color(Yellow), Position Of(Event Player), 250);
				Else;
					Small Message(Event Player, Custom String("돈이 모자란다 ($40000 필요)"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				End;
			End;
		End;
	}
}

rule("[조작 03e] 행동 실행 — 정거장")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Busy == 0;
		Event Player.Zone != -1;
		Is Alive(Event Player) == True;
		Global Variable(ArchOn) == 0;
		Or(Event Player.Escort == 0, Distance Between(Position Of(Event Player), Event Player.EscortPos) >= 4) == True;
		Or(Global Variable(WagonOn) == 0, Distance Between(Position Of(Event Player), Global Variable(WagonPos)) >= 4) == True;
		Or(Global Variable(HuntPhase) != 1, Distance Between(Position Of(Event Player), Global Variable(HuntTrackPos)) >= 5) == True;
		Is Button Held(Event Player, Button(Crouch)) == False;
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	action
	{
		If(And(Event Player.Bounty >= 800, Array Contains(Array(0, 2, 3, 4, 10, 13, 14), Event Player.Zone)));
			Small Message(Event Player, Custom String("수배범과는 거래하지 않는다 — 은신처로 가라"));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			Abort;
		End;
		If(Event Player.Zone == 11);
			If(Event Player.MenuIdx == 0);
				If(Event Player.Energy < 4);
					Small Message(Event Player, Custom String("너무 지쳤다 — 자거나 한잔 걸쳐야 한다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.CowOn >= 1);
					Small Message(Event Player, Custom String("소를 몰면서 화물은 못 든다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.Escort == 1);
					Small Message(Event Player, Custom String("금괴를 나르는 손으로 화물까지는 못 든다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.HasParcel >= 1);
					Small Message(Event Player, Custom String("이미 화물을 지고 있다 — 배달부터 끝내라"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else;
					Set Player Variable(Event Player, JobArg, 5);
					Call Subroutine(BecomeJob);
					Set Player Variable(Event Player, DelDest, Random Integer(0, 10));
					Set Player Variable(Event Player, HasParcel, 1);
					Destroy Icon(Event Player.DelIcon);
					Create Icon(Event Player, Add(Value In Array(Global Variable(LocPos), Event Player.DelDest), Vector(0, 3, 0)), Arrow: Down, Visible To and Position, Color(Yellow), True);
					Set Player Variable(Event Player, DelIcon, Last Created Entity());
					Set Player Variable(Event Player, RunPay, Round To Integer(Add(12, Multiply(Distance Between(Value In Array(Global Variable(LocPos), 11), Value In Array(Global Variable(LocPos), Event Player.DelDest)), 1.05)), To Nearest));
					Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("화물 접수 — {0}까지! 기본 보수 $ {1}", Value In Array(Array(Custom String("식당"), Custom String("협곡 광산"), Custom String("주유소 잡화점"), Custom String("모텔"), Custom String("정비소 고물상"), Custom String("술집"), Custom String("협곡 개활지"), Custom String("보안관 초소"), Custom String("무법자 은신처"), Custom String("안내소"), Custom String("대장간")), Event Player.DelDest), Event Player.RunPay));
					Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 2.5));
					Small Message(Event Player, Custom String("노란 화살표를 따라가라 · 이따금 값진 화물(보수 2.5배)이 걸린다"));
					If(Random Integer(1, 100) <= 25);
						Set Player Variable(Event Player, HasParcel, 2);
						Big Message(Event Player, Custom String("값진 화물이다! 보수 2.5배 — 어둠 속에서 그림자가 냄새를 맡았다"));
						Play Effect(Event Player, Ring Explosion, Color(Yellow), Position Of(Event Player), 2);
					End;
					Play Effect(Event Player, Buff Impact Sound, Color(Yellow), Position Of(Event Player), 60);
				End;
			Else If(Event Player.MenuIdx == 1);
				If(Event Player.Job != 5);
					Small Message(Event Player, Custom String("파발꾼만 승급할 수 있다 — 배달 수주가 너를 파발꾼으로 만든다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Value In Array(Event Player.Adv, Event Player.Job) == 1);
					Small Message(Event Player, Custom String("이미 역마차장이다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Value In Array(Event Player.JobXP, 5) < 1000);
					Small Message(Event Player, Custom String("경험이 부족하다 — {0} / 1000", Value In Array(Event Player.JobXP, 5)));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else;
					Set Player Variable At Index(Event Player, Adv, Event Player.Job, 1);
					Big Message(All Players(All Teams), Custom String("{0} — 역마차장가 되었다!", Event Player));
					Small Message(Event Player, Custom String("배달비 +30% · 배달마다 피로 5 회복"));
					Play Effect(All Players(All Teams), Ring Explosion, Color(Yellow), Position Of(Event Player), 4);
					Play Effect(Event Player, Buff Explosion Sound, Color(Yellow), Position Of(Event Player), 200);
				End;
			Else If(Event Player.MenuIdx == 2);
				If(Event Player.Escort == 1);
					Small Message(Event Player, Custom String("이미 금괴를 호송 중이다 — 노란 표식으로 가라"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.HasParcel >= 1);
					Small Message(Event Player, Custom String("화물을 진 채로 금괴까지는 못 맡는다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.Bounty > 0);
					Small Message(Event Player, Custom String("현상금 붙은 자에게 금괴를 맡길 수는 없다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Total Time Elapsed() < Event Player.EscortCd);
					Small Message(Event Player, Custom String("다음 금괴 마차가 아직이다 — {0}초 뒤에 다시", Round To Integer(Subtract(Event Player.EscortCd, Total Time Elapsed()), Up)));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.CowOn >= 1);
					Small Message(Event Player, Custom String("소를 몰면서 금괴는 못 나른다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.Plan >= 1);
					Small Message(Event Player, Custom String("역마차를 쫓는 중에는 금괴를 맡을 수 없다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.Energy < 4);
					Small Message(Event Player, Custom String("너무 지쳤다 — 자거나 한잔 걸쳐야 한다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else;
					Set Global Variable(PickRef, Value In Array(Global Variable(LocPos), 11));
					Set Global Variable(PickMin, 35);
					Set Global Variable(PickMax, 999);
					Call Subroutine(PickSpot);
					Set Player Variable(Event Player, EscortPos, Global Variable(PickPos));
					Set Player Variable(Event Player, EscortPay, Round To Integer(Add(60, Multiply(Distance Between(Value In Array(Global Variable(LocPos), 11), Event Player.EscortPos), 2)), To Nearest));
					If(Global Variable(FundTier) >= 2);
						Set Player Variable(Event Player, EscortPay, Round To Integer(Multiply(Event Player.EscortPay, 1.15), To Nearest));
					End;
					Set Player Variable(Event Player, Escort, 1);
					Destroy Icon(Event Player.EscortIco);
					Create Icon(Event Player, Add(Event Player.EscortPos, Vector(0, 3, 0)), Diamond, Visible To and Position, Color(Yellow), True);
					Set Player Variable(Event Player, EscortIco, Last Created Entity());
					Destroy Effect(Event Player.EscortFx);
					Create Effect(All Players(All Teams), Sphere, Color(Yellow), Add(Position Of(Event Player), Vector(0, 2.4, 0)), 0.3, Visible To Position Radius and Color);
					Set Player Variable(Event Player, EscortFx, Last Created Entity());
					Big Message(Event Player, Custom String("금괴 상자를 실었다 — 노란 표식까지 (보수 $ {0})", Event Player.EscortPay));
					Small Message(All Players(All Teams), Custom String("{0} — 금괴 호송을 시작했다", Event Player));
					Small Message(Event Player, Custom String("질주할 수 없다 · 죽거나 털리면 끝 — 악명 높은 자들이 냄새를 맡는다"));
					Play Effect(Event Player, Buff Impact Sound, Color(Yellow), Position Of(Event Player), 60);
				End;
			Else If(Event Player.MenuIdx == 3);
				If(Event Player.RanchReady <= 0);
					Small Message(Event Player, Custom String("넘길 소가 없다 — 목장에서 길러 와라"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else;
					Set Player Variable(Event Player, SellQty, Event Player.RanchReady);
					Set Player Variable(Event Player, Amt, Value In Array(Event Player.Adv, 6) == 1 ? 56 : 48);
					Set Player Variable(Event Player, SellSum, Multiply(Event Player.SellQty, Event Player.Amt));
					Set Player Variable(Event Player, RanchReady, 0);
					Modify Player Variable(Event Player, Money, Add, Event Player.SellSum);
					Modify Player Variable(Event Player, Earned, Add, Event Player.SellSum);
					Small Message(Event Player, Custom String("소 {0}마리를 넘겼다 — +$ {1}", Event Player.SellQty, Event Player.SellSum));
					Play Effect(Event Player, Buff Explosion Sound, Color(Lime Green), Position Of(Event Player), 120);
				End;
			Else If(Event Player.MenuIdx == 4);
				If(Event Player.Rebuild < 5);
					Small Message(Event Player, Custom String("기차역을 재건한 자만 이 기차에 오른다 (재건 {0}/5)", Event Player.Rebuild));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.Rebirth >= 5);
					Small Message(Event Player, Custom String("이미 전설이다 — 다섯 번의 새벽을 지났다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.EntryCur >= Total Time Elapsed());
					Set Player Variable(Event Player, EntryCur, 0);
					Modify Player Variable(Event Player, Rebirth, Add, 1);
					For Player Variable(Event Player, Idx, 0, 11, 1);
						If(Value In Array(Global Variable(BldOwner), Event Player.Idx) == Event Player);
							Set Global Variable At Index(BldOwner, Event Player.Idx, 0);
						End;
					End;
					Set Player Variable(Event Player, Money, 60);
					Set Player Variable(Event Player, Deposit, 0);
					Set Player Variable(Event Player, Inv, Array(2, 2, 0, 0));
					Set Player Variable(Event Player, Pick, 0);
					Set Player Variable(Event Player, HasBag, 0);
					Set Player Variable(Event Player, HasHorse, 0);
					Set Player Variable(Event Player, HasHome, 0);
					Set Player Variable(Event Player, Whisky, 0);
					Set Player Variable(Event Player, Rebuild, 0);
					Set Player Variable(Event Player, Contrib, 0);
					Set Player Variable(Event Player, Bounty, 0);
					Set Player Variable(Event Player, Sack, 0);
					Set Player Variable(Event Player, HasPowder, 0);
					Set Player Variable(Event Player, BrewVats, 0);
					Set Player Variable(Event Player, BrewEnd, 0);
					Set Player Variable(Event Player, BrewReady, 0);
					Set Player Variable(Event Player, RanchPens, 0);
					Set Player Variable(Event Player, RanchEnd, 0);
					Set Player Variable(Event Player, RanchReady, 0);
					Set Player Variable(Event Player, RanchCare, 0);
					Set Player Variable(Event Player, Prospect, 0);
					If(Event Player.Contraband == 1);
						Set Player Variable(Event Player, Contraband, 0);
						Destroy Icon(Event Player.SmuggleIco);
					End;
					If(Event Player.Escort == 1);
						Set Player Variable(Event Player, Escort, 0);
						Destroy Icon(Event Player.EscortIco);
						Destroy Effect(Event Player.EscortFx);
					End;
					If(Event Player.HasParcel >= 1);
						Set Player Variable(Event Player, HasParcel, 0);
						Destroy Icon(Event Player.DelIcon);
					End;
					If(Event Player.CowOn >= 1);
						Set Player Variable(Event Player, CowOn, 0);
						Destroy Effect(Event Player.CowFx);
						Destroy Icon(Event Player.CowIco);
					End;
					Set Player Variable(Event Player, Earned, 0);
					Set Player Variable(Event Player, DayStart, 0);
					Set Player Variable(Event Player, GoalDone, 0);
					Start Forcing Player To Be Hero(Event Player, Hero(캐서디));
			Wait(1, Ignore Condition);
			Stop Forcing Player To Be Hero(Event Player);
					Teleport(Event Player, Value In Array(Global Variable(LocPos), 0));
					Big Message(All Players(All Teams), Custom String("{0} — 새벽 기차를 타고 다시 태어났다!! (환생 {1}회)", Event Player, Event Player.Rebirth));
					Small Message(Event Player, Custom String("명성·악명·직업 경험은 남는다 — 아침마다 어제 수입의 {0}%가 얹힌다", Multiply(10, Event Player.Rebirth)));
					Play Effect(All Players(All Teams), Ring Explosion, Color(흰색), Position Of(Event Player), 8);
					Play Effect(All Players(All Teams), Buff Explosion Sound, Color(흰색), Position Of(Event Player), 250);
				Else;
					Set Player Variable(Event Player, EntryCur, Add(Total Time Elapsed(), 10));
					Big Message(Event Player, Custom String("정말 떠나는가 — 10초 안에 다시 실행하면 환생한다"));
					Small Message(Event Player, Custom String("전 재산·장비·부동산·사업·재건이 사라진다. 남는 것: 직업 경험 · 명성/악명 · 환생의 가호"));
				End;
			Else;
				If(Global Variable(TownStage) >= 8);
					Small Message(Event Player, Custom String("마을은 이미 되살아났다 — 당신의 이름과 함께"));
					Play Effect(Event Player, Buff Impact Sound, Color(Yellow), Position Of(Event Player), 50);
				Else If(Event Player.Money < 1000);
					Small Message(Event Player, Custom String("돈이 모자란다 ($1000 필요)"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else;
					Modify Player Variable(Event Player, Money, Subtract, 1000);
					Modify Global Variable(Fund, Add, 1000);
					Set Player Variable(Event Player, Contrib, 1);
					Set Player Variable(Event Player, Amt, Max(0, Subtract(Value In Array(Array(8000, 23000, 48000, 88000, 148000, 233000, 348000, 498000), Global Variable(TownStage)), Global Variable(Fund))));
					Set Player Variable(Event Player, Fame, Min(100, Add(Event Player.Fame, 2)));
					Big Message(All Players(All Teams), Custom String("{0} — 마을 금고에 $1,000 · {1}까지 $ {2}", Event Player, Value In Array(Array(Custom String("마을 우물"), Custom String("전신국"), Custom String("길손의 쉼터"), Custom String("마을 은행"), Custom String("역마차 급행로"), Custom String("오페라 극장"), Custom String("국도 대축제"), Custom String("기차역")), Global Variable(TownStage)), Event Player.Amt));
					Play Effect(All Players(All Teams), Buff Impact Sound, Color(Yellow), Position Of(Event Player), 90);
				End;
			End;
		End;
	}
}

rule("[조작 03f] 행동 실행 — 목장")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Busy == 0;
		Event Player.Zone != -1;
		Is Alive(Event Player) == True;
		Global Variable(ArchOn) == 0;
		Or(Event Player.Escort == 0, Distance Between(Position Of(Event Player), Event Player.EscortPos) >= 4) == True;
		Or(Global Variable(WagonOn) == 0, Distance Between(Position Of(Event Player), Global Variable(WagonPos)) >= 4) == True;
		Or(Global Variable(HuntPhase) != 1, Distance Between(Position Of(Event Player), Global Variable(HuntTrackPos)) >= 5) == True;
		Is Button Held(Event Player, Button(Crouch)) == False;
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	action
	{
		If(And(Event Player.Bounty >= 800, Array Contains(Array(0, 2, 3, 4, 10, 13, 14), Event Player.Zone)));
			Small Message(Event Player, Custom String("수배범과는 거래하지 않는다 — 은신처로 가라"));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			Abort;
		End;
		If(Event Player.Zone == 12);
			If(Event Player.MenuIdx == 0);
				If(Event Player.Energy < 5);
					Small Message(Event Player, Custom String("너무 지쳤다 — 자거나 한잔 걸쳐야 한다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.HasParcel >= 1);
					Small Message(Event Player, Custom String("화물을 든 채 소를 몰 수는 없다"));
				Else If(Event Player.Escort == 1);
					Small Message(Event Player, Custom String("금괴를 나르는 중에는 소를 몰 수 없다"));
				Else If(Event Player.Plan >= 1);
					Small Message(Event Player, Custom String("역마차를 쫓는 중에는 소를 몰 수 없다"));
				Else If(Event Player.CowOn >= 1);
					Small Message(Event Player, Custom String("이미 소를 몰고 있다 — 우리로 데려와라"));
				Else;
					Set Player Variable(Event Player, JobArg, 6);
					Call Subroutine(BecomeJob);
					Set Player Variable(Event Player, CowPos, Nearest Walkable Position(Add(Value In Array(Global Variable(LocPos), 12), Multiply(Direction Towards(Value In Array(Global Variable(LocPos), 12), Value In Array(Global Variable(LocPos), 11)), Random Real(55, 85)))));
					Set Player Variable(Event Player, DialCur, 99);
					Set Player Variable(Event Player, CowOn, 1);
					Set Player Variable(Event Player, CowEnd, Add(Total Time Elapsed(), 360));
					Destroy Effect(Event Player.CowFx);
					Create Effect(All Players(All Teams), Sphere, Color(흰색), Event Player.CowPos, 0.7, None);
					Set Player Variable(Event Player, CowFx, Last Created Entity());
					Destroy Icon(Event Player.CowIco);
					Create Icon(All Players(All Teams), Add(Event Player.CowPos, Vector(0, 1.6, 0)), Circle, Visible To and Position, Color(흰색), True);
					Set Player Variable(Event Player, CowIco, Last Created Entity());
					Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("소가 벌판에 있다 — 몸으로 밀어 우리로!"));
					Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 2.5));
					Play Effect(Event Player, Buff Impact Sound, Color(흰색), Position Of(Event Player), 60);
				End;
			Else If(Event Player.MenuIdx == 1);
				If(Event Player.Job != 6);
					Small Message(Event Player, Custom String("목동만 승급할 수 있다 — 소몰이가 너를 목동으로 만든다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Value In Array(Event Player.Adv, Event Player.Job) == 1);
					Small Message(Event Player, Custom String("이미 목장주다"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Value In Array(Event Player.JobXP, 6) < 1000);
					Small Message(Event Player, Custom String("경험이 부족하다 — {0} / 1000", Value In Array(Event Player.JobXP, 6)));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else;
					Set Player Variable At Index(Event Player, Adv, Event Player.Job, 1);
					Big Message(All Players(All Teams), Custom String("{0} — 목장주가 되었다!", Event Player));
					Small Message(Event Player, Custom String("몰이 보수 +15% · 소가 더 성큼 밀린다"));
					Play Effect(All Players(All Teams), Ring Explosion, Color(Lime Green), Position Of(Event Player), 4);
					Play Effect(Event Player, Buff Explosion Sound, Color(Lime Green), Position Of(Event Player), 200);
				End;
			Else If(Event Player.MenuIdx == 2);
				If(Event Player.RanchPens == 0);
					If(Event Player.Fame < 30);
						Small Message(Event Player, Custom String("목장은 신용이 필요하다 — 명성 30을 쌓아 와라 (현재 {0})", Event Player.Fame));
						Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
					Else If(Event Player.Money >= 2000);
						Modify Player Variable(Event Player, Money, Subtract, 2000);
						Set Player Variable(Event Player, RanchPens, 1);
						Big Message(Event Player, Custom String("내 목장을 차렸다 — 물통 2개와 육포 1개면 소를 들인다"));
						Play Effect(Event Player, Buff Explosion Sound, Color(Lime Green), Position Of(Event Player), 140);
					Else;
						Small Message(Event Player, Custom String("돈이 모자란다 ($2000 필요)"));
						Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
					End;
				Else If(Event Player.RanchReady > 0);
					Small Message(Event Player, Custom String("출하 준비 {0}마리 — 역마차 정거장에서 넘겨라", Event Player.RanchReady));
				Else If(Event Player.RanchEnd > Total Time Elapsed());
					If(Event Player.RanchCare == 0);
						Set Player Variable(Event Player, RanchCare, 1);
						Small Message(Event Player, Custom String("물과 여물을 챙겨줬다 — 소가 살이 오른다"));
						Play Effect(Event Player, Buff Impact Sound, Color(Lime Green), Position Of(Event Player), 60);
					Else;
						Small Message(Event Player, Custom String("소는 잘 크고 있다 — {0}초 뒤 출하", Round To Integer(Subtract(Event Player.RanchEnd, Total Time Elapsed()), Up)));
					End;
				Else If(And(Value In Array(Event Player.Inv, 1) >= 2, Value In Array(Event Player.Inv, 0) >= 1));
					Set Player Variable At Index(Event Player, Inv, 1, Subtract(Value In Array(Event Player.Inv, 1), 2));
					Set Player Variable At Index(Event Player, Inv, 0, Subtract(Value In Array(Event Player.Inv, 0), 1));
					Set Player Variable(Event Player, RanchEnd, Add(Total Time Elapsed(), 720));
					Set Player Variable(Event Player, RanchCare, 0);
					Big Message(Event Player, Custom String("소를 들였다 — 하루 뒤 출하. 크는 동안 한 번은 들러서 돌봐라"));
					Play Effect(Event Player, Buff Impact Sound, Color(Lime Green), Position Of(Event Player), 60);
				Else;
					Small Message(Event Player, Custom String("물통 2개와 육포 1개가 필요하다 (물 {0} · 육포 {1})", Value In Array(Event Player.Inv, 1), Value In Array(Event Player.Inv, 0)));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				End;
			Else If(Event Player.MenuIdx == 3);
				If(Event Player.RanchPens == 0);
					Small Message(Event Player, Custom String("목장부터 차려라"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.RanchPens >= 2);
					Small Message(Event Player, Custom String("이미 최대 규모다 — 한 번에 6마리"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else If(Event Player.Money >= 5000);
					Modify Player Variable(Event Player, Money, Subtract, 5000);
					Set Player Variable(Event Player, RanchPens, 2);
					Big Message(Event Player, Custom String("우리를 늘렸다 — 이제 한 번에 6마리"));
					Play Effect(Event Player, Buff Explosion Sound, Color(Lime Green), Position Of(Event Player), 140);
				Else;
					Small Message(Event Player, Custom String("돈이 모자란다 ($5000 필요)"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				End;
			End;
		End;
	}
}

rule("[직업 00] 일이 곧 직업 — 자동 전직")
{
	event
	{
		Subroutine;
		BecomeJob;
	}

	action
	{
		If(Event Player.Job != Event Player.JobArg);
			Set Player Variable(Event Player, Job, Event Player.JobArg);
			Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("전직 — {0}", Value In Array(Array(Custom String("뜨내기"), Custom String("광부"), Custom String("사냥꾼"), Custom String("현상금 사냥꾼"), Custom String("무법자"), Custom String("파발꾼"), Custom String("목동")), Event Player.JobArg)));
			Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 2.5));
			Small Message(Event Player, Custom String("일이 곧 직업이다 — 이전 직업의 경험치와 승급은 그대로 남는다"));
			Play Effect(Event Player, Buff Impact Sound, Color(Sky Blue), Position Of(Event Player), 70);
			Play Effect(All Players(All Teams), Ring Explosion, Color(Sky Blue), Position Of(Event Player), 2);
		End;
	}
}

rule("[직업 01] DoMine")
{
	event
	{
		Subroutine;
		DoMine;
	}

	action
	{
		If(Event Player.Energy < 5);
			Small Message(Event Player, Custom String("너무 지쳤다 — 자거나 한잔 걸쳐야 한다"));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			Abort;
		End;
		Set Player Variable(Event Player, Busy, 1);
		Set Player Variable(Event Player, JobArg, 1);
		Call Subroutine(BecomeJob);
		Set Player Variable(Event Player, WorkProg, 0);
		Destroy HUD Text(Event Player.KeyHud);
		Create HUD Text(Event Player, Null, Value In Array(Array(Custom String("◆□□□□□□■■■□□□□□□□"), Custom String("□◆□□□□□■■■□□□□□□□"), Custom String("□□◆□□□□■■■□□□□□□□"), Custom String("□□□◆□□□■■■□□□□□□□"), Custom String("□□□□◆□□■■■□□□□□□□"), Custom String("□□□□□◆□■■■□□□□□□□"), Custom String("□□□□□□◆■■■□□□□□□□"), Custom String("□□□□□□□◆■■□□□□□□□"), Custom String("□□□□□□□■◆■□□□□□□□"), Custom String("□□□□□□□■■◆□□□□□□□"), Custom String("□□□□□□□■■■◆□□□□□□"), Custom String("□□□□□□□■■■□◆□□□□□"), Custom String("□□□□□□□■■■□□◆□□□□"), Custom String("□□□□□□□■■■□□□◆□□□"), Custom String("□□□□□□□■■■□□□□◆□□"), Custom String("□□□□□□□■■■□□□□□◆□"), Custom String("□□□□□□□■■■□□□□□□◆")), Min(16, Max(0, Round To Integer(Event Player.WorkProg, To Nearest)))), Custom String("◆가 ■일 때 [{0}] — 한가운데면 회심   ·   [웅크리기] 마침", Input Binding String(Button(Interact))), Top, 1, Color(흰색), Color(Yellow), Color(회색), Visible To Sort Order String and Color, Default Visibility);
		Set Player Variable(Event Player, KeyHud, Last Text ID());
		Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("곡괭이의 박자 — 결을 읽어라"));
		Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 2.5));
		Wait Until(Not(Is Button Held(Event Player, Button(Interact))), 1.5);
		While(And(And(Event Player.Zone == 1, Is Alive(Event Player)), And(And(Event Player.Energy > 0, Event Player.Hunger > 0), Is Button Held(Event Player, Button(Crouch)) == False)));
			Set Player Variable(Event Player, Roll, Round To Integer(Event Player.WorkProg, To Nearest) >= 8 ? 0 : 16);
			Chase Player Variable Over Time(Event Player, WorkProg, Event Player.Roll, Max(0.5, Subtract(0.85, Multiply(0.012, Min(25, Event Player.Streak)))), Destination and Duration);
			Wait Until(Or(Is Button Held(Event Player, Button(Interact)), Is Button Held(Event Player, Button(Crouch))), Max(0.5, Subtract(0.85, Multiply(0.012, Min(25, Event Player.Streak)))));
			If(And(Is Button Held(Event Player, Button(Interact)), Is Button Held(Event Player, Button(Crouch)) == False));
				Stop Chasing Player Variable(Event Player, WorkProg);
				If(Global Variable(GasOn) == 1);
					Set Player Variable(Event Player, Streak, 0);
					Damage(Event Player, Null, 30);
					Set Player Variable(Event Player, Energy, Max(0, Subtract(Event Player.Energy, 2.5)));
					Small Message(Event Player, Custom String("분출 속에 곡괭이를 휘둘렀다! — 전조가 오르면 손을 멈춰라"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 60);
					Wait(0.8, Ignore Condition);
				Else If(And(Round To Integer(Event Player.WorkProg, To Nearest) >= 7, Round To Integer(Event Player.WorkProg, To Nearest) <= 9));
					Set Player Variable(Event Player, Roll, Random Integer(1, 100));
					Modify Player Variable(Event Player, MineCount, Add, 1);
					If(Event Player.Prospect > 0);
						Modify Player Variable(Event Player, Prospect, Subtract, 1);
						Modify Player Variable(Event Player, Roll, Subtract, 8);
					End;
					If(Event Player.Job == 1);
						Modify Player Variable(Event Player, Roll, Subtract, 2);
						Modify Player Variable(Event Player, Roll, Subtract, Min(4, Round To Integer(Divide(Value In Array(Event Player.JobXP, 1), 250), Down)));
					End;
					If(Event Player.Roll <= 3);
						Set Player Variable(Event Player, MineGain, Random Integer(40, 105));
						If(Global Variable(TodayJob) == 1);
							Set Player Variable(Event Player, MineGain, Round To Integer(Multiply(Player Variable(Event Player, MineGain), Global Variable(FundTier) >= 3 ? 1.75 : 1.5), To Nearest));
						End;
						Modify Player Variable(Event Player, Money, Add, Event Player.MineGain);
						Modify Player Variable(Event Player, Earned, Add, Event Player.MineGain);
						Set Player Variable At Index(Event Player, JobXP, 1, Add(Value In Array(Event Player.JobXP, 1), 40));
						Set Global Variable(TickerMsg, Custom String("{0} — 금맥 발견! $ {1}", Event Player, Event Player.MineGain));
						Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
						Play Effect(All Players(All Teams), Ring Explosion, Color(Yellow), Position Of(Event Player), 4);
					Else;
						Set Player Variable(Event Player, MineGain, Random Integer(1, 2));
						If(Event Player.Job == 1);
							Modify Player Variable(Event Player, MineGain, Add, 1);
							Set Player Variable At Index(Event Player, JobXP, 1, Add(Value In Array(Event Player.JobXP, 1), 20));
						End;
						Modify Player Variable(Event Player, MineGain, Add, Event Player.Pick);
						If(Round To Integer(Event Player.WorkProg, To Nearest) == 8);
							Modify Player Variable(Event Player, MineGain, Add, 2);
							Small Message(Event Player, Custom String("회심의 정타!"));
							Play Effect(Event Player, Ring Explosion, Color(Orange), Position Of(Event Player), 1.2);
						End;
						If(And(And(Event Player.Job == 1, Value In Array(Event Player.Adv, Event Player.Job) == 1), Random Integer(1, 100) <= 10));
							Modify Player Variable(Event Player, MineGain, Multiply, 2);
							Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("광산주의 눈 — 이번 수확 2배!"));
							Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 2.5));
							Play Effect(Event Player, Ring Explosion, Color(Yellow), Position Of(Event Player), 1.5);
						End;
						If(Global Variable(EventKind) == 1);
							Modify Player Variable(Event Player, MineGain, Multiply, 2);
						End;
						If(Global Variable(EventKind) == 6);
							Modify Player Variable(Event Player, MineGain, Multiply, 3);
							Damage(Event Player, Null, 15);
						End;
						If(Global Variable(TodayJob) == 1);
							Set Player Variable(Event Player, MineGain, Round To Integer(Multiply(Player Variable(Event Player, MineGain), Global Variable(FundTier) >= 3 ? 1.75 : 1.5), To Nearest));
						End;
						Set Player Variable At Index(Event Player, Inv, 2, Add(Value In Array(Event Player.Inv, 2), Event Player.MineGain));
						Small Message(Event Player, Custom String("원석 +{0}   (보유 {1})", Event Player.MineGain, Value In Array(Event Player.Inv, 2)));
						Play Effect(Event Player, Buff Impact Sound, Color(Yellow), Position Of(Event Player), 50);
					End;
					Play Effect(All Players(All Teams), Bad Explosion, Color(회색), Position Of(Event Player), 0.5);
					If(Modulo(Event Player.MineCount, 10) == 0);
						Modify Player Variable(Event Player, Money, Add, 20);
						Modify Player Variable(Event Player, Earned, Add, 20);
						Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("채굴 {0}회 달성 — 보너스 $20", Event Player.MineCount));
						Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 2.5));
						Play Effect(Event Player, Good Explosion, Color(Lime Green), Position Of(Event Player), 2);
					End;
					Set Player Variable(Event Player, Energy, Max(0, Subtract(Event Player.Energy, 5)));
					Set Player Variable(Event Player, Hunger, Max(0, Subtract(Event Player.Hunger, 2)));
					Set Player Variable(Event Player, Thirst, Max(0, Subtract(Event Player.Thirst, 2.5)));
					If(Subtract(Total Time Elapsed(), Event Player.LastMine) > 25);
						Set Player Variable(Event Player, Streak, 0);
					End;
					Set Player Variable(Event Player, LastMine, Total Time Elapsed());
					If(And(Global Variable(ContractKind) == 1, Modulo(Player Variable(Event Player, Giant), 10) < 8));
						Modify Player Variable(Event Player, Giant, Add, 1);
						If(Modulo(Player Variable(Event Player, Giant), 10) == 8);
							Modify Player Variable(Event Player, Giant, Add, Subtract(9, 8));
							Modify Player Variable(Event Player, Money, Add, 150);
							Modify Player Variable(Event Player, Earned, Add, 150);
							Set Player Variable(Event Player, Fame, Min(100, Add(Player Variable(Event Player, Fame), 3)));
							Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("오늘의 계약 달성! +$150 · 명성 +3"));
							Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 2.5));
							Play Effect(Event Player, Buff Explosion Sound, Color(Yellow), Position Of(Event Player), 120);
						Else;
							Small Message(Event Player, Custom String("오늘의 계약 — 진행 {0} / {1}", Modulo(Player Variable(Event Player, Giant), 10), 8));
						End;
					End;
					Modify Player Variable(Event Player, Streak, Add, 1);
					If(Modulo(Event Player.Streak, 5) == 0);
						Set Player Variable(Event Player, StreakPay, Multiply(Min(Event Player.Streak, 25), 3));
						Modify Player Variable(Event Player, Money, Add, Event Player.StreakPay);
						Modify Player Variable(Event Player, Earned, Add, Event Player.StreakPay);
						Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("{0}연속 채굴!   +$ {1}", Event Player.Streak, Event Player.StreakPay));
						Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 2.5));
						Play Effect(Event Player, Ring Explosion, Color(Yellow), Position Of(Event Player), 1.5);
					End;
					Wait(1.1, Ignore Condition);
				Else;
					Set Player Variable(Event Player, Streak, 0);
					Set Player Variable(Event Player, Energy, Max(0, Subtract(Event Player.Energy, 2.5)));
					Set Player Variable(Event Player, Hunger, Max(0, Subtract(Event Player.Hunger, 1)));
					Set Player Variable(Event Player, Thirst, Max(0, Subtract(Event Player.Thirst, 1.2)));
					Small Message(Event Player, Custom String("헛스윙 — 결을 놓쳤다 (연속 끊김)"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 40);
					Wait(0.6, Ignore Condition);
				End;
				Wait Until(Not(Is Button Held(Event Player, Button(Interact))), 1);
			End;
		End;
		Stop Chasing Player Variable(Event Player, WorkProg);
		Destroy HUD Text(Event Player.KeyHud);
		Set Player Variable(Event Player, WorkProg, 0);
		Set Player Variable(Event Player, Busy, 0);
		Small Message(Event Player, Custom String("곡괭이를 내려놓았다"));
	}
}

rule("[직업 03-5] 야수 정원 감시 — 항상 3마리")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(Ready) == 1;
		Is Game In Progress() == True;
	}

	action
	{
		If(Not(Entity Exists(Players In Slot(0, Team 2))));
			Create Dummy Bot(Hero(제트팩 캣), Team 2, 0, Nearest Walkable Position(Add(Value In Array(Global Variable(LocPos), 6), Vector(Random Real(-7, 7), 0, Random Real(-7, 7)))), Vector(1, 0, 0));
		End;
		If(Not(Entity Exists(Players In Slot(1, Team 2))));
			Create Dummy Bot(Hero(제트팩 캣), Team 2, 1, Nearest Walkable Position(Add(Value In Array(Global Variable(LocPos), 6), Vector(Random Real(-7, 7), 0, Random Real(-7, 7)))), Vector(1, 0, 0));
		End;
		If(Not(Entity Exists(Players In Slot(2, Team 2))));
			Create Dummy Bot(Hero(제트팩 캣), Team 2, 2, Nearest Walkable Position(Add(Value In Array(Global Variable(LocPos), 6), Vector(Random Real(-7, 7), 0, Random Real(-7, 7)))), Vector(1, 0, 0));
		End;
		Wait(6, Ignore Condition);
		Loop();
	}
}

rule("[직업 02] DoHunt")
{
	event
	{
		Subroutine;
		DoHunt;
	}

	action
	{
		If(Global Variable(HuntPhase) == 4);
			Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("전설의 야수를 사냥하러 가야할 듯 하다..."));
			Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 3));
			Play Effect(Event Player, Debuff Impact Sound, Color(Orange), Position Of(Event Player), 45);
			Abort;
		End;
		If(Event Player.Energy < 4);
			Small Message(Event Player, Custom String("너무 지쳤다 — 자거나 한잔 걸쳐야 한다"));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			Abort;
		End;
		Set Player Variable(Event Player, Target, Filtered Array(All Players(Team 2), And(Slot Of(Current Array Element) <= 2, And(And(Is Dummy Bot(Current Array Element), Is Alive(Current Array Element)), Current Array Element != Global Variable(HuntBeast)))));
		If(Count Of(Event Player.Target) == 0);
			Small Message(Event Player, Custom String("흔적이 끊겼다 — 잠시 뒤 다시 시도해라"));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			Abort;
		End;
		Set Player Variable(Event Player, Busy, 1);
		Set Player Variable(Event Player, WorkProg, 0);
		Destroy Progress Bar HUD Text(Event Player.WorkBar);
		Set Player Variable(Event Player, JobArg, 2);
		Call Subroutine(BecomeJob);
		Create Progress Bar HUD Text(Event Player, Event Player.WorkProg, Custom String("흔적 추적 중..."), Top, 0, Color(Orange), Color(흰색), Visible To Values and Color, Default Visibility);
		Set Player Variable(Event Player, WorkBar, Last Text ID());
		Chase Player Variable Over Time(Event Player, WorkProg, 100, 1.8, Destination and Duration);
		Wait(1.8, Ignore Condition);
		Stop Chasing Player Variable(Event Player, WorkProg);
		Destroy Progress Bar HUD Text(Event Player.WorkBar);
		Set Player Variable(Event Player, Energy, Max(0, Subtract(Event Player.Energy, 4)));
		Set Player Variable(Event Player, Hunger, Max(0, Subtract(Event Player.Hunger, 1.5)));
		Set Player Variable(Event Player, Thirst, Max(0, Subtract(Event Player.Thirst, 2)));
		Set Player Variable(Event Player, Roll, Value In Array(Event Player.Adv, 2));
		For Player Variable(Event Player, Idx, 0, Count Of(Event Player.Target), 1);
			Set Player Variable(Value In Array(Event Player.Target, Event Player.Idx), RevealEnd, Add(Total Time Elapsed(), 50));
			Set Player Variable(Value In Array(Event Player.Target, Event Player.Idx), Roll, Random Integer(1, 1000));
			Set Player Variable(Value In Array(Event Player.Target, Event Player.Idx), Giant, Player Variable(Value In Array(Event Player.Target, Event Player.Idx), Roll) <= Add(44, Multiply(20, Event Player.Roll)) ? 1 : 0);
			If(Player Variable(Value In Array(Event Player.Target, Event Player.Idx), Roll) <= 4);
				Set Player Variable(Value In Array(Event Player.Target, Event Player.Idx), Giant, 2);
			End;
			If(Player Variable(Value In Array(Event Player.Target, Event Player.Idx), Giant) == 2);
				Set Max Health(Value In Array(Event Player.Target, Event Player.Idx), 875);
				Remove All Health Pools From Player(Value In Array(Event Player.Target, Event Player.Idx));
				Add Health Pool To Player(Value In Array(Event Player.Target, Event Player.Idx), Health, 2500, True, True);
				Start Scaling Player(Value In Array(Event Player.Target, Event Player.Idx), 50, False);
				Heal(Value In Array(Event Player.Target, Event Player.Idx), Null, 9999);
				Big Message(All Players(All Teams), Custom String("전설의 야수가 깨어났다!! 보상 50배"));
				Play Effect(All Players(All Teams), Ring Explosion, Color(Red), Position Of(Value In Array(Event Player.Target, Event Player.Idx)), 14);
				Play Effect(All Players(All Teams), Explosion Sound, Color(Red), Position Of(Value In Array(Event Player.Target, Event Player.Idx)), 250);
			Else If(Player Variable(Value In Array(Event Player.Target, Event Player.Idx), Giant) == 1);
				Set Max Health(Value In Array(Event Player.Target, Event Player.Idx), 175);
				Start Scaling Player(Value In Array(Event Player.Target, Event Player.Idx), 2.4, False);
				Heal(Value In Array(Event Player.Target, Event Player.Idx), Null, 9999);
				Set Global Variable(TickerMsg, Custom String("거대한 야수다! 체력 5배 — 가죽도 5배"));
				Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
				Play Effect(All Players(All Teams), Ring Explosion, Color(Red), Position Of(Value In Array(Event Player.Target, Event Player.Idx)), 6);
			Else;
				Set Max Health(Value In Array(Event Player.Target, Event Player.Idx), 35);
				Stop Scaling Player(Value In Array(Event Player.Target, Event Player.Idx));
			End;
			Clear Status(Value In Array(Event Player.Target, Event Player.Idx), Phased Out);
			Set Invisible(Value In Array(Event Player.Target, Event Player.Idx), None);
			Teleport(Value In Array(Event Player.Target, Event Player.Idx), Nearest Walkable Position(Add(Add(Position Of(Event Player), Multiply(Facing Direction Of(Event Player), 7)), Vector(Random Real(-4, 4), 0, Random Real(-4, 4)))));
			Play Effect(All Players(All Teams), Ring Explosion, Color(Orange), Position Of(Value In Array(Event Player.Target, Event Player.Idx)), 3);
		End;
		Play Effect(Event Player, Explosion Sound, Color(Orange), Position Of(Event Player), 190);
		Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("크아앙! 엄청 무서운 야수가 나타났다!"));
		Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 2.5));
		Small Message(Event Player, Custom String("붉은 급소가 빛날 때 쏴라 — 세 배로 아프다"));
		Set Player Variable(Event Player, Busy, 0);
	}
}

rule("[직업 03] 야수 은신")
{
	event
	{
		Ongoing - Each Player;
		Team 2;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == True;
		Global Variable(Ready) == 1;
		Is Alive(Event Player) == True;
		Slot Of(Event Player) <= 2;
	}

	action
	{
		If(And(Total Time Elapsed() >= Event Player.RevealEnd, Has Status(Event Player, Phased Out) == False));
			Set Max Health(Event Player, 35);
			Remove All Health Pools From Player(Event Player);
			Set Respawn Max Time(Event Player, 4);
			Stop Scaling Player(Event Player);
			Set Player Variable(Event Player, Giant, 0);
			Set Ability 1 Enabled(Event Player, False);
			Set Ability 2 Enabled(Event Player, False);
			Set Ultimate Ability Enabled(Event Player, False);
			Set Primary Fire Enabled(Event Player, False);
			Set Secondary Fire Enabled(Event Player, False);
			Destroy Icon(Event Player.IcoId);
			Set Player Variable(Event Player, IcoId, 0);
			Stop Throttle In Direction(Event Player);
			Set Jump Vertical Speed(Event Player, 100);
			Set Move Speed(Event Player, 0);
			Set Invisible(Event Player, All);
			Set Status(Event Player, Null, Phased Out, 9999);
			Teleport(Event Player, Nearest Walkable Position(Add(Value In Array(Global Variable(LocPos), 6), Vector(Random Real(-7, 7), 0, Random Real(-7, 7)))));
		End;
		Wait(0.4, Ignore Condition);
		Loop();
	}
}

rule("[직업 03-3] 야수 배회")
{
	event
	{
		Ongoing - Each Player;
		Team 2;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == True;
		Global Variable(Ready) == 1;
		Is Alive(Event Player) == True;
		Event Player.RevealEnd > Total Time Elapsed();
		Slot Of(Event Player) <= 2;
		Event Player != Global Variable(HuntBeast);
	}

	action
	{
		If(Distance Between(Position Of(Event Player), Value In Array(Global Variable(LocPos), 6)) > 11);
			Teleport(Event Player, Nearest Walkable Position(Add(Value In Array(Global Variable(LocPos), 6), Vector(Random Real(-4, 4), 0, Random Real(-4, 4)))));
			Play Effect(All Players(All Teams), Ring Explosion, Color(Orange), Position Of(Event Player), 1);
			Wait(0.2, Ignore Condition);
		Else;
			Set Move Speed(Event Player, Random Integer(1, 100) <= 35 ? Random Integer(175, 215) : Random Integer(110, 148));
			Set Jump Vertical Speed(Event Player, Random Integer(100, 250));
			Start Throttle In Direction(Event Player, Direction Towards(Position Of(Event Player), Nearest Walkable Position(Add(Value In Array(Global Variable(LocPos), 6), Vector(Random Real(-7, 7), 0, Random Real(-7, 7))))), 1, To World, Replace existing throttle, None);
			Set Facing(Event Player, Vector(Random Real(-1, 1), Random Real(-0.6, 0.6), Random Real(-1, 1)), To World);
			If(Random Integer(1, 100) <= 8);
				Press Button(Event Player, Button(Jump));
			End;
			If(Random Integer(1, 100) <= 12);
				Apply Impulse(Event Player, Vector(Random Real(-1, 1), Random Real(0.8, 1.5), Random Real(-1, 1)), Random Real(9, 16), To World, Cancel Contrary Motion);
			End;
			Wait(Random Real(0.35, 0.9), Ignore Condition);
		End;
		Loop If(And(Event Player.RevealEnd > Total Time Elapsed(), Event Player != Global Variable(HuntBeast)));
		Stop Throttle In Direction(Event Player);
	}
}
rule("[직업 03-4] 야수 위치 표시")
{
	event
	{
		Ongoing - Each Player;
		Team 2;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == True;
		Global Variable(Ready) == 1;
		Is Alive(Event Player) == True;
		Event Player.RevealEnd > Total Time Elapsed();
		Slot Of(Event Player) <= 2;
	}

	action
	{
		Destroy Icon(Event Player.IcoId);
		Create Icon(All Players(All Teams), Add(Position Of(Event Player), Vector(0, 1.8, 0)), Eye, Visible To and Position, Color(Orange), True);
		Set Player Variable(Event Player, IcoId, Last Created Entity());
		Wait Until(Or(Total Time Elapsed() >= Event Player.RevealEnd, Not(Is Alive(Event Player))), 99999);
		Destroy Icon(Event Player.IcoId);
		Set Player Variable(Event Player, IcoId, 0);
	}
}

rule("[직업 03-2] 야수 처치")
{
	event
	{
		Player Died;
		Team 2;
		All;
	}

	condition
	{
		Is Dummy Bot(Victim) == True;
		Entity Exists(Attacker) == True;
		Player Variable(Attacker, Init) == 1;
		Slot Of(Victim) <= 2;
	}

	action
	{
		Set Player Variable(Attacker, Yield, Random Integer(1, 3));
		If(Player Variable(Attacker, Job) == 2);
			Modify Player Variable(Attacker, Yield, Add, Value In Array(Player Variable(Attacker, Adv), 2));
			Modify Player Variable(Attacker, Yield, Add, Min(2, Round To Integer(Divide(Value In Array(Player Variable(Attacker, JobXP), 2), 250), Down)));
			Set Player Variable At Index(Attacker, JobXP, 2, Add(Value In Array(Player Variable(Attacker, JobXP), 2), 20));
		End;
		If(Global Variable(EventKind) == 3);
			Modify Player Variable(Attacker, Yield, Multiply, 2);
		End;
		If(Player Variable(Victim, Giant) == 2);
			Modify Player Variable(Attacker, Yield, Multiply, 50);
		Else If(Player Variable(Victim, Giant) == 1);
			Modify Player Variable(Attacker, Yield, Multiply, 5);
		End;
		If(Global Variable(TodayJob) == 2);
			Set Player Variable(Attacker, Yield, Round To Integer(Multiply(Player Variable(Attacker, Yield), Global Variable(FundTier) >= 3 ? 1.75 : 1.5), To Nearest));
		End;
		Modify Player Variable At Index(Attacker, Inv, 3, Add, Player Variable(Attacker, Yield));
		Set Global Variable(JerkyStock, Min(60, Add(Global Variable(JerkyStock), 1)));
		If(And(Global Variable(ContractKind) == 2, Modulo(Player Variable(Attacker, Giant), 10) < 4));
			Modify Player Variable(Attacker, Giant, Add, 1);
			If(Modulo(Player Variable(Attacker, Giant), 10) == 4);
				Modify Player Variable(Attacker, Giant, Add, Subtract(9, 4));
				Modify Player Variable(Attacker, Money, Add, 150);
				Modify Player Variable(Attacker, Earned, Add, 150);
				Set Player Variable(Attacker, Fame, Min(100, Add(Player Variable(Attacker, Fame), 3)));
				Set Global Variable At Index(NoticeMsg, Slot Of(Attacker), Custom String("오늘의 계약 달성! +$150 · 명성 +3"));
				Set Global Variable At Index(NoticeEnd, Slot Of(Attacker), Add(Total Time Elapsed(), 2.5));
				Play Effect(Attacker, Buff Explosion Sound, Color(Yellow), Position Of(Attacker), 120);
			Else;
				Small Message(Attacker, Custom String("오늘의 계약 — 진행 {0} / {1}", Modulo(Player Variable(Attacker, Giant), 10), 4));
			End;
		End;
		If(Player Variable(Victim, Giant) == 2);
			Modify Player Variable(Attacker, Money, Add, 200);
			Modify Player Variable(Attacker, Earned, Add, 200);
			Big Message(All Players(All Teams), Custom String("{0} — 전설의 야수를 쓰러뜨렸다!! 가죽 +{1}장 + $200", Attacker, Player Variable(Attacker, Yield)));
			Play Effect(All Players(All Teams), Ring Explosion, Color(Red), Position Of(Attacker), 14);
			Play Effect(All Players(All Teams), Buff Explosion Sound, Color(Red), Position Of(Attacker), 250);
		Else If(Player Variable(Victim, Giant) == 1);
			Modify Player Variable(Attacker, Money, Add, 40);
			Modify Player Variable(Attacker, Earned, Add, 40);
			Set Global Variable(TickerMsg, Custom String("{0} — 거대한 야수를 쓰러뜨렸다! 가죽 +{1}장 + $40", Attacker, Player Variable(Attacker, Yield)));
			Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
			Play Effect(All Players(All Teams), Ring Explosion, Color(Red), Position Of(Attacker), 6);
			Play Effect(All Players(All Teams), Buff Explosion Sound, Color(Red), Position Of(Attacker), 200);
		Else If(Random Integer(1, 100) <= 10);
			Modify Player Variable(Attacker, Money, Add, 48);
			Modify Player Variable(Attacker, Earned, Add, 48);
			Set Global Variable(TickerMsg, Custom String("{0} — 큰 놈을 잡았다! 가죽 +{1}장 + $48", Attacker, Player Variable(Attacker, Yield)));
			Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
			Play Effect(All Players(All Teams), Ring Explosion, Color(Orange), Position Of(Attacker), 3);
		Else;
			Small Message(Attacker, Custom String("사냥 성공 — 가죽 +{0}장", Player Variable(Attacker, Yield)));
		End;
		Destroy Icon(Player Variable(Victim, IcoId));
		Set Player Variable(Victim, IcoId, 0);
		Set Player Variable(Victim, Giant, 0);
		Stop Scaling Player(Victim);
		Remove All Health Pools From Player(Victim);
		Set Max Health(Victim, 35);
		Set Player Variable(Victim, RevealEnd, 0);
	}
}
rule("[직업 04] DoPlan")
{
	event
	{
		Subroutine;
		DoPlan;
	}

	action
	{
		If(Event Player.Energy < 6);
			Small Message(Event Player, Custom String("너무 지쳤다 — 자거나 한잔 걸쳐야 한다"));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			Abort;
		End;
		If(Event Player.Plan >= 1);
			Small Message(Event Player, Custom String("이미 역마차를 쫓고 있다 — 보라 구슬을 따라잡아라"));
			Abort;
		End;
		If(Event Player.CowOn >= 1);
			Small Message(Event Player, Custom String("소를 몰면서 습격은 못 한다"));
			Abort;
		End;
		If(Event Player.Escort == 1);
			Small Message(Event Player, Custom String("금괴를 진 채 습격은 못 한다"));
			Abort;
		End;
		Set Player Variable(Event Player, JobArg, 4);
		Call Subroutine(BecomeJob);
		Set Player Variable At Index(Event Player, JobXP, 4, Add(Value In Array(Event Player.JobXP, 4), 15));
		Set Player Variable(Event Player, Energy, Max(0, Subtract(Event Player.Energy, 8)));
		Set Player Variable(Event Player, Hunger, Max(0, Subtract(Event Player.Hunger, 3)));
		Set Player Variable(Event Player, Thirst, Max(0, Subtract(Event Player.Thirst, 3)));
		Set Player Variable(Event Player, CowPos, Nearest Walkable Position(Value In Array(Global Variable(RaidPath), 0)));
		Set Player Variable(Event Player, CowEnd, Total Time Elapsed());
		Destroy Effect(Event Player.CowFx);
		Create Effect(All Players(All Teams), Sphere, Color(Purple), Event Player.CowPos, 1.1, Visible To Position Radius and Color);
		Set Player Variable(Event Player, CowFx, Last Created Entity());
		Destroy Icon(Event Player.CowIco);
		Create Icon(All Players(All Teams), Add(Event Player.CowPos, Vector(0, 2.4, 0)), Diamond, Visible To and Position, Color(Purple), True);
		Set Player Variable(Event Player, CowIco, Last Created Entity());
		Destroy Progress Bar HUD Text(Event Player.WorkBar);
		Create Progress Bar HUD Text(Event Player, Min(100, Subtract(Event Player.Plan, 1)), Custom String("역마차 약탈 — 마차에 붙어라"), Top, 0, Color(Purple), Color(흰색), Visible To Values and Color, Default Visibility);
		Set Player Variable(Event Player, WorkBar, Last Text ID());
		Set Player Variable(Event Player, Plan, 1);
		Big Message(Event Player, Custom String("역마차가 정거장을 떠났다 — 따라붙어서 털어라!"));
		Small Message(Event Player, Custom String("7m 안에 붙어 있으면 약탈이 차오른다 · 호위가 반격한다 · 잡화점에 닿기 전에 털어라"));
		Play Effect(Event Player, Buff Impact Sound, Color(Purple), Position Of(Event Player), 60);
	}
}

rule("[습격 01] 역마차 추격")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Event Player.Plan >= 1;
	}

	action
	{
		If(Not(Is Alive(Event Player)));
			Set Player Variable(Event Player, Plan, 0);
			Destroy Effect(Event Player.CowFx);
			Destroy Icon(Event Player.CowIco);
			Destroy Progress Bar HUD Text(Event Player.WorkBar);
			Small Message(Event Player, Custom String("쓰러졌다 — 역마차는 유유히 사라졌다"));
			Abort;
		End;
		If(Subtract(Total Time Elapsed(), Event Player.CowEnd) > 26);
			Set Player Variable(Event Player, Plan, 0);
			Destroy Effect(Event Player.CowFx);
			Destroy Icon(Event Player.CowIco);
			Destroy Progress Bar HUD Text(Event Player.WorkBar);
			Small Message(Event Player, Custom String("역마차가 잡화점 차고로 숨어들었다 — 습격 실패"));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 60);
			Abort;
		End;
		Set Player Variable(Event Player, Roll, Min(11.99, Divide(Subtract(Total Time Elapsed(), Event Player.CowEnd), 2)));
		Set Player Variable(Event Player, CowPos, Nearest Walkable Position(Add(Value In Array(Global Variable(RaidPath), Round To Integer(Event Player.Roll, Down)), Multiply(Subtract(Value In Array(Global Variable(RaidPath), Add(Round To Integer(Event Player.Roll, Down), 1)), Value In Array(Global Variable(RaidPath), Round To Integer(Event Player.Roll, Down))), Subtract(Event Player.Roll, Round To Integer(Event Player.Roll, Down))))));
		If(Distance Between(Position Of(Event Player), Event Player.CowPos) < 7);
			Modify Player Variable(Event Player, Plan, Add, Add(4, Multiply(2, Value In Array(Event Player.Adv, 4))));
			If(Random Integer(1, 100) <= 12);
				Damage(Event Player, Null, 22);
				Small Message(Event Player, Custom String("호위가 쏜다! 떨어지지 마라"));
				Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			End;
		End;
		If(Event Player.Plan >= 101);
			Set Player Variable(Event Player, Plan, 0);
			Destroy Effect(Event Player.CowFx);
			Destroy Icon(Event Player.CowIco);
			Destroy Progress Bar HUD Text(Event Player.WorkBar);
			Set Player Variable At Index(Event Player, JobXP, 4, Add(Value In Array(Event Player.JobXP, 4), 30));
			Set Player Variable(Event Player, PlanPay, Random Integer(260, 420));
			If(Global Variable(TodayJob) == 4);
				Set Player Variable(Event Player, PlanPay, Round To Integer(Multiply(Player Variable(Event Player, PlanPay), Global Variable(FundTier) >= 3 ? 1.75 : 1.5), To Nearest));
			End;
			Modify Player Variable(Event Player, Money, Add, Event Player.PlanPay);
			Modify Player Variable(Event Player, Earned, Add, Event Player.PlanPay);
			Modify Player Variable(Event Player, Bounty, Add, 200);
			Set Player Variable(Event Player, Noto, Min(100, Add(Event Player.Noto, 15)));
			Big Message(Event Player, Custom String("역마차를 털었다! +$ {0}", Event Player.PlanPay));
			Play Effect(All Players(All Teams), Ring Explosion, Color(Purple), Position Of(Event Player), 4);
			Wait(2, Ignore Condition);
			Small Message(Event Player, Custom String("현상금 $ {0} — 이제 쫓기는 몸이다", Event Player.Bounty));
			Abort;
		End;
		Wait(0.5, Ignore Condition);
		Loop If(Event Player.Plan >= 1);
	}
}

rule("[광산 02] 가스 분출 주기")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(Ready) == 1;
	}

	action
	{
		Wait(Random Real(8, 13), Ignore Condition);
		Destroy Effect(Global Variable(GasFx));
		Create Effect(All Players(All Teams), Light Shaft, Color(Yellow), Value In Array(Global Variable(LocPos), 1), 2.2, Visible To Position Radius and Color);
		Set Global Variable(GasFx, Last Created Entity());
		Small Message(Filtered Array(Players Within Radius(Value In Array(Global Variable(LocPos), 1), 16, All Teams, Off), Player Variable(Current Array Element, Job) == 1), Custom String("광산이 부글거린다 — 분출 전조다, 손을 멈춰라!"));
		Play Effect(Filtered Array(Players Within Radius(Value In Array(Global Variable(LocPos), 1), 16, All Teams, Off), Player Variable(Current Array Element, Job) == 1), Debuff Impact Sound, Color(Yellow), Value In Array(Global Variable(LocPos), 1), 60);
		Wait(2, Ignore Condition);
		Destroy Effect(Global Variable(GasFx));
		Set Global Variable(GasOn, 1);
		Create Effect(All Players(All Teams), Light Shaft, Color(Red), Value In Array(Global Variable(LocPos), 1), 2.2, Visible To Position Radius and Color);
		Set Global Variable(GasFx, Last Created Entity());
		Play Effect(All Players(All Teams), Bad Explosion, Color(Yellow), Value In Array(Global Variable(LocPos), 1), 6);
		Wait(1.8, Ignore Condition);
		Set Global Variable(GasOn, 0);
		Destroy Effect(Global Variable(GasFx));
		Loop();
	}
}

rule("[쥐 01] 쥐떼의 습격")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(Ready) == 1;
		Global Variable(RatOn) == 0;
		Total Time Elapsed() >= Global Variable(RatNext);
	}

	action
	{
		Set Global Variable(RatOn, 1);
		Create Dummy Bot(Hero(레킹볼), Team 2, 3, Nearest Walkable Position(Add(Value In Array(Global Variable(LocPos), 2), Vector(Random Real(-7, 7), 0, Random Real(-7, 7)))), Vector(1, 0, 0));
		Wait(0.5, Ignore Condition);
		Set Max Health(Players In Slot(3, Team 2), 667);
		Set Move Speed(Players In Slot(3, Team 2), 130);
		Set Global Variable(RatLast, Position Of(Players In Slot(3, Team 2)));
		Set Global Variable(RatStuck, 0);
		Set Global Variable(RatHitters, Empty Array);
		Set Global Variable(RatKill, 0);
		Set Damage Received(Players In Slot(3, Team 2), 18);
		Big Message(All Players(All Teams), Custom String("쥐떼가 몰려온다!! 사람을 물고 육포를 노린다 — 혼자서는 못 막는다"));
		Create Icon(All Players(All Teams), Players In Slot(3, Team 2), Skull, Visible To and Position, Color(Red), True);
		Set Global Variable(RatFx, Last Created Entity());
		Play Effect(All Players(All Teams), Debuff Impact Sound, Color(Red), Value In Array(Global Variable(LocPos), 2), 200);
		Wait(45, Ignore Condition);
		If(And(And(Global Variable(RatOn) == 1, Global Variable(JerkyStock) == 0), Global Variable(RatKill) == 0));
			Big Message(All Players(All Teams), Custom String("육포가 바닥났다 — 쥐떼가 물러나지 않는다! 죽여야 끝난다"));
			Wait Until(Or(Global Variable(RatOn) == 0, Global Variable(RatKill) == 1), 99999);
		End;
		If(Global Variable(RatOn) == 1);
			Set Global Variable(RatOn, 0);
			Destroy Icon(Global Variable(RatFx));
			If(Global Variable(RatKill) == 1);
				Big Message(All Players(All Teams), Custom String("쥐떼가 사람을 물어 죽이고 물러갔다"));
			Else;
				Set Global Variable(JerkyStock, Max(0, Subtract(Global Variable(JerkyStock), 15)));
				Big Message(All Players(All Teams), Custom String("쥐떼가 육포를 물고 달아났다 — 잡화점에 육포 {0} 남았다", Global Variable(JerkyStock)));
			End;
			Destroy Dummy Bot(Team 2, 3);
		End;
		Set Global Variable(RatNext, Add(Total Time Elapsed(), Random Real(240, 600)));
	}
}

rule("[쥐 02] 쥐의 약탈")
{
	event
	{
		Ongoing - Each Player;
		Team 2;
		All;
	}

	condition
	{
		Slot Of(Event Player) == 3;
		Global Variable(RatOn) == 1;
		Is Alive(Event Player) == True;
	}

	action
	{
		Set Global Variable(RatTgt, First Of(Sorted Array(Filtered Array(All Players(Team 1), And(And(Is Alive(Current Array Element), Player Variable(Current Array Element, Init) == 1), And(Has Status(Current Array Element, Phased Out) == False, And(Player Variable(Current Array Element, JailOn) == 0, Player Variable(Current Array Element, TutOn) == 0)))), Distance Between(Position Of(Current Array Element), Position Of(Event Player)))));
		If(Or(Global Variable(JerkyStock) > 0, Not(Entity Exists(Global Variable(RatTgt)))));
			Set Global Variable(RatGoal, Value In Array(Global Variable(LocPos), 2));
		Else;
			Set Global Variable(RatGoal, Position Of(Global Variable(RatTgt)));
		End;
		Start Throttle In Direction(Event Player, Direction Towards(Position Of(Event Player), Global Variable(RatGoal)), 1, To World, Replace existing throttle, None);
		If(And(Entity Exists(Global Variable(RatTgt)), Distance Between(Position Of(Event Player), Position Of(Global Variable(RatTgt))) < 3.5));
			Damage(Global Variable(RatTgt), Event Player, 20);
			Play Effect(All Players(All Teams), Bad Explosion, Color(Red), Position Of(Event Player), 1.5);
		End;
		If(And(Global Variable(JerkyStock) > 0, Distance Between(Position Of(Event Player), Value In Array(Global Variable(LocPos), 2)) < 9));
			Set Global Variable(JerkyStock, Max(0, Subtract(Global Variable(JerkyStock), 2)));
			Play Effect(All Players(All Teams), Bad Explosion, Color(Orange), Position Of(Event Player), 1);
		End;
		If(Distance Between(Position Of(Event Player), Global Variable(RatLast)) < 1);
			Modify Global Variable(RatStuck, Add, 1);
		Else;
			Set Global Variable(RatStuck, 0);
		End;
		Set Global Variable(RatLast, Position Of(Event Player));
		If(And(Global Variable(RatStuck) >= 3, Distance Between(Position Of(Event Player), Global Variable(RatGoal)) > 6));
			Set Global Variable(RatStuck, 0);
			Teleport(Event Player, First Of(Sorted Array(Global Variable(SpotPos), Distance Between(Current Array Element, Global Variable(RatGoal)))));
			Set Global Variable(RatLast, Position Of(Event Player));
			Play Effect(All Players(All Teams), Bad Explosion, Color(Orange), Position Of(Event Player), 2);
		End;
		Wait(1, Ignore Condition);
		Loop If(And(Global Variable(RatOn) == 1, Is Alive(Event Player)));
	}
}

rule("[쥐 03] 사냥꾼의 이빨")
{
	event
	{
		Player Took Damage;
		Team 2;
		All;
	}

	condition
	{
		Slot Of(Event Player) == 3;
		Global Variable(RatOn) == 1;
		Entity Exists(Attacker) == True;
		Is Dummy Bot(Attacker) == False;
	}

	action
	{
		If(Not(Array Contains(Global Variable(RatHitters), Attacker)));
			Modify Global Variable(RatHitters, Append To Array, Attacker);
			If(Count Of(Global Variable(RatHitters)) == 3);
				Big Message(All Players(All Teams), Custom String("셋이 붙었다 — 쥐떼의 가죽이 벗겨진다!"));
				Play Effect(All Players(All Teams), Ring Explosion, Color(Orange), Position Of(Event Player), 3);
			End;
		End;
		If(And(Player Variable(Attacker, Job) >= 2, Player Variable(Attacker, Job) <= 3));
			Damage(Event Player, Null, Multiply(Event Damage, Player Variable(Attacker, Job) == 3 ? 1 : 0.5));
		End;
	}
}

rule("[쥐 05] 쥐떼의 가죽")
{
	event
	{
		Ongoing - Each Player;
		Team 2;
		All;
	}

	condition
	{
		Slot Of(Event Player) == 3;
		Global Variable(RatOn) == 1;
		Is Alive(Event Player) == True;
	}

	action
	{
		Set Global Variable(RatPop, Count Of(Filtered Array(All Players(Team 1), And(And(Is Alive(Current Array Element), Player Variable(Current Array Element, Init) == 1), Player Variable(Current Array Element, TutOn) == 0))));
		Set Damage Received(Event Player, Max(Count Of(Global Variable(RatHitters)) >= 3 ? 70 : 18, Global Variable(RatPop) >= 3 ? 0 : Divide(110, Max(1, Global Variable(RatPop)))));
		Wait(0.25, Ignore Condition);
		Loop If(And(Global Variable(RatOn) == 1, Is Alive(Event Player)));
	}
}


rule("[쥐 06] 쥐가 사람을 잡았다")
{
	event
	{
		Player Died;
		Team 1;
		All;
	}

	condition
	{
		Global Variable(RatOn) == 1;
		Event Player.Init == 1;
		Entity Exists(Attacker) == True;
		Attacker == Players In Slot(3, Team 2);
	}

	action
	{
		Set Global Variable(RatKill, 1);
	}
}

rule("[쥐 04] 쥐떼 퇴치")
{
	event
	{
		Player Died;
		Team 2;
		All;
	}

	condition
	{
		Slot Of(Victim) == 3;
		Global Variable(RatOn) == 1;
	}

	action
	{
		Set Global Variable(RatOn, 0);
		Set Global Variable(RatNext, Add(Total Time Elapsed(), Random Real(240, 600)));
		Destroy Icon(Global Variable(RatFx));
		For Global Variable(Idx, 0, Count Of(Global Variable(RatHitters)), 1);
			Modify Player Variable(Value In Array(Global Variable(RatHitters), Global Variable(Idx)), Money, Add, 200);
			Modify Player Variable(Value In Array(Global Variable(RatHitters), Global Variable(Idx)), Earned, Add, 200);
			Set Player Variable(Value In Array(Global Variable(RatHitters), Global Variable(Idx)), Fame, Min(100, Add(Player Variable(Value In Array(Global Variable(RatHitters), Global Variable(Idx)), Fame), 4)));
			Small Message(Value In Array(Global Variable(RatHitters), Global Variable(Idx)), Custom String("쥐떼를 몰아내는 데 힘을 보탰다 +$200 · 명성 +4"));
		End;
		If(And(Entity Exists(Attacker), Is Dummy Bot(Attacker) == False));
			Modify Player Variable(Attacker, Money, Add, 200);
			Modify Player Variable(Attacker, Earned, Add, 200);
			Set Player Variable(Attacker, Fame, Min(100, Add(Player Variable(Attacker, Fame), 4)));
			Big Message(All Players(All Teams), Custom String("{0} — 쥐떼의 우두머리를 잡았다!! (막타 +$200 · 몫은 {1}명이 나눈다)", Attacker, Count Of(Global Variable(RatHitters))));
		Else;
			Big Message(All Players(All Teams), Custom String("쥐떼가 물러갔다"));
		End;
		Play Effect(All Players(All Teams), Good Explosion, Color(Lime Green), Position Of(Victim), 3);
		Play Effect(All Players(All Teams), Buff Explosion Sound, Color(Lime Green), Position Of(Victim), 200);
		Destroy Dummy Bot(Team 2, 3);
	}
}


rule("[야수 06] 급소의 빛")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(Ready) == 1;
	}

	action
	{
		Wait(2.5, Ignore Condition);
		Set Damage Received(Filtered Array(All Players(Team 2), Slot Of(Current Array Element) <= 2), 250);
		Set Global Variable(WeakFx, Empty Array);
		Create Effect(Player Variable(Players In Slot(0, Team 2), RevealEnd) > Total Time Elapsed() ? All Players(All Teams) : Null, Sphere, Color(Red), Add(Position Of(Players In Slot(0, Team 2)), Vector(0, 1.6, 0)), 0.55, Visible To Position Radius and Color);
		Modify Global Variable(WeakFx, Append To Array, Last Created Entity());
		Create Effect(Player Variable(Players In Slot(1, Team 2), RevealEnd) > Total Time Elapsed() ? All Players(All Teams) : Null, Sphere, Color(Red), Add(Position Of(Players In Slot(1, Team 2)), Vector(0, 1.6, 0)), 0.55, Visible To Position Radius and Color);
		Modify Global Variable(WeakFx, Append To Array, Last Created Entity());
		Create Effect(Player Variable(Players In Slot(2, Team 2), RevealEnd) > Total Time Elapsed() ? All Players(All Teams) : Null, Sphere, Color(Red), Add(Position Of(Players In Slot(2, Team 2)), Vector(0, 1.6, 0)), 0.55, Visible To Position Radius and Color);
		Modify Global Variable(WeakFx, Append To Array, Last Created Entity());
		Wait(2.5, Ignore Condition);
		Set Damage Received(Filtered Array(All Players(Team 2), Slot Of(Current Array Element) <= 2), 60);
		Destroy Effect(Value In Array(Global Variable(WeakFx), 0));
		Destroy Effect(Value In Array(Global Variable(WeakFx), 1));
		Destroy Effect(Value In Array(Global Variable(WeakFx), 2));
		Loop();
	}
}

rule("[알림 01] 알림 줄 생성")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(Ready) == 1;
	}

	action
	{
		Create HUD Text(Local Player.Init == 1 ? Local Player : False, Total Time Elapsed() < Value In Array(Global Variable(NoticeEnd), Slot Of(Local Player)) ? Value In Array(Global Variable(NoticeMsg), Slot Of(Local Player)) : Custom String(""), Null, Null, Top, 2, Color(Orange), Color(흰색), Color(회색), Visible To Sort Order String and Color, Default Visibility);
		Create HUD Text(Local Player.Init == 1 ? Local Player : False, Total Time Elapsed() < Global Variable(TickerEnd) ? Global Variable(TickerMsg) : Custom String(""), Null, Null, Top, 3, Color(흰색), Color(흰색), Color(회색), Visible To Sort Order String and Color, Default Visibility);
	}
}

rule("[세금 01] 징수원 도착")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(Ready) == 1;
	}

	action
	{
		Wait Until(And(Modulo(Global Variable(Day), 2) == 0, Global Variable(Clock) >= 600), 99999);
		Modify Global Variable(TaxRound, Add, 1);
		Set Global Variable(TaxOn, 1);
		Big Message(All Players(All Teams), Custom String("징수원이 마을에 도착했다 — 2분 안에 보안관 초소에서 재산세를 내라"));
		Small Message(All Players(All Teams), Custom String("재산의 8% — 예금도 재산이다 (명성 70+는 절반). 떼먹으면 10%가 현상금으로 붙는다"));
		Wait(90, Ignore Condition);
		Small Message(All Players(All Teams), Custom String("징수원이 곧 떠난다 — 30초"));
		Wait(30, Ignore Condition);
		Set Global Variable(TaxOn, 0);
		Big Message(All Players(All Teams), Custom String("징수원이 떠났다 — 체납자에게 현상금이 붙는다"));
		Wait Until(Modulo(Global Variable(Day), 2) == 1, 99999);
		Loop();
	}
}

rule("[세금 02] 납세 의무 표시")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Event Player.TutOn == 0;
		Global Variable(TaxOn) == 1;
		Event Player.TaxSeenRound != Global Variable(TaxRound);
	}

	action
	{
		Set Player Variable(Event Player, TaxSeenRound, Global Variable(TaxRound));
		Small Message(Event Player, Custom String("징수원이 기다린다 — 보안관 초소에서 재산세를 내라 (재산의 8%)"));
		Play Effect(Event Player, Debuff Impact Sound, Color(Yellow), Position Of(Event Player), 60);
	}
}

rule("[세금 03] 체납 처벌")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Global Variable(TaxOn) == 0;
		Event Player.TaxSeenRound == Global Variable(TaxRound);
		Event Player.TaxPaidRound != Global Variable(TaxRound);
	}

	action
	{
		Set Player Variable(Event Player, TaxPaidRound, Global Variable(TaxRound));
		If(Add(Event Player.Money, Event Player.Deposit) < 100);
			Small Message(Event Player, Custom String("털어봤자 먼지뿐 — 징수원이 포기하고 지나갔다"));
		Else;
			Set Player Variable(Event Player, Fine, Max(50, Round To Integer(Multiply(Add(Event Player.Money, Event Player.Deposit), 0.1), Down)));
			Modify Player Variable(Event Player, Bounty, Add, Event Player.Fine);
			Set Player Variable(Event Player, Noto, Min(100, Add(Event Player.Noto, 10)));
			Big Message(Event Player, Custom String("세금을 떼먹었다 — 현상금 +$ {0} (악명 +10)", Event Player.Fine));
			Play Effect(Event Player, Explosion Sound, Color(Red), Position Of(Event Player), 150);
		End;
	}
}

rule("[생활 01] DoSleep")
{
	event
	{
		Subroutine;
		DoSleep;
	}

	action
	{
		Set Player Variable(Event Player, Amt, Round To Integer(Multiply(90, Subtract(1, Multiply(Subtract(Event Player.Fame, Event Player.Noto), 0.002))), To Nearest));
		If(Event Player.Money < Event Player.Amt);
			Small Message(Event Player, Custom String("숙박비가 모자란다 ($ {0} 필요)", Event Player.Amt));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			Abort;
		End;
		Modify Player Variable(Event Player, Money, Subtract, Event Player.Amt);
		Set Player Variable(Event Player, Busy, 1);
		Set Status(Event Player, Null, Asleep, 4.6);
		If(And(Entity Exists(Value In Array(Global Variable(BldOwner), 3)), Value In Array(Global Variable(BldOwner), 3) != Event Player));
			Set Player Variable(Value In Array(Global Variable(BldOwner), 3), Rent, Max(1, Round To Integer(Multiply(Event Player.Amt, 0.1), To Nearest)));
			Modify Player Variable(Value In Array(Global Variable(BldOwner), 3), Money, Add, Player Variable(Value In Array(Global Variable(BldOwner), 3), Rent));
			Small Message(Value In Array(Global Variable(BldOwner), 3), Custom String("임대 수입 +$ {0}", Player Variable(Value In Array(Global Variable(BldOwner), 3), Rent)));
		End;
		Set Status(Event Player, Null, Phased Out, 4.6);
		Set Player Variable(Event Player, WorkProg, 0);
		Destroy Progress Bar HUD Text(Event Player.WorkBar);
		Create Progress Bar HUD Text(Event Player, Event Player.WorkProg, Custom String("취침 중..."), Top, 0, Color(Sky Blue), Color(흰색), Visible To Values and Color, Default Visibility);
		Set Player Variable(Event Player, WorkBar, Last Text ID());
		Chase Player Variable Over Time(Event Player, WorkProg, 100, 4.5, Destination and Duration);
		Wait(4.5, Ignore Condition);
		Stop Chasing Player Variable(Event Player, WorkProg);
		Destroy Progress Bar HUD Text(Event Player.WorkBar);
		Set Player Variable(Event Player, Energy, Min(100, Add(Event Player.Energy, Multiply(Event Player.HasHome == 1 ? 80 : 40, Event Player.Rebuild >= 4 ? 1.25 : 1))));
		Set Player Variable(Event Player, Hunger, Max(0, Subtract(Event Player.Hunger, 12)));
		Set Player Variable(Event Player, Thirst, Max(0, Subtract(Event Player.Thirst, 12)));
		Heal(Event Player, Null, 500);
		Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("잘 잤다 — 피로 {0}", Round To Integer(Event Player.Energy, Down)));
		Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 2.5));
		Play Effect(Event Player, Good Explosion, Color(Sky Blue), Position Of(Event Player), 2);
		Play Effect(Event Player, Buff Explosion Sound, Color(Sky Blue), Position Of(Event Player), 130);
		Wait Until(Not(Is Button Held(Event Player, Button(Interact))), 3);
		Set Player Variable(Event Player, Busy, 0);
	}
}

rule("[부동산 02] 은행 회수 — 떠난 주인")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(Ready) == 1;
	}

	action
	{
		For Global Variable(Idx, 0, 11, 1);
			If(And(Value In Array(Global Variable(BldPrice), Global Variable(Idx)) > 0, And(Value In Array(Global Variable(BldOwner), Global Variable(Idx)) != 0, Not(Entity Exists(Value In Array(Global Variable(BldOwner), Global Variable(Idx)))))));
				Set Global Variable At Index(BldOwner, Global Variable(Idx), 0);
				Set Global Variable At Index(BldPrice, Global Variable(Idx), Value In Array(Global Variable(BldBase), Global Variable(Idx)));
				Big Message(All Players(All Teams), Custom String("{0}의 주인이 마을을 떠났다 — 은행이 회수해 매물로 내놨다", Value In Array(Array(Custom String("식당"), Custom String("협곡 광산"), Custom String("주유소 잡화점"), Custom String("모텔"), Custom String("정비소 고물상"), Custom String("술집"), Custom String("협곡 개활지"), Custom String("보안관 초소"), Custom String("무법자 은신처"), Custom String("안내소"), Custom String("대장간")), Global Variable(Idx))));
			End;
		End;
		Wait(10, Ignore Condition);
		Loop();
	}
}

rule("[부동산 01] 건물 매입/인수 (웅크리기+F)")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Busy == 0;
		Global Variable(ArchOn) == 0;
		Is Alive(Event Player) == True;
		Event Player.Zone != -1;
		Is Button Held(Event Player, Button(Crouch)) == True;
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	action
	{
		If(Value In Array(Global Variable(BldPrice), Event Player.Zone) <= 0);
			Small Message(Event Player, Custom String("여긴 살 수 있는 건물이 아니다"));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
		Else If(Value In Array(Global Variable(BldOwner), Event Player.Zone) == Event Player);
			Small Message(Event Player, Custom String("내 건물이다 — 남이 노리는 값은 $ {0}", Value In Array(Global Variable(BldPrice), Event Player.Zone)));
		Else If(Event Player.Money < Value In Array(Global Variable(BldPrice), Event Player.Zone));
			Small Message(Event Player, Custom String("돈이 모자란다 ($ {0} 필요)", Value In Array(Global Variable(BldPrice), Event Player.Zone)));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
		Else;
			Modify Player Variable(Event Player, Money, Subtract, Value In Array(Global Variable(BldPrice), Event Player.Zone));
			If(Entity Exists(Value In Array(Global Variable(BldOwner), Event Player.Zone)));
				Modify Player Variable(Value In Array(Global Variable(BldOwner), Event Player.Zone), Money, Add, Value In Array(Global Variable(BldPrice), Event Player.Zone));
				Big Message(All Players(All Teams), Custom String("{0}이(가) {1}에게서 {2}을(를) 인수했다!", Event Player, Value In Array(Global Variable(BldOwner), Event Player.Zone), Value In Array(Array(Custom String("식당"), Custom String("협곡 광산"), Custom String("주유소 잡화점"), Custom String("모텔"), Custom String("정비소 고물상"), Custom String("술집"), Custom String("협곡 개활지"), Custom String("보안관 초소"), Custom String("무법자 은신처"), Custom String("안내소"), Custom String("대장간")), Event Player.Zone)));
			Else;
				Big Message(All Players(All Teams), Custom String("{0} — {1}의 주인이 되었다!", Event Player, Value In Array(Array(Custom String("식당"), Custom String("협곡 광산"), Custom String("주유소 잡화점"), Custom String("모텔"), Custom String("정비소 고물상"), Custom String("술집"), Custom String("협곡 개활지"), Custom String("보안관 초소"), Custom String("무법자 은신처"), Custom String("안내소"), Custom String("대장간")), Event Player.Zone)));
			End;
			Set Global Variable At Index(BldOwner, Event Player.Zone, Event Player);
			Set Global Variable At Index(BldPrice, Event Player.Zone, Round To Integer(Multiply(Value In Array(Global Variable(BldPrice), Event Player.Zone), 1.5), To Nearest));
			Play Effect(All Players(All Teams), Ring Explosion, Color(Yellow), Position Of(Event Player), 4);
			Play Effect(Event Player, Buff Explosion Sound, Color(Yellow), Position Of(Event Player), 200);
		End;
		Wait Until(Not(Is Button Held(Event Player, Button(Interact))), 10);
	}
}

rule("[파발 01] 배달 도착 — 자동 정산")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Event Player.HasParcel >= 1;
		Is Alive(Event Player) == True;
		Event Player.Zone == Event Player.DelDest;
	}

	action
	{
		Set Player Variable(Event Player, RunPay, Round To Integer(Add(12, Multiply(Distance Between(Value In Array(Global Variable(LocPos), 11), Value In Array(Global Variable(LocPos), Event Player.DelDest)), 1.05)), To Nearest));
		Set Player Variable(Event Player, RunPay, Round To Integer(Multiply(Event Player.RunPay, Add(1, Multiply(0.05, Min(10, Round To Integer(Divide(Value In Array(Event Player.JobXP, 5), 250), Down))))), To Nearest));
		If(And(Event Player.Job == 5, Value In Array(Event Player.Adv, Event Player.Job) == 1));
			Set Player Variable(Event Player, RunPay, Round To Integer(Multiply(Event Player.RunPay, 1.3), To Nearest));
			Set Player Variable(Event Player, Energy, Min(100, Add(Event Player.Energy, 5)));
		End;
		Set Player Variable(Event Player, Energy, Max(0, Subtract(Event Player.Energy, 4)));
		Set Player Variable(Event Player, Hunger, Max(0, Subtract(Event Player.Hunger, 2)));
		Set Player Variable(Event Player, Thirst, Max(0, Subtract(Event Player.Thirst, 3)));
		If(Global Variable(TodayJob) == 5);
			Set Player Variable(Event Player, RunPay, Round To Integer(Multiply(Player Variable(Event Player, RunPay), Global Variable(FundTier) >= 3 ? 1.75 : 1.5), To Nearest));
		End;
		If(Global Variable(FundTier) >= 2);
			Set Player Variable(Event Player, RunPay, Round To Integer(Multiply(Event Player.RunPay, 1.15), To Nearest));
		End;
		If(Event Player.HasParcel == 2);
			Set Player Variable(Event Player, RunPay, Round To Integer(Multiply(Event Player.RunPay, 2.5), To Nearest));
			Big Message(Event Player, Custom String("값진 화물을 지켜냈다! +$ {0}", Event Player.RunPay));
		End;
		Modify Player Variable(Event Player, Money, Add, Event Player.RunPay);
		Modify Player Variable(Event Player, Earned, Add, Event Player.RunPay);
		If(And(Global Variable(ContractKind) == 3, Modulo(Player Variable(Event Player, Giant), 10) < 3));
			Modify Player Variable(Event Player, Giant, Add, 1);
			If(Modulo(Player Variable(Event Player, Giant), 10) == 3);
				Modify Player Variable(Event Player, Giant, Add, Subtract(9, 3));
				Modify Player Variable(Event Player, Money, Add, 150);
				Modify Player Variable(Event Player, Earned, Add, 150);
				Set Player Variable(Event Player, Fame, Min(100, Add(Player Variable(Event Player, Fame), 3)));
				Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("오늘의 계약 달성! +$150 · 명성 +3"));
				Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 2.5));
				Play Effect(Event Player, Buff Explosion Sound, Color(Yellow), Position Of(Event Player), 120);
			Else;
				Small Message(Event Player, Custom String("오늘의 계약 — 진행 {0} / {1}", Modulo(Player Variable(Event Player, Giant), 10), 3));
			End;
		End;
		Set Player Variable At Index(Event Player, JobXP, 5, Add(Value In Array(Event Player.JobXP, 5), 25));
		Set Player Variable(Event Player, HasParcel, 0);
		Destroy Icon(Event Player.DelIcon);
		Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("배달 완료!   +$ {0}", Event Player.RunPay));
		Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 2.5));
		Play Effect(Event Player, Good Explosion, Color(Yellow), Position Of(Event Player), 2);
		Play Effect(Event Player, Buff Explosion Sound, Color(Yellow), Position Of(Event Player), 130);
	}
}

rule("[목동 01] 소몰이")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Event Player.CowOn >= 1;
	}

	action
	{
		If(Or(Not(Is Alive(Event Player)), Total Time Elapsed() > Event Player.CowEnd));
			Set Player Variable(Event Player, CowOn, 0);
			Destroy Effect(Event Player.CowFx);
			Destroy Icon(Event Player.CowIco);
			Small Message(Event Player, Custom String("소를 잃어버렸다..."));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 60);
			Abort;
		End;
		If(Distance Between(Event Player.CowPos, Value In Array(Global Variable(LocPos), 12)) < 6);
			If(And(Event Player.DialCur < 12, Event Player.DialPin < 3));
				Small Message(Event Player, Custom String("늑대가 소에 붙어 있다 — 쫓아내야 우리에 넣는다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 50);
				Wait(2, Ignore Condition);
				Abort;
			End;
			Destroy Effect(Event Player.CowFx);
			Destroy Icon(Event Player.CowIco);
			Set Player Variable(Event Player, RunPay, Add(220, Multiply(4, Min(10, Round To Integer(Divide(Value In Array(Event Player.JobXP, 6), 250), Down)))));
			If(And(Event Player.Job == 6, Value In Array(Event Player.Adv, Event Player.Job) == 1));
				Set Player Variable(Event Player, RunPay, Round To Integer(Multiply(Event Player.RunPay, 1.15), To Nearest));
			End;
			If(Global Variable(TodayJob) == 6);
				Set Player Variable(Event Player, RunPay, Round To Integer(Multiply(Player Variable(Event Player, RunPay), Global Variable(FundTier) >= 3 ? 1.75 : 1.5), To Nearest));
			End;
			If(Event Player.CowOn == 2);
				Set Player Variable(Event Player, RunPay, Round To Integer(Multiply(Event Player.RunPay, 0.5), To Nearest));
				Small Message(Event Player, Custom String("고삐를 놓친 몰이 — 삯이 절반이다"));
			End;
			Set Player Variable(Event Player, CowOn, 0);
			Modify Player Variable(Event Player, Money, Add, Event Player.RunPay);
			Modify Player Variable(Event Player, Earned, Add, Event Player.RunPay);
			Set Player Variable At Index(Event Player, JobXP, 6, Add(Value In Array(Event Player.JobXP, 6), 25));
			Set Global Variable(JerkyStock, Min(60, Add(Global Variable(JerkyStock), 6)));
			Set Player Variable(Event Player, Energy, Max(0, Subtract(Event Player.Energy, 5)));
			Set Player Variable(Event Player, Hunger, Max(0, Subtract(Event Player.Hunger, 3)));
			Set Player Variable(Event Player, Thirst, Max(0, Subtract(Event Player.Thirst, 2.5)));
			Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("우리에 몰아넣었다!   +$ {0}   (잡화점 육포 재고 +6)", Event Player.RunPay));
			Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 2.5));
			If(And(Global Variable(ContractKind) == 4, Modulo(Player Variable(Event Player, Giant), 10) < 2));
				Modify Player Variable(Event Player, Giant, Add, 1);
				If(Modulo(Player Variable(Event Player, Giant), 10) == 2);
					Modify Player Variable(Event Player, Giant, Add, Subtract(9, 2));
					Modify Player Variable(Event Player, Money, Add, 150);
					Modify Player Variable(Event Player, Earned, Add, 150);
					Set Player Variable(Event Player, Fame, Min(100, Add(Player Variable(Event Player, Fame), 3)));
					Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("오늘의 계약 달성! +$150 · 명성 +3"));
					Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 2.5));
					Play Effect(Event Player, Buff Explosion Sound, Color(Yellow), Position Of(Event Player), 120);
				Else;
					Small Message(Event Player, Custom String("오늘의 계약 — 진행 {0} / {1}", Modulo(Player Variable(Event Player, Giant), 10), 2));
				End;
			End;
			Play Effect(All Players(All Teams), Good Explosion, Color(Lime Green), Value In Array(Global Variable(LocPos), 12), 2.5);
			Play Effect(Event Player, Buff Explosion Sound, Color(Lime Green), Position Of(Event Player), 130);
			Abort;
		End;
		If(Distance Between(Position Of(Event Player), Event Player.CowPos) < 4.5);
			Set Player Variable(Event Player, CowPos, Nearest Walkable Position(Add(Event Player.CowPos, Multiply(Normalize(Vector(X Component Of(Add(Multiply(Direction Towards(Position Of(Event Player), Event Player.CowPos), 0.6), Multiply(Direction Towards(Event Player.CowPos, Value In Array(Global Variable(LocPos), 12)), 0.4))), 0, Z Component Of(Add(Multiply(Direction Towards(Position Of(Event Player), Event Player.CowPos), 0.6), Multiply(Direction Towards(Event Player.CowPos, Value In Array(Global Variable(LocPos), 12)), 0.4))))), Add(4.4, Multiply(1.8, Value In Array(Event Player.Adv, 6)))))));
			Destroy Effect(Event Player.CowFx);
			Create Effect(All Players(All Teams), Sphere, Color(흰색), Event Player.CowPos, 0.7, None);
			Set Player Variable(Event Player, CowFx, Last Created Entity());
			Destroy Icon(Event Player.CowIco);
			Create Icon(All Players(All Teams), Add(Event Player.CowPos, Vector(0, 1.6, 0)), Circle, Visible To and Position, Color(흰색), True);
			Set Player Variable(Event Player, CowIco, Last Created Entity());
		End;
		Wait(0.25, Ignore Condition);
		Loop If(Event Player.CowOn >= 1);
	}
}

rule("[범죄 01] 황야에서 강도 / 체포 (F)")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Busy == 0;
		Global Variable(ArchOn) == 0;
		Is Alive(Event Player) == True;
		Event Player.CowOn == 0;
		Is Button Held(Event Player, Button(Crouch)) == False;
		Is Button Held(Event Player, Button(Melee)) == True;
	}

	action
	{
		If(Total Time Elapsed() < Event Player.RobCd);
			Small Message(Event Player, Custom String("아직 몸을 사려야 한다 — {0}초 뒤에 다시", Round To Integer(Subtract(Event Player.RobCd, Total Time Elapsed()), Up)));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			Abort;
		End;
		If(Event Player.Energy < 3);
			Small Message(Event Player, Custom String("너무 지쳤다 — 자거나 한잔 걸쳐야 한다"));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			Abort;
		End;
		Set Player Variable(Event Player, Target, First Of(Sorted Array(Filtered Array(Players Within Radius(Eye Position(Event Player), 9, All Teams, Surfaces), And(Current Array Element != Event Player, And(Is Dummy Bot(Current Array Element) == False, And(Player Variable(Current Array Element, TutOn) == 0, And(Has Status(Current Array Element, Asleep) == False, And(Is Alive(Current Array Element), Dot Product(Facing Direction Of(Event Player), Direction Towards(Eye Position(Event Player), Eye Position(Current Array Element))) >= 0.93)))))), Distance Between(Eye Position(Event Player), Eye Position(Current Array Element)))));
		If(Not(Entity Exists(Event Player.Target)));
			If(And(And(Event Player.Zone == 9, Global Variable(IsNight) == 1), And(And(Global Variable(RebuildMax) >= 3, Global Variable(Day) >= Global Variable(BankLockDay)), Event Player.JailOn == 0)));
				If(Or(Event Player.HasParcel >= 1, Event Player.CowOn >= 1));
					Small Message(Event Player, Custom String("짐을 진 채로는 금고를 못 딴다 — 먼저 일을 끝내라"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Else;
					Set Player Variable(Event Player, Busy, 1);
					Set Player Variable(Event Player, DialOn, 1);
					Set Player Variable(Event Player, DialTgt, Random Integer(0, 9));
					Set Player Variable(Event Player, DialPin, 1);
					Set Player Variable(Event Player, DialCur, 0);
					Destroy HUD Text(Event Player.KeyHud);
					Create HUD Text(Event Player, Custom String("은행 다이얼   [ {0} ]", Event Player.DialCur), Custom String("핀 {0} / 3", Subtract(Event Player.DialPin, 1)), Custom String("[R] 돌리기      [F] 시도      [웅크리기] 포기"), Left, 5, Color(Orange), Color(흰색), Color(회색), Visible To Sort Order String and Color, Default Visibility);
					Set Player Variable(Event Player, KeyHud, Last Text ID());
					Big Message(Event Player, Custom String("은행 뒷문에 붙었다 — 다이얼을 맞혀라"));
					Small Message(Event Player, Custom String("아직은 조용하다 — 해정하는 순간 마을이 깬다"));
				End;
			Else If(And(And(Event Player.Zone == 9, Global Variable(IsNight) == 1), And(Global Variable(RebuildMax) >= 3, Global Variable(Day) < Global Variable(BankLockDay))));
				Small Message(Event Player, Custom String("은행 금고는 굳게 잠겼다 — {0}일차부터 다시 노릴 수 있다", Global Variable(BankLockDay)));
				Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			Else If(And(And(Event Player.Zone == 9, Global Variable(IsNight) == 0), Global Variable(RebuildMax) >= 3));
				Small Message(Event Player, Custom String("은행 뒷문은 밤에만 열 수 있다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			Else If(And(And(Event Player.Zone == 8, Event Player.Contraband == 0), Total Time Elapsed() >= Event Player.SmuggleCd));
				Set Global Variable(PickRef, Value In Array(Global Variable(LocPos), 8));
				Set Global Variable(PickMin, 40);
				Set Global Variable(PickMax, 999);
				Call Subroutine(PickSpot);
				Set Player Variable(Event Player, SmugglePos, Global Variable(PickPos));
				Set Player Variable(Event Player, SmugglePay, Round To Integer(Add(24, Multiply(Distance Between(Value In Array(Global Variable(LocPos), 8), Event Player.SmugglePos), 2)), To Nearest));
				Set Player Variable(Event Player, Contraband, 1);
				Destroy Icon(Event Player.SmuggleIco);
				Create Icon(Event Player, Add(Event Player.SmugglePos, Vector(0, 3, 0)), Diamond, Visible To and Position, Color(Purple), True);
				Set Player Variable(Event Player, SmuggleIco, Last Created Entity());
				Big Message(Event Player, Custom String("밀수 화물을 받았다 — 접선지로 (보수 $ {0})", Event Player.SmugglePay));
				Small Message(All Players(All Teams), Custom String("누군가 밀수 화물을 실었다 — 자주색 표식을 노려라"));
				Small Message(Event Player, Custom String("화물을 진 동안 질주할 수 없고, 죽으면 끝이다 — 자주색 표식을 따라가라"));
				Play Effect(Event Player, Buff Impact Sound, Color(Purple), Position Of(Event Player), 60);
			Else If(And(Event Player.Zone == 8, Event Player.Contraband == 1));
				Small Message(Event Player, Custom String("이미 밀수 화물을 지고 있다 — 자주색 표식의 접선지로 가라"));
				Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			Else If(And(And(Event Player.Zone == 8, Event Player.Contraband == 0), Total Time Elapsed() < Event Player.SmuggleCd));
				Small Message(Event Player, Custom String("다음 밀수 화물이 아직이다 — {0}초 뒤에 다시", Round To Integer(Subtract(Event Player.SmuggleCd, Total Time Elapsed()), Up)));
				Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			Else;
				Small Message(Event Player, Custom String("대상 없음 — 9m 안의 상대를 조준하고 [{0}]", Input Binding String(Button(Melee))));
				Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			End;
			Abort;
		End;
		Set Player Variable(Event Player, Busy, 1);
		Set Player Variable(Event Player, WorkProg, 0);
		Set Player Variable(Event Player, Take, Health(Event Player));
		If(Player Variable(Event Player.Target, Bounty) >= 300);
			If(Event Player.Job != 3);
				Set Player Variable(Event Player, Busy, 0);
				Small Message(Event Player, Custom String("체포는 현상금 사냥꾼의 일이다 — 보안관 초소에서 전직할 수 있다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Abort;
			End;
			If(Health(Event Player.Target) >= Multiply(Max Health(Event Player.Target), 0.5));
				Set Player Variable(Event Player, Busy, 0);
				Small Message(Event Player, Custom String("아직 팔팔하다 — 쏴서 제압해라 (체력 절반 미만이어야 수갑을 채운다)"));
				Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
				Abort;
			End;
			Big Message(Event Player.Target, Custom String("{0}이(가) 당신을 체포하려 한다 — 도망치거나 쏴서 뿌리쳐라", Event Player));
			Play Effect(Event Player.Target, Explosion Sound, Color(Sky Blue), Position Of(Event Player.Target), 160);
			Destroy Progress Bar HUD Text(Event Player.WorkBar);
			Create Progress Bar HUD Text(Event Player, Event Player.WorkProg, Custom String("체포 중..."), Top, 0, Color(Sky Blue), Color(흰색), Visible To Values and Color, Default Visibility);
		Else;
			Set Player Variable(Event Player, JobArg, 4);
			Call Subroutine(BecomeJob);
			Big Message(Event Player.Target, Custom String("{0}이(가) 총을 겨눴다 — 도망치거나 쏴서 뿌리쳐라", Event Player));
			Play Effect(Event Player.Target, Explosion Sound, Color(Red), Position Of(Event Player.Target), 160);
			Destroy Progress Bar HUD Text(Event Player.WorkBar);
			Create Progress Bar HUD Text(Event Player, Event Player.WorkProg, Custom String("강탈 중..."), Top, 0, Color(Red), Color(흰색), Visible To Values and Color, Default Visibility);
		End;
		Set Player Variable(Event Player, WorkBar, Last Text ID());
		Set Player Variable(Event Player, Amt, 3);
		If(Player Variable(Event Player.Target, Bounty) >= 300);
			Set Player Variable(Event Player, Amt, Value In Array(Event Player.Adv, 3) == 1 ? 3 : 5);
		End;
		Chase Player Variable Over Time(Event Player, WorkProg, 100, Event Player.Amt, Destination and Duration);
		Wait Until(Or(Or(Or(Distance Between(Position Of(Event Player), Position Of(Event Player.Target)) > 10, Health(Event Player) < Event Player.Take), Not(Is Alive(Event Player))), Event Player.WorkProg >= 99), 5.5);
		Stop Chasing Player Variable(Event Player, WorkProg);
		Destroy Progress Bar HUD Text(Event Player.WorkBar);
		Set Player Variable(Event Player, Energy, Max(0, Subtract(Event Player.Energy, 3)));
		Set Player Variable(Event Player, Hunger, Max(0, Subtract(Event Player.Hunger, 1)));
		Set Player Variable(Event Player, Thirst, Max(0, Subtract(Event Player.Thirst, 1)));
		If(Or(Or(Not(Entity Exists(Event Player.Target)), Distance Between(Position Of(Event Player), Position Of(Event Player.Target)) > 10), Or(Health(Event Player) < Event Player.Take, Not(Is Alive(Event Player)))));
			Set Player Variable(Event Player, RobCd, Add(Total Time Elapsed(), 15));
			Small Message(Event Player, Custom String("놓쳤다"));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			Small Message(Event Player.Target, Custom String("도망쳤다!"));
			Play Effect(Event Player.Target, Buff Impact Sound, Color(Lime Green), Position Of(Event Player.Target), 90);
		Else If(Player Variable(Event Player.Target, Bounty) >= 300);
			Set Player Variable(Event Player, Take, Min(Player Variable(Event Player.Target, Bounty), Player Variable(Event Player.Target, Money)));
			Set Player Variable(Event Player.Target, Money, Subtract(Player Variable(Event Player.Target, Money), Event Player.Take));
			If(Event Player.Job == 3);
				Set Player Variable At Index(Event Player, JobXP, 3, Add(Value In Array(Event Player.JobXP, 3), 25));
			End;
			Modify Player Variable(Event Player, Money, Add, Event Player.Take);
			Modify Player Variable(Event Player, Earned, Add, Event Player.Take);
			Set Player Variable(Event Player, Fame, Min(100, Add(Event Player.Fame, 12)));
			If(Global Variable(TodayJob) == 3);
				Set Player Variable(Event Player, Prize, Round To Integer(Multiply(Event Player.Take, 0.5), To Nearest));
				Modify Player Variable(Event Player, Money, Add, Event Player.Prize);
				Modify Player Variable(Event Player, Earned, Add, Event Player.Prize);
				Small Message(Event Player, Custom String("오늘의 직업 포상 +$ {0}", Event Player.Prize));
			End;
			Set Player Variable(Event Player.Target, Bounty, 0);
			Set Player Variable(Event Player, Fine, Round To Integer(Multiply(Player Variable(Event Player.Target, Money), 0.2), Down));
			Set Player Variable(Event Player.Target, Money, Subtract(Player Variable(Event Player.Target, Money), Event Player.Fine));
			If(And(Event Player.Job == 3, Value In Array(Event Player.Adv, Event Player.Job) == 1));
				Modify Player Variable(Event Player, Money, Add, Round To Integer(Multiply(Event Player.Fine, 0.5), Down));
				Modify Player Variable(Event Player, Earned, Add, Round To Integer(Multiply(Event Player.Fine, 0.5), Down));
				Small Message(Event Player, Custom String("보안관 수수료 +$ {0}", Round To Integer(Multiply(Event Player.Fine, 0.5), Down)));
			End;
			Teleport(Event Player.Target, Value In Array(Global Variable(LocPos), 7));
			Set Player Variable(Event Player.Target, JailOn, 1);
			Set Player Variable(Event Player.Target, WallHP, 15);
			Set Player Variable(Event Player.Target, JailEnd, Add(Total Time Elapsed(), Min(50, Add(30, Round To Integer(Divide(Player Variable(Event Player.Target, Noto), 5), Down)))));
			Set Player Variable(Event Player.Target, Busy, 1);
			Set Status(Event Player.Target, Null, Rooted, 9999);
			Set Status(Event Player.Target, Null, Phased Out, 9999);
			Set Primary Fire Enabled(Event Player.Target, False);
			Big Message(Event Player.Target, Custom String("유치장에 갇혔다 — 벌금 $ {0}", Event Player.Fine));
			Small Message(Event Player.Target, Custom String("[{0}] 연타로 벽을 부수면 탈옥 (악명 +15, 현상금 +$100) · 버티면 만기 출소 (악명 -20)", Input Binding String(Button(Melee))));
			Set Global Variable(TickerMsg, Custom String("{0}이(가) {1}을(를) 체포했다 — 현상금 $ {2}", Event Player, Event Player.Target, Event Player.Take));
			Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
			Play Effect(All Players(All Teams), Ring Explosion, Color(Sky Blue), Position Of(Event Player), 3);
			Play Effect(All Players(All Teams), Buff Explosion Sound, Color(Sky Blue), Position Of(Event Player), 180);
		Else;
			Set Player Variable(Event Player, Take, Round To Integer(Multiply(Player Variable(Event Player.Target, Money), 0.25), Down));
			If(Event Player.Job == 4);
				Set Player Variable(Event Player, Take, Round To Integer(Multiply(Player Variable(Event Player.Target, Money), Add(0.4, Min(0.2, Multiply(0.02, Round To Integer(Divide(Value In Array(Event Player.JobXP, 4), 250), Down))))), Down));
				Set Player Variable At Index(Event Player, JobXP, 4, Add(Value In Array(Event Player.JobXP, 4), 20));
			End;
			If(Event Player.Take < 1);
				Set Player Variable(Event Player, RobCd, Add(Total Time Elapsed(), 15));
				Small Message(Event Player, Custom String("빈털터리다"));
				Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
			Else;
				Set Player Variable(Event Player.Target, Money, Subtract(Player Variable(Event Player.Target, Money), Event Player.Take));
				Modify Player Variable(Event Player, Money, Add, Event Player.Take);
				Modify Player Variable(Event Player, Earned, Add, Event Player.Take);
				Modify Player Variable(Event Player, Bounty, Add, Event Player.Take);
				Set Player Variable(Event Player, Noto, Min(100, Add(Event Player.Noto, 15)));
				Set Player Variable(Event Player, RobCd, Add(Total Time Elapsed(), Subtract(45, Multiply(15, And(Event Player.Job == 4, Value In Array(Event Player.Adv, Event Player.Job) == 1)))));
				Set Global Variable(TickerMsg, Custom String("{0}이(가) {1}에게서 $ {2}를 강탈했다", Event Player, Event Player.Target, Event Player.Take));
				Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
				Small Message(Event Player, Custom String("현상금이 $ {0}로 올랐다", Event Player.Bounty));
				Play Effect(All Players(All Teams), Ring Explosion, Color(Red), Position Of(Event Player), 2.5);
			End;
			If(Player Variable(Event Player.Target, HasParcel) >= 1);
				Set Player Variable(Event Player, Prize, Player Variable(Event Player.Target, HasParcel) == 2 ? Round To Integer(Multiply(Add(12, Multiply(Distance Between(Value In Array(Global Variable(LocPos), 11), Value In Array(Global Variable(LocPos), Player Variable(Event Player.Target, DelDest))), 1.05)), 2.5), To Nearest) : 60);
				Set Player Variable(Event Player.Target, HasParcel, 0);
				Destroy Icon(Player Variable(Event Player.Target, DelIcon));
				Modify Player Variable(Event Player, Money, Add, Event Player.Prize);
				Modify Player Variable(Event Player, Earned, Add, Event Player.Prize);
				Set Player Variable(Event Player, Noto, Min(100, Add(Event Player.Noto, 5)));
				Set Global Variable(TickerMsg, Custom String("{0}이(가) {1}의 화물을 가로챘다! (+$ {2})", Event Player, Event Player.Target, Event Player.Prize));
				Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
			End;
			If(Player Variable(Event Player.Target, Contraband) == 1);
				Set Player Variable(Event Player.Target, Contraband, 0);
				Destroy Icon(Player Variable(Event Player.Target, SmuggleIco));
				Modify Player Variable(Event Player, Money, Add, 80);
				Modify Player Variable(Event Player, Earned, Add, 80);
				Set Player Variable(Event Player, Noto, Min(100, Add(Event Player.Noto, 5)));
				Set Global Variable(TickerMsg, Custom String("{0}이(가) {1}의 밀수 화물을 가로챘다! (+$80)", Event Player, Event Player.Target));
				Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
			End;
			If(Player Variable(Event Player.Target, Escort) == 1);
				Set Player Variable(Event Player.Target, Escort, 0);
				Destroy Icon(Player Variable(Event Player.Target, EscortIco));
				Destroy Effect(Player Variable(Event Player.Target, EscortFx));
				Modify Player Variable(Event Player, Money, Add, 120);
				Modify Player Variable(Event Player, Earned, Add, 120);
				Set Player Variable(Event Player, Noto, Min(100, Add(Event Player.Noto, 5)));
				Set Global Variable(TickerMsg, Custom String("{0}이(가) {1}의 금괴 호송을 털었다! (+$120)", Event Player, Event Player.Target));
				Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
				Small Message(Event Player.Target, Custom String("금괴를 빼앗겼다 — 호송 실패"));
			End;
		End;
		Set Player Variable(Event Player, Busy, 0);
	}
}

rule("[수배 02] 전단 경고")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Event Player.Bounty >= 300;
		Event Player.WantedTier == 0;
	}

	action
	{
		Set Player Variable(Event Player, WantedTier, 1);
		Big Message(Event Player, Custom String("수배 전단이 나돌기 시작했다 — 위치가 주기적으로 드러난다"));
		Small Message(All Players(All Teams), Custom String("{0}의 수배 전단이 마을에 붙었다 — 현상금 $ {1}", Event Player, Event Player.Bounty));
		Play Effect(Event Player, Explosion Sound, Color(Red), Position Of(Event Player), 140);
	}
}

rule("[수배 03] 추방 경고")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Event Player.Bounty >= 800;
		Event Player.WantedTier == 1;
	}

	action
	{
		Set Player Variable(Event Player, WantedTier, 2);
		Big Message(Event Player, Custom String("마을이 너를 추방했다 — 은신처만이 너를 받아준다"));
		Small Message(All Players(All Teams), Custom String("{0}이(가) 마을에서 추방됐다 — 상점 거래 불가", Event Player));
		Play Effect(All Players(All Teams), Ring Explosion, Color(Red), Position Of(Event Player), 4);
	}
}

rule("[수배 04] 전단 철회")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Event Player.Bounty < 300;
		Event Player.WantedTier >= 1;
	}

	action
	{
		Set Player Variable(Event Player, WantedTier, 0);
		Small Message(Event Player, Custom String("전단이 거둬졌다 — 다시 마을을 걸을 수 있다"));
	}
}

rule("[장물 01] 자루 정산 — 은신처")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Event Player.Sack > 0;
		Event Player.Zone == 8;
		Is Alive(Event Player) == True;
	}

	action
	{
		Set Player Variable(Event Player, Loot, Event Player.Sack);
		Set Player Variable(Event Player, Sack, 0);
		Modify Player Variable(Event Player, Money, Add, Event Player.Loot);
		Modify Player Variable(Event Player, Earned, Add, Event Player.Loot);
		Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("장물을 부렸다 — +$ {0}", Event Player.Loot));
		Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 2.5));
		Play Effect(Event Player, Buff Explosion Sound, Color(Purple), Position Of(Event Player), 140);
	}
}

rule("[은행 01] 다이얼 돌리기 (R)")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.DialOn == 1;
		Is Button Held(Event Player, Button(Reload)) == True;
	}

	action
	{
		Set Player Variable(Event Player, DialCur, Modulo(Add(Event Player.DialCur, 1), 10));
		Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Position Of(Event Player), 35);
	}
}

rule("[은행 02] 다이얼 시도 (F)")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.DialOn == 1;
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	action
	{
		If(Event Player.DialCur == Event Player.DialTgt);
			Modify Player Variable(Event Player, DialPin, Add, 1);
			Play Effect(Event Player, Buff Impact Sound, Color(Orange), Position Of(Event Player), 70);
			If(Event Player.DialPin > 3);
				Set Player Variable(Event Player, DialOn, 0);
				Set Player Variable(Event Player, DrillOn, 1);
				Set Player Variable(Event Player, WallHP, 30);
				Set Player Variable(Event Player, HeistEnd, Add(Total Time Elapsed(), 120));
				Destroy HUD Text(Event Player.KeyHud);
				Create HUD Text(Event Player, Custom String("금고 굴착   내구 {0}", Event Player.WallHP), Custom String("남은 시간 {0}초", Max(0, Round To Integer(Subtract(Event Player.HeistEnd, Total Time Elapsed()), Down))), Custom String("[{0}] 연타 — 곡괭이가 좋을수록 빠르다", Input Binding String(Button(Melee))), Left, 5, Color(Red), Color(흰색), Color(회색), Visible To Sort Order String and Color, Default Visibility);
				Set Player Variable(Event Player, KeyHud, Last Text ID());
				Destroy Icon(Global Variable(AlarmIco));
				Create Icon(All Players(All Teams), Add(Value In Array(Global Variable(LocPos), 9), Vector(0, 4, 0)), Warning, Visible To and Position, Color(Red), True);
				Set Global Variable(AlarmIco, Last Created Entity());
				Big Message(All Players(All Teams), Custom String("은행 경보가 울린다!! — 안내소로!"));
				Play Effect(All Players(All Teams), Explosion Sound, Color(Red), Value In Array(Global Variable(LocPos), 9), 250);
			Else;
				Set Player Variable(Event Player, DialTgt, Random Integer(0, 9));
				Small Message(Event Player, Custom String("철컥 — 핀이 물렸다 ({0} / 3)", Subtract(Event Player.DialPin, 1)));
			End;
		Else;
			Small Message(Event Player, Event Player.DialTgt > Event Player.DialCur ? Custom String("헛돎 — 더 크다") : Custom String("헛돎 — 더 작다"));
			Play Effect(Event Player, Debuff Impact Sound, Color(회색), Position Of(Event Player), 45);
		End;
		Wait Until(Not(Is Button Held(Event Player, Button(Interact))), 3);
	}
}

rule("[은행 03] 금고 굴착 (V 연타)")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.DrillOn == 1;
		Is Alive(Event Player) == True;
		Is Button Held(Event Player, Button(Melee)) == True;
	}

	action
	{
		Modify Player Variable(Event Player, WallHP, Subtract, Add(1, Event Player.Pick));
		Play Effect(All Players(All Teams), Ring Explosion, Color(Orange), Position Of(Event Player), 1);
		Play Effect(Event Player, Debuff Impact Sound, Color(회색), Position Of(Event Player), 70);
		If(Event Player.WallHP <= 0);
			Set Player Variable(Event Player, DrillOn, 0);
			Set Player Variable(Event Player, Busy, 0);
			Destroy HUD Text(Event Player.KeyHud);
			Destroy Icon(Global Variable(AlarmIco));
			Set Global Variable(BankLockDay, Add(Global Variable(Day), 2));
			Set Player Variable(Event Player, Loot, Random Integer(600, 1000));
			Modify Player Variable(Event Player, Sack, Add, Event Player.Loot);
			Set Player Variable(Event Player, Noto, Min(100, Add(Event Player.Noto, 25)));
			Modify Player Variable(Event Player, Bounty, Add, 400);
			Big Message(All Players(All Teams), Custom String("{0}이(가) 은행 금고를 뚫었다!! (+$ {1})", Event Player, Event Player.Loot));
			Small Message(Event Player, Custom String("장물 자루를 졌다 — 은신처에 가야 현금이 된다. 죽으면 잃고, 질주도 못 한다"));
			Play Effect(All Players(All Teams), Ring Explosion, Color(Orange), Position Of(Event Player), 5);
			Play Effect(All Players(All Teams), Buff Explosion Sound, Color(Orange), Position Of(Event Player), 200);
		End;
		Wait(0.25, Ignore Condition);
		Loop If(And(Event Player.DrillOn == 1, Is Button Held(Event Player, Button(Melee))));
	}
}

rule("[은행 04] 작업 중단")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Add(Event Player.DialOn, Event Player.DrillOn) > 0;
		Or(Or(Event Player.Zone != 9, Is Alive(Event Player) == False), Or(And(Event Player.DrillOn == 1, Total Time Elapsed() > Event Player.HeistEnd), Or(Global Variable(IsNight) == 0, Is Button Held(Event Player, Button(Crouch)) == True))) == True;
	}

	action
	{
		If(Event Player.DrillOn == 1);
			Set Global Variable(BankLockDay, Add(Global Variable(Day), 1));
			Destroy Icon(Global Variable(AlarmIco));
			Small Message(All Players(All Teams), Custom String("은행 경보가 멎었다 — 도둑은 빈손으로 사라졌다"));
		End;
		Set Player Variable(Event Player, DialOn, 0);
		Set Player Variable(Event Player, DrillOn, 0);
		Set Player Variable(Event Player, Busy, 0);
		Destroy HUD Text(Event Player.KeyHud);
		Big Message(Event Player, Custom String("금고가 잠겼다 — 빈손으로 물러난다"));
		Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 70);
	}
}

rule("[열차 01] 화약 설치 (F 8초)")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Busy == 0;
		Global Variable(ArchOn) == 0;
		Is Alive(Event Player) == True;
		Event Player.HasPowder == 1;
		Global Variable(PowderSet) == 0;
		Modulo(Global Variable(Day), 3) == 0;
		Global Variable(Clock) < 1200;
		Distance Between(Position Of(Event Player), Global Variable(TrainPos)) < 5;
		Is Button Held(Event Player, Button(Crouch)) == False;
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	action
	{
		Set Player Variable(Event Player, Busy, 1);
		Set Player Variable(Event Player, WorkProg, 0);
		Destroy Progress Bar HUD Text(Event Player.WorkBar);
		Create Progress Bar HUD Text(Event Player, Event Player.WorkProg, Custom String("화약 설치 중..."), Top, 0, Color(Orange), Color(흰색), Visible To Values and Color, Default Visibility);
		Set Player Variable(Event Player, WorkBar, Last Text ID());
		Chase Player Variable Over Time(Event Player, WorkProg, 100, 8, Destination and Duration);
		Wait Until(Or(Or(Distance Between(Position Of(Event Player), Global Variable(TrainPos)) > 7, Not(Is Alive(Event Player))), Event Player.WorkProg >= 99), 8.5);
		Stop Chasing Player Variable(Event Player, WorkProg);
		Destroy Progress Bar HUD Text(Event Player.WorkBar);
		If(Or(Or(Distance Between(Position Of(Event Player), Global Variable(TrainPos)) > 7, Not(Is Alive(Event Player))), Event Player.WorkProg < 99));
			Small Message(Event Player, Custom String("손을 뗐다 — 화약은 아직 품 안에 있다"));
		Else;
			Set Player Variable(Event Player, HasPowder, 0);
			Set Global Variable(PowderSet, 1);
			Set Player Variable(Event Player, Noto, Min(100, Add(Event Player.Noto, 5)));
			Big Message(Event Player, Custom String("화약을 심었다 — 저녁 8시를 기다려라"));
			Small Message(All Players(All Teams), Custom String("철길목에서 수상한 인기척이 있었다..."));
			Destroy Icon(Global Variable(TrainIco));
			Create Icon(All Players(All Teams), Add(Global Variable(TrainPos), Vector(0, 3, 0)), Warning, Visible To and Position, Color(Orange), True);
			Set Global Variable(TrainIco, Last Created Entity());
			Wait(5, Ignore Condition);
			Destroy Icon(Global Variable(TrainIco));
		End;
		Set Player Variable(Event Player, Busy, 0);
	}
}

rule("[열차 02] 열차 통과")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(Ready) == 1;
	}

	action
	{
		Wait Until(And(Modulo(Global Variable(Day), 3) == 0, Global Variable(Clock) >= 1080), 99999);
		If(Global Variable(PowderSet) == 1);
			Big Message(All Players(All Teams), Custom String("1분 뒤 열차가 선다 — 철길목으로 모여라"));
		Else;
			Big Message(All Players(All Teams), Custom String("1분 뒤 열차 — 아직 화약이 없다! 대장간 $200, 철길목에서 [F] 8초"));
		End;
		Wait Until(And(Modulo(Global Variable(Day), 3) == 0, Global Variable(Clock) >= 1200), 99999);
		If(Global Variable(PowderSet) == 0);
			Big Message(All Players(All Teams), Custom String("열차가 그냥 지나갔다 — 철길목에 화약이 없었다"));
			Set Global Variable(TickerMsg, Custom String("다음 열차는 사흘 뒤 — 대장간 화약 $200을 철길목에 묻어야 선다"));
			Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 5));
		Else;
			Set Global Variable(PowderSet, 0);
			Set Global Variable(TrainOn, 1);
			Set Global Variable(TrainVault, 3);
			Set Global Variable(TrainEnd, Add(Total Time Elapsed(), 90));
			Set Global Variable(TrainFx, Empty Array);
			Create Effect(All Players(All Teams), Sphere, Color(Orange), Add(Global Variable(TrainPos), Vector(-3, 1.2, 0)), 1.4, None);
			Modify Global Variable(TrainFx, Append To Array, Last Created Entity());
			Create Effect(All Players(All Teams), Sphere, Color(Orange), Add(Global Variable(TrainPos), Vector(0, 1.4, 0)), 1.6, None);
			Modify Global Variable(TrainFx, Append To Array, Last Created Entity());
			Create Effect(All Players(All Teams), Sphere, Color(Orange), Add(Global Variable(TrainPos), Vector(3, 1.2, 0)), 1.4, None);
			Modify Global Variable(TrainFx, Append To Array, Last Created Entity());
			Create Icon(All Players(All Teams), Add(Global Variable(TrainPos), Vector(0, 4, 0)), Skull, Visible To and Position, Color(Orange), True);
			Set Global Variable(TrainIco, Last Created Entity());
			Big Message(All Players(All Teams), Custom String("폭발!! 열차가 철길목에 멈췄다 — 금고 3칸, 90초"));
			Play Effect(All Players(All Teams), Ring Explosion, Color(Orange), Global Variable(TrainPos), 10);
			Play Effect(All Players(All Teams), Explosion Sound, Color(Orange), Global Variable(TrainPos), 250);
			Wait Until(Or(Global Variable(TrainOn) == 0, Total Time Elapsed() > Global Variable(TrainEnd)), 95);
			Set Global Variable(TrainOn, 0);
			For Global Variable(Idx, 0, 3, 1);
				Destroy Effect(Value In Array(Global Variable(TrainFx), Global Variable(Idx)));
			End;
			Destroy Icon(Global Variable(TrainIco));
			Set Global Variable(TickerMsg, Custom String("열차가 다시 움직인다 — 자루를 진 자는 은신처에서 정산해라"));
			Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
		End;
		Wait Until(Modulo(Global Variable(Day), 3) != 0, 99999);
		Loop();
	}
}

rule("[축제 02] 불꽃놀이")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(FireEnd) > 0;
		Total Time Elapsed() >= Global Variable(FireEnd);
	}

	action
	{
		Set Global Variable(FireEnd, 0);
		Set Global Variable(FireN, 0);
		Big Message(All Players(All Teams), Custom String("하늘이 열린다 — 불꽃놀이!"));
		While(Global Variable(FireN) < 20);
			Set Global Variable(FirePos, Add(Value In Array(Global Variable(LocPos), 5), Vector(Random Real(-14, 14), Random Real(34, 48), Random Real(-14, 14))));
			Play Effect(All Players(All Teams), Ring Explosion, Random Value In Array(Array(Color(Yellow), Color(Orange), Color(Red), Color(Rose), Color(Purple), Color(Sky Blue), Color(Lime Green))), Global Variable(FirePos), Random Real(7, 13));
			Play Effect(All Players(All Teams), Good Explosion, Random Value In Array(Array(Color(Yellow), Color(Orange), Color(Rose), Color(Sky Blue))), Global Variable(FirePos), Random Real(4, 8));
			Play Effect(All Players(All Teams), Buff Explosion Sound, Color(Yellow), Global Variable(FirePos), 200);
			Modify Global Variable(FireN, Add, 1);
			Wait(Random Real(0.45, 0.85), Ignore Condition);
		End;
		Set Global Variable(TickerMsg, Custom String("불꽃이 사그라들었다"));
		Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
	}
}

rule("[열차 04] 철길목 표식 — 열차의 날 내내")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(Ready) == 1;
		Modulo(Global Variable(Day), 3) == 0;
	}

	action
	{
		Destroy Icon(Global Variable(TrainWay));
		Create Icon(All Players(All Teams), Add(Global Variable(TrainPos), Vector(0, 3.5, 0)), Bolt, Visible To and Position, Color(Orange), True);
		Set Global Variable(TrainWay, Last Created Entity());
		Set Global Variable(TickerMsg, Custom String("철길목에 주황 표식이 섰다 — 저녁 8시, 열차"));
		Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 4));
		Wait Until(Modulo(Global Variable(Day), 3) != 0, 99999);
		Destroy Icon(Global Variable(TrainWay));
	}
}

rule("[열차 03] 금고 개방 (F 5초)")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Busy == 0;
		Global Variable(ArchOn) == 0;
		Global Variable(TrainOn) == 1;
		Global Variable(TrainVault) > 0;
		Is Alive(Event Player) == True;
		Distance Between(Position Of(Event Player), Global Variable(TrainPos)) < 5;
		Is Button Held(Event Player, Button(Crouch)) == False;
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	action
	{
		Set Player Variable(Event Player, Busy, 1);
		Set Player Variable(Event Player, WorkProg, 0);
		Destroy Progress Bar HUD Text(Event Player.WorkBar);
		Create Progress Bar HUD Text(Event Player, Event Player.WorkProg, Custom String("금고를 뜯는 중..."), Top, 0, Color(Orange), Color(흰색), Visible To Values and Color, Default Visibility);
		Set Player Variable(Event Player, WorkBar, Last Text ID());
		Chase Player Variable Over Time(Event Player, WorkProg, 100, 5, Destination and Duration);
		Wait Until(Or(Or(Distance Between(Position Of(Event Player), Global Variable(TrainPos)) > 7, Not(Is Alive(Event Player))), Event Player.WorkProg >= 99), 5.5);
		Stop Chasing Player Variable(Event Player, WorkProg);
		Destroy Progress Bar HUD Text(Event Player.WorkBar);
		If(Or(Or(Distance Between(Position Of(Event Player), Global Variable(TrainPos)) > 7, Not(Is Alive(Event Player))), Event Player.WorkProg < 99));
			Small Message(Event Player, Custom String("손을 뗐다"));
		Else If(Or(Global Variable(TrainOn) == 0, Global Variable(TrainVault) <= 0));
			Small Message(Event Player, Custom String("한발 늦었다 — 금고가 비어 있다"));
		Else;
			Modify Global Variable(TrainVault, Subtract, 1);
			Destroy Effect(Value In Array(Global Variable(TrainFx), Global Variable(TrainVault)));
			Set Player Variable(Event Player, Loot, Random Integer(300, 500));
			Modify Player Variable(Event Player, Sack, Add, Event Player.Loot);
			Set Player Variable(Event Player, Noto, Min(100, Add(Event Player.Noto, 10)));
			Modify Player Variable(Event Player, Bounty, Add, 150);
			Set Global Variable(TickerMsg, Custom String("{0}이(가) 열차 금고를 뜯었다! 자루에 $ {1} — 남은 금고 {2}", Event Player, Event Player.Loot, Global Variable(TrainVault)));
			Big Message(Event Player, Custom String("금고를 뜯었다 — 자루에 $ {0}. 은신처에서 부려야 돈이 된다", Event Player.Loot));
			Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
			Play Effect(All Players(All Teams), Ring Explosion, Color(Orange), Position Of(Event Player), 3);
			If(Global Variable(TrainVault) <= 0);
				Set Global Variable(TrainOn, 0);
			End;
		End;
		Set Player Variable(Event Player, Busy, 0);
	}
}

rule("[양조 01] 밀주 숙성 완료")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.BrewVats >= 1;
		Event Player.BrewEnd > 0;
		Total Time Elapsed() >= Event Player.BrewEnd;
	}

	action
	{
		Set Player Variable(Event Player, BrewEnd, 0);
		Set Player Variable(Event Player, BrewReady, Multiply(3, Event Player.BrewVats));
		Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("밀주가 익었다 — {0}병. 술집 뒷문이 기다린다", Event Player.BrewReady));
		Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 2.5));
		Play Effect(Event Player, Buff Impact Sound, Color(Purple), Position Of(Event Player), 80);
	}
}

rule("[밀수 01] 화물 냄새")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Contraband == 1;
		Is Alive(Event Player) == True;
	}

	action
	{
		Create Icon(All Players(All Teams), Add(Position Of(Event Player), Vector(0, 2.6, 0)), Circle, Visible To and Position, Color(Purple), True);
		Set Player Variable(Event Player, SmuggleFlash, Last Created Entity());
		Small Message(All Players(All Teams), Custom String("코를 찌르는 화약내 — 누군가 밀수 중이다 (자주색 표식)"));
		Wait(3, Ignore Condition);
		Destroy Icon(Event Player.SmuggleFlash);
		Wait(17, Ignore Condition);
		Loop If(And(Event Player.Contraband == 1, Is Alive(Event Player)));
	}
}

rule("[밀수 02] 접선 인계 (F 3초)")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Busy == 0;
		Global Variable(ArchOn) == 0;
		Event Player.Contraband == 1;
		Is Alive(Event Player) == True;
		Distance Between(Position Of(Event Player), Event Player.SmugglePos) < 4;
		Is Button Held(Event Player, Button(Crouch)) == False;
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	action
	{
		Set Player Variable(Event Player, Busy, 1);
		Set Player Variable(Event Player, WorkProg, 0);
		Destroy Progress Bar HUD Text(Event Player.WorkBar);
		Create Progress Bar HUD Text(Event Player, Event Player.WorkProg, Custom String("화물 인계 중..."), Top, 0, Color(Purple), Color(흰색), Visible To Values and Color, Default Visibility);
		Set Player Variable(Event Player, WorkBar, Last Text ID());
		Chase Player Variable Over Time(Event Player, WorkProg, 100, 3, Destination and Duration);
		Wait Until(Or(Or(Distance Between(Position Of(Event Player), Event Player.SmugglePos) > 6, Not(Is Alive(Event Player))), Event Player.WorkProg >= 99), 3.5);
		Stop Chasing Player Variable(Event Player, WorkProg);
		Destroy Progress Bar HUD Text(Event Player.WorkBar);
		If(Or(Or(Distance Between(Position Of(Event Player), Event Player.SmugglePos) > 6, Not(Is Alive(Event Player))), Event Player.WorkProg < 99));
			Small Message(Event Player, Custom String("손을 뗐다"));
		Else;
			Modify Player Variable(Event Player, Money, Add, Event Player.SmugglePay);
			Modify Player Variable(Event Player, Earned, Add, Event Player.SmugglePay);
			Set Player Variable(Event Player, Noto, Min(100, Add(Event Player.Noto, 8)));
			Set Player Variable(Event Player, Contraband, 0);
			Destroy Icon(Event Player.SmuggleIco);
			Set Player Variable(Event Player, SmuggleCd, Add(Total Time Elapsed(), 30));
			Small Message(Event Player, Custom String("화물을 넘겼다 — +$ {0} (악명 +8)", Event Player.SmugglePay));
			Play Effect(Event Player, Buff Explosion Sound, Color(Purple), Position Of(Event Player), 120);
		End;
		Set Player Variable(Event Player, Busy, 0);
	}
}

rule("[호송 01] 금괴의 소문")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Escort == 1;
		Is Alive(Event Player) == True;
	}

	action
	{
		Create Icon(Filtered Array(All Players(All Teams), Or(Player Variable(Current Array Element, Noto) >= 30, Player Variable(Current Array Element, Bounty) > 0)), Add(Position Of(Event Player), Vector(0, 2.6, 0)), Circle, Visible To and Position, Color(Yellow), True);
		Set Player Variable(Event Player, EscortFlash, Last Created Entity());
		Wait(3, Ignore Condition);
		Destroy Icon(Event Player.EscortFlash);
		Wait(17, Ignore Condition);
		Loop If(And(Event Player.Escort == 1, Is Alive(Event Player)));
	}
}

rule("[호송 02] 금괴 인계 (F 3초)")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Busy == 0;
		Global Variable(ArchOn) == 0;
		Event Player.Escort == 1;
		Is Alive(Event Player) == True;
		Distance Between(Position Of(Event Player), Event Player.EscortPos) < 4;
		Is Button Held(Event Player, Button(Crouch)) == False;
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	action
	{
		Set Player Variable(Event Player, Busy, 1);
		Set Player Variable(Event Player, WorkProg, 0);
		Destroy Progress Bar HUD Text(Event Player.WorkBar);
		Create Progress Bar HUD Text(Event Player, Event Player.WorkProg, Custom String("금괴 인계 중..."), Top, 0, Color(Yellow), Color(흰색), Visible To Values and Color, Default Visibility);
		Set Player Variable(Event Player, WorkBar, Last Text ID());
		Chase Player Variable Over Time(Event Player, WorkProg, 100, 3, Destination and Duration);
		Wait Until(Or(Or(Distance Between(Position Of(Event Player), Event Player.EscortPos) > 6, Not(Is Alive(Event Player))), Event Player.WorkProg >= 99), 3.5);
		Stop Chasing Player Variable(Event Player, WorkProg);
		Destroy Progress Bar HUD Text(Event Player.WorkBar);
		If(Or(Or(Distance Between(Position Of(Event Player), Event Player.EscortPos) > 6, Not(Is Alive(Event Player))), Event Player.WorkProg < 99));
			Small Message(Event Player, Custom String("손을 뗐다"));
		Else;
			Modify Player Variable(Event Player, Money, Add, Event Player.EscortPay);
			Modify Player Variable(Event Player, Earned, Add, Event Player.EscortPay);
			Set Player Variable(Event Player, Fame, Min(100, Add(Event Player.Fame, 8)));
			Set Player Variable(Event Player, Escort, 0);
			Destroy Icon(Event Player.EscortIco);
			Destroy Effect(Event Player.EscortFx);
			Set Player Variable(Event Player, EscortCd, Add(Total Time Elapsed(), 60));
			Small Message(Event Player, Custom String("금괴를 지켜냈다 — +$ {0} (명성 +8)", Event Player.EscortPay));
			Play Effect(Event Player, Buff Explosion Sound, Color(Yellow), Position Of(Event Player), 120);
		End;
		Set Player Variable(Event Player, Busy, 0);
	}
}

rule("[호송 03] 길목의 매복")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Escort == 1;
		Is Alive(Event Player) == True;
	}

	action
	{
		Wait(Random Real(10, 16), Ignore Condition);
		If(And(And(Event Player.Escort == 1, Is Alive(Event Player)), Random Integer(1, 100) <= 45));
			Set Player Variable(Event Player, CowPos, Nearest Walkable Position(Add(Position Of(Event Player), Multiply(Direction Towards(Position Of(Event Player), Event Player.EscortPos), 14))));
			Set Player Variable(Event Player, CowEnd, Add(Total Time Elapsed(), 15));
			Destroy Effect(Event Player.CowFx);
			Create Effect(All Players(All Teams), Sphere, Color(Red), Event Player.CowPos, 6, Visible To Position Radius and Color);
			Set Player Variable(Event Player, CowFx, Last Created Entity());
			Small Message(Event Player, Custom String("길목에 매복이다! 붉은 원을 밟지 마라 — 15초"));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 70);
			While(And(Total Time Elapsed() < Event Player.CowEnd, And(Event Player.Escort == 1, Is Alive(Event Player))));
				If(Distance Between(Position Of(Event Player), Event Player.CowPos) < 6);
					Damage(Event Player, Null, 30);
					Small Message(Event Player, Custom String("매복 사격에 당하고 있다!"));
					Play Effect(All Players(All Teams), Explosion Sound, Color(Red), Event Player.CowPos, 100);
				End;
				Wait(0.5, Ignore Condition);
			End;
			Destroy Effect(Event Player.CowFx);
			If(And(Event Player.Escort == 1, Is Alive(Event Player)));
				Small Message(Event Player, Custom String("매복이 물러갔다 — 길이 열렸다"));
			End;
		End;
		Wait(2, Ignore Condition);
		Loop If(Event Player.Escort == 1);
	}
}

rule("[대사냥 01] 대야수의 흔적")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(Ready) == 1;
		Modulo(Global Variable(Day), 3) == 1;
		Global Variable(Day) >= 4;
		Global Variable(Day) > Global Variable(HuntDay);
		Global Variable(IsNight) == 0;
	}

	action
	{
		Set Global Variable(HuntDay, Global Variable(Day));
		Set Global Variable(HuntPhase, 1);
		Set Global Variable(HuntTrackPos, Random Value In Array(Global Variable(SpotPos)));
		Destroy Icon(Global Variable(HuntTrackIco));
		Destroy Effect(Global Variable(HuntTrackFx));
		Create Effect(All Players(All Teams), Light Shaft, Color(Orange), Global Variable(HuntTrackPos), 1.5, Visible To Position Radius and Color);
		Set Global Variable(HuntTrackFx, Last Created Entity());
		Create Icon(All Players(All Teams), Add(Global Variable(HuntTrackPos), Vector(0, 3, 0)), Circle, Visible To and Position, Color(Orange), True);
		Set Global Variable(HuntTrackIco, Last Created Entity());
		Big Message(All Players(All Teams), Custom String("대사냥의 날 — 대야수의 흔적이 나타났다! 주황 표식을 조사하라"));
		Play Effect(All Players(All Teams), Buff Impact Sound, Color(Orange), Global Variable(HuntTrackPos), 200);
	}
}

rule("[대사냥 02] 흔적 조사 (F)")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Busy == 0;
		Global Variable(ArchOn) == 0;
		Global Variable(HuntPhase) >= 1;
		Global Variable(HuntPhase) <= 3;
		Is Alive(Event Player) == True;
		Distance Between(Position Of(Event Player), Global Variable(HuntTrackPos)) < 5;
		Is Button Held(Event Player, Button(Crouch)) == False;
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	action
	{
		If(Or(Or(Global Variable(HuntPhase) < 1, Global Variable(HuntPhase) > 3), Distance Between(Position Of(Event Player), Global Variable(HuntTrackPos)) >= 5));
			Abort;
		End;
		Destroy Icon(Global Variable(HuntTrackIco));
		Destroy Effect(Global Variable(HuntTrackFx));
		If(Global Variable(HuntPhase) <= 2);
			Modify Global Variable(HuntPhase, Add, 1);
			Set Global Variable(HuntTrackPos, Random Value In Array(Global Variable(SpotPos)));
			Create Effect(All Players(All Teams), Light Shaft, Color(Orange), Global Variable(HuntTrackPos), 1.5, Visible To Position Radius and Color);
			Set Global Variable(HuntTrackFx, Last Created Entity());
			Create Icon(All Players(All Teams), Add(Global Variable(HuntTrackPos), Vector(0, 3, 0)), Circle, Visible To and Position, Color(Orange), True);
			Set Global Variable(HuntTrackIco, Last Created Entity());
			Set Player Variable(Event Player, Fame, Min(100, Add(Event Player.Fame, 2)));
			Set Global Variable(TickerMsg, Custom String("흔적을 찾았다 — 냄새가 짙어진다. 다음 표식으로"));
			Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
			Play Effect(Event Player, Buff Impact Sound, Color(Orange), Position Of(Event Player), 60);
		Else;
			Set Global Variable(HuntBeast, First Of(Filtered Array(All Players(Team 2), And(Slot Of(Current Array Element) <= 2, And(Is Dummy Bot(Current Array Element), Is Alive(Current Array Element))))));
			If(Not(Entity Exists(Global Variable(HuntBeast))));
				Create Effect(All Players(All Teams), Light Shaft, Color(Orange), Global Variable(HuntTrackPos), 1.5, Visible To Position Radius and Color);
				Set Global Variable(HuntTrackFx, Last Created Entity());
				Create Icon(All Players(All Teams), Add(Global Variable(HuntTrackPos), Vector(0, 3, 0)), Circle, Visible To and Position, Color(Orange), True);
				Set Global Variable(HuntTrackIco, Last Created Entity());
				Small Message(Event Player, Custom String("기척이 흐트러졌다 — 잠시 뒤 다시 조사해라"));
				Play Effect(Event Player, Debuff Impact Sound, Color(회색), Position Of(Event Player), 45);
			Else;
				Set Global Variable(HuntPhase, 4);
				Set Player Variable(Global Variable(HuntBeast), RevealEnd, Add(Total Time Elapsed(), 9999));
				Set Player Variable(Global Variable(HuntBeast), Giant, 0);
				Set Max Health(Global Variable(HuntBeast), 1000);
				Remove All Health Pools From Player(Global Variable(HuntBeast));
				Add Health Pool To Player(Global Variable(HuntBeast), Health, 8000, True, True);
				Heal(Global Variable(HuntBeast), Null, 9999);
				Start Scaling Player(Global Variable(HuntBeast), 30, False);
				Clear Status(Global Variable(HuntBeast), Phased Out);
				Set Invisible(Global Variable(HuntBeast), None);
				Teleport(Global Variable(HuntBeast), Nearest Walkable Position(Add(Value In Array(Global Variable(LocPos), 6), Vector(Random Real(-5, 5), 0, Random Real(-5, 5)))));
				Set Player Variable(All Players(All Teams), HuntDmg, 0);
				Set Player Variable(Event Player, Fame, Min(100, Add(Event Player.Fame, 2)));
				Big Message(All Players(All Teams), Custom String("대야수가 깨어났다!! 협곡 개활지다 — 쓰러뜨린 몫은 기여만큼 나눈다"));
				Play Effect(All Players(All Teams), Ring Explosion, Color(Red), Position Of(Global Variable(HuntBeast)), 20);
				Play Effect(All Players(All Teams), Explosion Sound, Color(Red), Position Of(Global Variable(HuntBeast)), 300);
				Disable Movement Collision With Environment(Global Variable(HuntBeast), False);
				Set Global Variable(HuntTgt, Null);
				Set Global Variable(HuntLast, Position Of(Global Variable(HuntBeast)));
				Set Global Variable(HuntStuck, 0);
				Set Global Variable(HuntSwing, Total Time Elapsed());
			End;
		End;
		Wait(0.3, Ignore Condition);
	}
}

rule("[대사냥 03] 기여 기록")
{
	event
	{
		Player Dealt Damage;
		All;
		All;
	}

	condition
	{
		Global Variable(HuntPhase) == 4;
		Victim == Global Variable(HuntBeast);
		Is Dummy Bot(Event Player) == False;
	}

	action
	{
		Modify Player Variable(Event Player, HuntDmg, Add, Event Damage);
	}
}

rule("[대사냥 04] 대야수 토벌")
{
	event
	{
		Player Died;
		Team 2;
		All;
	}

	condition
	{
		Is Dummy Bot(Victim) == True;
		Global Variable(HuntPhase) == 4;
		Victim == Global Variable(HuntBeast);
	}

	action
	{
		Set Global Variable(HuntPhase, 0);
		Set Global Variable(HuntArr, Sorted Array(Filtered Array(All Players(All Teams), Player Variable(Current Array Element, HuntDmg) >= 1), Subtract(0, Player Variable(Current Array Element, HuntDmg))));
		For Global Variable(HuntIdx, 0, Count Of(Global Variable(HuntArr)), 1);
			Modify Player Variable At Index(Value In Array(Global Variable(HuntArr), Global Variable(HuntIdx)), Inv, 3, Add, 15);
			Set Player Variable(Value In Array(Global Variable(HuntArr), Global Variable(HuntIdx)), Fame, Min(100, Add(Player Variable(Value In Array(Global Variable(HuntArr), Global Variable(HuntIdx)), Fame), 10)));
			Modify Player Variable(Value In Array(Global Variable(HuntArr), Global Variable(HuntIdx)), Money, Add, 200);
			Modify Player Variable(Value In Array(Global Variable(HuntArr), Global Variable(HuntIdx)), Earned, Add, 200);
			Small Message(Value In Array(Global Variable(HuntArr), Global Variable(HuntIdx)), Custom String("대사냥 보상 — 가죽 15장 · $200 · 명성 +10"));
		End;
		If(Count Of(Global Variable(HuntArr)) >= 1);
			Modify Player Variable At Index(First Of(Global Variable(HuntArr)), Inv, 3, Add, 35);
			Modify Player Variable(First Of(Global Variable(HuntArr)), Money, Add, 300);
			Modify Player Variable(First Of(Global Variable(HuntArr)), Earned, Add, 300);
			Big Message(All Players(All Teams), Custom String("{0} — 대야수 토벌의 일등 공신! (가죽 +35 · +$300)", First Of(Global Variable(HuntArr))));
		End;
		Big Message(All Players(All Teams), Custom String("대야수가 쓰러졌다!! 참가자 모두에게 몫이 돌아간다"));
		Play Effect(All Players(All Teams), Ring Explosion, Color(Red), Position Of(Victim), 20);
		Play Effect(All Players(All Teams), Buff Explosion Sound, Color(Red), Position Of(Victim), 300);
		Enable Movement Collision With Environment(Victim);
		Set Player Variable(Victim, RevealEnd, 0);
		Set Player Variable(All Players(All Teams), HuntDmg, 0);
		Set Global Variable(HuntBeast, Null);
	}
}

rule("[대사냥 05] 밤이 오면 물러난다")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(HuntPhase) >= 1;
		Global Variable(IsNight) == 1;
	}

	action
	{
		If(Global Variable(HuntPhase) == 4);
			Set Player Variable(Global Variable(HuntBeast), RevealEnd, 0);
			Enable Movement Collision With Environment(Global Variable(HuntBeast));
		Else;
			Destroy Icon(Global Variable(HuntTrackIco));
			Destroy Effect(Global Variable(HuntTrackFx));
		End;
		Set Global Variable(HuntPhase, 0);
		Set Global Variable(HuntBeast, Null);
		Set Player Variable(All Players(All Teams), HuntDmg, 0);
		Big Message(All Players(All Teams), Custom String("대야수의 기척이 밤 속으로 사라졌다 — 사흘 뒤를 노려라"));
	}
}

rule("[대사냥 06] 대야수의 추격과 강타")
{
	event
	{
		Ongoing - Each Player;
		Team 2;
		All;
	}

	condition
	{
		Global Variable(HuntPhase) == 4;
		Event Player == Global Variable(HuntBeast);
		Is Alive(Event Player) == True;
	}

	action
	{
		Set Global Variable(HuntTgt, First Of(Sorted Array(Filtered Array(All Players(Team 1), And(And(Is Alive(Current Array Element), Player Variable(Current Array Element, Init) == 1), And(Player Variable(Current Array Element, TutOn) == 0, Has Status(Current Array Element, Phased Out) == False))), Distance Between(Position Of(Current Array Element), Position Of(Event Player)))));
		Set Move Speed(Event Player, 115);
		If(Entity Exists(Global Variable(HuntTgt)));
			Start Throttle In Direction(Event Player, Direction Towards(Position Of(Event Player), Position Of(Global Variable(HuntTgt))), 1, To World, Replace existing throttle, None);
			Set Facing(Event Player, Direction Towards(Position Of(Event Player), Position Of(Global Variable(HuntTgt))), To World);
			If(And(Distance Between(Position Of(Event Player), Position Of(Global Variable(HuntTgt))) <= 15, Total Time Elapsed() >= Global Variable(HuntSwing)));
				Damage(Global Variable(HuntTgt), Event Player, 28);
				Set Global Variable(HuntSwing, Add(Total Time Elapsed(), 1.6));
				Play Effect(All Players(All Teams), Bad Explosion, Color(Red), Position Of(Global Variable(HuntTgt)), 3);
				Play Effect(All Players(All Teams), Explosion Sound, Color(Red), Position Of(Global Variable(HuntTgt)), 120);
			End;
		Else;
			Stop Throttle In Direction(Event Player);
		End;
		If(And(Entity Exists(Global Variable(HuntTgt)), Distance Between(Position Of(Event Player), Global Variable(HuntLast)) < 1.5));
			Modify Global Variable(HuntStuck, Add, 1);
		Else;
			Set Global Variable(HuntStuck, 0);
		End;
		Set Global Variable(HuntLast, Position Of(Event Player));
		If(And(Global Variable(HuntStuck) >= 6, And(Entity Exists(Global Variable(HuntTgt)), Distance Between(Position Of(Event Player), Position Of(Global Variable(HuntTgt))) > 15)));
			Teleport(Event Player, First Of(Sorted Array(Global Variable(SpotPos), Distance Between(Current Array Element, Position Of(Global Variable(HuntTgt))))));
			Set Global Variable(HuntStuck, 0);
			Set Global Variable(HuntLast, Position Of(Event Player));
			Play Effect(All Players(All Teams), Ring Explosion, Color(Red), Position Of(Event Player), 12);
			Set Global Variable(TickerMsg, Custom String("대야수가 길을 질러 나타났다"));
			Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
		End;
		Wait(0.5, Ignore Condition);
		Loop If(And(Global Variable(HuntPhase) == 4, And(Is Alive(Event Player), Event Player == Global Variable(HuntBeast))));
		Stop Throttle In Direction(Event Player);
	}
}

rule("[목장 02] 소가 다 컸다")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.RanchPens >= 1;
		Event Player.RanchEnd > 0;
		Total Time Elapsed() >= Event Player.RanchEnd;
	}

	action
	{
		Set Player Variable(Event Player, RanchEnd, 0);
		Set Player Variable(Event Player, RanchReady, Multiply(Event Player.RanchCare == 1 ? 3 : 1, Event Player.RanchPens));
		If(Event Player.RanchCare == 1);
			Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("소가 통통하게 컸다 — {0}마리 출하 준비 완료", Event Player.RanchReady));
			Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 2.5));
			Play Effect(Event Player, Buff Impact Sound, Color(Lime Green), Position Of(Event Player), 80);
		Else;
			Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("돌보지 않은 우리 — 야윈 소 {0}마리뿐이다", Event Player.RanchReady));
			Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 2.5));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 80);
		End;
	}
}

rule("[재건 02] 오페라의 밤")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Rebuild >= 4;
		Global Variable(IsNight) == 1;
		Event Player.Zone == 5;
		Is Alive(Event Player) == True;
	}

	action
	{
		Set Player Variable(Event Player, Energy, Min(100, Add(Event Player.Energy, 15)));
		Set Player Variable(Event Player, Fame, Min(100, Add(Event Player.Fame, 1)));
		Small Message(Event Player, Custom String("오페라의 밤 — 무대의 노래가 피로를 씻는다 (피로 +15 · 명성 +1)"));
		Play Effect(Event Player, Buff Impact Sound, Color(Yellow), Position Of(Event Player), 80);
		Wait Until(Global Variable(IsNight) == 0, 99999);
	}
}

rule("[마스터리 01] 한 길의 장인")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Add(Add(Add(Add(Add(Add(Add(Add(Value In Array(Event Player.JobXP, 1) >= 2500, Value In Array(Event Player.JobXP, 1) >= 5000), Add(Value In Array(Event Player.JobXP, 1) >= 10000, Value In Array(Event Player.JobXP, 2) >= 2500)), Add(Value In Array(Event Player.JobXP, 2) >= 5000, Value In Array(Event Player.JobXP, 2) >= 10000)), Add(Value In Array(Event Player.JobXP, 3) >= 2500, Value In Array(Event Player.JobXP, 3) >= 5000)), Add(Value In Array(Event Player.JobXP, 3) >= 10000, Value In Array(Event Player.JobXP, 4) >= 2500)), Add(Value In Array(Event Player.JobXP, 4) >= 5000, Value In Array(Event Player.JobXP, 4) >= 10000)), Add(Add(Value In Array(Event Player.JobXP, 5) >= 2500, Value In Array(Event Player.JobXP, 5) >= 5000), Add(Value In Array(Event Player.JobXP, 5) >= 10000, Value In Array(Event Player.JobXP, 6) >= 2500))), Add(Value In Array(Event Player.JobXP, 6) >= 5000, Value In Array(Event Player.JobXP, 6) >= 10000)) > Round To Integer(Divide(Event Player.Giant, 10), Down);
	}

	action
	{
		Modify Player Variable(Event Player, Giant, Add, 10);
		Modify Player Variable(Event Player, Money, Add, 1000);
		Modify Player Variable(Event Player, Earned, Add, 1000);
		Big Message(All Players(All Teams), Custom String("{0} — 한 길의 장인이 되었다! (마스터리 {1}) +$1,000", Event Player, Round To Integer(Divide(Event Player.Giant, 10), Down)));
		Play Effect(All Players(All Teams), Ring Explosion, Color(Yellow), Position Of(Event Player), 4);
		Play Effect(Event Player, Buff Explosion Sound, Color(Yellow), Position Of(Event Player), 200);
		Wait(1, Ignore Condition);
	}
}

rule("[거래 01] 돈 건네기 (웅크리기+V)")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Busy == 0;
		Global Variable(ArchOn) == 0;
		Is Alive(Event Player) == True;
		Is Button Held(Event Player, Button(Crouch)) == True;
		Is Button Held(Event Player, Button(Melee)) == True;
	}

	action
	{
		Set Player Variable(Event Player, Target, First Of(Sorted Array(Filtered Array(Players Within Radius(Eye Position(Event Player), 9, All Teams, Surfaces), And(Current Array Element != Event Player, And(Is Dummy Bot(Current Array Element) == False, And(Player Variable(Current Array Element, TutOn) == 0, And(Has Status(Current Array Element, Asleep) == False, And(Is Alive(Current Array Element), Dot Product(Facing Direction Of(Event Player), Direction Towards(Eye Position(Event Player), Eye Position(Current Array Element))) >= 0.93)))))), Distance Between(Eye Position(Event Player), Eye Position(Current Array Element)))));
		If(Not(Entity Exists(Event Player.Target)));
			Small Message(Event Player, Custom String("건넬 상대가 없다 — 9m 안의 상대를 조준하고 웅크린 채 [{0}]", Input Binding String(Button(Melee))));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
		Else If(Event Player.Money < 100);
			Small Message(Event Player, Custom String("건넬 돈이 부족하다 — $100씩 건넨다"));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 45);
		Else;
			Modify Player Variable(Event Player, Money, Subtract, 100);
			Modify Player Variable(Event Player.Target, Money, Add, 100);
			Small Message(Event Player, Custom String("{0}에게 $100을 건넸다", Event Player.Target));
			Small Message(Event Player.Target, Custom String("{0}이(가) $100을 건넸다", Event Player));
			Play Effect(Event Player.Target, Buff Impact Sound, Color(Lime Green), Position Of(Event Player.Target), 60);
		End;
		Wait(0.6, Ignore Condition);
	}
}

rule("[파발 02] 편지 · 급행 우편")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Busy == 0;
		Event Player.HasParcel == 1;
		Is Alive(Event Player) == True;
	}

	action
	{
		Wait(Random Real(7, 14), Ignore Condition);
		If(And(And(Event Player.HasParcel == 1, Event Player.Busy == 0), Is Alive(Event Player)));
			Set Player Variable(Event Player, DialTgt, Random Value In Array(Filtered Array(All Players(Team 1), And(And(Current Array Element != Event Player, Is Dummy Bot(Current Array Element) == False), And(Is Alive(Current Array Element), Player Variable(Current Array Element, TutOn) == 0)))));
			If(And(Entity Exists(Event Player.DialTgt), Random Integer(1, 100) <= 50));
				Create Icon(Event Player, Event Player.DialTgt, Flag, Visible To and Position, Color(Sky Blue), True);
				Set Player Variable(Event Player, DialCur, Last Created Entity());
				Create Icon(Event Player.DialTgt, Event Player, Flag, Visible To and Position, Color(Sky Blue), True);
				Set Player Variable(Event Player, DialPin, Last Created Entity());
				Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("겸사겸사 편지 한 통 — {0}에게 전해라", Event Player.DialTgt));
				Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 3));
				Set Global Variable At Index(NoticeMsg, Slot Of(Event Player.DialTgt), Custom String("{0}이(가) 네게 편지를 가져오고 있다", Event Player));
				Set Global Variable At Index(NoticeEnd, Slot Of(Event Player.DialTgt), Add(Total Time Elapsed(), 3));
				Play Effect(Event Player, Buff Impact Sound, Color(Sky Blue), Position Of(Event Player), 45);
				Wait Until(Or(Or(Distance Between(Position Of(Event Player), Position Of(Event Player.DialTgt)) < 4, Event Player.Busy == 1), Or(Not(Entity Exists(Event Player.DialTgt)), Or(Event Player.HasParcel == 0, Not(Is Alive(Event Player))))), 45);
				Destroy Icon(Event Player.DialCur);
				Destroy Icon(Event Player.DialPin);
				If(And(And(Entity Exists(Event Player.DialTgt), Is Alive(Event Player.DialTgt)), And(Distance Between(Position Of(Event Player), Position Of(Event Player.DialTgt)) < 4, Is Alive(Event Player))));
					Modify Player Variable(Event Player, Money, Add, 40);
					Modify Player Variable(Event Player, Earned, Add, 40);
					Set Player Variable(Event Player, Fame, Min(100, Add(Event Player.Fame, 2)));
					Modify Player Variable(Event Player.DialTgt, Money, Add, 20);
					Modify Player Variable(Event Player.DialTgt, Earned, Add, 20);
					Small Message(Event Player, Custom String("편지를 건넸다 +$40 · 명성 +2"));
					Small Message(Event Player.DialTgt, Custom String("{0}에게서 편지를 받았다 +$20", Event Player));
					Play Effect(Event Player, Ring Explosion, Color(Sky Blue), Position Of(Event Player), 1.2);
					Play Effect(Event Player.DialTgt, Ring Explosion, Color(Sky Blue), Position Of(Event Player.DialTgt), 1.2);
				Else;
					Small Message(Event Player, Custom String("편지는 주머니에서 구겨졌다"));
				End;
			Else;
				Set Player Variable(Event Player, DialTgt, Add(Total Time Elapsed(), Add(2, Divide(Distance Between(Position Of(Event Player), Value In Array(Global Variable(LocPos), Event Player.DelDest)), 6))));
				Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("급행이다! {0}초 안에 도착하면 보수 2배", Round To Integer(Subtract(Event Player.DialTgt, Total Time Elapsed()), Up)));
				Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 3));
				Play Effect(Event Player, Buff Impact Sound, Color(Orange), Position Of(Event Player), 45);
				Wait Until(Or(Or(Event Player.HasParcel == 0, Event Player.Busy == 1), Or(Not(Is Alive(Event Player)), Total Time Elapsed() >= Event Player.DialTgt)), 120);
				If(And(And(Event Player.HasParcel == 0, Event Player.Zone == Event Player.DelDest), Total Time Elapsed() < Event Player.DialTgt));
					Modify Player Variable(Event Player, Money, Add, Event Player.RunPay);
					Modify Player Variable(Event Player, Earned, Add, Event Player.RunPay);
					Small Message(Event Player, Custom String("급행 성공! 보수 2배 — 추가 +$ {0}", Event Player.RunPay));
					Play Effect(Event Player, Ring Explosion, Color(Orange), Position Of(Event Player), 1.2);
				Else If(And(Event Player.HasParcel >= 1, Is Alive(Event Player)));
					Small Message(Event Player, Custom String("급행 시간을 넘겼다 — 보수는 그대로다"));
				End;
			End;
		End;
	}
}

rule("[파발 03] 그림자 강도")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.HasParcel == 2;
		Is Alive(Event Player) == True;
	}

	action
	{
		Wait(Random Real(8, 14), Ignore Condition);
		If(And(And(Event Player.HasParcel == 2, Event Player.Busy == 0), Is Alive(Event Player)));
			Set Player Variable(Event Player, EscortPay, 0);
			Set Player Variable(Event Player, EscortPos, Nearest Walkable Position(Add(Position Of(Event Player), Multiply(Facing Direction Of(Event Player), -22))));
			Destroy Effect(Event Player.EscortFx);
			Create Effect(All Players(All Teams), Sphere, Color(Red), Event Player.EscortPos, 0.9, Visible To Position Radius and Color);
			Set Player Variable(Event Player, EscortFx, Last Created Entity());
			Destroy Icon(Event Player.EscortIco);
			Create Icon(All Players(All Teams), Add(Event Player.EscortPos, Vector(0, 2.2, 0)), Skull, Visible To and Position, Color(Red), True);
			Set Player Variable(Event Player, EscortIco, Last Created Entity());
			Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("그림자 강도가 따라붙었다 — 쏴서 떨쳐내라! (붉은 그림자)"));
			Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 2.5));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 80);
			While(And(And(Event Player.HasParcel == 2, Is Alive(Event Player)), Event Player.EscortPay < 3));
				Set Player Variable(Event Player, EscortPos, Add(Event Player.EscortPos, Multiply(Direction Towards(Event Player.EscortPos, Position Of(Event Player)), 1.7)));
				If(And(Is Button Held(Event Player, Button(Primary Fire)), And(Distance Between(Position Of(Event Player), Event Player.EscortPos) < 30, Dot Product(Facing Direction Of(Event Player), Direction Towards(Eye Position(Event Player), Event Player.EscortPos)) >= 0.96)));
					Modify Player Variable(Event Player, EscortPay, Add, 1);
					Play Effect(Event Player, Buff Impact Sound, Color(Orange), Event Player.EscortPos, 40);
				End;
				If(Distance Between(Event Player.EscortPos, Position Of(Event Player)) < 2.5);
					Set Player Variable(Event Player, EscortPay, 99);
					Damage(Event Player, Null, 40);
					Small Message(Event Player, Custom String("그림자 강도에게 물어뜯겼다 — 놈이 어둠으로 사라졌다"));
					Play Effect(All Players(All Teams), Bad Explosion, Color(Red), Position Of(Event Player), 1.5);
				End;
				Wait(0.25, Ignore Condition);
			End;
			Destroy Effect(Event Player.EscortFx);
			Destroy Icon(Event Player.EscortIco);
			If(And(Event Player.EscortPay >= 3, Event Player.EscortPay < 99));
				Small Message(Event Player, Custom String("그림자 강도를 쫓아냈다!"));
				Play Effect(Event Player, Buff Impact Sound, Color(Lime Green), Position Of(Event Player), 60);
			End;
		End;
		Wait(Random Real(16, 24), Ignore Condition);
		Loop If(Event Player.HasParcel == 2);
	}
}

rule("[목동 02] 날뛰는 소")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Busy == 0;
		Event Player.CowOn >= 1;
		Is Alive(Event Player) == True;
	}

	action
	{
		Wait(Random Real(6, 12), Ignore Condition);
		If(And(And(Event Player.CowOn >= 1, Event Player.Busy == 0), Is Alive(Event Player)));
			Set Player Variable(Event Player, Busy, 1);
			Set Global Variable At Index(NoticeMsg, Slot Of(Event Player), Custom String("소가 성났다 — 고삐의 때를 노려라!"));
			Set Global Variable At Index(NoticeEnd, Slot Of(Event Player), Add(Total Time Elapsed(), 2.5));
			Play Effect(Event Player, Buff Impact Sound, Color(흰색), Position Of(Event Player), 45);
			Call Subroutine(DoSkillBar);
			If(And(Event Player.Roll == 1, Event Player.CowOn >= 1));
				Modify Player Variable(Event Player, Money, Add, 10);
				Modify Player Variable(Event Player, Earned, Add, 10);
				Small Message(Event Player, Custom String("고삐를 당겨 세웠다 +$10"));
				Play Effect(Event Player, Ring Explosion, Color(흰색), Position Of(Event Player), 1);
			Else;
				If(Event Player.CowOn >= 1);
					Set Player Variable(Event Player, CowOn, 2);
				End;
				Small Message(Event Player, Custom String("고삐를 놓쳤다 — 소가 날뛴다, 이번 몰이 삯은 절반이다"));
			End;
			Set Player Variable(Event Player, Busy, 0);
		End;
		Wait(2, Ignore Condition);
		Loop If(Event Player.CowOn >= 1);
	}
}

rule("[목동 03] 총성에 놀란 소")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Is Button Held(Event Player, Button(Primary Fire)) == True;
	}

	action
	{
		For Player Variable(Event Player, Idx, 0, Count Of(All Players(Team 1)), 1);
			If(And(And(Player Variable(Value In Array(All Players(Team 1), Event Player.Idx), CowOn) >= 1, Value In Array(All Players(Team 1), Event Player.Idx) != Event Player), Distance Between(Position Of(Event Player), Player Variable(Value In Array(All Players(Team 1), Event Player.Idx), CowPos)) < 25));
				Set Player Variable(Value In Array(All Players(Team 1), Event Player.Idx), CowPos, Nearest Walkable Position(Add(Player Variable(Value In Array(All Players(Team 1), Event Player.Idx), CowPos), Add(Multiply(Direction Towards(Value In Array(Global Variable(LocPos), 12), Player Variable(Value In Array(All Players(Team 1), Event Player.Idx), CowPos)), Random Real(8, 12)), Vector(Random Real(-6, 6), 0, Random Real(-6, 6))))));
				Destroy Effect(Player Variable(Value In Array(All Players(Team 1), Event Player.Idx), CowFx));
				Create Effect(All Players(All Teams), Sphere, Color(흰색), Player Variable(Value In Array(All Players(Team 1), Event Player.Idx), CowPos), 0.7, None);
				Set Player Variable(Value In Array(All Players(Team 1), Event Player.Idx), CowFx, Last Created Entity());
				Destroy Icon(Player Variable(Value In Array(All Players(Team 1), Event Player.Idx), CowIco));
				Create Icon(All Players(All Teams), Add(Player Variable(Value In Array(All Players(Team 1), Event Player.Idx), CowPos), Vector(0, 1.6, 0)), Circle, Visible To and Position, Color(흰색), True);
				Set Player Variable(Value In Array(All Players(Team 1), Event Player.Idx), CowIco, Last Created Entity());
				Small Message(Value In Array(All Players(Team 1), Event Player.Idx), Custom String("총성에 소가 놀라 내달렸다!"));
				Play Effect(Value In Array(All Players(Team 1), Event Player.Idx), Debuff Impact Sound, Color(흰색), Player Variable(Value In Array(All Players(Team 1), Event Player.Idx), CowPos), 60);
			End;
		End;
		Wait(1.5, Ignore Condition);
	}
}

rule("[목동 04] 늑대의 습격")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.CowOn >= 1;
		Is Alive(Event Player) == True;
	}

	action
	{
		Wait(Random Real(18, 30), Ignore Condition);
		If(And(And(Event Player.CowOn >= 1, Is Alive(Event Player)), And(Random Integer(1, 100) <= 45, Distance Between(Event Player.CowPos, Value In Array(Global Variable(LocPos), 12)) > 25)));
			Set Player Variable(Event Player, DialTgt, Nearest Walkable Position(Add(Event Player.CowPos, Multiply(Direction From Angles(Random Real(-180, 180), 0), 20))));
			Set Player Variable(Event Player, DialPin, 0);
			Set Player Variable(Event Player, DialCur, 0);
			Destroy Effect(Event Player.EscortFlash);
			Create Effect(All Players(All Teams), Sphere, Color(Red), Event Player.DialTgt, 1.4, Visible To Position Radius and Color);
			Set Player Variable(Event Player, EscortFlash, Last Created Entity());
			Destroy Icon(Event Player.WolfIco);
			Create Icon(Event Player, Add(Event Player.DialTgt, Vector(0, 2.2, 0)), Skull, Visible To and Position, Color(Red), True);
			Set Player Variable(Event Player, WolfIco, Last Created Entity());
			Small Message(Event Player, Custom String("늑대다! 붉은 표식을 조준해 세 발 맞혀 쫓아내라"));
			Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 80);
			While(And(And(Event Player.CowOn >= 1, Is Alive(Event Player)), And(Event Player.DialCur < 12, Event Player.DialPin < 3)));
				Set Player Variable(Event Player, DialTgt, Nearest Walkable Position(Add(Event Player.DialTgt, Multiply(Direction Towards(Event Player.DialTgt, Event Player.CowPos), 0.7))));
				If(And(Is Button Held(Event Player, Button(Primary Fire)), And(Distance Between(Position Of(Event Player), Event Player.DialTgt) < 30, Dot Product(Facing Direction Of(Event Player), Direction Towards(Eye Position(Event Player), Event Player.DialTgt)) >= 0.96)));
					Modify Player Variable(Event Player, DialPin, Add, 1);
					Play Effect(Event Player, Buff Impact Sound, Color(Orange), Event Player.DialTgt, 40);
				End;
				If(Distance Between(Event Player.DialTgt, Event Player.CowPos) < 2.5);
					Set Player Variable(Event Player, DialCur, 99);
					Set Player Variable(Event Player, CowPos, Nearest Walkable Position(Add(Event Player.CowPos, Add(Multiply(Direction Towards(Value In Array(Global Variable(LocPos), 12), Event Player.CowPos), Random Real(15, 20)), Vector(Random Real(-5, 5), 0, Random Real(-5, 5))))));
					Destroy Effect(Event Player.CowFx);
					Create Effect(All Players(All Teams), Sphere, Color(흰색), Event Player.CowPos, 0.7, None);
					Set Player Variable(Event Player, CowFx, Last Created Entity());
					Destroy Icon(Event Player.CowIco);
					Create Icon(All Players(All Teams), Add(Event Player.CowPos, Vector(0, 1.6, 0)), Circle, Visible To and Position, Color(흰색), True);
					Set Player Variable(Event Player, CowIco, Last Created Entity());
					Small Message(Event Player, Custom String("늑대가 소를 물었다 — 소가 멀리 달아났다!"));
					Play Effect(Event Player, Debuff Impact Sound, Color(Red), Event Player.CowPos, 90);
				End;
				Modify Player Variable(Event Player, DialCur, Add, 0.3);
				Wait(0.3, Ignore Condition);
			End;
			Destroy Effect(Event Player.EscortFlash);
			Destroy Icon(Event Player.WolfIco);
			If(Event Player.DialPin >= 3);
				Small Message(Event Player, Custom String("늑대를 쫓아냈다!"));
				Play Effect(Event Player, Buff Impact Sound, Color(Lime Green), Position Of(Event Player), 60);
			End;
		End;
		Wait(2, Ignore Condition);
		Loop If(Event Player.CowOn >= 1);
	}
}

rule("[스킬바 01] DoSkillBar")
{
	event
	{
		Subroutine;
		DoSkillBar;
	}

	action
	{
		Set Player Variable(Event Player, Roll, -1);
		Set Player Variable(Event Player, WorkProg, 0);
		Destroy HUD Text(Event Player.KeyHud);
		Create HUD Text(Event Player, Null, Value In Array(Array(Custom String("◆□□□□□□■■■□□□□□□□"), Custom String("□◆□□□□□■■■□□□□□□□"), Custom String("□□◆□□□□■■■□□□□□□□"), Custom String("□□□◆□□□■■■□□□□□□□"), Custom String("□□□□◆□□■■■□□□□□□□"), Custom String("□□□□□◆□■■■□□□□□□□"), Custom String("□□□□□□◆■■■□□□□□□□"), Custom String("□□□□□□□◆■■□□□□□□□"), Custom String("□□□□□□□■◆■□□□□□□□"), Custom String("□□□□□□□■■◆□□□□□□□"), Custom String("□□□□□□□■■■◆□□□□□□"), Custom String("□□□□□□□■■■□◆□□□□□"), Custom String("□□□□□□□■■■□□◆□□□□"), Custom String("□□□□□□□■■■□□□◆□□□"), Custom String("□□□□□□□■■■□□□□◆□□"), Custom String("□□□□□□□■■■□□□□□◆□"), Custom String("□□□□□□□■■■□□□□□□◆")), Min(16, Max(0, Round To Integer(Event Player.WorkProg, To Nearest)))), Custom String("◆가 ■ 구간에 올 때 [{0}]", Input Binding String(Button(Reload))), Top, 1, Color(흰색), Color(Orange), Color(회색), Visible To Sort Order String and Color, Default Visibility);
		Set Player Variable(Event Player, KeyHud, Last Text ID());
		If(Event Player.Roll == -1);
			Chase Player Variable Over Time(Event Player, WorkProg, 16, 0.72, Destination and Duration);
			Wait Until(Is Button Held(Event Player, Button(Reload)), 0.72);
			If(Is Button Held(Event Player, Button(Reload)));
				Stop Chasing Player Variable(Event Player, WorkProg);
				Set Player Variable(Event Player, Roll, 0);
				If(And(Round To Integer(Event Player.WorkProg, To Nearest) >= 7, Round To Integer(Event Player.WorkProg, To Nearest) <= 9));
					Set Player Variable(Event Player, Roll, 1);
				End;
			End;
		End;
		If(Event Player.Roll == -1);
			Chase Player Variable Over Time(Event Player, WorkProg, 0, 0.72, Destination and Duration);
			Wait Until(Is Button Held(Event Player, Button(Reload)), 0.72);
			If(Is Button Held(Event Player, Button(Reload)));
				Stop Chasing Player Variable(Event Player, WorkProg);
				Set Player Variable(Event Player, Roll, 0);
				If(And(Round To Integer(Event Player.WorkProg, To Nearest) >= 7, Round To Integer(Event Player.WorkProg, To Nearest) <= 9));
					Set Player Variable(Event Player, Roll, 1);
				End;
			End;
		End;
		If(Event Player.Roll == -1);
			Chase Player Variable Over Time(Event Player, WorkProg, 16, 0.72, Destination and Duration);
			Wait Until(Is Button Held(Event Player, Button(Reload)), 0.72);
			If(Is Button Held(Event Player, Button(Reload)));
				Stop Chasing Player Variable(Event Player, WorkProg);
				Set Player Variable(Event Player, Roll, 0);
				If(And(Round To Integer(Event Player.WorkProg, To Nearest) >= 7, Round To Integer(Event Player.WorkProg, To Nearest) <= 9));
					Set Player Variable(Event Player, Roll, 1);
				End;
			End;
		End;
		If(Event Player.Roll == -1);
			Chase Player Variable Over Time(Event Player, WorkProg, 0, 0.72, Destination and Duration);
			Wait Until(Is Button Held(Event Player, Button(Reload)), 0.72);
			If(Is Button Held(Event Player, Button(Reload)));
				Stop Chasing Player Variable(Event Player, WorkProg);
				Set Player Variable(Event Player, Roll, 0);
				If(And(Round To Integer(Event Player.WorkProg, To Nearest) >= 7, Round To Integer(Event Player.WorkProg, To Nearest) <= 9));
					Set Player Variable(Event Player, Roll, 1);
				End;
			End;
		End;
		Stop Chasing Player Variable(Event Player, WorkProg);
		Wait Until(Not(Is Button Held(Event Player, Button(Reload))), 3);
		Destroy HUD Text(Event Player.KeyHud);
		Set Player Variable(Event Player, WorkProg, 0);
		If(Event Player.Roll == -1);
			Set Player Variable(Event Player, Roll, 0);
		End;
	}
}

rule("[금고 01] 마을 금고 — 단계 달성")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(Ready) == 1;
		Global Variable(TownStage) <= 7;
		Global Variable(Fund) >= Value In Array(Array(8000, 23000, 48000, 88000, 148000, 233000, 348000, 498000), Global Variable(TownStage));
	}

	action
	{
		Modify Global Variable(TownStage, Add, 1);
		Big Message(All Players(All Teams), Custom String("마을 금고 {0}/8 — {1}이(가) 세워졌다!!", Global Variable(TownStage), Value In Array(Array(Custom String("마을 우물"), Custom String("전신국"), Custom String("길손의 쉼터"), Custom String("마을 은행"), Custom String("역마차 급행로"), Custom String("오페라 극장"), Custom String("국도 대축제"), Custom String("기차역")), Subtract(Global Variable(TownStage), 1))));
		If(Value In Array(Array(0, 1, 2, 0, 3, 0, 4, 0, 5), Global Variable(TownStage)) > 0);
			Set Player Variable(Filtered Array(All Players(Team 1), Player Variable(Current Array Element, Contrib) >= 1), Rebuild, Value In Array(Array(0, 1, 2, 0, 3, 0, 4, 0, 5), Global Variable(TownStage)));
			Set Global Variable(RebuildMax, Max(Global Variable(RebuildMax), Value In Array(Array(0, 1, 2, 0, 3, 0, 4, 0, 5), Global Variable(TownStage))));
			Small Message(Filtered Array(All Players(Team 1), Player Variable(Current Array Element, Contrib) >= 1), Custom String("재건 기여가 기록됐다 — 네 이름이 마을에 남는다"));
		End;
		If(Global Variable(TownStage) >= 8);
			Big Message(All Players(All Teams), Custom String("기차역이 복원되었다 — 66번 국도가 되살아났다!"));
		End;
		Play Effect(All Players(All Teams), Ring Explosion, Color(Yellow), Value In Array(Global Variable(LocPos), 9), 7);
		Play Effect(All Players(All Teams), Buff Explosion Sound, Color(Yellow), Value In Array(Global Variable(LocPos), 9), 220);
	}
}

rule("[기금 01] 부흥의 불")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(Ready) == 1;
		Global Variable(FundTier) <= 2;
		Global Variable(TownStage) >= Value In Array(Array(3, 5, 7), Global Variable(FundTier));
	}

	action
	{
		Modify Global Variable(FundTier, Add, 1);
		If(Global Variable(FundTier) == 1);
			Create Effect(All Players(All Teams), Sphere, Color(Orange), Add(Nearest Walkable Position(Multiply(Add(Value In Array(Global Variable(LocPos), 0), Value In Array(Global Variable(LocPos), 11)), 0.5)), Vector(0, 0.5, 0)), 0.8, None);
			Create Effect(All Players(All Teams), Light Shaft, Color(Orange), Nearest Walkable Position(Multiply(Add(Value In Array(Global Variable(LocPos), 0), Value In Array(Global Variable(LocPos), 11)), 0.5)), 1.4, None);
			Create In-World Text(All Players(All Teams), Custom String("길손의 쉼터"), Add(Nearest Walkable Position(Multiply(Add(Value In Array(Global Variable(LocPos), 0), Value In Array(Global Variable(LocPos), 11)), 0.5)), Vector(0, 2.4, 0)), 1.3, Do Not Clip, Visible To and Position, Color(Orange), Default Visibility);
			Small Message(All Players(All Teams), Custom String("특전 — 길목의 모닥불에서 몸을 데운다"));
		Else If(Global Variable(FundTier) == 2);
			Small Message(All Players(All Teams), Custom String("특전 — 배달·금괴 호송 보수 +15%"));
		Else;
			Small Message(All Players(All Teams), Custom String("특전 — 오늘의 직업 1.75배 · 밤마다 불꽃놀이 · 아침마다 명성 +1"));
		End;
		Play Effect(All Players(All Teams), Ring Explosion, Color(Orange), Nearest Walkable Position(Multiply(Add(Value In Array(Global Variable(LocPos), 0), Value In Array(Global Variable(LocPos), 11)), 0.5)), 8);
		Play Effect(All Players(All Teams), Buff Explosion Sound, Color(Orange), Nearest Walkable Position(Multiply(Add(Value In Array(Global Variable(LocPos), 0), Value In Array(Global Variable(LocPos), 11)), 0.5)), 250);
		Wait(0.5, Ignore Condition);
	}
}

rule("[기금 02] 모닥불 곁")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Global Variable(FundTier) >= 1;
		Is Alive(Event Player) == True;
		Distance Between(Position Of(Event Player), Nearest Walkable Position(Multiply(Add(Value In Array(Global Variable(LocPos), 0), Value In Array(Global Variable(LocPos), 11)), 0.5))) < 8;
	}

	action
	{
		Wait(10, Ignore Condition);
		If(And(Distance Between(Position Of(Event Player), Nearest Walkable Position(Multiply(Add(Value In Array(Global Variable(LocPos), 0), Value In Array(Global Variable(LocPos), 11)), 0.5))) < 8, Is Alive(Event Player)));
			Set Player Variable(Event Player, Energy, Min(100, Add(Event Player.Energy, 1)));
			Set Player Variable(Event Player, Thirst, Min(100, Add(Event Player.Thirst, 1.5)));
			Play Effect(Event Player, Good Pickup Effect, Color(Orange), Position Of(Event Player), 1);
		End;
		Loop If(Distance Between(Position Of(Event Player), Nearest Walkable Position(Multiply(Add(Value In Array(Global Variable(LocPos), 0), Value In Array(Global Variable(LocPos), 11)), 0.5))) < 8);
	}
}

rule("[기금 03] 축제의 밤")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(FundTier) >= 3;
		Global Variable(IsNight) == 1;
	}

	action
	{
		Play Effect(All Players(All Teams), Ring Explosion, Color(Yellow), Add(Value In Array(Global Variable(LocPos), 0), Vector(Random Real(-10, 10), 14, Random Real(-10, 10))), 7);
		Play Effect(All Players(All Teams), Explosion Sound, Color(Yellow), Value In Array(Global Variable(LocPos), 0), 200);
		Wait(1.2, Ignore Condition);
		Play Effect(All Players(All Teams), Ring Explosion, Color(Yellow), Add(Value In Array(Global Variable(LocPos), 0), Vector(Random Real(-10, 10), 14, Random Real(-10, 10))), 7);
		Play Effect(All Players(All Teams), Explosion Sound, Color(Yellow), Value In Array(Global Variable(LocPos), 0), 200);
		Wait(1.2, Ignore Condition);
		Play Effect(All Players(All Teams), Ring Explosion, Color(Yellow), Add(Value In Array(Global Variable(LocPos), 0), Vector(Random Real(-10, 10), 14, Random Real(-10, 10))), 7);
		Play Effect(All Players(All Teams), Explosion Sound, Color(Yellow), Value In Array(Global Variable(LocPos), 0), 200);
		Wait(1.2, Ignore Condition);
		Big Message(All Players(All Teams), Custom String("국도 대축제의 밤 — 불꽃이 66번 국도를 밝힌다"));
		Wait Until(Global Variable(IsNight) == 0, 99999);
	}
}

rule("[생활 03] 쪼그려 쉬기")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.TutOn == 0;
		Event Player.Busy == 0;
		Is Alive(Event Player) == True;
		Is Crouching(Event Player) == True;
		Is Moving(Event Player) == False;
		Event Player.Energy < 100;
	}

	action
	{
		Small Message(Event Player, Custom String("바닥에 쪼그려 앉아 숨을 고른다 — 느리게 피로가 돌아온다"));
		Wait(1, Ignore Condition);
		If(And(And(Is Crouching(Event Player) == True, Is Moving(Event Player) == False), And(Is Alive(Event Player), Event Player.Busy == 0)));
			Set Player Variable(Event Player, Energy, Min(100, Add(Event Player.Energy, 1)));
			Play Effect(Event Player, Good Pickup Effect, Color(회색), Position Of(Event Player), 0.8);
		End;
		Loop If(And(And(Is Crouching(Event Player) == True, Is Moving(Event Player) == False), And(Is Alive(Event Player), Event Player.Energy < 100)));
	}
}

rule("[목장 03] 이웃의 손길")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.TutOn == 0;
		Event Player.Busy == 0;
		Event Player.Zone == 12;
		Is Alive(Event Player) == True;
		Is Button Held(Event Player, Button(Crouch)) == True;
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	action
	{
		Set Player Variable(Event Player, Target, First Of(Filtered Array(All Players(All Teams), And(Current Array Element != Event Player, And(Player Variable(Current Array Element, RanchEnd) > Total Time Elapsed(), Player Variable(Current Array Element, RanchCare) == 0)))));
		If(Entity Exists(Event Player.Target));
			Set Player Variable(Event Player.Target, RanchCare, 1);
			Modify Player Variable(Event Player, Money, Add, 10);
			Modify Player Variable(Event Player, Earned, Add, 10);
			Set Player Variable(Event Player, Fame, Min(100, Add(Event Player.Fame, 1)));
			Small Message(Event Player, Custom String("{0}의 소에게 물을 줬다 — 품삯 $10 · 명성 +1", Event Player.Target));
			Small Message(Event Player.Target, Custom String("{0}이(가) 내 목장의 소를 돌봐줬다", Event Player));
			Play Effect(Event Player, Buff Impact Sound, Color(Lime Green), Position Of(Event Player), 60);
		Else;
			Small Message(Event Player, Custom String("돌봐줄 이웃의 소가 없다"));
		End;
		Wait(1, Ignore Condition);
	}
}

rule("[감옥 01] 만기 출소")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Event Player.JailOn == 1;
		Total Time Elapsed() >= Event Player.JailEnd;
	}

	action
	{
		Set Player Variable(Event Player, JailOn, 0);
		Clear Status(Event Player, Rooted);
		Clear Status(Event Player, Phased Out);
		Set Primary Fire Enabled(Event Player, True);
		Set Player Variable(Event Player, Busy, 0);
		Set Player Variable(Event Player, Noto, Max(0, Subtract(Event Player.Noto, 20)));
		Big Message(Event Player, Custom String("만기 출소 — 죗값을 치렀다 (악명 -20)"));
		Play Effect(Event Player, Buff Impact Sound, Color(Sky Blue), Position Of(Event Player), 80);
	}
}

rule("[감옥 03] 유치장에서는 손발이 묶인다")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.JailOn == 1;
		Event Player.Busy == 0;
	}

	action
	{
		Set Player Variable(Event Player, Busy, 1);
	}
}

rule("[감옥 02] 벽 부수기 (V 연타)")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Event Player.JailOn == 1;
		Is Button Held(Event Player, Button(Melee)) == True;
	}

	action
	{
		Modify Player Variable(Event Player, WallHP, Subtract, Add(1, Event Player.Pick));
		Play Effect(All Players(All Teams), Ring Explosion, Color(회색), Position Of(Event Player), 1);
		Play Effect(Event Player, Debuff Impact Sound, Color(회색), Position Of(Event Player), 70);
		If(Event Player.WallHP > 0);
			Small Message(Event Player, Custom String("퍽! 벽이 흔들린다 — 내구도 {0}", Event Player.WallHP));
		Else;
			Set Player Variable(Event Player, JailOn, 0);
			Clear Status(Event Player, Rooted);
			Clear Status(Event Player, Phased Out);
			Set Primary Fire Enabled(Event Player, True);
			Set Player Variable(Event Player, Busy, 0);
			Set Player Variable(Event Player, Noto, Min(100, Add(Event Player.Noto, 15)));
			Modify Player Variable(Event Player, Bounty, Add, 100);
			Teleport(Event Player, Nearest Walkable Position(Add(Value In Array(Global Variable(LocPos), 7), Vector(6, 0, 6))));
			Big Message(All Players(All Teams), Custom String("{0} — 유치장 벽을 부수고 탈옥했다!!", Event Player));
			Play Effect(All Players(All Teams), Ring Explosion, Color(Red), Position Of(Event Player), 5);
			Play Effect(All Players(All Teams), Explosion Sound, Color(Red), Position Of(Event Player), 200);
		End;
		Wait(0.25, Ignore Condition);
		Loop If(And(Event Player.JailOn == 1, Is Button Held(Event Player, Button(Melee))));
	}
}

rule("[범죄 02] 살해와 처단")
{
	event
	{
		Player Died;
		All;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Entity Exists(Attacker) == True;
		Attacker != Victim;
		Player Variable(Attacker, Init) == 1;
	}

	action
	{
		If(Player Variable(Victim, Bounty) > 0);
			Set Player Variable(Attacker, KillPay, Min(Player Variable(Victim, Bounty), Player Variable(Victim, Money)));
			Set Player Variable(Victim, Money, Subtract(Player Variable(Victim, Money), Player Variable(Attacker, KillPay)));
			Set Player Variable(Attacker, KillPay, Round To Integer(Multiply(Player Variable(Attacker, KillPay), 0.5), Down));
			Modify Player Variable(Attacker, Money, Add, Player Variable(Attacker, KillPay));
			Modify Player Variable(Attacker, Earned, Add, Player Variable(Attacker, KillPay));
			Set Player Variable(Victim, Bounty, 0);
			Set Player Variable(Attacker, Fame, Min(100, Add(Player Variable(Attacker, Fame), 4)));
			Set Global Variable(TickerMsg, Custom String("{0}이(가) 수배범 {1}을(를) 처단했다 — $ {2}", Attacker, Victim, Player Variable(Attacker, KillPay)));
			Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
			Small Message(Attacker, Custom String("산 채로 데려왔다면 두 배였다"));
			Play Effect(All Players(All Teams), Ring Explosion, Color(Yellow), Position Of(Attacker), 3);
			Play Effect(Attacker, Buff Explosion Sound, Color(Yellow), Position Of(Attacker), 180);
		Else;
			Modify Player Variable(Attacker, Bounty, Add, 120);
			Set Player Variable(Attacker, Noto, Min(100, Add(Player Variable(Attacker, Noto), 20)));
			Set Global Variable(TickerMsg, Custom String("{0}이(가) {1}을(를) 살해했다 — 현상금 $ {2}", Attacker, Victim, Player Variable(Attacker, Bounty)));
			Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
			Play Effect(All Players(All Teams), Ring Explosion, Color(Red), Position Of(Attacker), 3);
			Play Effect(All Players(All Teams), Explosion Sound, Color(Red), Position Of(Attacker), 180);
		End;
	}
}

rule("[범죄 03] 총격 판정 (플레이어)")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Is Alive(Event Player) == True;
		Is Firing Primary(Event Player) == True;
	}

	action
	{
		Set Player Variable(Event Player, ShotTgt, First Of(Sorted Array(Filtered Array(Players Within Radius(Eye Position(Event Player), 45, All Teams, Surfaces), And(And(Current Array Element != Event Player, Has Status(Current Array Element, Phased Out) == False), And(Is Alive(Current Array Element), And(Player Variable(Current Array Element, Init) == 1, Dot Product(Facing Direction Of(Event Player), Direction Towards(Eye Position(Event Player), Eye Position(Current Array Element))) >= 0.995)))), Distance Between(Eye Position(Event Player), Eye Position(Current Array Element)))));
		If(Entity Exists(Event Player.ShotTgt));
			Damage(Event Player.ShotTgt, Event Player, 50);
			Play Effect(All Players(All Teams), Bad Explosion, Color(Red), Eye Position(Event Player.ShotTgt), 0.4);
			Small Message(Event Player.ShotTgt, Custom String("{0}이(가) 당신을 쏘고 있다!", Event Player));
		End;
		Wait(0.5, Ignore Condition);
		Loop If(Is Firing Primary(Event Player));
	}
}

rule("[세이브 01] 숫자 +1 (R)")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.SaveOn == 1;
		Is Button Held(Event Player, Button(Reload)) == True;
	}

	action
	{
		Set Player Variable(Event Player, EntryCur, Modulo(Add(Event Player.EntryCur, 1), 10));
		Play Effect(Event Player, Debuff Impact Sound, Color(흰색), Position Of(Event Player), 40);
	}
}

rule("[세이브 02] 자리 확정 (F)")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.SaveOn == 1;
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	action
	{
		If(Event Player.EntryIdx < 6);
			Set Player Variable(Event Player, EnterA, Add(Multiply(Event Player.EnterA, 10), Event Player.EntryCur));
		Else If(Event Player.EntryIdx < 12);
			Set Player Variable(Event Player, EnterB, Add(Multiply(Event Player.EnterB, 10), Event Player.EntryCur));
		Else;
			Set Player Variable(Event Player, EnterC, Add(Multiply(Event Player.EnterC, 10), Event Player.EntryCur));
		End;
		Modify Player Variable(Event Player, EntryIdx, Add, 1);
		Set Player Variable(Event Player, EntryCur, 0);
		Play Effect(Event Player, Buff Impact Sound, Color(Aqua), Position Of(Event Player), 45);
		If(Event Player.EntryIdx >= 18);
			Set Player Variable(Event Player, SaveOn, 0);
			Destroy HUD Text(Event Player.KeyHud);
			Set Player Variable(Event Player, Busy, 0);
			Set Player Variable(Event Player, Amt, Round To Integer(Divide(Event Player.EnterB, 10), Down));
			Set Player Variable(Event Player, Roll, Round To Integer(Divide(Event Player.EnterC, 10), Down));
			If(Or(Or(Or(Modulo(Event Player.EnterB, 10) != Modulo(Add(Event Player.EnterA, Event Player.Amt), 9), Round To Integer(Divide(Event Player.Amt, 10000), Down) > 6), Or(Modulo(Round To Integer(Divide(Event Player.EnterA, 10), Down), 10) > 4, Modulo(Round To Integer(Divide(Event Player.Amt, 1000), Down), 10) > 1)), Or(Or(Modulo(Event Player.EnterC, 10) != Modulo(Add(Add(Event Player.EnterA, Event Player.EnterB), Event Player.Roll), 9), Round To Integer(Divide(Event Player.EnterC, 100000), Down) > 5), Modulo(Round To Integer(Divide(Event Player.EnterC, 10000), Down), 10) > 5)));
				Big Message(Event Player, Custom String("코드가 맞지 않는다 — 다시 살펴봐라"));
				Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 70);
			Else;
				Set Player Variable(Event Player, Money, Multiply(Round To Integer(Divide(Event Player.EnterA, 100), Down), 100));
				Set Player Variable(Event Player, Pick, Modulo(Round To Integer(Divide(Event Player.EnterA, 10), Down), 10));
				Set Player Variable(Event Player, HasBag, Modulo(Event Player.EnterA, 2));
				Set Player Variable(Event Player, HasHorse, Modulo(Round To Integer(Divide(Modulo(Event Player.EnterA, 10), 2), Down), 2));
				Set Player Variable(Event Player, HasHome, Round To Integer(Divide(Modulo(Event Player.EnterA, 10), 4), Down));
				Set Player Variable(Event Player, Job, Round To Integer(Divide(Event Player.Amt, 10000), Down));
				Set Player Variable(Event Player, Adv, Array(0, 0, 0, 0, 0, 0, 0));
				Set Player Variable At Index(Event Player, Adv, Event Player.Job, Modulo(Round To Integer(Divide(Event Player.Amt, 1000), Down), 10));
				Set Player Variable At Index(Event Player, JobXP, Event Player.Job, Multiply(Modulo(Round To Integer(Divide(Event Player.Amt, 100), Down), 10), 250));
				Set Player Variable(Event Player, Fame, Multiply(Modulo(Round To Integer(Divide(Event Player.Amt, 10), Down), 10), 10));
				Set Player Variable(Event Player, Noto, Multiply(Modulo(Event Player.Amt, 10), 10));
				Set Player Variable(Event Player, LastNoto, Event Player.Noto);
				Set Player Variable(Event Player, Rebuild, Round To Integer(Divide(Event Player.EnterC, 100000), Down));
				Set Global Variable(TownStage, Max(Global Variable(TownStage), Value In Array(Array(0, 1, 2, 4, 6, 8), Event Player.Rebuild)));
				Set Global Variable(Fund, Max(Global Variable(Fund), Value In Array(Array(0, 8000, 23000, 88000, 233000, 498000), Event Player.Rebuild)));
				Set Player Variable(Event Player, Rebirth, Modulo(Round To Integer(Divide(Event Player.EnterC, 10000), Down), 10));
				Set Player Variable(Event Player, Giant, Multiply(Modulo(Round To Integer(Divide(Event Player.EnterC, 1000), Down), 10), 10));
				Set Player Variable(Event Player, Earned, Multiply(Modulo(Event Player.Roll, 100), 2000));
				Set Player Variable(Event Player, DayStart, Event Player.Earned);
				Set Global Variable(RebuildMax, Max(Global Variable(RebuildMax), Event Player.Rebuild));
				If(Event Player.HasHorse == 1);
					Start Forcing Player To Be Hero(Event Player, Hero(시온));
				Else If(Event Player.HasBag == 1);
					Start Forcing Player To Be Hero(Event Player, Hero(트레이서));
				End;
				Big Message(Event Player, Custom String("복원 완료 — 66번 국도에 돌아온 것을 환영합니다"));
				Play Effect(All Players(All Teams), Ring Explosion, Color(Yellow), Position Of(Event Player), 4);
				Play Effect(Event Player, Buff Explosion Sound, Color(Yellow), Position Of(Event Player), 180);
			End;
		End;
		Wait Until(Not(Is Button Held(Event Player, Button(Interact))), 3);
	}
}

rule("[세이브 02-1] 한 칸 지우기 (근접 공격)")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.SaveOn == 1;
		Is Button Held(Event Player, Button(Melee)) == True;
	}

	action
	{
		If(Event Player.EntryIdx > 0);
			Modify Player Variable(Event Player, EntryIdx, Subtract, 1);
			If(Event Player.EntryIdx < 6);
				Set Player Variable(Event Player, EntryCur, Modulo(Event Player.EnterA, 10));
				Set Player Variable(Event Player, EnterA, Round To Integer(Divide(Event Player.EnterA, 10), Down));
			Else If(Event Player.EntryIdx < 12);
				Set Player Variable(Event Player, EntryCur, Modulo(Event Player.EnterB, 10));
				Set Player Variable(Event Player, EnterB, Round To Integer(Divide(Event Player.EnterB, 10), Down));
			Else;
				Set Player Variable(Event Player, EntryCur, Modulo(Event Player.EnterC, 10));
				Set Player Variable(Event Player, EnterC, Round To Integer(Divide(Event Player.EnterC, 10), Down));
			End;
			Small Message(Event Player, Custom String("한 칸 지웠다 — 지운 숫자가 현재 숫자로 돌아왔다"));
			Play Effect(Event Player, Debuff Impact Sound, Color(Orange), Position Of(Event Player), 45);
		Else;
			Small Message(Event Player, Custom String("지울 자리가 없다"));
		End;
		Wait Until(Not(Is Button Held(Event Player, Button(Melee))), 3);
	}
}

rule("[세이브 03] 입력 취소 (웅크리기)")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.SaveOn == 1;
		Is Button Held(Event Player, Button(Crouch)) == True;
	}

	action
	{
		Set Player Variable(Event Player, SaveOn, 0);
		Destroy HUD Text(Event Player.KeyHud);
		Set Player Variable(Event Player, Busy, 0);
		Small Message(Event Player, Custom String("입력을 취소했다"));
	}
}

rule("[세이브 04] 자리 이탈 시 입력 취소")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.SaveOn == 1;
		Event Player.Zone != 9;
	}

	action
	{
		Set Player Variable(Event Player, SaveOn, 0);
		Destroy HUD Text(Event Player.KeyHud);
		Set Player Variable(Event Player, Busy, 0);
		Small Message(Event Player, Custom String("안내소를 벗어나 입력이 취소됐다"));
	}
}

rule("[재건 01] 랜드마크 오브")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(RebuildMax) > Global Variable(RebuildFxN);
	}

	action
	{
		Create Effect(All Players(All Teams), Sphere, Color(Yellow), Add(Value In Array(Global Variable(LocPos), 9), Value In Array(Array(Vector(2.5, 2, 0), Vector(1.2, 2.6, 2.2), Vector(-1.2, 3.2, 2.2), Vector(-2.5, 3.8, 0), Vector(0, 4.6, 1)), Global Variable(RebuildFxN))), 0.4, None);
		Modify Global Variable(RebuildFxN, Add, 1);
		Wait(0.1, Ignore Condition);
		Loop If(Global Variable(RebuildMax) > Global Variable(RebuildFxN));
	}
}

rule("[코어 10] 서버 부하 보호")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Server Load() > 230;
	}

	action
	{
		Wait(2, Abort When False);
		Small Message(All Players(All Teams), Custom String("서버가 버겁다 — 구역 감지를 잠시 늦춘다"));
		Wait Until(Server Load() < 190, 120);
		Small Message(All Players(All Teams), Custom String("서버가 다시 안정됐다"));
	}
}

rule("[생활 02] 사망 처리")
{
	event
	{
		Player Died;
		All;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
	}

	action
	{
		Set Player Variable(Event Player, DeathLoss, Round To Integer(Multiply(Event Player.Money, Event Player.HasHome == 1 ? 0.05 : 0.15), Down));
		If(Event Player.Rebuild >= 3);
			Set Player Variable(Event Player, DeathLoss, Round To Integer(Multiply(Event Player.Money, 0.03), Down));
		End;
		Modify Player Variable(Event Player, Money, Subtract, Event Player.DeathLoss);
		Small Message(Event Player, Custom String("치료비와 분실 — $ {0} 손실", Event Player.DeathLoss));
		Play Effect(Event Player, Debuff Impact Sound, Color(Red), Position Of(Event Player), 80);
		Destroy Progress Bar HUD Text(Event Player.WorkBar);
		Set Player Variable(Event Player, Busy, 0);
		Set Player Variable(Event Player, WorkProg, 0);
		If(Event Player.HasParcel >= 1);
			Set Player Variable(Event Player, HasParcel, 0);
			Destroy Icon(Event Player.DelIcon);
			Small Message(Event Player, Custom String("화물을 잃어버렸다"));
		End;
		If(Event Player.CowOn >= 1);
			Set Player Variable(Event Player, CowOn, 0);
			Destroy Effect(Event Player.CowFx);
			Destroy Icon(Event Player.CowIco);
			Destroy Icon(Event Player.WolfIco);
		End;
		If(Event Player.SaveOn == 1);
			Set Player Variable(Event Player, SaveOn, 0);
			Destroy HUD Text(Event Player.KeyHud);
		End;
		If(Event Player.Sack > 0);
			Set Player Variable(Event Player, Loot, Event Player.Sack);
			Set Player Variable(Event Player, Sack, 0);
			Small Message(Event Player, Custom String("장물 자루를 흘렸다 — $ {0} 소실", Event Player.Loot));
		End;
		If(Event Player.HasPowder == 1);
			Set Player Variable(Event Player, HasPowder, 0);
			Small Message(Event Player, Custom String("품고 있던 화약을 흘렸다"));
		End;
		If(Event Player.Contraband == 1);
			Set Player Variable(Event Player, Contraband, 0);
			Destroy Icon(Event Player.SmuggleIco);
			Small Message(Event Player, Custom String("밀수 화물을 잃었다 — 접선은 없던 일이 됐다"));
		End;
		If(Event Player.Escort == 1);
			Set Player Variable(Event Player, Escort, 0);
			Destroy Icon(Event Player.EscortIco);
			Destroy Effect(Event Player.EscortFx);
			Small Message(Event Player, Custom String("금괴를 잃었다 — 호송은 실패로 끝났다"));
		End;
		If(Event Player.JailOn == 1);
			Set Player Variable(Event Player, JailOn, 0);
			Clear Status(Event Player, Rooted);
			Clear Status(Event Player, Phased Out);
			Set Primary Fire Enabled(Event Player, True);
			Small Message(Event Player, Custom String("유치장에서 쓰러졌다 — 죗값은 치른 셈이 됐다"));
		End;
		Set Player Variable(Event Player, Hunger, Max(Event Player.Hunger, 40));
		Set Player Variable(Event Player, Thirst, Max(Event Player.Thirst, 40));
		Wait Until(Is Alive(Event Player), 40);
		Wait(0.4, Ignore Condition);
		Teleport(Event Player, Value In Array(Global Variable(LocPos), 0));
	}
}

rule("[도파민 01] 길 위의 발견")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Event Player.Zone == -1;
		Is Alive(Event Player) == True;
		Is Moving(Event Player) == True;
	}

	action
	{
		Wait(30, Ignore Condition);
		If(Random Integer(1, 100) <= Add(8, Multiply(Global Variable(IsNight), 6)));
			Set Player Variable(Event Player, Roll, Random Integer(1, 100));
			If(Event Player.Roll <= 55);
				Set Player Variable(Event Player, Loot, Random Integer(15, 45));
				Modify Player Variable(Event Player, Money, Add, Event Player.Loot);
				Modify Player Variable(Event Player, Earned, Add, Event Player.Loot);
				Small Message(Event Player, Custom String("길바닥에서 낡은 지갑을 주웠다 — $ {0}", Event Player.Loot));
			Else If(Event Player.Roll <= 85);
				Set Player Variable At Index(Event Player, Inv, 0, Add(Value In Array(Event Player.Inv, 0), 2));
				Small Message(Event Player, Custom String("버려진 보급품을 찾았다 — 육포 +2"));
			Else;
				Set Player Variable At Index(Event Player, Inv, 2, Add(Value In Array(Event Player.Inv, 2), 6));
				Small Message(Event Player, Custom String("드러난 광맥 조각 — 원석 +6"));
			End;
			Play Effect(Event Player, Good Pickup Effect, Color(Yellow), Position Of(Event Player), 1.5);
		End;
		Loop If(And(Event Player.Zone == -1, Is Alive(Event Player)));
	}
}

rule("[밤 01] 금고 마차 출현")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(Ready) == 1;
	}

	action
	{
		Wait Until(Global Variable(IsNight) == 1, 99999);
		Set Global Variable(WagonPos, Add(Random Value In Array(Global Variable(SpotPos)), Vector(0, 1, 0)));
		Set Global Variable(WagonOn, 1);
		Create Effect(All Players(All Teams), Sphere, Color(Orange), Global Variable(WagonPos), 1.1, Visible To Position Radius and Color);
		Set Global Variable(WagonFx, Last Created Entity());
		Create Icon(All Players(All Teams), Global Variable(WagonPos), Skull, Visible To and Position, Color(Orange), True);
		Set Global Variable(WagonIco, Last Created Entity());
		Big Message(All Players(All Teams), Custom String("금고 마차가 어둠 속 어딘가에 멈춰 섰다"));
		Small Message(All Players(All Teams), Custom String("[F] 5초 — 터는 자는 돈과 악명을 얻는다"));
		Play Effect(All Players(All Teams), Ring Explosion, Color(Orange), Global Variable(WagonPos), 3);
		Wait Until(Or(Global Variable(WagonOn) == 0, Global Variable(IsNight) == 0), 400);
		If(Global Variable(WagonOn) == 1);
			Set Global Variable(WagonOn, 0);
			Destroy Effect(Global Variable(WagonFx));
			Destroy Icon(Global Variable(WagonIco));
			Small Message(All Players(All Teams), Custom String("금고 마차가 아무 일 없이 떠났다"));
		End;
		Wait Until(Global Variable(IsNight) == 0, 99999);
		Loop();
	}
}

rule("[밤 02] 금고 마차 털기 (F 5초)")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Busy == 0;
		Global Variable(ArchOn) == 0;
		Global Variable(WagonOn) == 1;
		Is Alive(Event Player) == True;
		Distance Between(Position Of(Event Player), Global Variable(WagonPos)) < 4;
		Is Button Held(Event Player, Button(Crouch)) == False;
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	action
	{
		Set Player Variable(Event Player, Busy, 1);
		Set Player Variable(Event Player, WorkProg, 0);
		Destroy Progress Bar HUD Text(Event Player.WorkBar);
		Small Message(All Players(All Teams), Custom String("누군가 금고 마차에 손을 댔다!"));
		Create Progress Bar HUD Text(Event Player, Event Player.WorkProg, Custom String("금고를 터는 중..."), Top, 0, Color(Orange), Color(흰색), Visible To Values and Color, Default Visibility);
		Set Player Variable(Event Player, WorkBar, Last Text ID());
		Chase Player Variable Over Time(Event Player, WorkProg, 100, 5, Destination and Duration);
		Wait Until(Or(Or(Distance Between(Position Of(Event Player), Global Variable(WagonPos)) > 6, Not(Is Alive(Event Player))), Event Player.WorkProg >= 99), 5.5);
		Stop Chasing Player Variable(Event Player, WorkProg);
		Destroy Progress Bar HUD Text(Event Player.WorkBar);
		If(Or(Or(Distance Between(Position Of(Event Player), Global Variable(WagonPos)) > 6, Not(Is Alive(Event Player))), Event Player.WorkProg < 99));
			Small Message(Event Player, Custom String("손을 뗐다"));
		Else If(Global Variable(WagonOn) == 0);
			Small Message(Event Player, Custom String("한발 늦었다 — 금고가 비어 있다"));
		Else;
			Set Global Variable(WagonOn, 0);
			Destroy Effect(Global Variable(WagonFx));
			Destroy Icon(Global Variable(WagonIco));
			Set Player Variable(Event Player, Loot, Random Integer(250, 450));
			Modify Player Variable(Event Player, Money, Add, Event Player.Loot);
			Modify Player Variable(Event Player, Earned, Add, Event Player.Loot);
			Set Player Variable(Event Player, Noto, Min(100, Add(Event Player.Noto, 10)));
			Set Global Variable(TickerMsg, Custom String("{0}이(가) 금고 마차를 털었다! (+$ {1}, 악명 +10)", Event Player, Event Player.Loot));
			Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
			Play Effect(All Players(All Teams), Ring Explosion, Color(Orange), Position Of(Event Player), 4);
			Play Effect(All Players(All Teams), Explosion Sound, Color(Orange), Position Of(Event Player), 180);
		End;
		Set Player Variable(Event Player, Busy, 0);
	}
}

rule("[도파민 02] 보물 상자 출현")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(Ready) == 1;
	}

	action
	{
		Wait(Random Integer(240, 420), Ignore Condition);
		Set Global Variable(TreasurePos, Add(Random Value In Array(Global Variable(SpotPos)), Vector(0, 1, 0)));
		Set Global Variable(TreasureOn, 1);
		Create Effect(All Players(All Teams), Sphere, Color(Yellow), Global Variable(TreasurePos), 1.2, Visible To Position Radius and Color);
		Set Global Variable(TreasureFx, Last Created Entity());
		Create Icon(All Players(All Teams), Global Variable(TreasurePos), Diamond, Visible To and Position, Color(Yellow), True);
		Set Global Variable(TreasureIco, Last Created Entity());
		Big Message(All Players(All Teams), Custom String("어딘가에 보물 상자가 떨어졌다 — 먼저 닿는 사람이 임자"));
		Play Effect(All Players(All Teams), Buff Explosion Sound, Color(Yellow), Global Variable(TreasurePos), 200);
		Wait Until(Global Variable(TreasureOn) == 0, 90);
		Set Global Variable(TreasureOn, 0);
		Destroy Effect(Global Variable(TreasureFx));
		Destroy Icon(Global Variable(TreasureIco));
		Loop();
	}
}

rule("[도파민 03] 보물 획득")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Event Player.TutOn == 0;
		Global Variable(TreasureOn) == 1;
		Is Alive(Event Player) == True;
		Distance Between(Position Of(Event Player), Global Variable(TreasurePos)) <= 3;
	}

	action
	{
		If(Global Variable(TreasureOn) == 0);
			Abort;
		End;
		Set Global Variable(TreasureOn, 0);
		Set Player Variable(Event Player, Prize, Random Integer(150, 350));
		Modify Player Variable(Event Player, Money, Add, Event Player.Prize);
		Modify Player Variable(Event Player, Earned, Add, Event Player.Prize);
		Set Global Variable(TickerMsg, Custom String("{0} — 보물 상자를 차지했다!  $ {1}", Event Player, Event Player.Prize));
		Set Global Variable(TickerEnd, Add(Total Time Elapsed(), 3));
		Play Effect(All Players(All Teams), Ring Explosion, Color(Yellow), Position Of(Event Player), 4);
	}
}

rule("[이벤트 01] 주기적 사건 발생")
{
	event
	{
		Ongoing - Global;
	}

	condition
	{
		Global Variable(Ready) == 1;
	}

	action
	{
		Wait(Random Integer(190, 330), Ignore Condition);
		Small Message(Filtered Array(All Players(All Teams), Player Variable(Current Array Element, Rebuild) >= 2), Custom String("전신국 타전 — 곧 무슨 일이 벌어진다"));
		Play Effect(Filtered Array(All Players(All Teams), Player Variable(Current Array Element, Rebuild) >= 2), Buff Impact Sound, Color(Yellow), Vector(0, 0, 0), 9999);
		Wait(30, Ignore Condition);
		Call Subroutine(RollEvent);
		Loop();
	}
}

rule("[이벤트 02] RollEvent")
{
	event
	{
		Subroutine;
		RollEvent;
	}

	action
	{
		Set Global Variable(EventKind, Random Integer(1, 6));
		If(Global Variable(EventKind) == 1);
			Big Message(All Players(All Teams), Custom String("금맥 소동! 90초 동안 채굴 수확 2배"));
		Else If(Global Variable(EventKind) == 2);
			Big Message(All Players(All Teams), Custom String("모래폭풍! 갈증이 빠르게 오른다"));
		Else If(Global Variable(EventKind) == 3);
			Big Message(All Players(All Teams), Custom String("야수 광란! 90초 동안 야수 가죽이 2배로 벗겨진다"));
		Else If(Global Variable(EventKind) == 4);
			Set Global Variable(SellMult, 2);
			Big Message(All Players(All Teams), Custom String("역마차 도착! 90초 동안 원석·가죽이 두 배 값에 팔린다"));
		Else If(Global Variable(EventKind) == 5);
			Set Global Variable(Tmp, Random Value In Array(Filtered Array(All Players(All Teams), And(Player Variable(Current Array Element, Init) == 1, Player Variable(Current Array Element, TutOn) == 0))));
			If(Entity Exists(Global Variable(Tmp)));
				Modify Player Variable(Global Variable(Tmp), Bounty, Add, 300);
				Big Message(All Players(All Teams), Custom String("{0}에게 누명이 씌워졌다 — 현상금 $300", Global Variable(Tmp)));
				Small Message(Global Variable(Tmp), Custom String("억울하지만 쫓기게 됐다. 보안관 초소에서 벌금을 내면 지워진다"));
				Play Effect(Global Variable(Tmp), Explosion Sound, Color(Red), Position Of(Global Variable(Tmp)), 170);
			End;
		Else;
			Big Message(All Players(All Teams), Custom String("금광이 무너진다! 채굴 수확 3배, 대신 다칠 각오를 해라"));
		End;
		Wait(90, Ignore Condition);
		Set Global Variable(EventKind, 0);
		Set Global Variable(SellMult, 1);
		Small Message(All Players(All Teams), Custom String("소동이 가라앉았다"));
	}
}

rule("[이벤트 04] 사건 알림")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Global Variable(EventKind) != 0;
	}

	action
	{
		Play Effect(Event Player, Ring Explosion Sound, Color(Yellow), Position Of(Event Player), 200);
		Play Effect(Event Player, Ring Explosion, Color(Yellow), Position Of(Event Player), 2.5);
		Wait Until(Global Variable(EventKind) == 0, 200);
		Play Effect(Event Player, Debuff Impact Sound, Color(회색), Position Of(Event Player), 60);
	}
}

rule("[이벤트 03] 모래폭풍 효과")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Global Variable(EventKind) == 2;
	}

	action
	{
		Wait(6, Ignore Condition);
		Set Player Variable(Event Player, Thirst, Max(0, Subtract(Event Player.Thirst, 3)));
		Play Effect(Event Player, Bad Pickup Effect, Color(Orange), Position Of(Event Player), 1);
		Loop If(Global Variable(EventKind) == 2);
	}
}
