		Create In-World Text(All Players(All Teams), Custom String("역마차 정거장"), Add(Value In Array(Global Variable(LocPos), 11), Vector(0, 2.6, 0)), 1.7, Do Not Clip, Visible To and Position, Color(Yellow), Default Visibility);
		Create In-World Text(And(Distance Between(Local Player, Value In Array(Global Variable(LocPos), 11)) < 13, Local Player.TutOn == 0) ? Local Player : False, Custom String("{0}{1}", Custom String("{0}{1}", Custom String("화물을 받아 찍힌 곳까지 달려라 — 도착하면 자동 정산\r\n보수는 거리만큼 · 화물을 든 채 털리면 빼앗긴다\r\n배달 완료 — 허기 2 · 갈증 3 · 피로 4\r\n금괴 호송 — 수배 없는 자만 · 질주 불가 · 악명 높"), Custom String("은 자들이 노린다\r\n가축 출하 — 목장에서 기른 소, 마리당 $48\r\n새 출발의 기차 — 재건을 마친 자는 전 재산을 두고 다시 태어난다\r\n마을 금고 — $1000씩 보태 우물부터 기차역까지 여덟 걸음\r\n")), Custom String("[{0}] 행동 선택      [{1}] 실행", Input Binding String(Button(Reload)), Input Binding String(Button(Interact)))), Add(Value In Array(Global Variable(LocPos), 11), Vector(0, 1.5, 0)), 0.95, Do Not Clip, Visible To Position and String, Color(흰색), Default Visibility);
		Create In-World Text(All Players(All Teams), Custom String("목장"), Add(Value In Array(Global Variable(LocPos), 12), Vector(0, 2.6, 0)), 1.7, Do Not Clip, Visible To and Position, Color(Yellow), Default Visibility);
		Create In-World Text(And(Distance Between(Local Player, Value In Array(Global Variable(LocPos), 12)) < 13, Local Player.TutOn == 0) ? Local Player : False, Custom String("{0}{1}", Custom String("{0}{1}", Custom String("벌판의 소를 몸으로 밀어 우리 안까지 몰아넣어라\r\n소는 네가 다가간 반대쪽으로 밀린다 · 360초 제한\r\n몰이 성공 — 허기 3 · 갈증 2.5 · 피로 5\r\n내 목장 $2000 (명성 30) — 물통 2·육포 1이"), Custom String(" 하루 만에 소가 된다\r\n")), Custom String("[{0}] 행동 선택      [{1}] 실행", Input Binding String(Button(Reload)), Input Binding String(Button(Interact)))), Add(Value In Array(Global Variable(LocPos), 12), Vector(0, 1.5, 0)), 0.95, Do Not Clip, Visible To Position and String, Color(흰색), Default Visibility);
		Create In-World Text(All Players(All Teams), Custom String("식당 2호점"), Add(Value In Array(Global Variable(LocPos), 13), Vector(0, 2.6, 0)), 1.7, Do Not Clip, Visible To and Position, Color(Yellow), Default Visibility);
		Create In-World Text(And(Distance Between(Local Player, Value In Array(Global Variable(LocPos), 13)) < 13, Local Player.TutOn == 0) ? Local Player : False, Custom String("{0}{1}", Custom String("따뜻한 식사 $36 — 허기와 갈증을 한 번에 채운다\r\n본점 주인이 자릿세를 걷는다\r\n"), Custom String("[{0}] 실행", Input Binding String(Button(Interact)))), Add(Value In Array(Global Variable(LocPos), 13), Vector(0, 1.5, 0)), 0.95, Do Not Clip, Visible To Position and String, Color(흰색), Default Visibility);
		Create In-World Text(All Players(All Teams), Custom String("식당 3호점"), Add(Value In Array(Global Variable(LocPos), 14), Vector(0, 2.6, 0)), 1.7, Do Not Clip, Visible To and Position, Color(Yellow), Default Visibility);
		Create In-World Text(And(Distance Between(Local Player, Value In Array(Global Variable(LocPos), 14)) < 13, Local Player.TutOn == 0) ? Local Player : False, Custom String("{0}{1}", Custom String("따뜻한 식사 $36 — 허기와 갈증을 한 번에 채운다\r\n본점 주인이 자릿세를 걷는다\r\n"), Custom String("[{0}] 실행", Input Binding String(Button(Interact)))), Add(Value In Array(Global Variable(LocPos), 14), Vector(0, 1.5, 0)), 0.95, Do Not Clip, Visible To Position and String, Color(흰색), Default Visibility);
		Create Dummy Bot(Hero(제트팩 캣), Team 2, 0, Nearest Walkable Position(Add(Value In Array(Global Variable(LocPos), 6), Vector(Random Real(-7, 7), 0, Random Real(-7, 7)))), Vector(1, 0, 0));
		Wait(0.25, Ignore Condition);
		Create Dummy Bot(Hero(제트팩 캣), Team 2, 1, Nearest Walkable Position(Add(Value In Array(Global Variable(LocPos), 6), Vector(Random Real(-7, 7), 0, Random Real(-7, 7)))), Vector(1, 0, 0));
		Wait(0.25, Ignore Condition);
		Create Dummy Bot(Hero(제트팩 캣), Team 2, 2, Nearest Walkable Position(Add(Value In Array(Global Variable(LocPos), 6), Vector(Random Real(-7, 7), 0, Random Real(-7, 7)))), Vector(1, 0, 0));
		Wait(0.25, Ignore Condition);
	}
}
rule("[코어 03] 플레이어 최초 설정")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Global Variable(Ready) == 1;
		Is Dummy Bot(Event Player) == False;
		Event Player.Init != 1;
	}

	action
	{
		Call Subroutine(SetupPlayer);
	}
}

rule("[좌표 00] PickSpot — 검증된 지점 뽑기")
{
	event
	{
		Subroutine;
		PickSpot;
	}

	action
	{
		Set Global Variable(PickIdx, Random Integer(0, Subtract(Count Of(Global Variable(SpotPos)), 1)));
		Set Global Variable(PickPos, Value In Array(Global Variable(SpotPos), Global Variable(PickIdx)));
		Set Global Variable(PickN, 0);
		While(And(Global Variable(PickN) < Count Of(Global Variable(SpotPos)), Or(Distance Between(Global Variable(PickPos), Global Variable(PickRef)) < Global Variable(PickMin), Distance Between(Global Variable(PickPos), Global Variable(PickRef)) > Global Variable(PickMax))));
			Set Global Variable(PickIdx, Modulo(Add(Global Variable(PickIdx), 1), Count Of(Global Variable(SpotPos))));
			Set Global Variable(PickPos, Value In Array(Global Variable(SpotPos), Global Variable(PickIdx)));
			Modify Global Variable(PickN, Add, 1);
		End;
	}
}

rule("[코어 04] SetupPlayer")
{
	event
	{
		Subroutine;
		SetupPlayer;
	}

	action
	{
		Set Player Variable(Event Player, Init, 1);
		Set Player Variable(Event Player, Sprinting, 0);
		Set Player Variable(Event Player, ZoneDist, 9999);
		If(Team Of(Event Player) != Team 1);
			Move Player to Team(Event Player, Team 1, -1);
			Wait(1, Ignore Condition);
		End;
		Set Player Variable(Event Player, Money, 60);
		Set Player Variable(Event Player, Hunger, 100);
		Set Player Variable(Event Player, Thirst, 100);
		Set Player Variable(Event Player, Energy, 100);
		Set Player Variable(Event Player, Job, 0);
		Set Player Variable(Event Player, Adv, Array(0, 0, 0, 0, 0, 0, 0));
		Set Player Variable(Event Player, JobXP, Array(0, 0, 0, 0, 0, 0, 0));
		Set Player Variable(Event Player, HasParcel, 0);
		Set Player Variable(Event Player, DelDest, -1);
		Set Player Variable(Event Player, CowOn, 0);
		Set Player Variable(Event Player, Plan, 0);
		Set Player Variable(Event Player, Fame, 0);
		Set Player Variable(Event Player, Noto, 0);
		Set Player Variable(Event Player, TaxSeenRound, 0);
		Set Player Variable(Event Player, TaxPaidRound, 0);
		Set Player Variable(Event Player, SaveOn, 0);
		Set Player Variable(Event Player, JailOn, 0);
		Set Player Variable(Event Player, Bounty, 0);
		Set Player Variable(Event Player, Zone, -1);
		Set Player Variable(Event Player, MenuIdx, 0);
		Set Player Variable(Event Player, Inv, Array(2, 2, 0, 0, 0));
		Set Player Variable(Event Player, Busy, 0);
		Set Player Variable(Event Player, WorkProg, 0);
		Set Player Variable(Event Player, Streak, 0);
		Set Player Variable(Event Player, Earned, 0);
		Set Player Variable(Event Player, MineCount, 0);
		Set Player Variable(Event Player, Pick, 0);
		Set Player Variable(Event Player, LastDay, -1);
		Set Player Variable(Event Player, HasBag, 0);
		Set Player Variable(Event Player, HasHorse, 0);
		Set Player Variable(Event Player, HasHome, 0);
		Set Player Variable(Event Player, Prospect, 0);
		Set Player Variable(Event Player, Target, Null);
		Set Player Allowed Heroes(Event Player, Array(Hero(캐서디), Hero(애쉬)));
		Set Respawn Max Time(Event Player, 4);
		Disable Game Mode HUD(Event Player);
		Disable Game Mode In-World UI(Event Player);
		Disable Hero HUD(Event Player);
		Create In-World Text(All Players(All Teams), Custom String("{0}\r\n{1}", Custom String("『 {0} 』 {1}", Event Player.Bounty > 0 ? Custom String("수배 중") : Custom String("{0}", Event Player.Rebirth >= 1 ? Value In Array(Array(Custom String("환생자"), Custom String("환생자"), Custom String("불사조"), Custom String("불사조"), Custom String("66번 국도의 전설")), Subtract(Min(5, Event Player.Rebirth), 1)) : Custom String("{0}", Event Player.Rebuild >= 5 ? Custom String("66번 국도의 재건자") : Value In Array(Array(Custom String("떠돌이"), Custom String("일꾼"), Custom String("정착민"), Custom String("유지"), Custom String("거상"), Custom String("66번 국도의 주인")), Add(Add(Add(Add(Event Player.Earned >= 1000, Event Player.Earned >= 5000), Event Player.Earned >= 20000), Event Player.Earned >= 60000), Event Player.Earned >= 150000)))), Event Player), Custom String("{0} Lv.{1}   {2}", Value In Array(Event Player.Adv, Event Player.Job) == 1 ? Value In Array(Array(Custom String("뜨내기"), Custom String("광산주"), Custom String("맹수 사냥꾼"), Custom String("보안관"), Custom String("갱단 두목"), Custom String("역마차장"), Custom String("목장주")), Event Player.Job) : Value In Array(Array(Custom String("뜨내기"), Custom String("광부"), Custom String("사냥꾼"), Custom String("현상금 사냥꾼"), Custom String("무법자"), Custom String("파발꾼"), Custom String("목동")), Event Player.Job), Add(1, Round To Integer(Divide(Value In Array(Event Player.JobXP, Event Player.Job), 250), Down)), Custom String("명성 {0} · 악명 {1}{2}", Event Player.Fame, Event Player.Noto, Event Player.Giant >= 10 ? Custom String(" · ★{0}", Round To Integer(Divide(Event Player.Giant, 10), Down)) : Custom String("")))), Event Player, 1, Clip Against Surfaces, Visible To Position String and Color, Event Player.Bounty > 0 ? Color(Red) : Color(흰색), Default Visibility);
		Set Player Variable(Event Player, NameId, Last Text ID());
		Set Player Variable(Event Player, NameSig, Add(Multiply(Add(Add(Add(Add(Event Player.Earned >= 1000, Event Player.Earned >= 5000), Event Player.Earned >= 20000), Event Player.Earned >= 60000), Event Player.Earned >= 150000), 2), Event Player.Bounty > 0));
	}
}

rule("[코어 14] 스폰 즉시 식당으로")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Count Of(Global Variable(LocPos)) > 0;
		Has Spawned(Event Player) == True;
		Is Alive(Event Player) == True;
	}

	action
	{
		Disable Game Mode HUD(Event Player);
		Disable Game Mode In-World UI(Event Player);
		Disable Hero HUD(Event Player);
		Teleport(Event Player, Value In Array(Global Variable(LocPos), 0));
	}
}

rule("[코어 11] 떠난 자의 흔적 정리")
{
	event
	{
		Player Left Match;
		All;
		All;
	}

	action
	{
		Destroy In-World Text(Event Player.NameId);
		Destroy HUD Text(Event Player.KeyHud);
		Destroy HUD Text(Event Player.SaveHud);
		Destroy HUD Text(Event Player.TutHud);
		Destroy Progress Bar HUD Text(Event Player.WorkBar);
		Destroy Icon(Event Player.DelIcon);
		Destroy Icon(Event Player.SmuggleIco);
		Destroy Icon(Event Player.SmuggleFlash);
		Destroy Icon(Event Player.EscortIco);
		Destroy Icon(Event Player.CowIco);
		Destroy Icon(Event Player.WolfIco);
		Destroy Icon(Event Player.DialCur);
		Destroy Icon(Event Player.DialPin);
		Destroy Icon(Event Player.EscortFlash);
		Destroy Effect(Event Player.EscortFlash);
		Destroy Effect(Event Player.EscortFx);
		Destroy Effect(Event Player.CowFx);
	}
}

rule("[코어 15] 머리 위 이름표 갱신")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Event Player.Init == 1;
		Add(Multiply(Add(Add(Add(Add(Event Player.Earned >= 1000, Event Player.Earned >= 5000), Event Player.Earned >= 20000), Event Player.Earned >= 60000), Event Player.Earned >= 150000), 2), Event Player.Bounty > 0) != Event Player.NameSig;
	}

	action
	{
		Set Player Variable(Event Player, NameSig, Add(Multiply(Add(Add(Add(Add(Event Player.Earned >= 1000, Event Player.Earned >= 5000), Event Player.Earned >= 20000), Event Player.Earned >= 60000), Event Player.Earned >= 150000), 2), Event Player.Bounty > 0));
		Destroy In-World Text(Event Player.NameId);
		Create In-World Text(All Players(All Teams), Custom String("{0}\r\n{1}", Custom String("『 {0} 』 {1}", Event Player.Bounty > 0 ? Custom String("수배 중") : Custom String("{0}", Event Player.Rebirth >= 1 ? Value In Array(Array(Custom String("환생자"), Custom String("환생자"), Custom String("불사조"), Custom String("불사조"), Custom String("66번 국도의 전설")), Subtract(Min(5, Event Player.Rebirth), 1)) : Custom String("{0}", Event Player.Rebuild >= 5 ? Custom String("66번 국도의 재건자") : Value In Array(Array(Custom String("떠돌이"), Custom String("일꾼"), Custom String("정착민"), Custom String("유지"), Custom String("거상"), Custom String("66번 국도의 주인")), Add(Add(Add(Add(Event Player.Earned >= 1000, Event Player.Earned >= 5000), Event Player.Earned >= 20000), Event Player.Earned >= 60000), Event Player.Earned >= 150000)))), Event Player), Custom String("{0} Lv.{1}   {2}", Value In Array(Event Player.Adv, Event Player.Job) == 1 ? Value In Array(Array(Custom String("뜨내기"), Custom String("광산주"), Custom String("맹수 사냥꾼"), Custom String("보안관"), Custom String("갱단 두목"), Custom String("역마차장"), Custom String("목장주")), Event Player.Job) : Value In Array(Array(Custom String("뜨내기"), Custom String("광부"), Custom String("사냥꾼"), Custom String("현상금 사냥꾼"), Custom String("무법자"), Custom String("파발꾼"), Custom String("목동")), Event Player.Job), Add(1, Round To Integer(Divide(Value In Array(Event Player.JobXP, Event Player.Job), 250), Down)), Custom String("명성 {0} · 악명 {1}{2}", Event Player.Fame, Event Player.Noto, Event Player.Giant >= 10 ? Custom String(" · ★{0}", Round To Integer(Divide(Event Player.Giant, 10), Down)) : Custom String("")))), Event Player, 1, Clip Against Surfaces, Visible To Position String and Color, Event Player.Bounty > 0 ? Color(Red) : Color(흰색), Default Visibility);
		Set Player Variable(Event Player, NameId, Last Text ID());
