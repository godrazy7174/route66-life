}

rule("[튜토리얼 01] DoTutorial")
{
	event
	{
		Subroutine;
		DoTutorial;
	}

	action
	{
		Set Player Variable(Event Player, TutOn, 1);
		Set Player Variable(Event Player, Busy, 1);
		Set Status(Event Player, Null, Rooted, 9999);
		Set Status(Event Player, Null, Phased Out, 9999);
		Set Invisible(Event Player, All);
		Set Player Variable(Event Player, TutSkip, 0);
		Set Player Variable(Event Player, TutStep, 0);
		Destroy HUD Text(Event Player.TutHud);
		Create HUD Text(Event Player, Value In Array(Array(Custom String("66번 국도"), Custom String("굶주림과 목마름"), Custom String("피로"), Custom String("직업"), Custom String("광부"), Custom String("사냥꾼"), Custom String("무법자"), Custom String("현상금 사냥꾼"), Custom String("파발꾼"), Custom String("목동"), Custom String("돈으로 바꾸기"), Custom String("장비"), Custom String("하루와 밤"), Custom String("사건"), Custom String("사흘의 리듬"), Custom String("두 갈래 큰 길"), Custom String("긴 여정"), Custom String("시작")), Min(17, Event Player.TutStep)), Value In Array(Array(Custom String("이기는 게임이 아니다. 서부에서 하루하루를 버티고, 자기 삶을 쌓아 올리는 게임이다."), Custom String("허기와 갈증은 쉬지 않고 줄어든다. 육포는 [E], 물은 [Q] — 하지만 요기일 뿐이다.\r\n제대로 채우려면 식당에서 한 끼를 먹어라. 0이 되면 피를 흘린다."), Custom String("피로가 바닥나면 아무 일도 할 수 없다.\r\n하룻밤 $90에 피로를 40 되찾는다. 내 방을 마련하면 80으로 늘어난다.\r\n빈털터리라면 쪼그려 앉아 숨을 골라라 — 느리지만 공짜다."), Custom String("{0}{1}", Custom String("광부 · 사냥꾼 · 현상금 사냥꾼 · 파발꾼 · 목동 · 무법자 — 여섯 갈래 인생.\r\n"), Custom String("일을 하는 순간 그 직업이 된다. 경험과 승급은 직업마다 따로 남는다.\r\n어느 일이든 손만 놀려서는 벌이가 시원찮다 — 저마다 요령이 따로 있다.\r\n매일 아침 '오늘의 직업'이 뽑힌다 — 그날 그 직업은 보수 1.5배.")), Custom String("곡괭이질은 박자다 — ◆가 ■에 올 때 [R]이 정타.\r\n헛치면 연속이 끊기고 수확도 절반, 한가운데는 원석이 덤.\r\n광산이 부글거리면 손을 멈춰라 — 가스에 휘두르면 다친다."), Custom String("야수는 숨어 있어 흔적을 쫓아야 모습을 드러낸다.\r\n드러난 50초 안에 좌클릭으로 직접 맞혀야 한다.\r\n몸에 붉은 급소가 번뜩이는 순간이 온다 — 그때 맞히면 피해가 네 배다."), Custom String("{0}{1}", Custom String("강탈과 습격으로 크게 번다. 대신 그만큼 목에 값이 붙는다.\r\n은신처에서 습격을 꾸미면 역마차가 정거장을 떠난다 — 쫓아가 곁에 붙어 있어야 턴다.\r\n"), Custom String("목값 $300이면 전단이 돌고, $800이면 마을이 문을 걸어 잠근다.\r\n습격의 장물은 자루에 담긴다 — 은신처에서 정산하고, 진 채로 죽으면 흘린다.")), Custom String("배지 조건 — 명성 30 이상, 악명 20 이하.\r\n전단이 붙은 자($300+)를 쏴서 제압하고 수갑을 채운다. 산 채로 잡으면 전액, 죽이면 절반.\r\n배지를 달면 프레야가 되어 발이 빨라진다."), Custom String("화물을 받아 찍힌 곳까지 달린다 — 멀수록 크게 번다.\r\n이따금 값진 화물이 걸린다 — 2.5배지만 그림자 강도가 붙는다. 세 발로 떨쳐내라.\r\n편지가 딸려오면 건네고, 급행이 걸리면 달려라."), Custom String("소를 몸으로 밀어 우리까지 몰아넣는다 — 다가간 반대쪽으로 도망친다.\r\n소가 성나면 고삐를 잡아라 — 놓치면 삯이 절반.\r\n늑대는 쫓아내야 삯이 나오고, 총소리에도 소는 달아난다."), Custom String("캔 원석과 잡은 가죽은 여기서 현금이 된다. 시세는 매일 아침 바뀌니 값을 보고 팔아라.\r\n명성은 값을 깎아주고, 악명은 바가지를 부른다.\r\n죄를 지으면 명성이 깎인다 — 평판은 쌓기 더디고 잃기 쉽다."), Custom String("곡괭이를 벼리면 캘 때마다 더 나오고, 말을 사면 바이크를 몬다.\r\n번 돈은 결국 여기로 돌아온다.\r\n건물 앞에서 [Ctrl+F] — 통째로 사서 임대료를 걷는 길도 있다."), Custom String("12분이 하루다. 밤이 오면 마을의 불이 꺼지고 길 위의 행운이 늘어난다.\r\n하루 목표를 채우면 보너스가 붙는다.\r\n이틀에 한 번, 아침이면 징수원이 재산세를 걷으러 온다."), Custom String("몇 분에 한 번씩 세상에 일이 생긴다. 금맥 소동, 모래폭풍, 역마차 도착, 누명.\r\n쥐떼가 몰려오면 사람부터 문다 — 셋은 붙어야 하고, 사냥 솜씨가 있으면 더 낫다.\r\n보물 상자가 떨어지면 먼저 닿는 사람이 임자다."), Custom String("{0}{1}", Custom String("밤마다 금고 마차가 어둠 속 어딘가에 멈춘다 — 먼저 터는 자가 임자, 대신 악명이 붙는다.\r\n"), Custom String("사흘에 한 번 저녁이면 열차가 선다 — 대장간의 화약 $200이 금고를 연다.\r\n그다음 날 아침엔 대야수의 흔적이 나타난다 — 함께 쫓고, 기여한 만큼 나눈다.")), Custom String("{0}{1}", Custom String("명성 30이면 목장에서 소를 치고, 악명 30이면 뒷골목에서 밀주를 담근다.\r\n"), Custom String("은신처의 밀수, 정거장의 금괴 호송 — 나르는 동안 질주할 수 없고, 죽거나 털리면 끝이다.\r\n금괴를 나르는 길목에는 매복이 깔린다. 마을 은행이 서면(금고 4단계) 밤의 은행이 간 큰 자를 기다린다.")), Custom String("마을 금고에 $1,000씩 보태라 — 우물부터 기차역까지 여덟 걸음.\r\n한 번이라도 보탠 사람은 다음 판에도 그 단계에서 시작한다.\r\n떠나기 전엔 세이브 코드를 받아라."), Custom String("{0}{1}", Custom String("[R] 행동 선택 · [F] 실행 · [E] 육포 · [Q] 물 · [Shift] 달리기 · [{0}] 강도/체포\r\n가진 건 $60과 육포 둘, 물 둘. 어디서 무엇으로 살아갈지는 네가 정한다.\r\n", Input Binding String(Button(Melee))), Custom String("궁금하거나 막히는 것이 있다면 공식 위키를 찾아봐라."))), Min(17, Event Player.TutStep)), Custom String("[{0}] 다음      ({1}/18)", Input Binding String(Button(Jump)), Add(Event Player.TutStep, 1)), Top, 0, Color(흰색), Color(흰색), Color(흰색), Visible To Sort Order String and Color, Default Visibility);
		Set Player Variable(Event Player, TutHud, Last Text ID());
		For Player Variable(Event Player, TutStep, 0, 18, 1);
			Set Player Variable(Event Player, TutSkip, 0);
			Start Camera(Event Player, Ray Cast Hit Position(Add(Value In Array(Global Variable(LocPos), Value In Array(Array(0, 2, 3, 0, 1, 6, 8, 7, 11, 12, 4, 10, 0, 5, 11, 12, 9, 9), Event Player.TutStep)), Vector(0, 2, 0)), Add(Value In Array(Global Variable(LocPos), Value In Array(Array(0, 2, 3, 0, 1, 6, 8, 7, 11, 12, 4, 10, 0, 5, 11, 12, 9, 9), Event Player.TutStep)), Vector(0, 6, 9)), Empty Array, All Players(All Teams), False), Value In Array(Global Variable(LocPos), Value In Array(Array(0, 2, 3, 0, 1, 6, 8, 7, 11, 12, 4, 10, 0, 5, 11, 12, 9, 9), Event Player.TutStep)), 0);
			Wait Until(Event Player.TutSkip == 1, 7);
		End;
		Destroy HUD Text(Event Player.TutHud);
		Stop Camera(Event Player);
		Start Camera(Event Player, Ray Cast Hit Position(Add(Position Of(Event Player), Vector(0, 1.9, 0)), Add(Add(Position Of(Event Player), Vector(0, 1.9, 0)), Multiply(Facing Direction Of(Event Player), -4)), Empty Array, All Players(All Teams), False), Add(Add(Position Of(Event Player), Vector(0, 1.9, 0)), Multiply(Facing Direction Of(Event Player), 6)), 50);
		Set Invisible(Event Player, None);
		Clear Status(Event Player, Phased Out);
		Clear Status(Event Player, Rooted);
		Teleport(Event Player, Value In Array(Global Variable(LocPos), 0));
		Set Player Variable(Event Player, TutOn, 0);
		Set Player Variable(Event Player, Busy, 0);
		If(Event Player.TutDone == 0);
			Set Player Variable(Event Player, TutDone, 1);
			Set Player Variable At Index(Event Player, Inv, 0, Add(Value In Array(Event Player.Inv, 0), 3));
			Set Player Variable At Index(Event Player, Inv, 1, Add(Value In Array(Event Player.Inv, 1), 3));
			Modify Player Variable(Event Player, Money, Add, 50);
			Modify Player Variable(Event Player, Earned, Add, 50);
			Big Message(Event Player, Custom String("안내를 마쳤다 — 육포 3, 물통 3, $50"));
			Play Effect(Event Player, Good Explosion, Color(Lime Green), Position Of(Event Player), 2);
		Else;
			Small Message(Event Player, Custom String("보상은 처음 한 번뿐이다"));
		End;
	}
}
rule("[튜토리얼 02] 건너뛰기 (점프)")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	condition
	{
		Event Player.TutOn == 1;
		Is Button Held(Event Player, Button(Jump)) == True;
	}

	action
	{
		Set Player Variable(Event Player, TutSkip, 1);
	}
}

rule("[코어 05] 캐서디 스킬 봉인")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Hero Of(Event Player) == Hero(캐서디);
	}

	action
	{
		Set Ability 1 Enabled(Event Player, False);
		Set Ability 2 Enabled(Event Player, False);
		Set Ultimate Ability Enabled(Event Player, False);
		Set Secondary Fire Enabled(Event Player, False);
		Set Ultimate Charge(Event Player, 0);
		Set Melee Enabled(Event Player, False);
		Disallow Button(Event Player, Button(Ability 1));
		Disallow Button(Event Player, Button(Ability 2));
		Disallow Button(Event Player, Button(Ultimate));
		Disallow Button(Event Player, Button(Secondary Fire));
	}
}

rule("[코어 06] 애쉬 스킬 봉인 (조준경 허용)")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Hero Of(Event Player) == Hero(애쉬);
	}

	action
	{
		Set Ability 1 Enabled(Event Player, False);
		Set Ability 2 Enabled(Event Player, False);
		Set Ultimate Ability Enabled(Event Player, False);
		Set Secondary Fire Enabled(Event Player, True);
		Set Ultimate Charge(Event Player, 0);
		Set Melee Enabled(Event Player, False);
		Disallow Button(Event Player, Button(Ability 1));
		Disallow Button(Event Player, Button(Ability 2));
		Disallow Button(Event Player, Button(Ultimate));
		Allow Button(Event Player, Button(Secondary Fire));
	}
}

rule("[코어 20] 프레야 스킬 봉인 (조준 허용)")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Hero Of(Event Player) == Hero(프레야);
	}

	action
	{
		Set Ability 1 Enabled(Event Player, False);
		Set Ability 2 Enabled(Event Player, False);
		Set Ultimate Ability Enabled(Event Player, False);
		Set Secondary Fire Enabled(Event Player, True);
		Set Ultimate Charge(Event Player, 0);
		Set Melee Enabled(Event Player, False);
		Disallow Button(Event Player, Button(Ability 1));
		Disallow Button(Event Player, Button(Ability 2));
		Disallow Button(Event Player, Button(Ultimate));
		Allow Button(Event Player, Button(Secondary Fire));
	}
}

rule("[코어 16] 트레이서 설정 (배낭)")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Hero Of(Event Player) == Hero(트레이서);
	}

	action
	{
		Set Ability 1 Enabled(Event Player, False);
		Set Ability 2 Enabled(Event Player, False);
		Set Ultimate Ability Enabled(Event Player, False);
		Set Secondary Fire Enabled(Event Player, False);
		Set Ultimate Charge(Event Player, 0);
		Set Melee Enabled(Event Player, False);
		Disallow Button(Event Player, Button(Ability 1));
		Disallow Button(Event Player, Button(Ability 2));
		Disallow Button(Event Player, Button(Ultimate));
		Disallow Button(Event Player, Button(Secondary Fire));
	}
}

rule("[코어 17] 시온 설정 (말) — 바이크만 해금")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Hero Of(Event Player) == Hero(시온);
	}

	action
	{
		Set Ability 1 Enabled(Event Player, False);
		If(Or(Event Player.Contraband == 1, Or(Event Player.Sack >= 1, Event Player.Escort == 1)));
			Set Ability 2 Enabled(Event Player, False);
			Disallow Button(Event Player, Button(Ability 2));
		Else;
			Set Ability 2 Enabled(Event Player, True);
			Allow Button(Event Player, Button(Ability 2));
		End;
		Set Ultimate Ability Enabled(Event Player, False);
		Set Secondary Fire Enabled(Event Player, False);
		Set Ultimate Charge(Event Player, 0);
		Set Melee Enabled(Event Player, False);
		Disallow Button(Event Player, Button(Ability 1));
		Disallow Button(Event Player, Button(Ultimate));
		Disallow Button(Event Player, Button(Secondary Fire));
	}
}

rule("[코어 17-3] 운반 중 바이크 봉인")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Hero Of(Event Player) == Hero(시온);
		Or(Event Player.Contraband == 1, Or(Event Player.Sack >= 1, Event Player.Escort == 1)) == True;
	}

	action
	{
		Set Ability 2 Enabled(Event Player, False);
		Disallow Button(Event Player, Button(Ability 2));
		Small Message(Event Player, Custom String("짐을 진 몸이다 — 바이크는 못 탄다"));
	}
}

rule("[코어 17-4] 운반 종료 — 바이크 해금")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Hero Of(Event Player) == Hero(시온);
		Event Player.Contraband == 0;
		Event Player.Sack == 0;
		Event Player.Escort == 0;
	}

	action
	{
		Set Ability 2 Enabled(Event Player, True);
		Allow Button(Event Player, Button(Ability 2));
	}
}

rule("[코어 17-2] 바이크 쿨타임 2초")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Hero Of(Event Player) == Hero(시온);
		Is Using Ability 2(Event Player) == True;
	}

	action
	{
		Wait Until(Is Using Ability 2(Event Player) == False, 30);
		Set Ability Cooldown(Event Player, Button(Ability 2), 2);
	}
}

rule("[코어 17-5] 시온 — 안장 주머니 자동 취식")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Is Alive(Event Player) == True;
		Hero Of(Event Player) == Hero(시온);
		Event Player.Hunger < 35;
		Value In Array(Event Player.Inv, 0) >= 1;
	}

	action
	{
		Set Player Variable At Index(Event Player, Inv, 0, Subtract(Value In Array(Event Player.Inv, 0), 1));
		Set Player Variable(Event Player, Hunger, Min(100, Add(Event Player.Hunger, 20)));
		Heal(Event Player, Null, 15);
		Small Message(Event Player, Custom String("안장 주머니에서 육포를 꺼내 먹었다 — 허기 {0}", Round To Integer(Event Player.Hunger, Down)));
		Play Effect(Event Player, Buff Impact Sound, Color(Lime Green), Position Of(Event Player), 50);
	}
}

rule("[코어 18] 무한 탄창")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Is Alive(Event Player) == True;
		Ammo(Event Player, 0) < Max Ammo(Event Player, 0);
	}

	action
	{
		Set Max Ammo(Event Player, 0, 999);
		Set Ammo(Event Player, 0, 999);
	}
}

rule("[코어 21] 현상금 사냥꾼은 프레야")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Job == 3;
		Hero Of(Event Player) != Hero(프레야);
	}

	action
	{
		Start Forcing Player To Be Hero(Event Player, Hero(프레야));
	}
}

rule("[코어 22] 배지를 반납하면")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Init == 1;
		Event Player.Job != 3;
		Hero Of(Event Player) == Hero(프레야);
	}

	action
	{
		If(Event Player.HasHorse == 1);
		Start Forcing Player To Be Hero(Event Player, Hero(시온));
		Else If(Event Player.HasBag == 1);
		Start Forcing Player To Be Hero(Event Player, Hero(트레이서));
		Else;
		Start Forcing Player To Be Hero(Event Player, Hero(캐서디));
		Wait(1, Ignore Condition);
		Stop Forcing Player To Be Hero(Event Player);
		End;
	}
}

rule("[코어 07] 궁극기 게이지 상시 제거")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	condition
	{
		Is Dummy Bot(Event Player) == False;
	}

	action
	{
		Set Ultimate Charge(Event Player, 0);
		Wait(3, Ignore Condition);
		Loop();
	}
}

