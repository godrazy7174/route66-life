		Create In-World Text(And(Distance Between(Local Player, Value In Array(Global Variable(LocPos), 5)) < 13, Local Player.TutOn == 0) ? Local Player : False, Custom String("소유주  {0}      [웅크리기+F] 인수 $ {1}", Entity Exists(Value In Array(Global Variable(BldOwner), 5)) ? Value In Array(Global Variable(BldOwner), 5) : Custom String("없음 — 매물"), Value In Array(Global Variable(BldPrice), 5)), Add(Value In Array(Global Variable(LocPos), 5), Vector(0, 0.9, 0)), 0.8, Do Not Clip, Visible To Position and String, Color(Yellow), Default Visibility);
		Create In-World Text(And(Distance Between(Local Player, Value In Array(Global Variable(LocPos), 4)) < 13, Local Player.TutOn == 0) ? Local Player : False, Custom String("소유주  {0}      [웅크리기+F] 인수 $ {1}", Entity Exists(Value In Array(Global Variable(BldOwner), 4)) ? Value In Array(Global Variable(BldOwner), 4) : Custom String("없음 — 매물"), Value In Array(Global Variable(BldPrice), 4)), Add(Value In Array(Global Variable(LocPos), 4), Vector(0, 0.9, 0)), 0.8, Do Not Clip, Visible To Position and String, Color(Yellow), Default Visibility);
